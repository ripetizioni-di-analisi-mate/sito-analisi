---
import Base from '../layouts/Base.astro';
import { MATERIE } from '../data/materie';
import { VIDEOCORSI } from '../data/videocorsi';
import { PACCHETTI_MATERIE, PACCHETTI_VIDEO, riepilogoMaterie, riepilogoVideo, euro } from '../data/pacchetti.mjs';
const materie = MATERIE.filter((m) => m.attiva && m.prezzo).map((m) => ({ slug: m.slug, titolo: m.breve, prezzo: m.prezzo, attiva: true }));
const video = VIDEOCORSI.map(({ slug, breve, prezzo, sblocca, lezioni, pacchettoDi }) => ({ slug, breve, prezzo, sblocca, lezioni, pacchettoDi }));
const pacchetti = PACCHETTI_MATERIE.filter((p) => p.materie.every((s) => materie.some((m) => m.slug === s)));
const nomi = (slugs) => slugs.map((s) => materie.find((m) => m.slug === s)?.titolo || s).join(' + ');
---
<Base titolo="Pacchetti e sconti" descrizione="Pacchetti di materie con sconti dal 15% al 25% e percorsi di videocorsi con video, PDF e materiale incluso. Un acquisto unico, senza scadenza." percorso={[{ titolo: 'Pacchetti e sconti' }]} lingua="it" seo={{ soloQuestaLingua: true, senzaInglese: true }}>
  <h1>Più materie, più risparmio.</h1>
  <p class="sommario">Un acquisto unico, senza scadenza.</p>
  <div id="pacchetti-app" data-materie={JSON.stringify(materie)} data-video={JSON.stringify(video)}>
    <div class="schede-pacchetti" role="tablist" aria-label="Tipo di pacchetto">
      <button type="button" id="tab-materie" role="tab" aria-label="Materie" aria-describedby="tab-materie-dettagli" aria-selected="true" aria-controls="pannello-materie" data-tab="materie"><span>Materie</span><small id="tab-materie-dettagli">Teoria ed esercizi</small></button>
      <button type="button" id="tab-video" role="tab" aria-label="Videocorsi" aria-describedby="tab-video-dettagli" aria-selected="false" aria-controls="pannello-video" data-tab="video" tabindex="-1"><span>Videocorsi</span><small id="tab-video-dettagli">Video e PDF</small></button>
    </div>
    <section id="pannello-materie" role="tabpanel" aria-labelledby="tab-materie">
      <ul class="fasce" aria-label="Sconti sul numero di materie"><li data-sconto="15"><strong>−15%</strong><span>2 materie</span></li><li data-sconto="20"><strong>−20%</strong><span>3 materie</span></li><li data-sconto="25"><strong>−25%</strong><span>4 o più materie</span></li></ul>
      <div class="sezione-pacchetti"><h2>Pacchetti pronti</h2><a href="#componi" data-apri-componi>Scegli tu le materie <span aria-hidden="true">→</span></a></div>
      <div class="pacchetti-griglia">
        {pacchetti.map((p) => {
          const q = riepilogoMaterie(p.materie, materie);
          return <article class="pacchetto" data-preset={p.id}>
            <div class="pacchetto-testa"><span class="pacchetto-meta">{p.materie.length} materie</span><span class="sconto">−{q.percentuale}%</span></div>
            <h3>{p.titolo}</h3>
            <ul class="comprende" aria-label="Materie incluse">{p.materie.map((s) => <li>{nomi([s])}</li>)}</ul>
            <div class="pacchetto-prezzo"><p class="prezzi-pacchetto"><strong><span class="solo-lettore">Prezzo del pacchetto: </span>{euro(q.totale)}</strong><del><span class="solo-lettore">Prezzo separato: </span>{euro(q.separato)}</del></p><p class="risparmio">Risparmi {euro(q.risparmio)}</p></div>
            <button type="button" class="scegli-pacchetto" data-titolo={p.titolo} aria-label={`Scegli ${p.titolo}`} aria-pressed="false" data-scegli-materie={p.materie.join(',')}><span data-etichetta-scelta>Scegli il pacchetto</span><span data-segno-scelta aria-hidden="true">→</span></button>
          </article>;
        })}
      </div>
      <details class="componi" id="componi">
        <summary><span>Componi il tuo pacchetto</span><small>Da 2 materie</small></summary>
        <fieldset><legend>Scegli almeno due materie</legend>
          <div class="scelta-materie">{materie.map((m) => <label><input type="checkbox" name="materia" value={m.slug} /><span>{m.titolo}<small data-stato-materia={m.slug}>{euro(Math.round(m.prezzo * 100))}</small></span></label>)}</div>
        </fieldset>
      </details>
      <section class="riepilogo-pacchetto" id="riepilogo-materie" aria-label="Riepilogo delle materie" hidden>
        <h2 tabindex="-1">Il tuo pacchetto</h2>
        <div aria-live="polite"><p data-nomi-materie>Scegli un pacchetto o le materie che ti servono.</p><p class="totale-scelto" data-totale-materie>—</p><p class="risparmio" data-risparmio-materie></p></div>
        <button type="button" class="bottone-primario" data-compra="materie" disabled>Scegli almeno due materie</button>
      </section>
    </section>
    <section id="pannello-video" role="tabpanel" aria-labelledby="tab-video" hidden>
      <div class="sezione-pacchetti"><h2>Pacchetti video</h2></div>
      <p class="introduzione-video">Video, PDF e materie del sito collegate: tutto incluso.</p>
      <div class="pacchetti-griglia">
        {PACCHETTI_VIDEO.map((p) => {
          const q = riepilogoVideo(p.id, video);
          const numeroVideo = p.video.reduce((n, s) => n + (video.find((v) => v.slug === s)?.pacchettoDi?.length || 1), 0);
          return <article class="pacchetto" data-video-offerta={p.id}>
            <div class="pacchetto-testa"><span class="pacchetto-meta">{numeroVideo} videocorsi</span><span class="video-incluso">Materiale incluso</span></div>
            <h3>{p.titolo}</h3>
            <ul class="comprende" aria-label="Videocorsi inclusi">{p.video.map((s) => <li>{video.find((v) => v.slug === s)?.breve}</li>)}</ul>
            <p class="dati-video">{q.lezioni} lezioni · video e PDF</p>
            <p class="materiali-inclusi">Sul sito: {nomi(q.inclusi)}</p>
            <div class="pacchetto-prezzo"><p class="prezzi-pacchetto"><strong><span class="solo-lettore">Prezzo del pacchetto: </span>{euro(q.totale)}</strong><del><span class="solo-lettore">Prezzo dei corsi separati: </span>{euro(q.separato)}</del></p><p class="risparmio">Risparmi {euro(q.risparmio)}</p></div>
            <button type="button" class="scegli-pacchetto" data-titolo={p.titolo} aria-label={`Scegli ${p.titolo}`} aria-pressed="false" data-scegli-video={p.id}><span data-etichetta-scelta>Scegli il pacchetto</span><span data-segno-scelta aria-hidden="true">→</span></button>
          </article>;
        })}
      </div>
      <section class="riepilogo-pacchetto" id="riepilogo-video" aria-label="Riepilogo dei videocorsi" hidden>
        <h2 data-titolo-video tabindex="-1">Il tuo percorso video</h2>
        <div aria-live="polite"><p data-nomi-video>Scegli il pacchetto che ti interessa.</p><p class="totale-scelto" data-totale-video>—</p><p class="risparmio" data-risparmio-video></p></div>
        <button type="button" class="bottone-primario" data-compra="video" disabled>Scegli un pacchetto</button>
      </section>
      <p class="nota-pacchetti">Hai già un videocorso o del materiale? <a href="https://wa.me/393885680393" target="_blank" rel="noopener">Scrivi a Carmine per completare il percorso</a>.</p>
    </section>
    <p id="esito-pacchetto" role="status" aria-live="polite" hidden></p>
    <p class="nota-pacchetti">Sconto già incluso, non cumulabile. Pagamento sicuro con Paddle.</p>
    <p class="nota-termini-breve">Acquistando accetti i <a href="/termini">termini d’uso</a>.</p>
    <noscript><p>Attiva JavaScript per scegliere e acquistare il pacchetto. <a href="/contatti">Contattaci per assistenza</a>.</p></noscript>
  </div>
  <script>import '../scripts/pacchetti.mjs';</script>
</Base>
<style>
  .schede-pacchetti { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .35rem; margin: 1.25rem 0 1.35rem; padding: .3rem; border: 1px solid var(--riga); border-radius: 12px; background: var(--carta-2); font-family: var(--ui); }
  .schede-pacchetti button { display: flex; flex-direction: column; gap: .05rem; align-items: center; min-width: 0; min-height: 3.6rem; padding: .5rem .7rem; border: 1px solid transparent; border-radius: 8px; background: transparent; color: var(--inchiostro-2); font: inherit; cursor: pointer; }
  .schede-pacchetti button > span { font-weight: 600; }
  .schede-pacchetti small { font-size: .78rem; }
  .schede-pacchetti button[aria-selected="true"] { border-color: color-mix(in srgb,var(--azione) 23%,var(--riga)); background: #fff; color: var(--azione); box-shadow: 0 1px 3px rgba(34,48,47,.05); }
  .fasce { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .6rem; list-style: none; padding: 0; margin: 0 0 1.8rem; font-family: var(--ui); }
  .fasce li { display: flex; flex-direction: column; align-items: center; gap: .05rem; padding: .7rem .4rem; border: 1px solid var(--riga); border-radius: 9px; background: var(--carta); }
  .fasce strong { font-size: 1.6rem; line-height: 1.3; font-weight: 600; color: var(--azione); font-variant-numeric: tabular-nums; }
  .fasce span { font-size: .83rem; color: var(--inchiostro-2); text-align: center; }
  .fasce .is-attiva { border-color: var(--azione); background: color-mix(in srgb,var(--azione) 7%,var(--carta)); }
  .sezione-pacchetti { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .4rem .8rem; margin: 0 0 .9rem; }
  .sezione-pacchetti h2 { margin: 0; font-size: 1.2rem; }
  .sezione-pacchetti a { padding: .25rem 0; font: 600 .85rem/1.4 var(--ui); text-decoration: none; }
  .sezione-pacchetti a:hover { text-decoration: underline; }
  .pacchetti-griglia { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; }
  .pacchetto { display: flex; flex-direction: column; min-width: 0; padding: 1.15rem; border: 1px solid var(--riga); border-radius: 11px; background: #fff; }
  .pacchetto-testa { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .35rem .5rem; margin: 0 0 .65rem; font-family: var(--ui); }
  .pacchetto-meta { color: var(--inchiostro-2); font-size: .75rem; }
  .sconto { padding: .12rem .5rem; border-radius: 5px; background: color-mix(in srgb,var(--azione) 9%,white); color: var(--azione); font: 600 .8rem/1.4 var(--ui); }
  .video-incluso { color: var(--azione); font: 600 .72rem/1.4 var(--ui); }
  .pacchetto h3 { margin: 0; font-size: 1.25rem; line-height: 1.3; }
  .comprende { display: flex; flex-wrap: wrap; gap: .35rem; list-style: none; padding: 0; margin: .75rem 0 .9rem; font-family: var(--ui); }
  .comprende li { max-width: 100%; padding: .2rem .45rem; border-radius: 5px; background: var(--carta-2); color: var(--inchiostro); font-size: .8rem; line-height: 1.4; }
  .pacchetto-prezzo { margin-top: auto; padding-top: .4rem; }
  .prezzi-pacchetto { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem; margin: 0; font-family: var(--ui); font-variant-numeric: tabular-nums; }
  .prezzi-pacchetto strong { color: var(--inchiostro); font-size: 2rem; line-height: 1.3; font-weight: 700; }
  .prezzi-pacchetto del { color: var(--inchiostro-2); font-size: .88rem; }
  .risparmio { margin: .2rem 0 .85rem; color: var(--azione); font: 600 .85rem/1.4 var(--ui); }
  .scegli-pacchetto { display: flex; align-items: center; justify-content: space-between; gap: .4rem; min-height: 2.75rem; width: 100%; padding: .6rem .75rem; border: 1px solid color-mix(in srgb,var(--azione) 22%,var(--riga)); border-radius: 7px; background: color-mix(in srgb,var(--azione) 5%,white); color: var(--azione); text-align: left; font: 600 .9rem/1.4 var(--ui); cursor: pointer; }
  .scegli-pacchetto:hover:not(:disabled) { border-color: var(--azione); background: color-mix(in srgb,var(--azione) 9%,white); }
  .scegli-pacchetto:disabled { border-color: var(--riga); background: var(--carta); color: var(--inchiostro-2); cursor: default; font-weight: 400; }
  .pacchetto.is-selected { border-color: var(--azione); box-shadow: inset 0 0 0 1px var(--azione); background: color-mix(in srgb,var(--azione) 3%,white); }
  .pacchetto.is-selected .scegli-pacchetto { background: var(--azione); border-color: var(--azione); color: white; }
  .componi { margin: 1.25rem 0; border: 1px solid var(--riga); border-radius: 10px; background: var(--carta-2); font-family: var(--ui); scroll-margin-top: 5rem; }
  .componi summary { display: flex; align-items: center; gap: .6rem; min-height: 3.4rem; padding: .8rem 1rem; list-style: none; color: var(--azione); font-size: .95rem; font-weight: 600; cursor: pointer; }
  .componi summary::-webkit-details-marker { display: none; }
  .componi summary small { margin-left: auto; color: var(--inchiostro-2); font-size: .75rem; font-weight: 400; white-space: nowrap; }
  .componi summary::after { content: ''; flex: none; width: .35rem; height: .35rem; margin-left: .2rem; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(-45deg); }
  .componi[open] summary::after { transform: rotate(45deg); }
  fieldset { min-width: 0; border: 0; padding: 0 1rem 1rem; margin: 0; }
  legend { padding: .2rem 0 .6rem; color: var(--inchiostro-2); font-size: .85rem; }
  .scelta-materie { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .35rem .9rem; }
  .scelta-materie label { display: flex; align-items: center; gap: .6rem; min-height: 44px; padding: .45rem 0; font-size: .9rem; cursor: pointer; }
  .scelta-materie input { flex: none; width: 1.1rem; height: 1.1rem; accent-color: var(--azione); }
  .scelta-materie small { display: block; color: var(--inchiostro-2); font-size: .78rem; }
  .scelta-materie input:disabled + span { color: var(--inchiostro-2); }
  .riepilogo-pacchetto { margin: 1.4rem 0; padding: 1.2rem; border: 1px solid var(--riga); border-top: 3px solid var(--azione); border-radius: 10px; background: #fff; scroll-margin-top: 5rem; }
  .riepilogo-pacchetto h2 { margin: 0; font-size: 1.25rem; }
  .riepilogo-pacchetto p { margin: .55rem 0; }
  .riepilogo-pacchetto [data-nomi-materie], .riepilogo-pacchetto [data-nomi-video] { color: var(--inchiostro-2); font: .95rem/1.5 var(--ui); }
  .riepilogo-pacchetto .totale-scelto { color: var(--inchiostro); font: 700 2rem/1.3 var(--ui); font-variant-numeric: tabular-nums; }
  .riepilogo-pacchetto .risparmio { margin-bottom: 1rem; }
  .riepilogo-pacchetto button { width: 100%; max-width: 100%; margin-top: .3rem; white-space: normal; }
  .introduzione-video, .dati-video, .materiali-inclusi, .nota-pacchetti { color: var(--inchiostro-2); font: .85rem/1.5 var(--ui); }
  .introduzione-video { margin: -.45rem 0 1.2rem; }
  .dati-video { margin: -.35rem 0 .6rem; }
  .materiali-inclusi { padding-top: .6rem; margin: 0 0 .7rem; border-top: 1px solid var(--riga); }
  .solo-lettore { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  #esito-pacchetto { font-family: var(--ui); scroll-margin-top: 5rem; }
  @media (max-width: 36rem) { .pacchetti-griglia, .scelta-materie { grid-template-columns: minmax(0,1fr); } }
  @media (max-width: 23rem) { .fasce { gap: .4rem; } .fasce strong { font-size: 1.4rem; } .fasce span { font-size: .76rem; } .componi summary { gap: .4rem; padding-inline: .8rem; font-size: .88rem; } }
</style>
