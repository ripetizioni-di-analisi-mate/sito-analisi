---
import Base from '../layouts/Base.astro';
import { MATERIE } from '../data/materie';
import { VIDEOCORSI } from '../data/videocorsi';
import { PACCHETTI_MATERIE, PACCHETTI_VIDEO, riepilogoMaterie, riepilogoVideo, euro } from '../data/pacchetti.mjs';
const materie = MATERIE.filter((m) => m.attiva && m.prezzo).map((m) => ({ slug: m.slug, titolo: m.breve, prezzo: m.prezzo, attiva: true }));
const video = VIDEOCORSI.map(({ slug, breve, prezzo, sblocca, lezioni, pacchettoDi }) => ({ slug, breve, prezzo, sblocca, lezioni, pacchettoDi }));
const pacchetti = PACCHETTI_MATERIE.filter((p) => p.materie.every((s) => materie.some((m) => m.slug === s)));
const nomi = (slugs) => slugs.map((s) => materie.find((m) => m.slug === s)?.titolo || s).join(' + ');
---
<Base titolo="Pacchetti e sconti" descrizione="Pacchetti di materie con sconti dal 15% al 25% e percorsi di videocorsi con video, PDF e materiale incluso. Un acquisto unico, senza scadenza." percorso={[{ titolo: 'Pacchetti e sconti' }]} lingua="it" seo={{ soloQuestaLingua: true, senzaInglese: true }}>
  <h1>Più materie, più risparmio.</h1>
  <p class="sommario">Scegli il tuo percorso. Un acquisto unico, senza scadenza.</p>
  <div id="pacchetti-app" data-materie={JSON.stringify(materie)} data-video={JSON.stringify(video)}>
    <div class="schede-pacchetti" role="tablist" aria-label="Tipo di pacchetto">
      <button type="button" id="tab-materie" role="tab" aria-selected="true" aria-controls="pannello-materie" data-tab="materie">Materie</button>
      <button type="button" id="tab-video" role="tab" aria-selected="false" aria-controls="pannello-video" data-tab="video" tabindex="-1">Videocorsi</button>
    </div>
    <section id="pannello-materie" role="tabpanel" aria-labelledby="tab-materie">
      <p class="fasce"><span>2 materie <b>−15%</b></span><span>3 materie <b>−20%</b></span><span>4 o più <b>−25%</b></span></p>
      <div class="pacchetti-griglia">
        {pacchetti.map((p) => {
          const q = riepilogoMaterie(p.materie, materie);
          return <article class="pacchetto" data-preset={p.id}>
            <div class="pacchetto-testa"><h2>{p.titolo}</h2><span class="sconto">−{q.percentuale}%</span></div>
            <p class="comprende">{nomi(p.materie)}</p>
            <p class="prezzi-pacchetto"><del aria-label="Prezzo separato">{euro(q.separato)}</del><strong>{euro(q.totale)}</strong></p>
            <p class="risparmio">Risparmi {euro(q.risparmio)}</p>
            <button type="button" class="scegli-pacchetto" data-scegli-materie={p.materie.join(',')}>Scegli il pacchetto <span aria-hidden="true">→</span></button>
          </article>;
        })}
      </div>
      <details class="componi" id="componi">
        <summary>Oppure componi il tuo pacchetto</summary>
        <fieldset><legend>Scegli almeno due materie</legend>
          <div class="scelta-materie">{materie.map((m) => <label><input type="checkbox" name="materia" value={m.slug} /><span>{m.titolo}<small data-stato-materia={m.slug}>{euro(Math.round(m.prezzo * 100))}</small></span></label>)}</div>
        </fieldset>
      </details>
      <section class="riepilogo-pacchetto" id="riepilogo-materie" aria-label="Riepilogo delle materie">
        <h2>Il tuo pacchetto</h2>
        <div aria-live="polite"><p data-nomi-materie>Scegli un pacchetto o le materie che ti servono.</p><p class="totale-scelto" data-totale-materie>—</p><p class="risparmio" data-risparmio-materie></p></div>
        <button type="button" class="bottone-primario" data-compra="materie" disabled>Scegli almeno due materie</button>
      </section>
    </section>
    <section id="pannello-video" role="tabpanel" aria-labelledby="tab-video" hidden>
      <p class="nota-pacchetti">Video, PDF e materie del sito collegate: tutto incluso.</p>
      <div class="pacchetti-griglia">
        {PACCHETTI_VIDEO.map((p) => {
          const q = riepilogoVideo(p.id, video);
          return <article class="pacchetto" data-video-offerta={p.id}>
            <h2>{p.titolo}</h2>
            <p class="comprende">{p.video.map((s) => video.find((v) => v.slug === s)?.breve).join(' + ')}</p>
            <p class="dati-video">{q.lezioni} lezioni · video e PDF</p>
            <p class="prezzi-pacchetto"><del aria-label="Prezzo dei corsi acquistati separatamente">{euro(q.separato)}</del><strong>{euro(q.totale)}</strong></p>
            <p class="risparmio">Risparmi {euro(q.risparmio)}</p>
            <p class="materiali-inclusi">Sul sito: {nomi(q.inclusi)}</p>
            <button type="button" class="scegli-pacchetto" data-scegli-video={p.id}>Scegli il pacchetto <span aria-hidden="true">→</span></button>
          </article>;
        })}
      </div>
      <section class="riepilogo-pacchetto" id="riepilogo-video" aria-label="Riepilogo dei videocorsi">
        <h2 data-titolo-video>Il tuo percorso video</h2>
        <div aria-live="polite"><p data-nomi-video>Scegli il pacchetto che ti interessa.</p><p class="totale-scelto" data-totale-video>—</p><p class="risparmio" data-risparmio-video></p></div>
        <button type="button" class="bottone-primario" data-compra="video" disabled>Scegli un pacchetto</button>
      </section>
      <p class="nota-pacchetti">Hai già un videocorso o del materiale? <a href="https://wa.me/393885680393" target="_blank" rel="noopener">Scrivi a Carmine per completare il percorso</a>.</p>
    </section>
    <p id="esito-pacchetto" role="status" aria-live="polite" hidden></p>
    <p class="nota-pacchetti">Lo sconto è già nel totale e non si somma ad altre promozioni. Pagamento sicuro con Paddle.</p>
    <p class="nota-termini-breve">Acquistando accetti i <a href="/termini">termini d’uso</a>.</p>
    <noscript><p>Attiva JavaScript per scegliere e acquistare il pacchetto. <a href="/contatti">Contattaci per assistenza</a>.</p></noscript>
  </div>
  <script>import '../scripts/pacchetti.mjs';</script>
</Base>
<style>
  .schede-pacchetti { display: flex; gap: .4rem; border-bottom: 1px solid var(--riga); margin: 1.3rem 0 1rem; font-family: var(--ui); }
  .schede-pacchetti button { font: inherit; font-weight: 600; border: 0; border-bottom: 2px solid transparent; padding: .7rem 1rem; color: var(--inchiostro-2); background: none; cursor: pointer; }
  .schede-pacchetti button[aria-selected="true"] { border-bottom-color: var(--azione); color: var(--azione); }
  .fasce { display: flex; flex-wrap: wrap; gap: .5rem 1rem; font: .9rem/1.4 var(--ui); margin: 0 0 1.2rem; }
  .fasce b { color: var(--azione); margin-left: .25rem; }
  .pacchetti-griglia { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .85rem; }
  .pacchetto { display: flex; flex-direction: column; padding: 1rem; border: 1px solid var(--riga); background: #fff; border-radius: 8px; min-width: 0; }
  .pacchetto-testa { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem; }
  .pacchetto h2 { margin: 0; font-size: 1.15rem; }
  .sconto { font: 600 .85rem var(--ui); color: var(--azione); white-space: nowrap; }
  .comprende { color: var(--inchiostro-2); font: .9rem/1.45 var(--ui); margin: .5rem 0 .7rem; }
  .prezzi-pacchetto { display: flex; align-items: baseline; flex-wrap: wrap; gap: .3rem .65rem; margin: auto 0 0; font-family: var(--ui); font-variant-numeric: tabular-nums; }
  .prezzi-pacchetto del { font-size: .9rem; color: var(--inchiostro-2); }
  .prezzi-pacchetto strong { font-size: 1.65rem; color: var(--inchiostro); }
  .risparmio { margin: .15rem 0 .7rem; font: 600 .85rem/1.4 var(--ui); color: var(--azione); }
  .scegli-pacchetto { display: flex; align-items: center; justify-content: space-between; gap: .4rem; padding: .65rem 0 0; margin-top: .2rem; border: 0; border-top: 1px solid var(--riga); background: none; color: var(--azione); text-align: left; font: 600 .9rem/1.4 var(--ui); cursor: pointer; }
  .scegli-pacchetto:disabled { color: var(--inchiostro-2); cursor: default; }
  .componi { margin: 1.25rem 0; padding: .9rem 0; border-block: 1px solid var(--riga); font-family: var(--ui); }
  .componi summary { font-weight: 600; color: var(--azione); cursor: pointer; }
  fieldset { border: 0; padding: .85rem 0 0; margin: 0; min-width: 0; }
  legend { font-size: .9rem; padding: .7rem 0 0; }
  .scelta-materie { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .4rem .8rem; }
  .scelta-materie label { display: flex; gap: .6rem; align-items: center; padding: .5rem 0; font-size: .95rem; cursor: pointer; }
  .scelta-materie input { flex: none; width: 1.1rem; height: 1.1rem; accent-color: var(--azione); }
  .scelta-materie small { display: block; font-size: .8rem; color: var(--inchiostro-2); }
  .scelta-materie input:disabled + span { color: var(--inchiostro-2); }
  .riepilogo-pacchetto { margin: 1.25rem 0; padding: 1rem; border: 1px solid var(--riga); border-radius: 8px; background: var(--carta-2); scroll-margin-top: 5rem; }
  .riepilogo-pacchetto h2 { font-size: 1.2rem; margin: 0; }
  .riepilogo-pacchetto p { margin: .45rem 0; }
  .riepilogo-pacchetto [data-nomi-materie], .riepilogo-pacchetto [data-nomi-video] { font: .95rem/1.45 var(--ui); }
  .riepilogo-pacchetto .totale-scelto { font: 700 1.8rem/1.3 var(--ui); font-variant-numeric: tabular-nums; }
  .riepilogo-pacchetto button { margin-top: .6rem; max-width: 100%; white-space: normal; }
  .dati-video, .materiali-inclusi, .nota-pacchetti { color: var(--inchiostro-2); font: .85rem/1.5 var(--ui); }
  .dati-video { margin: -.35rem 0 .75rem; }
  .materiali-inclusi { margin: 0 0 .6rem; }
  #esito-pacchetto { font-family: var(--ui); scroll-margin-top: 5rem; }
  @media (max-width: 36rem) { .pacchetti-griglia, .scelta-materie { grid-template-columns: minmax(0,1fr); } }
</style>
