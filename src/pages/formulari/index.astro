---
// Elenco dei formulari gratuiti.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { materia as trovaMateria } from '../../data/materie';
import { FORMULARI } from '../../data/formulari';

const voci = (await getCollection('formulari'))
  .filter((v) => (FORMULARI as readonly string[]).includes(v.id))
  .sort((a, b) => FORMULARI.indexOf(a.id as any) - FORMULARI.indexOf(b.id as any));
---
<Base titolo="Formulari gratuiti di Analisi matematica e Fisica" descrizione="Formulari gratuiti di Precorso, Analisi matematica 1 e 2 e Fisica 1, con le condizioni di validità di ogni formula: si leggono online e si scaricano in PDF." lingua="it" percorso={[{ titolo: 'Formulari' }]}>
  <p class="sopratitolo">Gratis</p>
  <h1>Formulari</h1>
  <p class="sommario">Le formule di ogni materia con le loro condizioni di validità, nell'ordine degli argomenti dell'esame. Si leggono qui per intero; il PDF si scarica con un account gratuito.</p>
  <ul class="elenco-righe">
    {voci.map((v) => {
      const m = trovaMateria(v.id);
      return (
        <li style={`--accento: ${m.colore}`}>
          <a href={`/formulari/${v.id}`}>
            <span class="riga-punto" aria-hidden="true"></span>
            <span class="riga-testo"><strong>{v.data.titolo}</strong><small>{v.data.sommario}</small></span>
            <span class="riga-etichetta">Gratis · PDF con account</span>
            <span class="riga-freccia" aria-hidden="true">→</span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>
