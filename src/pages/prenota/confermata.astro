---
// Ritorno dal pagamento di Stripe: conferma della lezione prenotata.
import Base from '../../layouts/Base.astro';
import StileLezioni from '../../components/StileLezioni.astro';
---
<Base lingua="it" titolo="Lezione prenotata" percorso={[{ titolo: 'Prenota una lezione', href: '/prenota' }, { titolo: 'Conferma' }]}
  seo={{ noindex: true, soloQuestaLingua: true, senzaInglese: true }}>
  <StileLezioni />
  <div class="prenota">
    <p class="sopratitolo">Lezione individuale online</p>
    <h1 id="titolo">Controllo del pagamento…</h1>
    <div id="contenuto"><p class="sommario">Un momento: aspetto la conferma del pagamento.</p></div>
  </div>
</Base>

<script>
  const titolo = document.getElementById('titolo')!;
  const contenuto = document.getElementById('contenuto')!;
  const s = new URLSearchParams(location.search).get('s') || '';
  const esc = (x: string) => String(x ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  async function controlla(tentativo = 0) {
    const r = await fetch('/api/prenota/stato', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ s }) }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    if (d?.stato === 'pagata') {
      titolo.textContent = 'Lezione prenotata';
      contenuto.innerHTML = `<p class="sommario">Il pagamento è stato ricevuto. All’indirizzo ${esc(d.email)} arrivano l’email di conferma e l’invito di Google Calendar con il link di Google Meet.</p>
        <div class="scheda-lezione"><dl><dt>Materia</dt><dd>${esc(d.materia)}</dd><dt>Quando</dt><dd>${esc(d.quando)}</dd>
        <dt>Dove</dt><dd>${d.meet ? `<a href="${esc(d.meet)}" target="_blank" rel="noopener">Google Meet</a>` : 'Google Meet, link nell’invito'}</dd></dl></div>
        <p>Una traccia d’esame o degli esercizi su cui lavorare si possono mandare prima della lezione su <a href="https://wa.me/393885680393" target="_blank" rel="noopener">WhatsApp</a>.</p>
        <div class="tasti"><a class="bottone-primario" href="${esc(d.gestione)}">Sposta o disdici</a><a class="bottone-secondario" href="/">Torna al sito</a></div>`;
      return;
    }
    if (tentativo < 15 && (!d || d.stato === 'in-attesa')) { setTimeout(() => controlla(tentativo + 1), 2000); return; }
    titolo.textContent = d ? 'Pagamento non completato' : 'Prenotazione non trovata';
    contenuto.innerHTML = d
      ? '<p class="sommario">Il pagamento non risulta completato e l’orario è tornato libero. Si può prenotare di nuovo dalla pagina <a href="/prenota">Prenota una lezione</a>.</p>'
      : '<p class="sommario">La conferma del pagamento non è ancora arrivata. Se l’importo è stato addebitato, l’email di conferma arriva entro pochi minuti; altrimenti scrivimi su <a href="https://wa.me/393885680393">WhatsApp</a>.</p>';
  }
  controlla();
</script>
