---
// English formula sheet of a subject: free page (indexed) and PDF for account holders (Italian version: src/pages/formulari/[materia].astro).
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { materiaL } from '../../../i18n';
import { FORMULARI, pdfFormulario } from '../../../data/formulari';
import { SITO, assoluto } from '../../../lib/seo';

export async function getStaticPaths() {
  const voci = await getCollection('formulari_en');
  return voci.filter((v) => (FORMULARI as readonly string[]).includes(v.id)).map((v) => ({ params: { materia: v.id }, props: { voce: v } }));
}
const { voce } = Astro.props;
const slug = voce.id;
const m = materiaL('en', slug);
const { Content, headings } = await render(voce);
const sezioni = headings.filter((h) => h.depth === 2);
const pdf = pdfFormulario(slug, 'en');
const indirizzo = `/en/formulari/${slug}`;
const tradotti = new Set((await getCollection('formulari_en')).map((v) => v.id));
const altri = FORMULARI.filter((x) => x !== slug && tradotti.has(x)).map((x) => ({ slug: x, titolo: materiaL('en', x).titolo }));
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: voce.data.titolo,
  description: voce.data.descrizione,
  inLanguage: 'en',
  isAccessibleForFree: true,
  learningResourceType: 'Formula sheet',
  educationalLevel: 'University',
  about: m.titolo,
  url: assoluto(indirizzo),
  author: { '@type': 'Person', name: 'Carmine Tornincasa', url: assoluto('/en/chi-sono') },
  publisher: { '@type': 'Organization', name: 'Ripetizioni di Analisi', url: SITO },
  encoding: { '@type': 'MediaObject', encodingFormat: 'application/pdf', contentUrl: assoluto(pdf) },
}];
---
<Base titolo={voce.data.titolo} descrizione={voce.data.descrizione} lingua="en" percorso={[{ titolo: 'Formula sheets', href: '/en/formulari' }, { titolo: m.titolo }]} seo={{ titolo: `${voce.data.titolo} (free PDF)`, schema }}>
  <div class="formulario" style={`--accento: ${m.colore}`}>
    <p class="sopratitolo">Free formula sheet</p>
    <h1>{voce.data.titolo}</h1>
    <p class="sommario">{voce.data.sommario}</p>

    <div class="scarica-formulario" id="scarica">
      <p class="scarica-testo">The whole formula sheet can be read here. The PDF, ready to print, can be downloaded with a free account.</p>
      <a class="bottone-primario scarica-pdf solo-collegati" href={pdf} download>Download the PDF</a>
      <a class="bottone-primario scarica-pdf solo-ospiti" href={`/en/accedi?nuovo=1&dopo=${encodeURIComponent(indirizzo + '#scarica')}`}>Create a free account and download the PDF</a>
      <p class="nota-accesso solo-ospiti">Already have an account? <a href={`/en/accedi?dopo=${encodeURIComponent(indirizzo + '#scarica')}`}>Sign in</a></p>
    </div>

    <nav class="indice-formulario" aria-label="Sections of the formula sheet">
      <ol>{sezioni.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>

    <div class="testo-studio testo-formulario">
      <Content />
    </div>

    <aside class="formulario-fine">
      <p>The full theory, with proofs and step-by-step worked examples, is in the subject <a href={`/en/${slug}`}>{m.titolo}</a>.</p>
      <p>Other formula sheets: {altri.map((a, i) => <>{i > 0 && ' · '}<a href={`/en/formulari/${a.slug}`}>{a.titolo}</a></>)}.</p>
    </aside>
  </div>
</Base>
