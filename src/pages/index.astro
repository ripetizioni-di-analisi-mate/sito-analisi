---
import Base from '../layouts/Base.astro';
import Stato from '../components/Stato.astro';
import { MATERIE, gruppi } from '../data/materie';
import { url } from '../lib/url';
---
<Base titolo="Ripetizioni di Analisi" descrizione="Teoria ed esercizi per gli esami di matematica dell'università, materia per materia.">
  <p class="sopratitolo">Teoria ed esercizi</p>
  <h1>Scegli la materia</h1>
  <p class="sommario">Per ogni materia trovi teoria, definizioni, teoremi e dimostrazioni, esercizi svolti passo dopo passo ed esercizi da risolvere con soluzione.</p>
  <form class="cerca-home" action={url('/cerca')} role="search">
    <input type="search" name="q" placeholder="Cerca un argomento, un teorema, un tipo di esercizio…" aria-label="Cerca nel sito" autocomplete="off" />
    <button type="submit">Cerca</button>
  </form>
  {gruppi().map((g) => (
    <section class="gruppo">
      <h2 class="nome-gruppo">{g}</h2>
      <ul class="griglia-materie">
        {MATERIE.filter((m) => m.gruppo === g).map((m) => (
          <li class:list={{ 'in-preparazione': !m.attiva }} style={`--accento: ${m.colore}`} data-materia={m.slug}>
            {m.attiva ? (
              <a href={url(`/${m.slug}`)}>
                <h3>{m.titolo}</h3>
                <p>{m.descrizione}</p>
                <span class="piede-scheda"><span class="conteggio">{m.argomenti.length} argomenti</span><Stato prezzo={m.prezzo} /></span>
              </a>
            ) : (
              <div>
                <h3>{m.titolo}</h3>
                <p>{m.descrizione}</p>
                <span class="conteggio">in preparazione</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
