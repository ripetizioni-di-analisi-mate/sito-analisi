---
import Base from '../layouts/Base.astro';
import { MATERIE } from '../data/materie';
import { url } from '../lib/url';
---
<Base titolo="Ripetizioni di Analisi" descrizione="Teoria ed esercizi per gli esami di matematica dell'università, materia per materia.">
  <p class="sopratitolo">Teoria ed esercizi</p>
  <h1>Scegli la materia</h1>
  <p class="sommario">Per ogni materia gli argomenti dell'esame, uno alla volta: la teoria con definizioni, teoremi e dimostrazioni; gli esercizi svolti con tutti i passaggi; gli esercizi da fare con la soluzione.</p>
  <ul class="griglia-materie">
    {MATERIE.map((m) => (
      <li class:list={{ 'in-preparazione': !m.attiva }} style={`--accento: ${m.colore}`}>
        {m.attiva ? (
          <a href={url(`/${m.slug}`)}>
            <h2>{m.titolo}</h2>
            <p>{m.descrizione}</p>
            <span class="conteggio">{m.argomenti.length} argomenti</span>
          </a>
        ) : (
          <div>
            <h2>{m.titolo}</h2>
            <p>{m.descrizione}</p>
            <span class="conteggio">in preparazione</span>
          </div>
        )}
      </li>
    ))}
  </ul>
</Base>
