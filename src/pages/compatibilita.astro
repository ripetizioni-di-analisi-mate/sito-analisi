---
// «Compatibilità con il tuo esame»: lo studente carica il testo del suo compito d'esame universitario e il sito lo
// confronta con il materiale della materia (componente CompatibilitaEsame.astro, Worker worker/compatibilita.mjs).
// Solo esami universitari: niente concorsi, test di ingresso e scuole superiori. Solo in italiano.
import Base from '../layouts/Base.astro';
import CompatibilitaEsame from '../components/CompatibilitaEsame.astro';
import { materia as datiMateria } from '../data/materie';
import { MATERIE_COMPATIBILITA } from '../data/compatibilita';
const elenco = MATERIE_COMPATIBILITA.map((s) => datiMateria(s).titolo).join(', ').replace(/, ([^,]*)$/, ' e $1');
---
<Base lingua="it" titolo="Compatibilità con il tuo esame" percorso={[{ titolo: 'Compatibilità con il tuo esame' }]}
  descrizione={`Carica il compito d'esame o il programma di ${elenco}: confronta esercizi e argomenti con la teoria e gli esercizi svolti del sito.`}
  seo={{ titolo: 'Compatibilità con il tuo esame universitario | Ripetizioni di Analisi', soloQuestaLingua: true, senzaInglese: true }}>
  <div class="pagina-compat">
    <p class="sopratitolo">Esami universitari</p>
    <h1>Compatibilità con il tuo esame</h1>
    <p class="sommario">Carica un compito d’esame oppure il programma del corso, anche come elenco di argomenti. Il sito riconosce il documento e indica quanto è coperto e dove studiare ogni voce.</p>
    <CompatibilitaEsame />
  </div>
</Base>

<style is:global>
  .pagina-compat { max-width: 44rem; }
</style>
