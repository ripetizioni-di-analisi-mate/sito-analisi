---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { MATERIE, materia as trovaMateria } from '../../data/materie';

export function getStaticPaths() {
  return MATERIE.filter((m) => m.attiva && m.prezzo).map((m) => ({ params: { materia: m.slug } }));
}
const { materia } = Astro.params;
const m = trovaMateria(materia!);
const svolti = (await getCollection('svolti')).filter((v) => v.id.startsWith(`${materia}/`)).length;
const dafare = (await getCollection('dafare')).filter((v) => v.id.startsWith(`${materia}/`)).length;
---
<Base titolo={`Sblocca ${m.titolo}`} descrizione={`Accesso completo a ${m.titolo}: teoria, schede di esercizi svolti, soluzioni e PDF.`} materia={materia} percorso={[{ titolo: 'Sblocca' }]}>
  <p class="sopratitolo">{m.titolo}</p>
  <h1>Sblocca {m.titolo}</h1>
  <p class="sommario">Un acquisto unico, senza abbonamento: la materia resta sbloccata nel tuo account, su tutti i tuoi dispositivi.</p>
  <ul class="cosa-include">
    <li>La <strong>teoria completa</strong> di tutti gli {m.argomenti.length} argomenti, con definizioni, teoremi e dimostrazioni</li>
    <li>Tutte le <strong>{svolti} schede di esercizi svolti</strong> per tipologia, con ogni passaggio spiegato</li>
    <li>Le <strong>soluzioni</strong> dei {dafare} esercizi da fare</li>
    <li>Il <strong>PDF scaricabile</strong> di ogni argomento, per studiare anche senza connessione</li>
  </ul>
  <div class="riquadro-acquisto">
    <p class="prezzo"><strong>{m.prezzo} €</strong> <span>una volta sola</span></p>
    <div id="azione"><p class="esito-modulo">Un momento…</p></div>
  </div>

  <script is:inline define:vars={{ materia, titolo: m.titolo }}>
    (async () => {
      const azione = document.getElementById('azione');
      const qui = location.pathname;
      const [rIo, rConf] = await Promise.all([fetch('/api/io').catch(() => null), fetch('/api/config').catch(() => null)]);
      const io = rIo && rIo.ok ? await rIo.json() : null;
      const conf = rConf && rConf.ok ? (await rConf.json()).paddle : null;

      if (!io) {
        azione.innerHTML = `<a class="bottone-primario" href="/accedi?nuovo=1&dopo=${encodeURIComponent(qui)}">Crea un account e sblocca</a>
          <p class="nota-accesso">Hai già un account? <a href="/accedi?dopo=${encodeURIComponent(qui)}">Accedi</a></p>`;
        return;
      }
      if (io.materie.includes(materia)) {
        azione.innerHTML = `<p class="stato-ok">${titolo} è già sbloccata nel tuo account ✓</p><a class="bottone-primario" href="/${materia}">Vai agli argomenti</a>`;
        return;
      }
      if (!conf || !conf.prezzi[materia]) {
        azione.innerHTML = `<p>I pagamenti online stanno per arrivare. Nel frattempo puoi sbloccare scrivendomi su
          <a href="https://wa.me/393885680393" target="_blank" rel="noopener">WhatsApp</a> o su
          <a href="https://instagram.com/ripetizioni_di_analisi_mate" target="_blank" rel="noopener">Instagram</a>:
          attivo la materia sul tuo account <strong>${io.email}</strong>.</p>`;
        return;
      }
      azione.innerHTML = `<button type="button" class="bottone-primario" id="compra">Sblocca ora</button>
        <p class="nota-accesso">Acquisto collegato al tuo account ${io.email}.</p>`;
      const s = document.createElement('script');
      s.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
      s.onload = () => {
        if (conf.ambiente === 'sandbox') Paddle.Environment.set('sandbox');
        Paddle.Initialize({
          token: conf.token,
          eventCallback: (ev) => {
            if (ev.name !== 'checkout.completed') return;
            azione.innerHTML = '<p>Pagamento ricevuto. Sto sbloccando la materia nel tuo account…</p>';
            let tentativi = 0;
            const controlla = async () => {
              const r = await fetch('/api/io').catch(() => null);
              const d = r && r.ok ? await r.json() : null;
              if (d && d.materie.includes(materia)) { location.href = `/${materia}`; return; }
              if (++tentativi < 30) setTimeout(controlla, 2000);
              else azione.innerHTML = '<p>Pagamento ricevuto. Lo sblocco richiede ancora qualche istante: ricarica la pagina tra poco, oppure scrivimi dalla pagina Contatti.</p>';
            };
            controlla();
          },
        });
        document.getElementById('compra').addEventListener('click', () => {
          Paddle.Checkout.open({
            items: [{ priceId: conf.prezzi[materia], quantity: 1 }],
            customer: { email: io.email },
            customData: { materia, email: io.email },
            settings: { locale: 'it' },
          });
        });
      };
      s.onerror = () => { azione.innerHTML = '<p>Il modulo di pagamento non si è caricato. Ricarica la pagina o scrivimi dalla pagina Contatti.</p>'; };
      document.head.appendChild(s);
    })();
  </script>
</Base>
