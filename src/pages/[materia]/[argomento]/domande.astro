---
import Domande from '../../../viste/Domande.astro';
import { catalogoDomande, conteggiDomande } from '../../../lib/domande';
import { RIPASSO, RIPASSO_OGGI } from '../../../data/livelli';
export async function getStaticPaths() {
  const out = [];
  for (const [materia, argomenti] of Object.entries(await catalogoDomande('it'))) {
    const dati = (await conteggiDomande('it'))[materia] ?? {};
    for (const argomento of argomenti) out.push({ params: { materia, argomento }, props: { totale: dati[argomento] ?? 0 } });
    // Ultimo capitolo, Prove d'esame: domande di ripasso su tutti gli argomenti.
    out.push({ params: { materia, argomento: RIPASSO }, props: { totale: Object.values(dati).reduce((t, x) => t + x, 0) } });
    // Ripasso di oggi (con l'account): le domande sbagliate che tornano dopo 1, 3 e 7 giorni.
    out.push({ params: { materia, argomento: RIPASSO_OGGI }, props: { totale: 0 } });
  }
  return out;
}
const { materia, argomento } = Astro.params;
---
<Domande lingua="it" materia={materia!} argomento={argomento!} totale={Astro.props.totale} />
