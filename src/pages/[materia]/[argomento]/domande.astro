---
import Domande from '../../../viste/Domande.astro';
import { catalogoDomande, domandePer } from '../../../lib/domande';
export async function getStaticPaths() {
  const out = [];
  for (const [materia, argomenti] of Object.entries(await catalogoDomande('it'))) {
    const dati = await domandePer(materia, 'it');
    for (const argomento of argomenti) out.push({ params: { materia, argomento }, props: { totale: dati[argomento]?.length ?? 0 } });
  }
  return out;
}
const { materia, argomento } = Astro.params;
---
<Domande lingua="it" materia={materia!} argomento={argomento!} totale={Astro.props.totale} />
