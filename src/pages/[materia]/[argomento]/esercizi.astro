---
import DafareLista from '../../../viste/DafareLista.astro';
import { coppie } from '../../../data/materie';
export function getStaticPaths() {
  return coppie().map((c) => ({ params: c }));
}
const { materia, argomento } = Astro.params;
---
<DafareLista lingua="it" materia={materia!} argomento={argomento!} />
