---
import Teoria from '../../../viste/Teoria.astro';
import { coppie } from '../../../data/materie';
export function getStaticPaths() {
  return coppie().map((c) => ({ params: c }));
}
const { materia, argomento } = Astro.params;
---
<Teoria lingua="it" materia={materia!} argomento={argomento!} />
