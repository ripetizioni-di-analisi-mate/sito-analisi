---
import { existsSync } from 'node:fs';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { coppie, argomento as trovaArgomento, materia as trovaMateria } from '../../../data/materie';
import { url } from '../../../lib/url';
import { vicini, perArgomento, numero } from '../../../lib/nav';

export function getStaticPaths() {
  return coppie().map((c) => ({ params: c }));
}
const { materia, argomento } = Astro.params;
const arg = trovaArgomento(materia!, argomento!);
const voce = await getEntry('teoria', `${materia}/${argomento}`);
const resa = voce ? await render(voce) : null;
const Contenuto = resa?.Content ?? null;
const sezioni = resa?.headings.filter((h) => h.depth === 2) ?? [];
const svolti = perArgomento(await getCollection('svolti'), materia!, argomento!);
const dafare = perArgomento(await getCollection('dafare'), materia!, argomento!);
const { precedente, successivo } = vicini(materia!, argomento!, 'teoria');
// Argomento successivo della materia, per chi segue solo il filo della teoria.
const elenco = trovaMateria(materia!).argomenti;
const dopo = elenco[elenco.findIndex((a) => a.slug === argomento) + 1];
const prossimo = dopo && { titolo: dopo.titolo, href: url(`/${materia}/${dopo.slug}/teoria`) };
const pdf = existsSync(new URL(`../../../../public/pdf/${materia}/${argomento}.pdf`, import.meta.url));
const base = `/${materia}/${argomento}`;

// ancora → esercizi che la usano, per i collegamenti dalla teoria agli esercizi
const usi: Record<string, { s: number[]; d: number[] }> = {};
for (const e of svolti) for (const t of e.data.teoria) ((usi[t] ||= { s: [], d: [] }).s.push(numero(e.id)));
for (const e of dafare) for (const t of e.data.teoria) ((usi[t] ||= { s: [], d: [] }).d.push(numero(e.id)));
const basi = { s: url(`${base}/esercizi-svolti`), d: url(`${base}/esercizi`) };
---
<Base
  titolo={`${arg.titolo} · Teoria`}
  descrizione={voce?.data.sommario}
  percorso={[{ titolo: arg.breve, href: url(`${base}/teoria`) }, { titolo: 'Teoria' }]}
  materia={materia} argomento={argomento} sezione="teoria"
  precedente={precedente} successivo={successivo} prossimo={prossimo}
>
  <p class="sopratitolo">Teoria</p>
  <h1>{voce?.data.titolo ?? arg.titolo}</h1>
  {voce?.data.sommario && <p class="sommario">{voce.data.sommario}</p>}
  {pdf && <p class="collegamenti">PDF dell'argomento: <a href={url(`/pdf/${materia}/${argomento}.pdf`)}>scarica {arg.titolo} in PDF</a> (teoria, esercizi svolti ed esercizi da fare).</p>}
  {sezioni.length > 1 && (
    <details class="sommario-pagina">
      <summary>In questa pagina</summary>
      <ol>
        {sezioni.map((s) => <li><a href={`#${s.slug}`}>{s.text}</a></li>)}
      </ol>
    </details>
  )}
  {Contenuto ? <Contenuto /> : <p class="nota-segnaposto">La teoria di questo argomento è in preparazione.</p>}
  <script is:inline define:vars={{ usi, basi }}>
    for (const [id, u] of Object.entries(usi)) {
      const b = document.getElementById(id);
      if (!b) continue;
      const link = (base, n) => `<a href="${base.replace(/\.html$/, '')}/${n}${base.endsWith('.html') ? '.html' : ''}">${n}</a>`;
      const parti = [];
      if (u.s.length) parti.push('svolti ' + u.s.map((n) => link(basi.s, n)).join(', '));
      if (u.d.length) parti.push('da fare ' + u.d.map((n) => link(basi.d, n)).join(', '));
      const p = document.createElement('p');
      p.className = 'blocco-esercizi';
      p.innerHTML = 'Esercizi: ' + parti.join(' · ');
      b.appendChild(p);
    }
  </script>
  {svolti.length > 0 && (
    <>
      <h2>Esercizi svolti su questo argomento</h2>
      <ul class="elenco-esercizi">
        {svolti.map((e) => (
          <li><a href={url(`${base}/esercizi-svolti/${numero(e.id)}`)}><span class="numero">{numero(e.id)}</span><span>{e.data.titolo}</span></a></li>
        ))}
      </ul>
    </>
  )}
</Base>
