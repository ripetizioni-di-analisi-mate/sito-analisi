---
// Studio guidato: test sulle lacune per abilità (anteprima riservata ai GM; versione 2 del 14/11/2026).
// Le domande e la correzione arrivano dal Worker (/api/studio-guidato/…, worker/studio-guidato.mjs):
// la risposta corretta non è mai nella pagina.
import Base from '../../layouts/Base.astro';
import { STUDIO_GUIDATO } from '../../data/studio-guidato.mjs';
import { materia as materiaIt } from '../../data/materie';

export function getStaticPaths() {
  return Object.keys(STUDIO_GUIDATO).map((materia) => ({ params: { materia } }));
}
const { materia } = Astro.params;
const m = materiaIt(materia!)!;
const argomenti = m.argomenti.filter((a) => STUDIO_GUIDATO[materia!].dipendenze[a.slug]);
const nome = m.breve || m.titolo;
---
<Base lingua="it" titolo={`Studio guidato · ${m.titolo}`} percorso={[{ titolo: m.titolo, href: `/${materia}` }, { titolo: 'Studio guidato' }]}
  descrizione="Un test breve sul capitolo scelto: individua le abilità da riprendere e indica i paragrafi della teoria e le schede svolte da cui ripartire."
  seo={{ titolo: `Studio guidato · ${m.titolo}`, noindex: true, soloQuestaLingua: true, senzaInglese: true }}>
  <div class="sg-pagina" id="studio-guidato" data-materia={materia} data-nome={nome}>
    <section data-sg-intro>
      <header class="sg-testa"><h1>Studio guidato</h1><p>Su che cosa ti sei bloccato?</p></header>
      <div class="sg-righe">
        <button type="button" data-sg-arg="">
          <svg class="sg-bers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg>
          <span><b>Non so da dove iniziare</b><small>Una domanda per capitolo, poi il test sul primo capitolo da riprendere.</small></span><svg class="sg-fr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
        {argomenti.map((a, n) => <button type="button" data-sg-arg={a.slug}><i>{String(n + 1).padStart(2, '0')}</i><span><b>{a.titolo}</b></span><svg class="sg-fr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>)}
      </div>
      <p class="sg-nota">Il test parte appena scegli. Al massimo 12 domande, senza limite di tempo.</p>
      <div class="sg-ripresa" data-sg-ripresa hidden></div>
      <p class="sg-errore" data-sg-errore role="alert"></p>
    </section>

    <section data-sg-test hidden aria-label="Test in corso">
      <div class="sg-avanz"><div class="sg-barra" data-sg-barra aria-hidden="true"><span></span></div>
        <div class="sg-sopra"><span class="sg-arg"><b data-sg-argomento></b><em data-sg-provenienza hidden></em></span><span data-sg-numero></span></div></div>
      <form class="sg-dom" data-sg-form>
        <fieldset><legend class="q" data-sg-testo tabindex="-1"></legend><div class="sg-scelte" data-sg-scelte></div></fieldset>
        <div class="sg-nav"><button type="button" class="sg-link" data-sg-nonso>Non lo so</button><button type="submit" class="sg-btn" data-sg-conferma disabled>Conferma</button></div>
      </form>
    </section>

    <section data-sg-risultato hidden aria-label="Il risultato" tabindex="-1"></section>
  </div>

  <style is:global>
    .sg-pagina{font-family:var(--ui);max-width:42rem;color:var(--inchiostro)}
    .sg-pagina section:not([hidden]){display:flex;flex-direction:column;gap:1.25rem}
    .sg-testa h1{margin:0 0 .35rem;font-size:2.1rem;line-height:1.15}
    .sg-testa p{margin:0;font-size:1.06rem;line-height:1.45;color:var(--inchiostro-2)}
    .sg-righe{display:flex;flex-direction:column;border-bottom:1px solid var(--riga)}
    .sg-righe button{display:grid;grid-template-columns:2.25rem minmax(0,1fr) 1rem;align-items:center;gap:0 .9rem;min-height:3.5rem;padding:.4rem 0;border:0;border-top:1px solid var(--riga);background:none;color:var(--inchiostro);text-align:left;cursor:pointer;font-family:var(--ui)}
    .sg-righe button:hover b{color:var(--azione)}
    .sg-righe i{font:700 1.2rem var(--titoli);color:#7d765c}
    .sg-righe span{display:flex;flex-direction:column;gap:.05rem}
    .sg-righe b{font:700 1.12rem/1.3 var(--titoli)}
    .sg-righe small{font-size:.88rem;color:var(--inchiostro-2)}
    .sg-bers{width:22px;height:22px;color:var(--azione)}
    .sg-fr{width:15px;height:15px;color:var(--azione)}
    .sg-nota{margin:0;font-size:.88rem;color:var(--inchiostro-2)}
    .sg-btn{display:inline-flex;align-items:center;justify-content:center;height:2.9rem;padding:0 1.5rem;border:0;border-radius:999px;background:var(--azione);color:#fff;text-decoration:none;font:600 1rem var(--ui);cursor:pointer}
    .sg-btn[disabled]{opacity:.45;cursor:default}
    .sg-link{background:none;border:0;color:var(--inchiostro);text-decoration:underline;text-underline-offset:3px;font:400 .94rem var(--ui);cursor:pointer;padding:0;min-height:2.75rem;align-self:flex-start}
    .sg-errore{color:#9b2c1c;font-weight:600;margin:0}
    .sg-errore:empty{display:none}
    .sg-ripresa[hidden]{display:none}
    .sg-ripresa a{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.2rem 1rem;padding:.8rem 1.1rem;background:#fff;border:1px solid var(--riga);border-radius:14px;font-size:.94rem;color:var(--inchiostro);text-decoration:none}
    .sg-ripresa a:hover{border-color:var(--azione)}
    .sg-ripresa b{font-weight:600;color:var(--azione);white-space:nowrap}
    .sg-btn.sec{background:none;color:var(--azione);border:1.5px solid var(--azione);height:2.5rem;padding:0 1.1rem;font-size:.92rem}
    .sg-avanz{display:flex;flex-direction:column;gap:.5rem}
    .sg-barra{height:3px;border-radius:2px;background:var(--riga)}
    .sg-barra span{display:block;height:3px;border-radius:2px;background:var(--azione);width:0;transition:width .25s}
    .sg-barra.senza{display:none}
    .sg-sopra{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;font-size:.88rem;color:var(--inchiostro-2)}
    .sg-sopra>span:last-child{white-space:nowrap;flex:none}
    .sg-arg em{font-style:normal;margin-left:.5rem;color:#785735;white-space:nowrap}
    .sg-arg b{font-weight:400}
    .sg-dom{display:flex;flex-direction:column;gap:1.25rem}
    .sg-dom fieldset{border:0;margin:0;padding:0;min-width:0}
    .sg-dom .q{font:700 1.55rem/1.35 var(--titoli);padding:.9rem 0 .2rem;margin:0 0 1rem;overflow-x:auto;max-width:100%}
    .sg-dom .q p{margin:0 0 .5rem}
    .sg-scelte{display:flex;flex-direction:column;border-bottom:1px solid var(--riga);counter-reset:sc}
    .sg-scelta{counter-increment:sc;position:relative;display:flex;align-items:center;gap:1rem;min-height:3.5rem;padding:.35rem .75rem;border-top:1px solid var(--riga);font:1.18rem var(--testo);cursor:pointer;overflow-x:auto}
    .sg-scelta::before{content:counter(sc,upper-alpha);font:700 1.05rem var(--titoli);color:var(--azione);width:1rem;flex:none}
    .sg-scelta input{position:absolute;opacity:0;pointer-events:none}
    .sg-scelta:hover{background:#fbf9f3}
    .sg-scelta:has(input:checked){background:#f4efe1;box-shadow:inset 3px 0 0 var(--azione)}
    .sg-scelta:has(input:focus-visible){outline:2px solid var(--azione);outline-offset:-2px}
    .sg-scelta p{margin:0}
    .sg-nav{display:flex;align-items:center;justify-content:space-between;gap:1rem}
    .sg-nav .sg-link{color:var(--inchiostro-2);align-self:center}
    .sg-sintesi{margin:0;padding-left:1rem;border-left:3px solid var(--azione);font:1.12rem/1.5 var(--testo)}
    .sg-tappe{display:flex;flex-direction:column;margin:.3rem 0 0;padding:0;list-style:none}
    .sg-tappe li{display:grid;grid-template-columns:2.5rem minmax(0,1fr);gap:1rem}
    .sg-filo{display:flex;flex-direction:column;align-items:center}
    .sg-filo b{width:2.5rem;height:2.5rem;border-radius:10px;border:1.5px solid var(--azione);background:#fff;color:var(--azione);font:700 1.05rem var(--titoli);display:grid;place-items:center;box-sizing:border-box}
    .sg-tappe li:first-child .sg-filo b{background:var(--azione);color:#fff}
    .sg-filo::after{content:'';flex:1;width:2px;background:var(--riga)}
    .sg-tappe li:last-child .sg-filo::after{display:none}
    .sg-tappa{display:flex;flex-direction:column;gap:.5rem;padding:1rem 1.1rem;margin-bottom:.9rem;background:#fff;border:1px solid var(--riga);border-radius:14px}
    .sg-tappe li:last-child .sg-tappa{margin-bottom:0}
    .sg-tappe li:first-child .sg-tappa{background:#f4efe1;border-color:#e7dec8}
    .sg-qui{font-size:.75rem;font-weight:600;letter-spacing:.06em;color:#785735}
    .sg-tit{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem}
    .sg-tit h2{margin:0;font:700 1.25rem/1.3 var(--titoli)}
    .sg-tit span{font-size:.82rem;font-weight:600;white-space:nowrap;color:#785735}
    .sg-tit span.cons{color:var(--azione)}
    .sg-perche{margin:0;font-size:.88rem;line-height:1.45;color:var(--inchiostro-2)}
    .sg-vai{display:flex;flex-wrap:wrap;gap:.5rem}
    .sg-vai a{flex:1 1 12.5rem;display:flex;flex-direction:column;gap:.1rem;padding:.6rem .9rem;border:1px solid var(--riga);border-radius:10px;background:#fff;text-decoration:none;color:var(--inchiostro);font-size:.88rem;line-height:1.3}
    .sg-vai a:hover{border-color:var(--azione)}
    .sg-vai small{font-size:.75rem;font-weight:600;color:var(--azione)}
    .sg-chip{display:flex;flex-wrap:wrap;gap:.5rem;margin:0}
    .sg-chip span{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .75rem .3rem .5rem;border-radius:999px;background:#e6efec;color:#1f5a4f;font-size:.88rem}
    .sg-chip.nv span{background:#efebe2;color:var(--inchiostro-2);padding-left:.75rem}
    .sg-chip svg{width:14px;height:14px;flex:none}
    .sg-etich{margin:0 0 -.7rem;font-size:.82rem;color:var(--inchiostro-2)}
    .sg-dopo{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem 1rem;padding:.85rem 1.1rem;background:#fff;border:1px solid var(--riga);border-radius:14px;font-size:.94rem}
    @media(max-width:640px){
      .sg-testa h1{font-size:1.7rem}
      .sg-dom .q{font-size:1.3rem}
      .sg-tappe li{grid-template-columns:2rem minmax(0,1fr);gap:.6rem}
      .sg-filo b{width:2rem;height:2rem;font-size:.95rem;border-radius:8px}
      .sg-tit{flex-direction:column;gap:.1rem}
      .sg-dopo .sg-btn{flex:1 1 auto}
    }
  </style>
  <script>
    const radice = document.getElementById('studio-guidato')!;
    const materia = radice.dataset.materia!;
    const $ = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
    const intro = $('[data-sg-intro]'), test = $('[data-sg-test]'), ris = $('[data-sg-risultato]');
    const errore = $('[data-sg-errore]');
    let token = '';
    let occupato = false;

    const esc = (t: string) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
    async function chiama(percorso: string, corpo?: unknown) {
      const r = await fetch(percorso, corpo === undefined ? { credentials: 'same-origin', cache: 'no-store' }
        : { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify(corpo) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.errore || 'Errore di collegamento. Riprova.');
      return d;
    }

    function mostraDomanda(d: any) {
      intro.hidden = true; ris.hidden = true; test.hidden = false;
      $('[data-sg-numero]').textContent = d.massimo ? `${d.numero} di ${d.massimo} al massimo` : `Domanda ${d.numero}`;
      $('[data-sg-barra]').classList.toggle('senza', !d.massimo);
      if (d.massimo) $('[data-sg-barra] span').style.width = `${Math.round(100 * d.numero / d.massimo)}%`;
      $('[data-sg-argomento]').textContent = d.argomento;
      const etichetta = d.base ? 'Basi · Precorso' : d.fase === 'base' ? 'Base di un altro capitolo' : d.fase === 'cerca' ? 'Ricerca del capitolo' : d.fase === 'ricontrollo' ? 'Ricontrollo' : '';
      $('[data-sg-provenienza]').textContent = etichetta;
      $('[data-sg-provenienza]').hidden = !etichetta;
      $('[data-sg-testo]').innerHTML = d.testo;
      $('[data-sg-scelte]').innerHTML = d.scelte.map((s: string, i: number) =>
        `<label class="sg-scelta"><input type="radio" name="scelta" value="${i}" /><span>${s}</span></label>`).join('');
      $<HTMLButtonElement>('[data-sg-conferma]').disabled = true;
      $('[data-sg-testo]').focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    $('[data-sg-scelte]').addEventListener('change', () => { $<HTMLButtonElement>('[data-sg-conferma]').disabled = false; });

    async function avanza(percorso: string, corpo: unknown) {
      if (occupato) return;
      occupato = true;
      errore.textContent = '';
      try {
        const d = await chiama(percorso, corpo);
        if (d.fine) mostraEsito(d.esito, d.progresso);
        else { token = d.token; mostraDomanda(d.domanda); }
      } catch (e: any) {
        if (test.hidden) errore.textContent = e.message;
        else alertInline(e.message);
      } finally { occupato = false; }
    }
    function alertInline(msg: string) {
      let p = test.querySelector<HTMLElement>('.sg-errore');
      if (!p) { p = document.createElement('p'); p.className = 'sg-errore'; p.setAttribute('role', 'alert'); test.append(p); }
      p.textContent = msg;
    }

    const righe = [...radice.querySelectorAll<HTMLButtonElement>('[data-sg-arg]')];
    righe.forEach((b) => b.addEventListener('click', () => {
      const argomento = b.dataset.sgArg;
      avanza('/api/studio-guidato/inizia', argomento ? { materia, argomento } : { materia });
    }));
    $('[data-sg-form]').addEventListener('submit', (e) => {
      e.preventDefault();
      const s = radice.querySelector<HTMLInputElement>('input[name="scelta"]:checked');
      if (s) avanza('/api/studio-guidato/rispondi', { token, scelta: Number(s.value) });
    });
    $('[data-sg-nonso]').addEventListener('click', () => avanza('/api/studio-guidato/rispondi', { token, scelta: null }));

    const minuscola = (x: string) => esc(x[0].toLowerCase() + x.slice(1));
    function mostraEsito(e: any, prog: any) {
      test.hidden = true; intro.hidden = true; ris.hidden = false;
      const lacune = e.lacune || [];
      const percorso = lacune.map((l: any, k: number) => {
        const dove = l.m === 'precorso' ? `Precorso · ${esc(l.capitolo)}` : esc(l.capitolo);
        const perche = [
          `${dove}.`,
          l.stato === 'lacuna' ? `${l.sbagliate === 1 ? 'Una risposta sbagliata' : `${l.sbagliate} risposte sbagliate`} su ${l.chieste}.` : 'Sbagliata la domanda di livello medio.',
          l.per?.length ? `È la base di ${l.per.map((x: string) => `«${minuscola(x)}»`).join(', ')}.` : '',
        ].filter(Boolean).join(' ');
        const vai = [
          ...l.teoria.map((t: any) => `<a href="${t.href}"><small>Teoria</small>${esc(t.titolo)}</a>`),
          ...l.schede.map((x: any) => `<a href="${x.href}"><small>Scheda svolta</small>${esc(x.titolo)}</a>`),
        ].join('') || `<a href="${l.domande}"><small>Allenamento</small>Domande a tempo del capitolo</a>`;
        return `<li><div class="sg-filo"><b>${k + 1}</b></div><div class="sg-tappa">
          ${k === 0 ? '<span class="sg-qui">PARTI DA QUI</span>' : ''}
          <div class="sg-tit"><h2>${esc(l.nome)}</h2><span${l.stato === 'lacuna' ? '' : ' class="cons"'}>${l.stato === 'lacuna' ? 'Da riprendere' : 'Da consolidare'}</span></div>
          <p class="sg-perche">${perche}</p>
          <div class="sg-vai">${vai}</div></div></li>`;
      }).join('');
      const spunta = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
      const nomi = (stato: string, segno = '') => (e.abilita || []).filter((a: any) => a.stato === stato).map((a: any) => `<span>${segno}${esc(a.nome)}</span>`).join('');
      const sai = nomi('ok', spunta), nonVerificate = nomi('nv');
      const capitolo = e.modo === 'ricontrollo' ? 'Ricontrollo' : e.titoloCapitolo ? esc(e.titoloCapitolo) : 'Tutti i capitoli';
      ris.innerHTML = `<header class="sg-testa"><h1>Da dove ripartire</h1><p>${capitolo} · ${e.domande} domande</p></header>
        <p class="sg-sintesi">${esc(e.sintesi)}</p>
        ${lacune.length ? `<ol class="sg-tappe">${percorso}</ol>` : ''}
        ${sai ? `<p class="sg-etich">Senza errori</p><p class="sg-chip">${sai}</p>` : ''}
        ${nonVerificate ? `<p class="sg-etich">Non verificate in questo test</p><p class="sg-chip nv">${nonVerificate}</p>` : ''}
        ${lacune.length ? '<div class="sg-dopo"><span>Dopo lo studio: una domanda nuova per ogni punto.</span><button type="button" class="sg-btn" data-sg-ricontrolla>Ricontrolla le lacune</button></div>'
          : `<div class="sg-dopo"><span>Nessun punto da riprendere in questo test.</span><a class="sg-btn" href="/${materia}/simulazione">Simulazione d’esame</a></div>`}
        <button type="button" class="sg-link" data-sg-rifai>Scegli un altro capitolo</button>`;
      ris.querySelector('[data-sg-rifai]')!.addEventListener('click', () => { ris.hidden = true; intro.hidden = false; window.scrollTo({ top: 0 }); });
      ris.querySelector('[data-sg-ricontrolla]')?.addEventListener('click', () => avanza('/api/studio-guidato/inizia', { materia, ricontrollo: true }));
      ris.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // All'apertura: se c'è un test precedente si mostra il risultato (?esito) oppure la riga di ripresa.
    chiama(`/api/studio-guidato?materia=${encodeURIComponent(materia)}`).then((d) => {
      if (!d.ultimo) return;
      if (new URLSearchParams(location.search).has('esito')) { mostraEsito(d.ultimo, d.progresso); return; }
      const r = $('[data-sg-ripresa]');
      const n = d.ultimo.lacune.length;
      const quando = new Date(d.ultimo.quando).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
      r.innerHTML = `<a href="?esito"><span>Ultimo test: ${quando}${d.ultimo.titoloCapitolo ? `, ${esc(d.ultimo.titoloCapitolo)}` : ''} · ${n ? `${n === 1 ? 'un punto' : `${n} punti`} da riprendere` : 'nessun punto da riprendere'}</span><b>Rivedi il risultato</b></a>`;
      r.hidden = false;
    }).catch((e) => { errore.textContent = e.message; righe.forEach((b) => { b.disabled = true; }); });
  </script>
</Base>
