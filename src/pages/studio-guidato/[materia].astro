---
// Studio guidato: test sulle lacune per abilità (anteprima riservata ai GM; versione 2 del 14/11/2026).
// Le domande e la correzione arrivano dal Worker (/api/studio-guidato/…, worker/studio-guidato.mjs):
// la risposta corretta non è mai nella pagina.
import Base from '../../layouts/Base.astro';
import { STUDIO_GUIDATO } from '../../data/studio-guidato.mjs';
import { materia as materiaIt } from '../../data/materie';

export function getStaticPaths() {
  return Object.keys(STUDIO_GUIDATO).map((materia) => ({ params: { materia } }));
}
const { materia } = Astro.params;
const m = materiaIt(materia!)!;
const argomenti = m.argomenti.filter((a) => STUDIO_GUIDATO[materia!].dipendenze[a.slug]);
const nome = m.breve || m.titolo;
---
<Base lingua="it" titolo={`Studio guidato · ${m.titolo}`} percorso={[{ titolo: m.titolo, href: `/${materia}` }, { titolo: 'Studio guidato' }]}
  descrizione="Un test breve sul capitolo scelto: individua le abilità da riprendere e indica i paragrafi della teoria e le schede svolte da cui ripartire."
  seo={{ titolo: `Studio guidato · ${m.titolo}`, noindex: true, soloQuestaLingua: true, senzaInglese: true }}>
  <div class="sg-pagina" id="studio-guidato" data-materia={materia} data-nome={nome}>
    <section data-sg-intro>
      <header class="sg-testa"><h1>Studio guidato</h1><p>Scegli il capitolo su cui ti sei bloccato.</p></header>
      <div class="sg-righe">
        <button type="button" data-sg-arg="">
          <svg class="sg-bers" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg>
          <span><b>Non so da dove iniziare</b><small>Una domanda per capitolo, poi il test sul primo capitolo da riprendere.</small></span><svg class="sg-fr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>
        {argomenti.map((a, n) => <button type="button" data-sg-arg={a.slug}><i>{String(n + 1).padStart(2, '0')}</i><span><b>{a.titolo}</b></span><svg class="sg-fr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></button>)}
        <div class="sg-parole" data-sg-parole>
          <button type="button" class="sg-parole-apri" data-sg-parole-apri aria-expanded="false" aria-controls="sg-blocco"><i class="sg-pi-ic" aria-hidden="true">π</i><span><b>Descrivilo a parole</b><small>Scrivi che cosa non ti è chiaro: Pi sceglie il capitolo e le domande.</small></span><svg class="sg-fr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
          <form class="sg-blocco" id="sg-blocco" data-sg-blocco hidden>
            <label for="sg-frase" class="sg-vis">Che cosa non ti è chiaro?</label>
            <div class="sg-blocco-riga"><textarea id="sg-frase" rows="2" maxlength="400" placeholder="Per esempio: non capisco quando si può usare il teorema di De l’Hôpital"></textarea>
              <button type="submit" class="sg-btn">Inizia</button></div>
            <p class="sg-blocco-nota" data-sg-blocco-nota role="status"></p>
          </form>
        </div>
      </div>
      <p class="sg-nota">Il test parte appena scegli. Al massimo 12 domande, senza limite di tempo.</p>
      <div class="sg-ripresa" data-sg-ripresa hidden></div>
      <div class="sg-iscriviti" data-sg-iscriviti hidden>
        <p><b>Lo Studio guidato è riservato agli iscritti.</b> Basta un account gratuito.</p>
        <p><a class="sg-btn" data-sg-nuovo href="/accedi?nuovo=1">Crea un account gratuito</a> <a class="sg-link" data-sg-accedi href="/accedi">Accedi</a></p>
      </div>
      <p class="sg-errore" data-sg-errore role="alert"></p>
    </section>

    <section data-sg-test hidden aria-label="Test in corso">
      <div class="sg-avanz"><div class="sg-barra" data-sg-barra aria-hidden="true"><span></span></div>
        <div class="sg-sopra"><span class="sg-arg"><b data-sg-argomento></b><em data-sg-provenienza hidden></em></span><span data-sg-numero></span></div></div>
      <p class="sg-pi" data-sg-pi hidden><i aria-hidden="true">π</i><span data-sg-pi-testo></span></p>
      <form class="sg-dom" data-sg-form>
        <fieldset><legend class="q" data-sg-testo tabindex="-1"></legend><div class="sg-scelte" data-sg-scelte></div></fieldset>
        <div class="sg-nav"><button type="button" class="sg-link" data-sg-nonso>Non lo so</button>
          <div class="sg-conf"><button type="submit" class="sg-btn sec" data-sg-sicuro="0" disabled>Sto tirando a indovinare</button><button type="submit" class="sg-btn" data-sg-sicuro="1" disabled>Sono sicuro</button></div></div>
      </form>
    </section>

    <section data-sg-risultato hidden aria-label="Il risultato" tabindex="-1"></section>
  </div>

  <style is:global>
    .sg-pagina{font-family:var(--ui);max-width:42rem;color:var(--inchiostro)}
    .sg-pagina section:not([hidden]){display:flex;flex-direction:column;gap:1.25rem}
    .sg-testa h1{margin:0 0 .35rem;font-size:2.1rem;line-height:1.15}
    .sg-testa p{margin:0;font-size:1.06rem;line-height:1.45;color:var(--inchiostro-2)}
    .sg-righe{display:flex;flex-direction:column;border-bottom:1px solid var(--riga)}
    .sg-righe>button,.sg-righe .sg-parole-apri{display:grid;grid-template-columns:2.25rem minmax(0,1fr) 1rem;align-items:center;gap:0 .9rem;min-height:3.5rem;padding:.4rem 0;border:0;border-top:1px solid var(--riga);background:none;color:var(--inchiostro);text-align:left;cursor:pointer;font-family:var(--ui)}
    .sg-righe>button:hover b,.sg-righe .sg-parole-apri:hover b{color:var(--azione)}
    .sg-righe i{font:700 1.2rem var(--titoli);color:#7d765c}
    .sg-righe span{display:flex;flex-direction:column;gap:.05rem}
    .sg-righe b{font:700 1.12rem/1.3 var(--titoli)}
    .sg-righe small{font-size:.88rem;color:var(--inchiostro-2)}
    .sg-bers{width:22px;height:22px;color:var(--azione)}
    .sg-fr{width:15px;height:15px;color:var(--azione)}
    .sg-nota{margin:0;font-size:.88rem;color:var(--inchiostro-2)}
    .sg-btn{display:inline-flex;align-items:center;justify-content:center;height:2.9rem;padding:0 1.5rem;border:0;border-radius:999px;background:var(--azione);color:#fff;text-decoration:none;font:600 1rem var(--ui);cursor:pointer}
    .sg-btn[disabled]{opacity:.45;cursor:default}
    .sg-link{background:none;border:0;color:var(--inchiostro);text-decoration:underline;text-underline-offset:3px;font:400 .94rem var(--ui);cursor:pointer;padding:0;min-height:2.75rem;align-self:flex-start}
    .sg-errore{color:#9b2c1c;font-weight:600;margin:0}
    .sg-errore:empty{display:none}
    .sg-ripresa[hidden]{display:none}
    .sg-iscriviti{padding:1rem 1.1rem;background:#fff;border:1px solid var(--riga);border-radius:14px}
    .sg-iscriviti[hidden],.sg-righe[hidden],.sg-nota[hidden]{display:none}
    .sg-iscriviti p{margin:0 0 .7rem;font-size:.98rem}
    .sg-iscriviti p:last-child{margin:0;display:flex;flex-wrap:wrap;align-items:center;gap:.4rem 1.2rem}
    .sg-iscriviti .sg-link{align-self:center}
    .sg-ripresa a{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.2rem 1rem;padding:.8rem 1.1rem;background:#fff;border:1px solid var(--riga);border-radius:14px;font-size:.94rem;color:var(--inchiostro);text-decoration:none}
    .sg-ripresa a:hover{border-color:var(--azione)}
    .sg-ripresa b{font-weight:600;color:var(--azione);white-space:nowrap}
    .sg-btn.sec{background:none;color:var(--azione);border:1.5px solid var(--azione);height:2.5rem;padding:0 1.1rem;font-size:.92rem}
    .sg-avanz{display:flex;flex-direction:column;gap:.5rem}
    .sg-barra{height:3px;border-radius:2px;background:var(--riga)}
    .sg-barra span{display:block;height:3px;border-radius:2px;background:var(--azione);width:0;transition:width .25s}
    .sg-barra.senza{display:none}
    .sg-sopra{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;font-size:.88rem;color:var(--inchiostro-2)}
    .sg-sopra>span:last-child{white-space:nowrap;flex:none}
    .sg-arg em{font-style:normal;margin-left:.5rem;color:#785735;white-space:nowrap}
    .sg-arg b{font-weight:400}
    .sg-dom{display:flex;flex-direction:column;gap:1.25rem}
    .sg-dom fieldset{border:0;margin:0;padding:0;min-width:0}
    .sg-dom .q{font:600 1.2rem/1.45 var(--titoli);padding:.9rem 0 .2rem;margin:0 0 1rem;overflow-x:auto;max-width:100%}
    .sg-dom .q p{margin:0 0 .5rem}
    .sg-scelte{display:flex;flex-direction:column;border-bottom:1px solid var(--riga);counter-reset:sc}
    .sg-scelta{counter-increment:sc;position:relative;display:flex;align-items:center;gap:1rem;min-height:3.1rem;padding:.35rem .75rem;border-top:1px solid var(--riga);font:1.02rem var(--testo);cursor:pointer;overflow-x:auto}
    .sg-scelta::before{content:counter(sc,upper-alpha);font:700 .95rem var(--titoli);color:var(--azione);width:1rem;flex:none}
    .sg-scelta input{position:absolute;opacity:0;pointer-events:none}
    .sg-scelta:hover{background:#fbf9f3}
    .sg-scelta:has(input:checked){background:#f4efe1;box-shadow:inset 3px 0 0 var(--azione)}
    .sg-scelta:has(input:focus-visible){outline:2px solid var(--azione);outline-offset:-2px}
    .sg-scelta p{margin:0}
    .sg-nav{display:flex;flex-wrap:wrap-reverse;align-items:center;justify-content:space-between;gap:.6rem 1rem}
    .sg-conf{display:flex;flex-wrap:wrap;gap:.5rem}
    .sg-conf>.sg-btn.sg-btn{height:2.75rem;padding:0 1.2rem;font-size:.95rem}
    .sg-blocco[hidden],.sg-parole[hidden]{display:none}
    .sg-parole{border-top:1px solid var(--riga)}
    .sg-righe .sg-parole-apri{width:100%;border-top:0}
    .sg-pi-ic{display:inline-flex;align-items:center;justify-content:center;width:1.6rem;height:1.6rem;border-radius:50%;border:1px solid var(--riga);background:#fff;font:italic 700 .9rem var(--titoli)!important;color:var(--inchiostro)!important}
    .sg-parole-apri .sg-fr{transition:transform .2s}
    .sg-parole-apri[aria-expanded="true"] .sg-fr{transform:rotate(180deg)}
    .sg-parole .sg-blocco{margin:0 0 .9rem 3.15rem}
    .sg-vis{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
    .sg-blocco{display:flex;flex-direction:column;gap:.6rem;padding:.9rem 1rem;background:rgba(255,255,255,.7);border:1px solid var(--riga);border-radius:12px}
    .sg-blocco label{font-size:.9rem;color:var(--inchiostro-2)}
    .sg-blocco-riga{display:flex;gap:.6rem;align-items:flex-end}
    .sg-blocco textarea{flex:1;min-width:0;resize:vertical;min-height:2.9rem;padding:.6rem .8rem;border:1px solid var(--riga);border-radius:10px;font:1rem/1.4 var(--ui);color:var(--inchiostro);background:#fff}
    .sg-blocco textarea:focus{outline:2px solid var(--azione);outline-offset:-1px;border-color:transparent}
    .sg-blocco.vuoto textarea{border-color:#c98a6c}
    .sg-blocco-nota{margin:0;font-size:.88rem;color:var(--inchiostro-2)}
    .sg-blocco.vuoto .sg-blocco-nota{color:#9b2c1c}
    .sg-blocco-nota:empty{display:none}
    .sg-blocco.pensa .sg-btn{opacity:.5;pointer-events:none}
    .sg-pi{display:flex;align-items:flex-start;gap:.6rem;margin:0;font-size:.92rem;line-height:1.45;color:var(--inchiostro-2)}
    .sg-pi[hidden]{display:none}
    .sg-pi span{padding-top:.12rem}
    [data-sg-test].sg-attesa .sg-dom{opacity:.35;transition:opacity .2s}
    [data-sg-test].sg-attesa .sg-pi span::after{content:'';display:inline-block;width:1.2em;text-align:left;animation:sg-punti 1.2s steps(4) infinite}
    @keyframes sg-punti{0%{content:''}25%{content:'.'}50%{content:'..'}75%{content:'...'}}
    .sg-entra{animation:sg-entra .32s ease-out}
    @keyframes sg-entra{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
    @media(prefers-reduced-motion:reduce){.sg-entra{animation:none}}
    .sg-nav .sg-link{color:var(--inchiostro-2);align-self:center}
    .sg-sintesi{margin:0;padding-left:1rem;border-left:3px solid var(--azione);font:1.12rem/1.5 var(--testo)}
    .sg-commento{display:flex;flex-direction:column;gap:.4rem}
    .sg-commento .sg-sintesi.scrive::after{content:'';display:inline-block;width:.45em;height:1em;margin-left:.15em;vertical-align:-.12em;background:var(--azione);opacity:.5;animation:sg-cursore 1s steps(2) infinite}
    @keyframes sg-cursore{50%{opacity:0}}
    .sg-firma{display:flex;align-items:center;gap:.45rem;margin:0 0 0 1.2rem;font-size:.78rem;color:var(--inchiostro-2)}
    .sg-firma[hidden]{display:none}
    .sg-firma i{font:italic 700 .85rem var(--titoli);width:1.25rem;height:1.25rem;border-radius:50%;display:grid;place-items:center;background:#e6efec;color:#1f5a4f}
    .sg-err{margin:0;font-size:.88rem;line-height:1.45;color:#7a3b1d}
    .sg-err b{font-weight:600}
    .sg-tappe{display:flex;flex-direction:column;margin:.3rem 0 0;padding:0;list-style:none}
    .sg-tappe li{display:grid;grid-template-columns:2.5rem minmax(0,1fr);gap:1rem}
    .sg-filo{display:flex;flex-direction:column;align-items:center}
    .sg-filo b{width:2.5rem;height:2.5rem;border-radius:10px;border:1.5px solid var(--azione);background:#fff;color:var(--azione);font:700 1.05rem var(--titoli);display:grid;place-items:center;box-sizing:border-box}
    .sg-tappe li:first-child .sg-filo b{background:var(--azione);color:#fff}
    .sg-filo::after{content:'';flex:1;width:2px;background:var(--riga)}
    .sg-tappe li:last-child .sg-filo::after{display:none}
    .sg-tappa{display:flex;flex-direction:column;gap:.5rem;padding:1rem 1.1rem;margin-bottom:.9rem;background:#fff;border:1px solid var(--riga);border-radius:14px}
    .sg-tappe li:last-child .sg-tappa{margin-bottom:0}
    .sg-tappe li:first-child .sg-tappa{background:#f4efe1;border-color:#e7dec8}
    .sg-qui{font-size:.75rem;font-weight:600;letter-spacing:.06em;color:#785735}
    .sg-tit{display:flex;align-items:baseline;justify-content:space-between;gap:.75rem}
    .sg-tit h2{margin:0;font:700 1.25rem/1.3 var(--titoli)}
    .sg-tit span{font-size:.82rem;font-weight:600;white-space:nowrap;color:#785735}
    .sg-tit span.cons{color:var(--azione)}
    .sg-perche{margin:0;font-size:.88rem;line-height:1.45;color:var(--inchiostro-2)}
    .sg-vai{display:flex;flex-wrap:wrap;gap:.5rem}
    .sg-vai a{flex:1 1 12.5rem;display:flex;flex-direction:column;gap:.1rem;padding:.6rem .9rem;border:1px solid var(--riga);border-radius:10px;background:#fff;text-decoration:none;color:var(--inchiostro);font-size:.88rem;line-height:1.3}
    .sg-vai a:hover{border-color:var(--azione)}
    .sg-vai small{font-size:.75rem;font-weight:600;color:var(--azione)}
    .sg-chip{display:flex;flex-wrap:wrap;gap:.5rem;margin:0}
    .sg-chip span{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .75rem .3rem .5rem;border-radius:999px;background:#e6efec;color:#1f5a4f;font-size:.88rem}
    .sg-chip.nv span{background:#efebe2;color:var(--inchiostro-2);padding-left:.75rem}
    .sg-chip svg{width:14px;height:14px;flex:none}
    .sg-etich{margin:0 0 -.7rem;font-size:.82rem;color:var(--inchiostro-2)}
    /* Fine del test per l'ospite, variante C (15/11/2026): riquadro sopra il percorso velato. */
    .sg-blindato{display:grid}
    .sg-blindato>*{grid-area:1/1}
    .sg-blindato .sg-sotto{filter:blur(3px);opacity:.5;pointer-events:none;user-select:none;display:flex;flex-direction:column;gap:.6rem}
    .sg-blindato .sg-sotto span{display:flex;align-items:center;gap:.9rem;padding:.85rem 1rem;border:1px solid var(--riga);border-radius:12px;background:#fff}
    .sg-blindato .sg-sotto span:first-child{background:#f4efe1;border-color:#e7dec8}
    .sg-blindato .sg-sotto i{width:1.9rem;height:1.9rem;border-radius:8px;border:1.5px solid var(--azione)}
    .sg-blindato .sg-sotto em{flex:1;height:.7rem;border-radius:4px;background:#ece7db}
    .sg-foglio{position:relative;z-index:1;display:grid;place-items:start center;padding:1.5rem 0}
    .sg-foglio>div{background:#fff;border:1px solid var(--riga);border-radius:16px;box-shadow:0 10px 34px rgba(35,48,46,.12);padding:1.5rem 1.6rem;max-width:25rem;width:100%;box-sizing:border-box;display:flex;flex-direction:column;gap:.9rem;font-size:1rem;line-height:1.5}
    .sg-foglio h2{margin:0;font:700 1.35rem/1.25 var(--titoli)}
    .sg-foglio p{margin:0}
    .sg-foglio .sg-lucchetto{width:2.4rem;height:2.4rem;border-radius:50%;display:grid;place-items:center;background:#e6efec;color:#1f5a4f}
    .sg-foglio .sg-lucchetto svg{width:18px;height:18px}
    .sg-foglio ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.4rem}
    .sg-foglio li{display:flex;gap:.5rem;align-items:flex-start;font-size:.95rem}
    .sg-foglio li svg{width:16px;height:16px;flex:none;margin-top:.2rem;color:var(--azione)}
    .sg-foglio .sg-btn{width:100%;box-sizing:border-box}
    .sg-foglio .sg-accedi{text-align:center;font-size:.88rem;color:var(--inchiostro-2)}
    .sg-foglio .sg-accedi a{color:var(--inchiostro)}
    .sg-dopo{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:.6rem 1rem;padding:.85rem 1.1rem;background:#fff;border:1px solid var(--riga);border-radius:14px;font-size:.94rem}
    @media(max-width:640px){
      .sg-parole .sg-blocco{margin-left:0}
      .sg-testa h1{font-size:1.7rem}
      .sg-dom .q{font-size:1.06rem}
      .sg-scelta{font-size:.98rem}
      .sg-conf{width:100%}
      .sg-conf .sg-btn{flex:1 1 auto;padding:0 .8rem}
      .sg-blocco-riga{flex-direction:column;align-items:stretch}
      .sg-tappe li{grid-template-columns:2rem minmax(0,1fr);gap:.6rem}
      .sg-filo b{width:2rem;height:2rem;font-size:.95rem;border-radius:8px}
      .sg-tit{flex-direction:column;gap:.1rem}
      .sg-dopo .sg-btn{flex:1 1 auto}
    }
  </style>
  <script>
    const radice = document.getElementById('studio-guidato')!;
    const materia = radice.dataset.materia!;
    const $ = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
    const intro = $('[data-sg-intro]'), test = $('[data-sg-test]'), ris = $('[data-sg-risultato]');
    const errore = $('[data-sg-errore]');
    let token = '';
    let occupato = false;
    let fraseIniziale = '';

    const esc = (t: string) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as any)[c]);
    async function chiama(percorso: string, corpo?: unknown) {
      const r = await fetch(percorso, corpo === undefined ? { credentials: 'same-origin', cache: 'no-store' }
        : { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify(corpo) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw Object.assign(new Error(d.errore || 'Errore di collegamento. Riprova.'), { codice: d.codice });
      return d;
    }

    function mostraDomanda(d: any) {
      intro.hidden = true; ris.hidden = true; test.hidden = false;
      $('[data-sg-numero]').textContent = d.massimo ? `${d.numero} di ${d.massimo} al massimo` : `Domanda ${d.numero}`;
      $('[data-sg-barra]').classList.toggle('senza', !d.massimo);
      if (d.massimo) $('[data-sg-barra] span').style.width = `${Math.round(100 * d.numero / d.massimo)}%`;
      $('[data-sg-argomento]').textContent = d.argomento;
      const pi = (fraseIniziale || d.motivo || '').trim();
      fraseIniziale = '';
      $('[data-sg-pi-testo]').textContent = pi;
      $('[data-sg-pi]').hidden = !pi;
      test.classList.remove('sg-attesa');
      const f = $('[data-sg-form]');
      f.classList.remove('sg-entra'); void f.offsetWidth; f.classList.add('sg-entra');
      const etichetta = d.base ? `Basi · ${d.materiaBase || 'Precorso'}` : d.fase === 'base' ? 'Base di un altro capitolo' : d.fase === 'cerca' ? 'Ricerca del capitolo' : d.fase === 'ricontrollo' ? 'Ricontrollo' : '';
      $('[data-sg-provenienza]').textContent = etichetta;
      $('[data-sg-provenienza]').hidden = !etichetta;
      $('[data-sg-testo]').innerHTML = d.testo;
      $('[data-sg-scelte]').innerHTML = d.scelte.map((s: string, i: number) =>
        `<label class="sg-scelta"><input type="radio" name="scelta" value="${i}" /><span>${s}</span></label>`).join('');
      radice.querySelectorAll<HTMLButtonElement>('[data-sg-sicuro]').forEach((b) => { b.disabled = true; });
      $('[data-sg-testo]').focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    $('[data-sg-scelte]').addEventListener('change', () => { radice.querySelectorAll<HTMLButtonElement>('[data-sg-sicuro]').forEach((b) => { b.disabled = false; }); });

    async function avanza(percorso: string, corpo: unknown) {
      if (occupato) return;
      occupato = true;
      errore.textContent = '';
      if (!test.hidden) {
        test.classList.add('sg-attesa');
        $('[data-sg-pi-testo]').textContent = 'Pi sceglie la prossima domanda';
        $('[data-sg-pi]').hidden = false;
      }
      try {
        const d = await chiama(percorso, corpo);
        if (d.fine && d.ospite) mostraChiuso(d);
        else if (d.fine) mostraEsito(d.esito, d.progresso);
        else { token = d.token; mostraDomanda(d.domanda); }
      } catch (e: any) {
        if (test.hidden) errore.textContent = e.message;
        else alertInline(e.message);
      } finally { occupato = false; test.classList.remove('sg-attesa'); }
    }
    function alertInline(msg: string) {
      let p = test.querySelector<HTMLElement>('.sg-errore');
      if (!p) { p = document.createElement('p'); p.className = 'sg-errore'; p.setAttribute('role', 'alert'); test.append(p); }
      p.textContent = msg;
    }

    // «Cosa ti blocca?»: Pi sceglie capitolo e abilità da verificare per prime (POST /api/studio-guidato/capisci).
    const blocco = $<HTMLFormElement>('[data-sg-blocco]');
    const notaBlocco = $('[data-sg-blocco-nota]');
    blocco.addEventListener('submit', async (e) => {
      e.preventDefault();
      const testo = (blocco.querySelector('textarea') as HTMLTextAreaElement).value.trim();
      if (blocco.classList.contains('pensa')) return;
      if (testo.length < 4) { blocco.classList.add('vuoto'); notaBlocco.textContent = 'Scrivi almeno qualche parola prima di premere Inizia.'; (blocco.querySelector('textarea') as HTMLTextAreaElement).focus(); return; }
      blocco.classList.add('pensa');
      notaBlocco.textContent = 'Pi sta leggendo la frase…';
      try {
        const d = await chiama('/api/studio-guidato/capisci', { materia, testo });
        if (!d.argomento) { notaBlocco.textContent = d.frase || 'Scegli il capitolo dall’elenco.'; return; }
        notaBlocco.textContent = '';
        fraseIniziale = d.frase || '';
        await avanza('/api/studio-guidato/inizia', { materia, argomento: d.argomento, priorita: d.priorita || [] });
      } catch (x: any) { notaBlocco.textContent = x.message; }
      finally { blocco.classList.remove('pensa'); }
    });
    const apri = $<HTMLButtonElement>('[data-sg-parole-apri]');
    apri.addEventListener('click', () => {
      const aperto = blocco.hidden;
      blocco.hidden = !aperto;
      apri.setAttribute('aria-expanded', String(aperto));
      if (aperto) (blocco.querySelector('textarea') as HTMLTextAreaElement).focus();
    });
    blocco.querySelector('textarea')!.addEventListener('input', () => {
      if (blocco.classList.contains('vuoto')) { blocco.classList.remove('vuoto'); notaBlocco.textContent = ''; }
    });
    blocco.querySelector('textarea')!.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); blocco.requestSubmit(); }
    });

    const righe = [...radice.querySelectorAll<HTMLButtonElement>('[data-sg-arg]')];
    righe.forEach((b) => b.addEventListener('click', () => {
      const argomento = b.dataset.sgArg;
      avanza('/api/studio-guidato/inizia', argomento ? { materia, argomento } : { materia });
    }));
    $('[data-sg-form]').addEventListener('submit', (e) => {
      e.preventDefault();
      const s = radice.querySelector<HTMLInputElement>('input[name="scelta"]:checked');
      const b = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      if (s) avanza('/api/studio-guidato/rispondi', { token, scelta: Number(s.value), sicuro: b?.dataset.sgSicuro === '1' });
    });
    $('[data-sg-nonso]').addEventListener('click', () => avanza('/api/studio-guidato/rispondi', { token, scelta: null }));

    const minuscola = (x: string) => esc(x[0].toLowerCase() + x.slice(1));
    // HTML già protetto (formule rese dal sito): minuscola solo se comincia con una lettera.
    const iniziale = (h: string) => /^[A-ZÀ-Ý]/.test(h) ? h[0].toLowerCase() + h.slice(1) : h;
    function mostraEsito(e: any, prog: any) {
      test.hidden = true; intro.hidden = true; ris.hidden = false;
      const lacune = e.lacune || [];
      const percorso = lacune.map((l: any, k: number) => {
        const dove = l.m !== materia ? `${esc(l.materia)} · ${esc(l.capitolo)}` : esc(l.capitolo);
        const perche = [
          `${dove}.`,
          l.stato === 'lacuna' ? `${l.sbagliate === 1 ? 'Una risposta sbagliata' : `${l.sbagliate} risposte sbagliate`} su ${l.chieste}.` : l.indovinate ? 'Risposta giusta, data tirando a indovinare.' : 'Sbagliata la domanda di livello medio.',
          l.convinzione ? 'La risposta sbagliata era data con sicurezza.' : '',
          l.per?.length ? `È la base di ${l.per.map((x: string) => `«${minuscola(x)}»`).join(', ')}.` : '',
        ].filter(Boolean).join(' ');
        const vai = [
          ...l.teoria.map((t: any) => `<a href="${t.href}"><small>Teoria</small>${esc(t.titolo)}</a>`),
          ...l.schede.map((x: any) => `<a href="${x.href}"><small>Scheda svolta</small>${esc(x.titolo)}</a>`),
        ].join('') || `<a href="${l.domande}"><small>Allenamento</small>Domande a tempo del capitolo</a>`;
        return `<li><div class="sg-filo"><b>${k + 1}</b></div><div class="sg-tappa">
          ${k === 0 ? '<span class="sg-qui">PARTI DA QUI</span>' : ''}
          <div class="sg-tit"><h2>${esc(l.nome)}</h2><span${l.stato === 'lacuna' ? '' : ' class="cons"'}>${l.stato === 'lacuna' ? 'Da riprendere' : 'Da consolidare'}</span></div>
          <p class="sg-perche">${perche}</p>
          ${(l.errori || []).map((x: any) => `<p class="sg-err"><b>Errore${x.volte > 1 ? ` ripetuto ${x.volte} volte` : ''}:</b> ${iniziale(x.nomeHtml || esc(x.nome))}. ${x.fattoHtml || esc(x.fatto)}</p>`).join('')}
          <div class="sg-vai">${vai}</div></div></li>`;
      }).join('');
      const spunta = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
      const nomi = (stato: string, segno = '') => (e.abilita || []).filter((a: any) => a.stato === stato).map((a: any) => `<span>${segno}${esc(a.nome)}</span>`).join('');
      const sai = nomi('ok', spunta), nonVerificate = nomi('nv');
      const capitolo = e.modo === 'ricontrollo' ? 'Ricontrollo' : e.titoloCapitolo ? esc(e.titoloCapitolo) : 'Tutti i capitoli';
      ris.innerHTML = `<header class="sg-testa"><h1>Da dove ripartire</h1><p>${capitolo} · ${e.domande} domande</p></header>
        <div class="sg-commento"><p class="sg-sintesi" data-sg-commento>${esc(e.racconto || e.sintesi)}</p>
          <p class="sg-firma" data-sg-firma${e.racconto ? '' : ' hidden'}><i>π</i>Commento di Pi, l’assistente IA del sito</p></div>
        ${lacune.length ? `<ol class="sg-tappe">${percorso}</ol>` : ''}
        ${sai ? `<p class="sg-etich">Senza errori</p><p class="sg-chip">${sai}</p>` : ''}
        ${nonVerificate ? `<p class="sg-etich">Non verificate in questo test</p><p class="sg-chip nv">${nonVerificate}</p>` : ''}
        ${lacune.length ? '<div class="sg-dopo"><span>Dopo lo studio: una domanda nuova per ogni punto.</span><button type="button" class="sg-btn" data-sg-ricontrolla>Ricontrolla le lacune</button></div>'
          : `<div class="sg-dopo"><span>Nessun punto da riprendere in questo test.</span><a class="sg-btn" href="/${materia}/simulazione">Simulazione d’esame</a></div>`}
        <button type="button" class="sg-link" data-sg-rifai>Scegli un altro capitolo</button>`;
      ris.querySelector('[data-sg-rifai]')!.addEventListener('click', () => { ris.hidden = true; intro.hidden = false; window.scrollTo({ top: 0 }); });
      ris.querySelector('[data-sg-ricontrolla]')?.addEventListener('click', () => avanza('/api/studio-guidato/inizia', { materia, ricontrollo: true }));
      ris.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (!e.racconto && e.domande) racconta();
    }

    // Ospite: il test è finito, la diagnosi si apre con un account gratuito. Lo stato firmato resta nel browser
    // (48 ore) e dopo l'iscrizione diventa un esito dell'account (/api/studio-guidato/rivendica).
    const CHIAVE_OSPITE = `sg-ospite-${materia}`;
    function mostraChiuso(d: any) {
      try { localStorage.setItem(CHIAVE_OSPITE, d.chiave); } catch {}
      test.hidden = true; intro.hidden = true; ris.hidden = false;
      const a = d.anteprima || {};
      const dopo = encodeURIComponent(`${location.pathname}?esito`);
      const lucchetto = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
      const spunta = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
      const frase = a.punti
        ? `Sono emersi ${a.punti === 1 ? 'un punto' : `${a.punti} punti`} da riprendere${a.capitolo ? ` in ${esc(a.capitolo)}` : ''}. Con un account gratuito vedi:`
        : 'Non sono emersi punti da riprendere. Con un account gratuito vedi:';
      const voci = a.punti
        ? ['quali sono e in che ordine affrontarli', 'l’errore commesso in ogni risposta sbagliata', 'il paragrafo e la scheda da cui ripartire']
        : ['le abilità verificate senza errori', 'il passo successivo per prepararti all’esame', 'il risultato salvato per i prossimi test'];
      ris.innerHTML = `<header class="sg-testa"><h1>Il test è finito</h1><p>${a.domande || 0} domande</p></header>
        <div class="sg-blindato"><div class="sg-sotto" aria-hidden="true">${'<span><i></i><em></em></span>'.repeat(Math.max(3, Math.min(a.punti || 0, 4)))}</div>
          <div class="sg-foglio"><div role="dialog" aria-labelledby="sg-foglio-titolo"><span class="sg-lucchetto">${lucchetto}</span>
            <h2 id="sg-foglio-titolo">Il risultato è pronto</h2><p>${frase}</p>
            <ul>${voci.map((v) => `<li>${spunta}${v}</li>`).join('')}</ul>
            <a class="sg-btn" href="/accedi?nuovo=1&dopo=${dopo}">Crea un account gratuito</a>
            <p class="sg-accedi">Hai già un account? <a href="/accedi?dopo=${dopo}">Accedi</a></p></div></div></div>`;
      ris.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Commento di Pi sull'esito (Claude dal Worker, testo a pezzi). Se non arriva resta la frase di sintesi.
    async function racconta() {
      const p = ris.querySelector<HTMLElement>('[data-sg-commento]');
      const firma = ris.querySelector<HTMLElement>('[data-sg-firma]');
      if (!p || !firma) return;
      const sintesi = p.textContent || '';
      try {
        const r = await fetch('/api/studio-guidato/racconto', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ materia }) });
        if (!r.ok || r.status === 204 || !r.body) return;
        const lettore = r.body.getReader();
        const dec = new TextDecoder();
        let testo = '';
        for (;;) {
          const { value, done } = await lettore.read();
          if (done) break;
          testo += dec.decode(value, { stream: true });
          if (testo.trim()) {
            if (!p.classList.contains('scrive')) { p.classList.add('scrive'); firma.hidden = false; }
            p.textContent = testo;
          }
        }
        if (!testo.trim()) { p.textContent = sintesi; firma.hidden = true; }
      } catch { p.textContent = sintesi; firma.hidden = true; }
      finally { p.classList.remove('scrive'); }
    }

    // All'apertura: se c'è un test precedente si mostra il risultato (?esito) oppure la riga di ripresa.
    chiama(`/api/studio-guidato?materia=${encodeURIComponent(materia)}`).then(async (d) => {
      if (d.ospite) {
        // L'ospite sceglie il capitolo e fa il test; «Scrivilo in una frase» (Pi) è per gli iscritti.
        radice.querySelector<HTMLElement>('[data-sg-parole]')!.hidden = true;
        $('.sg-nota').textContent = 'Il test parte appena scegli. Al massimo 12 domande, senza limite di tempo. Il risultato completo si vede con un account gratuito.';
        return;
      }
      let chiave = '';
      try { chiave = localStorage.getItem(CHIAVE_OSPITE) || ''; } catch {}
      if (chiave) {
        try { localStorage.removeItem(CHIAVE_OSPITE); } catch {}
        try { const r = await chiama('/api/studio-guidato/rivendica', { chiave }); mostraEsito(r.esito, r.progresso); return; } catch {}
      }
      if (!d.ultimo) return;
      if (new URLSearchParams(location.search).has('esito')) { mostraEsito(d.ultimo, d.progresso); return; }
      const r = $('[data-sg-ripresa]');
      const n = d.ultimo.lacune.length;
      const quando = new Date(d.ultimo.quando).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
      r.innerHTML = `<a href="?esito"><span>Ultimo test: ${quando}${d.ultimo.titoloCapitolo ? `, ${esc(d.ultimo.titoloCapitolo)}` : ''} · ${n ? `${n === 1 ? 'un punto' : `${n} punti`} da riprendere` : 'nessun punto da riprendere'}</span><b>Rivedi il risultato</b></a>`;
      r.hidden = false;
    }).catch((e) => {
      righe.forEach((b) => { b.disabled = true; });
      radice.querySelector<HTMLElement>('[data-sg-parole]')!.hidden = true;
      if (e.codice === 'iscrizione') radice.querySelectorAll<HTMLElement>('.sg-righe, .sg-nota').forEach((x) => { x.hidden = true; });
      if (e.codice === 'iscrizione') {
        const dopo = encodeURIComponent(location.pathname);
        $<HTMLAnchorElement>('[data-sg-nuovo]').href = `/accedi?nuovo=1&dopo=${dopo}`;
        $<HTMLAnchorElement>('[data-sg-accedi]').href = `/accedi?dopo=${dopo}`;
        $('[data-sg-iscriviti]').hidden = false;
      } else errore.textContent = e.message;
    });
  </script>
</Base>
