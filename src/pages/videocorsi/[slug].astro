---
// Pagina di un videocorso, con l'acquisto tramite Paddle (solo in italiano).
import Base from '../../layouts/Base.astro';
import { MATERIE } from '../../data/materie';
import { VIDEOCORSI, MINUTI_LEZIONE, chiaveVideo, oreTotali, prezzoSeparato, valoreMateriale, type Videocorso } from '../../data/videocorsi';
import { SITO } from '../../lib/seo';

export function getStaticPaths() {
  return VIDEOCORSI.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}
interface Props { v: Videocorso }
const { v } = Astro.props;
const sblocca = v.sblocca.map((s) => MATERIE.find((m) => m.slug === s)!).filter(Boolean);
const separato = prezzoSeparato(v);
const materiale = valoreMateriale(v);
const una = sblocca.length === 1;
const MASCHILI = ['precorso']; // nomi di materia maschili: «Precorso da solo»
const chiave = chiaveVideo(v.slug);
const altri = VIDEOCORSI.filter((x) => x.slug !== v.slug);
const schema = [{
  '@type': 'Course', name: v.titolo, description: v.sommario, url: `${SITO}/videocorsi/${v.slug}`, inLanguage: 'it',
  provider: { '@type': 'Person', name: 'Carmine Tornincasa' },
  offers: { '@type': 'Offer', price: v.prezzo, priceCurrency: 'EUR', availability: 'https://schema.org/InStock', category: 'Paid' },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'online', courseWorkload: `PT${oreTotali(v)}H` },
}];
const titolo = v.titolo;
---
<Base titolo={v.titolo} percorso={[{ titolo: 'Videocorsi', href: '/videocorsi' }, { titolo: v.breve }]} descrizione={`${v.titolo}: ${v.lezioni} lezioni con video e PDF. L'acquisto sblocca in automatico sul sito ${sblocca.map((m) => m.breve).join(', ')}.`} lingua="it" seo={{ soloQuestaLingua: true, schema }}>
  <div class="testa-video" style={`--accento: ${v.colore}`}>
    <p class="sopratitolo">Videocorso</p>
    <h1>{v.titolo}</h1>
    <p class="sommario">{v.sommario}</p>
    <ul class="fatti-video">
      <li><strong>{v.lezioni}</strong> lezioni</li>
      <li><strong>{MINUTI_LEZIONE} min</strong> circa ciascuna</li>
      <li><strong>{oreTotali(v)} ore</strong> circa in tutto</li>
      <li><strong>PDF</strong> di ogni lezione</li>
    </ul>
  </div>

  <div class="sblocco-video" style={`--accento: ${v.colore}`}>
    <h2>{una ? 'Compresa nel videocorso' : 'Comprese nel videocorso'}</h2>
    <p>{una
      ? <>Comprando il videocorso trovi <strong>{sblocca[0].titolo}</strong> già attiva nel tuo account, con teoria, esercizi svolti ed esercizi con la soluzione. Da sola costa {materiale} €; con il videocorso non la paghi.</>
      : <>Comprando il videocorso trovi già attive nel tuo account queste {sblocca.length} materie, con teoria, esercizi svolti ed esercizi con la soluzione. Da sole costano {materiale} € in tutto; con il videocorso non le paghi.</>}</p>
    {!una && (
      <ul>
        {sblocca.map((m) => (
          <li style={`--c: ${m.colore}`}>
            <a href={`/${m.slug}`}><span class="punto-materia"></span><strong>{m.titolo}</strong></a>
            <span>{m.argomenti.length} argomenti · {MASCHILI.includes(m.slug) ? 'da solo' : 'da sola'} {m.prezzo} €</span>
          </li>
        ))}
      </ul>
    )}
    {una && <p class="vedi-materia"><a href={`/${sblocca[0].slug}`}>Guarda gratis l'anteprima di {sblocca[0].titolo} ({sblocca[0].argomenti.length} argomenti)</a></p>}
  </div>

  <div class="riquadro-acquisto" style={`--accento: ${v.colore}`}>
    <p class="prezzo"><strong>{v.prezzo} €</strong> <span>una volta sola</span></p>
    {separato > v.prezzo && <p class="risparmio-video">Risparmi {separato - v.prezzo} € rispetto ai corsi comprati separatamente ({separato} €)</p>}
    {materiale > 0 && <p class="risparmio-video">Incluso il materiale didattico del sito: risparmi {materiale} €</p>}
    <div id="azione"><p class="esito-modulo">Un momento…</p></div>
    <p class="nota-termini">Con l'acquisto accetti i <a href="/termini">termini d'uso</a>: l'accesso ai video e alle materie è personale e il materiale non può essere condiviso né diffuso.</p>
  </div>

  <h2>Che cosa contiene</h2>
  <ul class="cosa-include">
    <li><strong>{v.lezioni} lezioni chiare e progressive</strong>, spiegate in modo semplice ma rigoroso, della durata di circa {MINUTI_LEZIONE} minuti.</li>
    <li><strong>Il PDF di ogni lezione</strong>, insieme al video.</li>
    <li><strong>Esercizi svolti e spiegati</strong>, con un metodo per affrontare lo scritto e l'orale.</li>
    <li><strong>Pensato per studenti universitari</strong> di ingegneria, economia, fisica, matematica e corsi affini, anche per chi parte da zero o ha avuto difficoltà con il corso.</li>
  </ul>

  <h2>Come ricevi i video</h2>
  <ol class="passi-video">
    <li>Dopo il pagamento, nel tuo account trovi il link alla cartella del videocorso su Google Drive.</li>
    <li>Apri la cartella e chiedi l'accesso con la stessa email dell'account: Carmine lo conferma appena possibile.</li>
    <li>Le materie collegate del sito sono già sbloccate dal momento del pagamento.</li>
  </ol>

  <div class="prova-video">
    <p><strong>Hai dubbi?</strong> Puoi chiedere la prima lezione come prova gratuita, oppure verificare che il corso copra il programma del tuo esame.</p>
    <a class="bottone-secondario" href={`https://wa.me/393885680393?text=${encodeURIComponent(`Ciao Carmine, vorrei informazioni sul ${v.titolo}`)}`} target="_blank" rel="noopener">Scrivi a Carmine su WhatsApp</a>
  </div>

  <h2>Gli altri videocorsi</h2>
  <ul class="altri-video">
    {altri.map((x) => <li><a href={`/videocorsi/${x.slug}`} style={`--accento: ${x.colore}`}><span>{x.titolo}</span><span>{x.lezioni} lezioni · {x.prezzo} €</span></a></li>)}
  </ul>

  <script is:inline define:vars={{ slug: v.slug, chiave, titolo }}>
    (async () => {
      const azione = document.getElementById('azione');
      const qui = location.pathname;
      const [rIo, rConf] = await Promise.all([fetch('/api/io').catch(() => null), fetch('/api/config').catch(() => null)]);
      const io = rIo && rIo.ok ? await rIo.json() : null;
      const conf = rConf && rConf.ok ? (await rConf.json()).paddle : null;
      const prezzo = conf && conf.videocorsi ? conf.videocorsi[slug] : null;

      if (!io) {
        azione.innerHTML = `<a class="bottone-primario" href="/accedi?nuovo=1&dopo=${encodeURIComponent(qui)}">Crea un account e acquista</a>
          <p class="nota-accesso">Hai già un account? <a href="/accedi?dopo=${encodeURIComponent(qui)}">Accedi</a></p>`;
        return;
      }
      if (io.materie.includes(chiave)) {
        azione.innerHTML = `<p class="stato-ok">Hai già questo videocorso.</p><a class="bottone-primario" href="/account">Vai al tuo account</a>`;
        return;
      }
      if (!prezzo) {
        azione.innerHTML = `<p>Per acquistare scrivi a Carmine su <a href="https://wa.me/393885680393" target="_blank" rel="noopener">WhatsApp</a>: attiva il videocorso sul tuo account <strong>${io.email}</strong>.</p>`;
        return;
      }
      azione.innerHTML = `<button type="button" class="bottone-primario" id="compra">Acquista il videocorso</button>
        <p class="nota-accesso">Acquisto collegato al tuo account ${io.email}.</p>`;
      const s = document.createElement('script');
      s.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
      s.onload = () => {
        if (conf.ambiente === 'sandbox') Paddle.Environment.set('sandbox');
        Paddle.Initialize({
          token: conf.token,
          eventCallback: (ev) => {
            if (ev.name !== 'checkout.completed') return;
            azione.innerHTML = '<p>Pagamento ricevuto. Sto attivando il videocorso nel tuo account…</p>';
            let tentativi = 0;
            const controlla = async () => {
              const r = await fetch('/api/io').catch(() => null);
              const d = r && r.ok ? await r.json() : null;
              if (d && d.materie.includes(chiave)) { location.href = '/account#videocorsi'; return; }
              if (++tentativi < 30) setTimeout(controlla, 2000);
              else azione.innerHTML = '<p>Pagamento ricevuto. L’attivazione richiede ancora qualche istante: ricarica la pagina tra poco, oppure scrivi a Carmine dalla pagina Contatti.</p>';
            };
            controlla();
          },
        });
        document.getElementById('compra').addEventListener('click', () => {
          Paddle.Checkout.open({
            items: [{ priceId: prezzo, quantity: 1 }],
            customer: { email: io.email },
            customData: { videocorso: slug, email: io.email },
            settings: { locale: 'it' },
          });
        });
      };
      s.onerror = () => { azione.innerHTML = '<p>Il modulo di pagamento non si è caricato. Ricarica la pagina o scrivi a Carmine dalla pagina Contatti.</p>'; };
      document.head.appendChild(s);
    })();
  </script>
</Base>

<style>
  .testa-video h1 { color: var(--accento); }
  .fatti-video { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; font-family: var(--ui); }
  .fatti-video li { padding: 0.35rem 0.75rem; border-radius: 99px; background: color-mix(in srgb, var(--accento) 9%, white); border: 1px solid color-mix(in srgb, var(--accento) 22%, white); font-size: 0.9rem; }
  .fatti-video strong { color: var(--accento); }
  .sblocco-video { margin: 1.6rem 0; padding: 1rem 1.15rem; border-radius: 10px; background: color-mix(in srgb, #2e7d4f 8%, white); border: 1px solid color-mix(in srgb, #2e7d4f 28%, white); }
  .sblocco-video h2 { margin: 0 0 0.3rem; font-size: 1.2rem; color: #2e7d4f; }
  .sblocco-video p { margin: 0 0 0.6rem; font-family: var(--ui); font-size: 0.95rem; }
  .sblocco-video ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; font-family: var(--ui); }
  .sblocco-video li { display: flex; flex-direction: column; }
  .sblocco-video li a { display: inline-flex; align-items: center; gap: 0.45rem; color: var(--c); text-decoration: none; }
  .sblocco-video .vedi-materia { margin: 0; }
  .sblocco-video .vedi-materia a { color: #2e7d4f; }
  .sblocco-video li span { font-size: 0.85rem; color: var(--inchiostro-2); padding-left: 1.2rem; }
  .punto-materia { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--c); padding: 0 !important; }
  .risparmio-video { margin: -0.4rem 0 0.9rem; font-weight: 600; color: #2e7d4f; font-size: 0.95rem; }
  .passi-video { font-family: var(--ui); padding-left: 1.3rem; }
  .passi-video li { margin: 0.45rem 0; }
  .prova-video { margin: 1.5rem 0; padding: 1rem 1.1rem; border: 1px dashed var(--riga); border-radius: 10px; font-family: var(--ui); }
  .prova-video p { margin: 0 0 0.7rem; }
  .altri-video { list-style: none; padding: 0; display: grid; gap: 0.5rem; font-family: var(--ui); }
  .altri-video a { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0.85rem; border: 1px solid var(--riga); border-left: 4px solid var(--accento); border-radius: var(--raggio); text-decoration: none; color: var(--inchiostro); background: white; }
  .altri-video a span:first-child { font-weight: 600; color: var(--accento); }
  .altri-video a span:last-child { color: var(--inchiostro-2); font-size: 0.9rem; white-space: nowrap; }
</style>
