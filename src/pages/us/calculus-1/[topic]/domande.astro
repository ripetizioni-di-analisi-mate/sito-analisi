---
import Domande from '../../../../viste/Domande.astro';
import { calculusSlug, calculusTimedCount } from '../../../../lib/stem-usa-practice';
import { calculusTimed } from '../../../../data/stem-usa/calculus-1-timed.mjs';
import { RIPASSO, RIPASSO_OGGI } from '../../../../data/livelli';

export function getStaticPaths() {
  return [
    ...Object.entries(calculusTimed).map(([topic, questions]) => ({ params: { topic }, props: { total: questions.length } })),
    { params: { topic: RIPASSO }, props: { total: calculusTimedCount } },
    { params: { topic: RIPASSO_OGGI }, props: { total: 0 } },
  ];
}
---
<Domande lingua="en" materia={calculusSlug} argomento={Astro.params.topic!} totale={Astro.props.total} usa />
