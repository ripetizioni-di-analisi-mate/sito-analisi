---
import UsStem from '../../layouts/UsStem.astro';
import UsPractice from '../../components/UsPractice.astro';
import UsCourseOutline from '../../components/UsCourseOutline.astro';
import CalculusPractice from '../../components/CalculusPractice.astro';
import { linkArgomentoUsa } from '../../data/stem-usa/catalog-view';
import { calculusPractice, calculusSlug } from '../../data/stem-usa/calculus-1-practice.mjs';
import { calculusTimed } from '../../data/stem-usa/calculus-1-timed.mjs';
import { calculusHtml, calculusTimedCount } from '../../lib/stem-usa-practice';
import { calculusTheory } from '../../data/stem-usa/calculus-1-theory.mjs';
import { PUNTI, RIPASSO, RIPASSO_OGGI } from '../../data/livelli';
import { T, sezioniL } from '../../i18n';
import { universityCourses, courseUrl, optionsFor } from '../../data/stem-usa/catalog.mjs';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return universityCourses.map(course => ({ params: { course: course.slug }, props: { course } }));
}

const { course } = Astro.props;
const questions = course.lessons.map((lesson, index) => ({
  title: lesson.title,
  prompt: lesson.prompt,
  choices: optionsFor(lesson, index),
  correct: index % (lesson.distractors.length + 1),
  explanation: lesson.explanation,
  href: '#unit-' + (index + 1),
}));
const title = course.title;
const t = T('en');
const sezioni = sezioniL('en');
const isCalculus = course.slug === calculusSlug;
---
<UsStem title={title} description={course.description} course={course.slug}>
  <p class="sopratitolo">{t.programma}</p>
  <h1>{title}</h1>
  <p class="sommario">{course.description}</p>
  <UsCourseOutline slug={course.slug} topics={course.lessons} />
  <section data-usa-content>
  {isCalculus && <p class="nota">While signed in, you earn {PUNTI.esercizio} XP the first time you check a correct answer to each practice exercise.</p>}
  <ol class="griglia-argomenti">
    {course.lessons.map((lesson, index) => {
      const number = index + 1;
      const slug = ('unit-' + number) as keyof typeof calculusPractice;
      const practice = isCalculus ? calculusPractice[slug] : undefined;
      const theory = isCalculus ? calculusTheory[slug] : undefined;
      const href = (sezione: string) => linkArgomentoUsa(course.slug, slug, sezione);
      return (
        <li>
          <h2><a href={href('teoria')}>{lesson.title}</a></h2>
          <p class="riassunto">{lesson.theory.split(/(?<=[.!?])\s/)[0]}</p>
          <nav aria-label={lesson.title}>
            {sezioni.map(sezione => {
              const count = sezione.slug === 'esercizi-svolti' ? (practice?.worked.length ?? 0) + 1
                : sezione.slug === 'esercizi' ? practice?.exercises.length ?? 1 : null;
              return <a href={href(sezione.slug)}>{sezione.titolo}{count !== null && ' (' + count + ')'}</a>;
            })}
            {practice && <a href={href('domande')}>Timed questions ({calculusTimed[slug].length})</a>}
          </nav>
          <details class="sommario-pagina studio-unita-usa" id={slug} hidden>
            <summary>{t.sezioni.teoria}</summary>
            <div>
              {theory ? theory.map(([heading, explanation, proof]) => (
                <section class="calculus-theory">
                  <h3>{heading}</h3>
                  <p set:html={calculusHtml(explanation)} />
                  {proof && <details class="stem-feedback">
                    <summary>Proof</summary>
                    <p set:html={calculusHtml(proof)} />
                  </details>}
                </section>
              )) : <p>{lesson.theory}</p>}
              {!practice && <>
                <h3 id={'worked-' + number}>Worked example</h3>
                <p>{lesson.worked}</p>
              </>}
            </div>
          </details>
          {practice && <CalculusPractice topic={slug} number={number} originalExample={lesson.worked} />}
        </li>
      );
    })}
    <li>
      <h2><a href="#course-practice">Exam practice</a></h2>
      <p class="riassunto">Review questions on the topics of {title} with worked solutions.</p>
      <nav aria-label="Exam practice">
        <a href="#course-practice">Review questions ({questions.length})</a>
        {isCalculus && <>
          <a href={linkArgomentoUsa(course.slug, RIPASSO, 'domande')}>Timed review ({calculusTimedCount})</a>
          <a class="solo-collegati" href={linkArgomentoUsa(course.slug, RIPASSO_OGGI, 'domande')}>Today’s review</a>
          <a href={url(courseUrl(course.slug) + '/practice-exam')}>General practice exam</a>
          <a href={url(courseUrl(course.slug) + '/purdue')}>Purdue exam practice</a>
        </>}
      </nav>
    </li>
  </ol>
  <UsPractice questions={questions} minutes={questions.length * 2} />
  </section>
  <section class="risorse-usa">
    <h2>University syllabi</h2>
    <p><strong>Preparation</strong> {course.preparation}</p>
    <ul>{course.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener">{source.title}</a></li>)}</ul>
  </section>
</UsStem>
<script>
  import '../../scripts/apri-unita-usa';
</script>

<style>
  .calculus-theory + .calculus-theory { margin-block-start: 1.1rem; }
  .calculus-theory h3 { margin-block: 0 .35rem; }
  .calculus-theory p { overflow-wrap: break-word; }
</style>
