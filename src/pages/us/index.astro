---
import UsStem from '../../layouts/UsStem.astro';
import { groups, courses, courseUrl } from '../../data/stem-usa/catalog.mjs';
import { url } from '../../lib/url';

const description = 'Study the topics taught in U.S. college STEM courses, with worked examples and practice questions.';
---
<UsStem title="U.S. College STEM Courses" description={description}>
  <header class="stem-hero">
    <h1>U.S. College STEM</h1>
    <p>{description}</p>
    <p>Each course links to the university syllabi used to choose its study units.</p>
  </header>
  <div class="stem-catalog-tools">
    <nav class="stem-jumps" aria-label="Subjects">
      {groups.map(group => <a href={'#' + group.id}>{group.name}</a>)}
    </nav>
    <label for="stem-search" class="stem-search" hidden data-stem-search-label>
      <span>Find a course</span>
      <input type="search" id="stem-search" placeholder="e.g. Calculus II or circuits" autocomplete="off" />
    </label>
    <p class="stem-result-count" data-course-count aria-live="polite" hidden>{courses.length} courses</p>
  </div>
  {groups.map(group => (
    <section id={group.id} class="stem-group" data-stem-group>
      <h2>{group.name}</h2>
      <ul class="stem-grid">
        {group.courses.map(course => (
          <li data-stem-card data-topics={course.lessons.map(lesson => lesson.title).join(' ')}>
            <a class="stem-card" href={url(courseUrl(course.slug))}>
              <h3>{course.title}</h3>
              <p>{course.description}</p>
              <span>{course.lessons.length} study units <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p data-stem-empty hidden>No courses match your search.</p>
</UsStem>
<script>
  const search = document.querySelector<HTMLInputElement>('#stem-search');
  if (search) {
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-stem-group]'));
    const label = document.querySelector<HTMLElement>('[data-stem-search-label]');
    const count = document.querySelector<HTMLElement>('[data-course-count]');
    const empty = document.querySelector<HTMLElement>('[data-stem-empty]');
    if (label && count && empty) {
      label.hidden = false;
      count.hidden = false;
      search.addEventListener('input', () => {
        const terms = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        let total = 0;
        for (const section of sections) {
          let matches = 0;
          for (const card of section.querySelectorAll<HTMLElement>('[data-stem-card]')) {
            const text = (card.textContent + ' ' + card.dataset.topics).toLowerCase();
            card.hidden = !terms.every(term => text.includes(term));
            if (!card.hidden) matches += 1;
          }
          section.hidden = matches === 0;
          total += matches;
        }
        count.textContent = total + (total === 1 ? ' course' : ' courses');
        empty.hidden = total !== 0;
      });
    }
  }
</script>
