---
import UsStem from '../../../layouts/UsStem.astro';
import UsPractice from '../../../components/UsPractice.astro';
import { calculus2Exam } from '../../../data/stem-usa/calculus-2/exam.mjs';
import { url } from '../../../lib/url';
---
<UsStem title="Calculus II Practice Exam" course="calculus-2" section="General practice exam" description="An original Calculus II practice exam with solutions and a timer.">
  <p class="sopratitolo">Exam practice</p>
  <h1>Calculus II practice exam</h1>
  <p class="sommario">Practice integration, convergence, Taylor series, and plane curves in 60 minutes. Calculus techniques and applications are mixed across the paper.</p>
  <p class="nota">Purdue MA 16200 students can also practice <a href={url('/us/calculus-2/unit-7/domande')}>vectors and analytic geometry</a> and consult the <a href="https://www.math.purdue.edu/academic/courses/oldexams.php?course=MA16200">Purdue past exam archive</a>.</p>
  <UsPractice questions={calculus2Exam.map(question => ({ ...question, href: url(question.href) }))} minutes={60} renderMath />
</UsStem>
