---
import Base from '../../../../../layouts/Base.astro';
import ElencoSchedeSvolte from '../../../../../components/ElencoSchedeSvolte.astro';
import FineAnteprimaUsa from '../../../../../components/FineAnteprimaUsa.astro';
import IndiceTeoria from '../../../../../components/IndiceTeoria.astro';
import SoluzioneEsercizioUsa from '../../../../../components/SoluzioneEsercizioUsa.astro';
import VerificaRisposta from '../../../../../components/VerificaRisposta.astro';
import { highSchoolCourses, highSchoolHasStudyPages, FREE_THEORY_SECTIONS, FREE_WORKED_EXAMPLES, FREE_PRACTICE_EXERCISE } from '../../../../../data/stem-usa/high-school/index.mjs';
import { linkArgomentoUsa } from '../../../../../data/stem-usa/catalog-view';
import { calculusAnswer, calculusHtml } from '../../../../../lib/stem-usa-practice';
import { T } from '../../../../../i18n';

export function getStaticPaths() {
  return highSchoolCourses.filter(highSchoolHasStudyPages).flatMap(course => course.lessons.flatMap((lesson, index) =>
    ['teoria', 'esercizi-svolti', 'esercizi'].map(section => ({
      params: { course: course.slug.slice(3), topic: 'unit-' + (index + 1), section },
      props: { slug: course.slug, lesson },
    }))
  ));
}

const { slug, lesson } = Astro.props;
const { topic, section } = Astro.params as { topic: string; section: 'teoria' | 'esercizi-svolti' | 'esercizi' };
const t = T('en');
const label = t.sezioni[section];
const href = (type: string) => linkArgomentoUsa(slug, topic, type);
const sections = lesson.sections.map(([text, explanation], index) => ({
  slug: 'lesson-' + (index + 1), text, explanation, riservata: index >= FREE_THEORY_SECTIONS,
}));
const sheets = lesson.worked.map((_, index) => ({
  numero: index + 1,
  titolo: lesson.workedTitles[index],
  href: href('esercizi-svolti/' + (index + 1)),
  accesso: index < FREE_WORKED_EXAMPLES ? 'Free worked example' : undefined,
}));
---
<Base lingua="en" usa titolo={lesson.title + ' · ' + label} descrizione={lesson.theory} materia={slug} argomento={topic} sezione={section}
  percorso={[{ titolo: lesson.title, href: href('teoria') }, { titolo: label }]}>
  <p class="sopratitolo">{label}</p>
  <h1>{lesson.title}</h1>
  {section === 'teoria' && <>
    <p class="sommario">{lesson.theory}</p>
    <IndiceTeoria titolo={t.inQuestaPagina} sezioni={sections} />
    <div class="testo-studio">
      {sections.map(({ slug: id, text, explanation, riservata }) => (
        <Fragment>
          <h2 id={id} data-usa-content={riservata || undefined}>{text}</h2>
          <div class="blocco blocco-definizione" data-usa-content={riservata || undefined}>
            <p set:html={calculusHtml(explanation)} />
          </div>
        </Fragment>
      ))}
    </div>
    <FineAnteprimaUsa materia={slug} titolo="Continue with the full lesson">
      <ol class="velo-elenco" start={FREE_THEORY_SECTIONS + 1}>
        {sections.slice(FREE_THEORY_SECTIONS).map(({ text }) => <li>{text}</li>)}
      </ol>
      <p><a href={href('esercizi-svolti')}>Open the free worked examples →</a></p>
    </FineAnteprimaUsa>
    <h2>{t.svoltiSuArgomento}</h2>
    <ElencoSchedeSvolte schede={sheets} />
    <p class="vai-esercizi"><a href={href('esercizi')}>{t.dafareSuArgomento(lesson.exercises.length)} →</a></p>
  </>}
  {section === 'esercizi-svolti' && <>
    <p class="sommario">{t.svoltiSommario}</p>
    <ElencoSchedeSvolte schede={sheets} />
  </>}
  {section === 'esercizi' && <>
    <p class="sommario">{t.dafareSommario}</p>
    {lesson.exercises.map(([title, prompt, solution, answer], index) => {
      const number = index + 1;
      return <section class="traccia" id={'esercizio-' + number}>
        <h2><a href={href('esercizi/' + number)}><span class="numero">{number}.</span> {title}</a></h2>
        <div class="testo-studio">
          <p set:html={calculusHtml(prompt)} />
          <SoluzioneEsercizioUsa soluzione={solution} riservata={number !== FREE_PRACTICE_EXERCISE} />
        </div>
        <div data-usa-content={number !== FREE_PRACTICE_EXERCISE || undefined}>
          <VerificaRisposta lingua="en" id={slug + '/' + topic + '/' + number}
            tipo={answer ? calculusAnswer(answer, false).tipo : undefined} mostraIndizio={false} />
        </div>
      </section>;
    })}
    <section class="ingresso-domande">
      <div class="ingresso-testa"><h2>Timed questions</h2><span>{lesson.title}</span></div>
      <p>One multiple-choice question at a time, with an explanation after each answer.</p>
      <p class="ingresso-azioni"><a class="bottone-primario" href={href('domande')}>Start</a></p>
    </section>
  </>}
</Base>
