---
import Domande from '../../../../../viste/Domande.astro';
import { highSchoolCourses } from '../../../../../data/stem-usa/high-school/index.mjs';
import { RIPASSO, RIPASSO_OGGI } from '../../../../../data/livelli';

export function getStaticPaths() {
  return highSchoolCourses.flatMap(course => [
    ...course.lessons.map((_, i) => ({ params: { course: course.slug.slice(3), topic: 'unit-' + (i + 1) }, props: { slug: course.slug, total: 1 } })),
    { params: { course: course.slug.slice(3), topic: RIPASSO }, props: { slug: course.slug, total: course.lessons.length } },
    { params: { course: course.slug.slice(3), topic: RIPASSO_OGGI }, props: { slug: course.slug, total: 0 } },
  ]);
}
---
<Domande lingua="en" materia={Astro.props.slug} argomento={Astro.params.topic!} totale={Astro.props.total} usa />
