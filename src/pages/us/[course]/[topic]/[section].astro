---
import UsStudySection from '../../../../components/UsStudySection.astro';
import UsTeoria from '../../../../components/UsTeoria.astro';
import { usSectionPaths } from '../../../../lib/stem-usa-study-pages';
import { PROGRAMMI, SEZIONI_USA } from '../../../../data/stem-usa/programmi.mjs';

export function getStaticPaths() {
  // Corsi scritti sul programma americano: contenuti in Markdown, indirizzi delle sezioni in inglese.
  const markdown = Object.entries(PROGRAMMI).flatMap(([corso, argomenti]) =>
    argomenti.map((a) => ({ params: { course: corso, topic: a.slug, section: SEZIONI_USA.teoria }, props: { markdown: true } })));
  return [...markdown, ...usSectionPaths(false)];
}

const { markdown, slug, lesson } = Astro.props as any;
const params = Astro.params as { course: string; topic: string; section: string };
---
{markdown
  ? <UsTeoria corso={params.course} argomento={params.topic} />
  : <UsStudySection {slug} {lesson} topic={params.topic} section={params.section as 'teoria' | 'esercizi-svolti' | 'esercizi'} />}
