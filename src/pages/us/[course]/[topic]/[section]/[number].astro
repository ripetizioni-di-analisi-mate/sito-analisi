---
import UsStudyItem from '../../../../../components/UsStudyItem.astro';
import UsSvolto from '../../../../../components/UsSvolto.astro';
import UsEsercizio from '../../../../../components/UsEsercizio.astro';
import { usItemPaths } from '../../../../../lib/stem-usa-study-pages';
import { usVociMarkdown } from '../../../../../lib/stem-usa-markdown';
import { SEZIONI_USA } from '../../../../../data/stem-usa/programmi.mjs';

export async function getStaticPaths() {
  const markdown = (await usVociMarkdown()).map((x) => ({ ...x, props: { markdown: true } }));
  return [...markdown, ...usItemPaths(false)];
}

const { markdown, slug, lesson } = Astro.props as any;
const { course, topic, section, number } = Astro.params as { course: string; topic: string; section: string; number: string };
---
{markdown
  ? (section === SEZIONI_USA['esercizi-svolti']
      ? <UsSvolto corso={course} argomento={topic} n={number} />
      : <UsEsercizio corso={course} argomento={topic} n={number} />)
  : <UsStudyItem {slug} {lesson} topic={topic} section={section as 'esercizi-svolti' | 'esercizi'} number={number} />}
