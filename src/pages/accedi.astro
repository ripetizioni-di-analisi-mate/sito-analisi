---
import Base from '../layouts/Base.astro';
---
<Base titolo="Accedi" percorso={[{ titolo: 'Accedi' }]} descrizione="Accedi al tuo account o creane uno nuovo.">
  <h1>Il tuo account</h1>
  <p class="sommario">Con l'account acquisti le materie e le ritrovi sbloccate su ogni dispositivo in cui accedi.</p>

  <div class="schede-accesso" role="tablist">
    <button type="button" role="tab" aria-selected="true" data-scheda="accedi">Accedi</button>
    <button type="button" role="tab" aria-selected="false" data-scheda="registrati">Crea un account</button>
  </div>

  <form class="modulo" id="modulo" novalidate>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    <label>Password<input type="password" name="password" autocomplete="current-password" required minlength="8" /></label>
    <label id="campo-conferma" hidden>Ripeti la password<input type="password" name="conferma" autocomplete="new-password" minlength="8" /></label>
    <p class="esito-modulo" id="esito" role="status"></p>
    <button class="bottone-primario" type="submit" id="invia">Accedi</button>
  </form>
  <p class="nota-accesso" id="nota-password">Password dimenticata? Scrivimi dalla pagina <a href="/contatti">Contatti e assistenza</a> e te ne imposto una nuova.</p>

  <script is:inline>
    (() => {
      const modulo = document.getElementById('modulo');
      const esito = document.getElementById('esito');
      const invia = document.getElementById('invia');
      const conferma = document.getElementById('campo-conferma');
      const dopo = new URLSearchParams(location.search).get('dopo');
      const destinazione = dopo && dopo.startsWith('/') && !dopo.startsWith('//') ? dopo : '/account';
      let scheda = new URLSearchParams(location.search).get('nuovo') ? 'registrati' : 'accedi';

      const imposta = (s) => {
        scheda = s;
        document.querySelectorAll('[data-scheda]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.scheda === s)));
        conferma.hidden = s !== 'registrati';
        invia.textContent = s === 'registrati' ? 'Crea l’account' : 'Accedi';
        modulo.password.autocomplete = s === 'registrati' ? 'new-password' : 'current-password';
        esito.textContent = ''; esito.className = 'esito-modulo';
      };
      document.querySelectorAll('[data-scheda]').forEach((b) => b.addEventListener('click', () => imposta(b.dataset.scheda)));
      imposta(scheda);

      modulo.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = modulo.email.value.trim().toLowerCase();
        const password = modulo.password.value;
        const errore = (t) => { esito.textContent = t; esito.className = 'esito-modulo errore'; };
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return errore('Scrivi un indirizzo email valido.');
        if (password.length < 8) return errore('La password deve avere almeno 8 caratteri.');
        if (scheda === 'registrati' && password !== modulo.conferma.value) return errore('Le due password non coincidono.');
        invia.disabled = true; esito.textContent = 'Un momento…'; esito.className = 'esito-modulo';
        try {
          const r = await fetch(scheda === 'registrati' ? '/api/registrati' : '/api/accedi', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) { invia.disabled = false; return errore(d.errore || 'Qualcosa non ha funzionato. Riprova.'); }
          location.href = destinazione;
        } catch {
          invia.disabled = false; errore('Connessione assente. Riprova tra un momento.');
        }
      });
    })();
  </script>
</Base>
