---
import Base from '../layouts/Base.astro';
---
<Base titolo="Cerca" percorso={[{ titolo: 'Cerca' }]}>
  <p class="sopratitolo">Ricerca</p>
  <h1>Cerca nel sito</h1>
  <p class="sommario">Argomenti, definizioni, teoremi ed esercizi di tutte le materie. La ricerca avviene nel browser, senza inviare nulla.</p>
  <input class="campo-cerca" id="cerca" type="search" placeholder="Per esempio: permanenza del segno, forma indeterminata" autocomplete="off" autofocus />
  <p id="esito" class="nota-segnaposto" hidden></p>
  <ul class="risultati" id="risultati"></ul>

  <script>
    const campo = document.getElementById('cerca') as HTMLInputElement;
    const lista = document.getElementById('risultati') as HTMLUListElement;
    const esito = document.getElementById('esito') as HTMLParagraphElement;
    // La ricerca dalla home arriva come ?q=…: il campo parte già compilato.
    if (!campo.value) campo.value = new URLSearchParams(location.search).get('q') ?? '';
    let voci: { t: string; s: string; m: string; h: string; p: string }[] = [];

    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const evid = (t: string, q: string[]) => {
      let out = t;
      for (const w of q) out = out.replace(new RegExp(`(${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'ig'), '<mark>$1</mark>');
      return out;
    };

    async function carica() {
      const r = await fetch(new URL('./indice-ricerca.json', location.href));
      voci = await r.json();
      cerca();
    }
    function cerca() {
      const q = norm(campo.value).split(/\s+/).filter((w) => w.length > 1);
      lista.innerHTML = '';
      if (q.length === 0) { esito.hidden = true; return; }
      const trovate = voci
        .map((v) => {
          const testo = norm(`${v.t} ${v.s} ${v.m} ${v.p}`);
          const punti = q.reduce((acc, w) => acc + (norm(v.t).includes(w) ? 3 : testo.includes(w) ? 1 : 0), 0);
          return { v, punti, tutte: q.every((w) => testo.includes(w)) };
        })
        .filter((x) => x.tutte)
        .sort((a, b) => b.punti - a.punti)
        .slice(0, 40);
      esito.hidden = false;
      esito.textContent = trovate.length === 0 ? 'Nessun risultato.' : `${trovate.length} risultat${trovate.length === 1 ? 'o' : 'i'}`;
      for (const { v } of trovate) {
        const li = document.createElement('li');
        li.innerHTML = `<a href="${v.h}">${evid(v.t, q)}<small>${v.m} · ${v.s}</small></a>`;
        lista.appendChild(li);
      }
    }
    campo.addEventListener('input', cerca);
    carica();
  </script>
</Base>
