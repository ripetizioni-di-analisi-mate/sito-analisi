---
// Domande a tempo di tutte le materie (gratis). 03/11/2026: versione A scelta da Carmine fra tre (B elenco a fisarmonica, C tasti delle materie):
// una scheda per materia con «Ripasso su tutto» e la simulazione; gli argomenti si aprono con «Scegli un argomento». Versione inglese: src/pages/en/domande-a-tempo.astro.
import Base from '../layouts/Base.astro';
import { RIPASSO } from '../data/livelli';
import { elencoDomande } from '../lib/domande-elenco';
import { nomiAllenamento } from '../lib/allenamento.mjs';
const { materie, gruppi, totale } = await elencoDomande();
---
<Base titolo="Domande a tempo: quiz gratuiti per materia e argomento" descrizione={`Quiz a risposta multipla gratuiti su ${materie.length} materie: quattro risposte, due minuti per domanda e la spiegazione dopo ogni risposta. Anche senza account.`} lingua="it" percorso={[{ titolo: 'Domande a tempo' }]}>
  <p class="sopratitolo">Gratis</p>
  <h1>Domande a tempo</h1>
  <p class="sommario">{totale} domande a risposta multipla: quattro risposte, due minuti per domanda e la spiegazione dopo la conferma. Si usano anche senza account.</p>
  {gruppi.map((g) => (
    <>
      <p class="dta-gruppo">{g}</p>
      <ul class="dta-griglia">
        {materie.filter((m) => m.gruppo === g).map((m) => (
          <li style={`--accento: ${m.colore}`}>
            <h3>{m.titolo}</h3>
            <p class="dta-conti">{m.argomenti.length} argomenti · {m.totale} domande</p>
            <div class="dta-tasti">
              <a class="dta-primario" href={`/${m.slug}/${RIPASSO}/domande`}>Ripasso su tutto</a>
              <a class="dta-secondario" href={`/${m.slug}/simulazione`}>{m.concorsi ? 'Simulazione a quiz' : nomiAllenamento(m).simulazione}</a>
            </div>
            <details>
              <summary>Scegli un argomento</summary>
              <ol>
                {m.argomenti.map((a) => <li><a href={`/${m.slug}/${a.slug}/domande`}>{a.titolo}</a></li>)}
              </ol>
            </details>
          </li>
        ))}
      </ul>
    </>
  ))}
</Base>
<style>
  .dta-gruppo { display: flex; width: fit-content; align-items: center; gap: 0.4rem; margin: 1.8rem 0 0; padding: 0.22rem 0.6rem; border-radius: 6px; background: var(--scheda-chiaro); font: 700 0.7rem/1.5 var(--ui); letter-spacing: 0.08em; text-transform: uppercase; color: var(--azione); }
  .dta-gruppo::before { content: ''; width: 0.35rem; height: 0.35rem; border-radius: 50%; background: currentColor; }
  .dta-griglia { list-style: none; padding: 0; margin: 0.7rem 0 0; display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); align-items: start; }
  .dta-griglia > li { border: 1px solid var(--scheda-bordo); border-top: 3px solid var(--accento); border-radius: 14px; padding: 0.95rem 1.05rem 1rem; background: #fff; box-shadow: var(--scheda-ombra); }
  .dta-griglia h3 { margin: 0; font-size: 1.15rem; line-height: 1.3; color: var(--inchiostro); }
  .dta-conti { margin: 0.2rem 0 0.7rem; font-family: var(--ui); font-size: 0.85rem; color: var(--inchiostro-2); }
  .dta-tasti { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .dta-tasti a { font-family: var(--ui); font-size: 0.85rem; font-weight: 600; text-decoration: none; border-radius: 999px; padding: 0.3rem 0.8rem; }
  .dta-primario { background: var(--accento); color: #fff; }
  .dta-secondario { color: var(--accento); background: color-mix(in srgb, var(--accento) 11%, transparent); }
  details { margin-top: 0.8rem; border-top: 1px solid var(--scheda-bordo); padding-top: 0.55rem; font-family: var(--ui); font-size: 0.9rem; }
  summary { cursor: pointer; color: var(--inchiostro-2); }
  details ol { margin: 0.4rem 0 0; padding-left: 1.3rem; display: grid; gap: 0.2rem; }
  details a { color: var(--inchiostro); }
</style>
