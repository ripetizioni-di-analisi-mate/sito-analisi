---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { argomentoL, materiaL, link, voceL, T, type Lingua } from '../i18n';
import { vicini, perArgomento, numero } from '../lib/nav';
import { catalogoDomande } from '../lib/domande';
interface Props { lingua: Lingua; materia: string; argomento: string }
const { lingua, materia, argomento } = Astro.props;
const t = T(lingua);
const arg = argomentoL(lingua, materia, argomento);
const voci = await Promise.all(perArgomento(await getCollection('dafare'), materia, argomento).map((e) => voceL(lingua, 'dafare', e.id)));
const nonTradotta = voci.some((v) => !v.tradotta);
const resi = await Promise.all(voci.map(async ({ voce: v }) => ({ v, Content: (await render(v)).Content })));
const { precedente, successivo } = vicini(materia, argomento, 'esercizi', lingua);
const base = `/${materia}/${argomento}`;
// Domande a tempo, per gli argomenti che ne hanno.
const conDomande = ((await catalogoDomande(lingua))[materia] ?? []).includes(argomento);
---
<Base
  titolo={`${arg.titolo} · ${t.sezioni.esercizi}`}
  descrizione={SEO(lingua).dafareListaDescr(arg.titolo, materiaL(lingua, materia).titolo, voci.length)}
  seo={{ titolo: SEO(lingua).dafareLista(arg.titolo, materiaL(lingua, materia).breve), soloQuestaLingua: lingua === 'it' ? !(await voceL('en', 'dafare', voci[0]?.voce.id ?? '')).tradotta : nonTradotta }}
  percorso={[{ titolo: arg.breve, href: link(lingua, `${base}/teoria`) }, { titolo: t.sezioni.esercizi }]}
  materia={materia} argomento={argomento} sezione="esercizi"
  precedente={precedente} successivo={successivo}
  lingua={lingua} nonTradotta={nonTradotta}
>
  <p class="sopratitolo">{t.sezioni.esercizi}</p>
  <h1>{arg.titolo}</h1>
  <p class="sommario">{t.dafareSommario}</p>
  {voci.length === 0 && <p class="nota-segnaposto">{t.dafareInPreparazione}</p>}
  {resi.map(({ v, Content }) => (
    <section class="traccia" id={`esercizio-${numero(v.id)}`}>
      <h2><a href={link(lingua, `${base}/esercizi/${numero(v.id)}`)}><span class="numero">{numero(v.id)}.</span> {v.data.titolo}</a></h2>
      <div class="testo-studio"><Content /></div>
    </section>
  ))}
  {conDomande && (
    <section class="ingresso-domande">
      <div class="ingresso-testa"><h2>{lingua === 'en' ? 'Timed questions' : 'Domande a tempo'}</h2><span>{arg.breve}</span></div>
      <p>{lingua === 'en' ? 'Multiple-choice questions on the exercises of this topic, one at a time, two minutes each. The explanation appears after every answer.' : 'Domande a risposta multipla sugli esercizi di questo argomento, una alla volta, con due minuti per ciascuna. Dopo ogni risposta compare la spiegazione.'}</p>
      <p class="ingresso-azioni"><a class="bottone-primario" href={link(lingua, `${base}/domande`)}>{lingua === 'en' ? 'Start' : 'Inizia'}</a><span>{lingua === 'en' ? 'Up to 15 XP per correct answer' : 'Fino a 15 EXP per risposta corretta'}</span></p>
    </section>
  )}
</Base>
