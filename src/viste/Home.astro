---
import { SEO } from '../lib/seo-testi';
import Base from '../layouts/Base.astro';
import Presentazione from '../components/Presentazione.astro';
import SpazioStudente from '../components/SpazioStudente.astro';
import MaterialiStudente from '../components/MaterialiStudente.astro';
import GratisHome from '../components/GratisHome.astro';
import PacchettiHome from '../components/PacchettiHome.astro';
import PercorsiHome from '../components/PercorsiHome.astro';
import { link, T, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const icona = {
  teoria: '<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M5 2.5h7l3.5 3.5v11.5H5z"/><path d="M12 2.5V6h3.5M7.8 10h5M7.8 13h5"/></svg>',
  video: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M8 6.5v7l5.5-3.5z" fill="#fff"/></svg>',
};
---
<Base titolo={t.nomeSito} descrizione={SEO(lingua).homeDescr} lingua={lingua} sezione="home" ricercaPrincipale seo={{ titolo: SEO(lingua).home }}>
  <div class="home-intro solo-ospiti">
    <p class="sopratitolo">{lingua === 'it' ? 'Università · Superiori · Concorsi' : 'University · Secondary school · Entrance tests'}</p>
    <h1>{t.homeTitolo}</h1>
    <p class="sommario">{lingua === 'it' ? 'Scegli la materia. Trovi teoria, esercizi spiegati passo dopo passo e prove per esercitarti in autonomia.' : 'Choose a subject. Find theory, step-by-step worked examples and exercises to practise on your own.'}</p>
  </div>
  <h1 class="home-personale solo-collegati">{lingua === 'it' ? 'Il tuo spazio di studio' : 'Your study space'}</h1>
  {/* Chi ha fatto l'accesso vede il suo spazio (livello, studio, materie) al posto della presentazione di Carmine. */}
  <SpazioStudente lingua={lingua} />
  <MaterialiStudente lingua={lingua} />
  <form class="cerca-home" id="ricerca-principale" action={link(lingua, '/cerca')} role="search">
    <div class="con-lente"><svg class="lente" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
    <input type="search" name="q" placeholder={t.cercaSegnaposto} aria-label={t.cercaNelSito} autocomplete="off" />
    </div>
    <button type="submit">{t.cerca}</button>
  </form>
  <PercorsiHome lingua={lingua} />
  {lingua === 'it' ? (
    <ul class="legenda-home">
      <li><Fragment set:html={icona.teoria} /><span><b>Teoria ed esercizi</b>: spiegazioni, svolgimenti e soluzioni.</span></li>
      <li><Fragment set:html={icona.video} /><span><b>Videocorsi</b>: lezioni di Carmine, con video e PDF.</span></li>
    </ul>
    <p class="gratis-home solo-ospiti"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 10S4.8 4.5 10 4.5 18.2 10 18.2 10 15.2 15.5 10 15.5 1.8 10 1.8 10Z"/><circle cx="10" cy="10" r="2.5"/></svg><span><b>Prova gratis</b>: anteprime di teoria ed esercizi, senza account.</span></p>
  ) : (
    <p class="nota-anteprima solo-ospiti"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 10S4.8 4.5 10 4.5 18.2 10 18.2 10 15.2 15.5 10 15.5 1.8 10 1.8 10Z"/><circle cx="10" cy="10" r="2.5"/></svg>{t.homeAnteprima}</p>
  )}
  <div class="risorse-home"><GratisHome lingua={lingua} /></div>
  {lingua === 'it' && <PacchettiHome />}
  <section class="home-lezioni solo-ospiti" aria-labelledby="home-servizi">
    <h2 id="home-servizi">{lingua === 'it' ? 'Studiare con Carmine' : 'Study with Carmine'}</h2>
    <p>{lingua === 'it' ? 'Oltre ai materiali puoi seguire le lezioni registrate, prenotare una lezione individuale o partecipare a un corso di gruppo.' : 'Explore the materials or study with Carmine through recorded courses and live lessons.'}</p>
    {lingua === 'it' && <nav aria-label="Lezioni con Carmine"><a href="/videocorsi">Videocorsi registrati <span aria-hidden="true">→</span></a><a href="/prenota">Lezione individuale <span aria-hidden="true">→</span></a><a href="/corsi-di-gruppo">Corso di gruppo <span aria-hidden="true">→</span></a></nav>}
    <Presentazione lingua={lingua} />
  </section>
</Base>
<style>
  .home-intro{margin-bottom:1.4rem}.home-intro h1{max-width:24ch}.home-intro .sommario{margin-bottom:0}
  .home-personale{margin-bottom:1.4rem}
  .home-lezioni{border-top:1px solid var(--riga);margin-top:2.5rem;padding-top:1.3rem}.home-lezioni h2{font-size:1.4rem;margin:0 0 .6rem}.home-lezioni>p{font-size:1rem;color:var(--inchiostro-2)}
  .home-lezioni nav{display:flex;flex-wrap:wrap;gap:.7rem 1.2rem;margin:1rem 0 1.4rem;font:600 .95rem var(--ui)}
  :global(html.collegato.home-chiarezza .risorse-home){margin-top:1rem;font-size:.9rem}
</style>
