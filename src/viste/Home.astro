---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import Base from '../layouts/Base.astro';
import Stato from '../components/Stato.astro';
import Presentazione from '../components/Presentazione.astro';
import SpazioStudente from '../components/SpazioStudente.astro';
import EsameHome from '../components/EsameHome.astro';
import GratisHome from '../components/GratisHome.astro';
import { getCollection } from 'astro:content';
import { VIDEOCORSI, chiaveVideo } from '../data/videocorsi';
import { materieL, gruppiL, blocchiGruppo, link, T, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const MATERIE = materieL(lingua);
// Videocorso proprio di ogni materia (in italiano): quello che sblocca per prima la materia; il pacchetto di più corsi non ha una scheda sua.
const videoDi = (slug: string) => lingua === 'it' ? VIDEOCORSI.find((v) => !v.pacchettoDi && v.sblocca[0] === slug) : undefined;
// "Sbloccata" compare solo su ciò che è nell'account: la teoria ed esercizi se la materia è sbloccata, il videocorso se è stato acquistato
// (da solo o dentro un pacchetto). Il Worker scrive su <html> data-materie con le materie e le chiavi video-<slug>.
const regoleSbloccato = lingua === 'it' ? MATERIE.filter((m) => m.prezzo && m.attiva).map((m) => {
  const v = videoDi(m.slug);
  const teoria = `html[data-materie~="${m.slug}"] [data-materia="${m.slug}"] .pulsante-teoria .ok{display:inline-flex}`;
  const video = v ? [v.slug, ...VIDEOCORSI.filter((p) => p.pacchettoDi?.includes(v.slug)).map((p) => p.slug)]
    .map((s) => `html[data-materie~="${chiaveVideo(s)}"] [data-materia="${m.slug}"] .pulsante-video .ok{display:inline-flex}`).join('') : '';
  return teoria + video;
}).join('') : '';
// Conteggi veri di ogni materia, letti dai file dei contenuti (non scritti a mano).
const [svolti, dafare] = [await getCollection('svolti'), await getCollection('dafare')];
const conta = (lista: { id: string }[], slug: string) => lista.filter((x) => x.id.startsWith(`${slug}/`)).length;
const conti = (m: (typeof MATERIE)[number]) => `${m.argomenti.length} argomenti · ${conta(svolti, m.slug)} schede svolte · ${conta(dafare, m.slug)} esercizi da fare`;
const icona = {
  teoria: '<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M5 2.5h7l3.5 3.5v11.5H5z"/><path d="M12 2.5V6h3.5M7.8 10h5M7.8 13h5"/></svg>',
  video: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M8 6.5v7l5.5-3.5z" fill="#fff"/></svg>',
  ok: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};
---
<Base titolo={t.nomeSito} descrizione={SEO(lingua).homeDescr} lingua={lingua} seo={{ titolo: SEO(lingua).home }}>
  {/* Accanto al titolo, solo con l'account e una data d'esame inserita: il conto alla rovescia all'esame più vicino. */}
  <div class="testa-home">
    <div class="testa-home-titolo">
      {t.homeSopra && <p class="sopratitolo">{t.homeSopra}</p>}
      <h1>{t.homeTitolo}</h1>
    </div>
    <EsameHome lingua={lingua} versione="a" />
  </div>
  {/* Chi ha fatto l'accesso vede il suo spazio (livello, studio, materie) al posto della presentazione di Carmine. */}
  <SpazioStudente lingua={lingua} />
  <div class="solo-ospiti">
    <p class="sommario">{t.homeSommario}</p>
    <Presentazione lingua={lingua} />
  </div>
  <form class="cerca-home" action={link(lingua, '/cerca')} role="search">
    <div class="con-lente"><svg class="lente" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
    <input type="search" name="q" placeholder={t.cercaSegnaposto} aria-label={t.cercaNelSito} autocomplete="off" />
    </div>
    <button type="submit">{t.cerca}</button>
  </form>
  {lingua === 'it' ? (
    <ul class="legenda-home">
      <li><Fragment set:html={icona.teoria} /><span><b>Teoria ed esercizi</b>: teoria, teoremi con dimostrazione, esercizi svolti passo dopo passo ed esercizi con soluzione.</span></li>
      <li><Fragment set:html={icona.video} /><span><b>Videocorsi</b>: le lezioni complete dei corsi, registrate, con il PDF di ogni lezione.</span></li>
    </ul>
    <p class="gratis-home solo-ospiti"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 10S4.8 4.5 10 4.5 18.2 10 18.2 10 15.2 15.5 10 15.5 1.8 10 1.8 10Z"/><circle cx="10" cy="10" r="2.5"/></svg><span>Di ogni argomento si leggono gratis l'inizio della teoria e le prime tre schede svolte, senza account.</span></p>
  ) : (
    <p class="nota-anteprima solo-ospiti"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 10S4.8 4.5 10 4.5 18.2 10 18.2 10 15.2 15.5 10 15.5 1.8 10 1.8 10Z"/><circle cx="10" cy="10" r="2.5"/></svg>{t.homeAnteprima}</p>
  )}
  {lingua === 'it' && <GratisHome />}
  {regoleSbloccato && <style is:inline set:html={regoleSbloccato}></style>}
  {gruppiL(lingua).map((g, i) => (
    <details class="gruppo" open={i === 0} id={i === 0 ? 'materie-home' : undefined}>
      <summary class="nome-gruppo"><h2>{g}</h2><span class="conta-gruppo">{MATERIE.filter((m) => m.gruppo === g).length}</span></summary>
      {lingua === 'it' && g === 'Concorsi' && (
        <ul class="griglia-materie">
          <li style="--accento: #6d5a8a">
            <a href="/concorsi">
              <h3>Che cosa studiare per il tuo concorso</h3>
              <p>Guida gratuita: gli argomenti di matematica e logica che compaiono nei concorsi pubblici, nei test delle forze dell'ordine e nei test di ammissione.</p>
              <span class="conteggio">Guida gratuita</span>
            </a>
          </li>
        </ul>
      )}
      {(() => {
        // Nelle aree senza sottogruppi con almeno una materia pronta (Università, Percorso per principianti) le materie in preparazione stanno in una riga di testo;
        // se nessuna è pronta (TOLC, OFA e test di ingresso) restano schede «in preparazione».
        const griglia = (voci: { m: (typeof MATERIE)[number]; nome: string }[], riga = false) => (
          <ul class="griglia-materie">
            {voci.filter(({ m }) => !riga || m.attiva).map(({ m, nome }) => (
              <li class:list={{ 'in-preparazione': !m.attiva, 'con-pulsanti': m.attiva && lingua === 'it' }} style={`--accento: ${m.colore}`} data-materia={m.slug}>
                {m.attiva && lingua === 'it' ? (() => {
                  const v = videoDi(m.slug);
                  return (
                    <>
                      <a class="scheda-materia" href={link(lingua, `/${m.slug}`)}>
                        <h3>{nome}</h3>
                        <p>{m.descrizione}</p>
                        <span class="conti-materia">{conti(m)}</span>
                      </a>
                      <span class="piede-scheda pulsanti-scheda">
                        {v && (
                          <a class="pulsante-scheda pulsante-video" href={`/videocorsi/${v.slug}`}>
                            <Fragment set:html={icona.video} />Videocorso<span class="ok"><Fragment set:html={icona.ok} />Sbloccato</span>
                          </a>
                        )}
                        <a class="pulsante-scheda pulsante-teoria" href={link(lingua, `/${m.slug}`)}>
                          <Fragment set:html={icona.teoria} />Teoria ed esercizi{m.prezzo && <span class="ok"><Fragment set:html={icona.ok} />Sbloccata</span>}
                        </a>
                      </span>
                    </>
                  );
                })() : m.attiva ? (
                  <a href={link(lingua, `/${m.slug}`)}>
                    <h3>{nome}</h3>
                    <p>{m.descrizione}</p>
                    <span class="piede-scheda"><Stato prezzo={m.prezzo} lingua={lingua} /></span>
                  </a>
                ) : (
                  <div>
                    <h3>{nome}</h3>
                    <p>{m.descrizione}</p>
                    <span class="conteggio">{t.inPreparazione}</span>
                  </div>
                )}
              </li>
            ))}
            {riga && voci.some(({ m }) => !m.attiva) && (
              <li class="riga-preparazione">In preparazione: {voci.filter(({ m }) => !m.attiva).map(({ nome }) => nome).join(', ')}.</li>
            )}
          </ul>
        );
        return blocchiGruppo(MATERIE, g).map((b) => b.sotto ? (
          <details class="sottogruppo">
            <summary class="nome-sottogruppo"><h3>{b.sotto}</h3><span class="conta-gruppo">{b.materie.length}</span></summary>
            {griglia(b.materie)}
          </details>
        ) : griglia(b.materie, lingua === 'it' && b.materie.some(({ m }) => m.attiva)));
      })()}
    </details>
  ))}
</Base>
