---
import '@fontsource/source-sans-3/latin-500-italic.css';
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import Base from '../layouts/Base.astro';
import Stato from '../components/Stato.astro';
import Presentazione from '../components/Presentazione.astro';
import SpazioStudente from '../components/SpazioStudente.astro';
import MaterialiStudente from '../components/MaterialiStudente.astro';
import GratisHome from '../components/GratisHome.astro';
import PacchettiHome from '../components/PacchettiHome.astro';
import PercorsiHome from '../components/PercorsiHome.astro';
import NotaSuperiori from '../components/NotaSuperiori.astro';
import { getCollection } from 'astro:content';
import { VIDEOCORSI, chiaveVideo } from '../data/videocorsi';
import { materieL, gruppiL, blocchiGruppo, link, T, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const MATERIE = materieL(lingua);
const gruppi = gruppiL(lingua).map((nome, i) => ({
  nome,
  id: i === 0 ? 'materie-home' : `percorso-home-${i}`,
  breve: nome.startsWith('TOLC') ? (lingua === 'en' ? 'Admission tests' : 'Test d’ingresso') : nome,
}));
// Videocorso proprio di ogni materia (in italiano): quello che sblocca per prima la materia; il pacchetto di più corsi non ha una scheda sua.
const videoDi = (slug: string) => lingua === 'it' ? VIDEOCORSI.find((v) => !v.pacchettoDi && v.sblocca[0] === slug) : undefined;
// "Sbloccata" compare solo su ciò che è nell'account: la teoria ed esercizi se la materia è sbloccata, il videocorso se è stato acquistato
// (da solo o dentro un pacchetto). Il Worker scrive su <html> data-materie con le materie e le chiavi video-<slug>.
const regoleSbloccato = lingua === 'it' ? MATERIE.filter((m) => m.prezzo && m.attiva).map((m) => {
  const v = videoDi(m.slug);
  const teoria = `html[data-materie~="${m.slug}"] [data-materia="${m.slug}"] .pulsante-teoria .ok{display:inline-flex}html[data-materie~="${m.slug}"] [data-materia="${m.slug}"] .nota-anteprima-scheda{display:none}html[data-materie~="${m.slug}"] [data-materia="${m.slug}"] .nota-accesso-scheda{display:inline}`;
  const video = v ? [v.slug, ...VIDEOCORSI.filter((p) => p.pacchettoDi?.includes(v.slug)).map((p) => p.slug)]
    .map((s) => `html[data-materie~="${chiaveVideo(s)}"] [data-materia="${m.slug}"] .pulsante-video .ok{display:inline-flex}`).join('') : '';
  return teoria + video;
}).join('') : '';
// Conteggi veri di ogni materia, letti dai file dei contenuti (non scritti a mano).
const [svolti, dafare] = [await getCollection('svolti'), await getCollection('dafare')];
const conta = (lista: { id: string }[], slug: string) => lista.filter((x) => x.id.startsWith(`${slug}/`)).length;
const conti = (m: (typeof MATERIE)[number]) => `${m.argomenti.length} argomenti · ${conta(svolti, m.slug)} schede svolte · ${conta(dafare, m.slug)} esercizi da fare`;
const icona = {
  teoria: '<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M5 2.5h7l3.5 3.5v11.5H5z"/><path d="M12 2.5V6h3.5M7.8 10h5M7.8 13h5"/></svg>',
  video: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M8 6.5v7l5.5-3.5z" fill="#fff"/></svg>',
  ok: '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};
---
<Base titolo={t.nomeSito} descrizione={SEO(lingua).homeDescr} lingua={lingua} sezione="home" ricercaPrincipale seo={{ titolo: SEO(lingua).home }}>
  <div class="home-intro solo-ospiti">
    {/* Il titolo resta per i motori di ricerca e gli screen reader; a schermo la home parte dal sommario (08/11, scelta di Carmine). */}
    <h1 class="solo-lettori">{lingua === 'it' ? 'Matematica e fisica: teoria ed esercizi svolti' : 'Calculus, Linear Algebra and Physics: theory and solved problems'}</h1>
    <p class="sommario">{lingua === 'it' ? 'Teoria chiara, esercizi svolti e strumenti per verificare la tua preparazione. Scegli la materia e parti da ciò che ti serve.' : 'Clear theory, worked examples and tools to test your understanding. Choose a subject and start with what you need.'}</p>
  </div>
  <div class="solo-ospiti">
    <Presentazione lingua={lingua} motto={lingua === 'it' ? 'Ciò che comprendi oggi diventa la tua forza domani.' : 'What you understand today becomes your strength tomorrow.'} />
  </div>
  <h1 class="home-personale solo-collegati">{lingua === 'it' ? 'Il tuo spazio di studio' : 'Your study space'}</h1>
  {/* Chi ha fatto l'accesso vede il suo spazio (livello, studio, materie) al posto della presentazione di Carmine. */}
  <SpazioStudente lingua={lingua} />
  {lingua === 'it' && <div class="pacchetti-studente solo-collegati"><PacchettiHome /></div>}
  <MaterialiStudente lingua={lingua} />
  <form class="cerca-home" id="ricerca-principale" action={link(lingua, '/cerca')} role="search">
    <div class="con-lente"><svg class="lente" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
    <input type="search" name="q" placeholder={t.cercaSegnaposto} aria-label={t.cercaNelSito} autocomplete="off" />
    </div>
    <button type="submit">{t.cerca}</button>
  </form>
  {lingua === 'it' ? (
    <ul class="legenda-home">
      <li><Fragment set:html={icona.teoria} /><span><b>Teoria ed esercizi</b>: spiegazioni, svolgimenti e soluzioni.</span></li>
      <li><Fragment set:html={icona.video} /><span><b>Videocorsi</b>: lezioni di Carmine, con video e PDF.</span></li>
    </ul>
    <p class="gratis-home solo-ospiti"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 10S4.8 4.5 10 4.5 18.2 10 18.2 10 15.2 15.5 10 15.5 1.8 10 1.8 10Z"/><circle cx="10" cy="10" r="2.5"/></svg><span><b>Prova gratis</b>: anteprime di teoria ed esercizi, senza account.</span></p>
  ) : (
    <p class="nota-anteprima solo-ospiti"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 10S4.8 4.5 10 4.5 18.2 10 18.2 10 15.2 15.5 10 15.5 1.8 10 1.8 10Z"/><circle cx="10" cy="10" r="2.5"/></svg>{t.homeAnteprima}</p>
  )}
  <div class="risorse-home"><GratisHome lingua={lingua} /></div>
  {lingua === 'it' && <div class="solo-ospiti"><PacchettiHome /></div>}
  <PercorsiHome lingua={lingua} gruppi={gruppi} />
  {regoleSbloccato && <style is:inline set:html={regoleSbloccato}></style>}
  {gruppi.map(({ nome: g, id }, i) => (
    <details class="gruppo" open={i === 0} id={id}>
      <summary class="nome-gruppo"><h2>{g}</h2><span class="conta-gruppo">{MATERIE.filter((m) => m.gruppo === g && m.attiva).length || (lingua === 'it' ? 'In preparazione' : 'Coming soon')}</span></summary>
      {(g === 'Superiori' || g === 'High school') && <NotaSuperiori lingua={lingua} />}
      {lingua === 'it' && g === 'Concorsi' && (
        <ul class="griglia-materie">
          <li style="--accento: #6d5a8a">
            <a href="/concorsi">
              <h3>Che cosa studiare per il tuo concorso</h3>
              <p>Guida gratuita: gli argomenti di matematica e logica che compaiono nei concorsi pubblici, nei test delle forze dell'ordine e nei test di ammissione.</p>
              <span class="conteggio">Guida gratuita</span>
            </a>
          </li>
        </ul>
      )}
      {(() => {
        // Nelle aree senza sottogruppi con almeno una materia pronta (Università, Percorso per principianti) le materie in preparazione stanno in una riga di testo;
        // se nessuna è pronta (TOLC, OFA e test di ingresso) restano schede «in preparazione».
        const griglia = (voci: { m: (typeof MATERIE)[number]; nome: string }[], riga = true) => (
          <ul class="griglia-materie">
            {voci.filter(({ m }) => !riga || m.attiva).map(({ m, nome }) => (
              <li class:list={{ 'in-preparazione': !m.attiva, 'con-pulsanti': m.attiva && lingua === 'it' }} style={`--accento: ${m.colore}`} data-materia={m.slug}>
                {m.attiva && lingua === 'it' ? (() => {
                  const v = videoDi(m.slug);
                  return (
                    <>
                      <div class="scheda-materia">
                        <h3>{nome}</h3>
                        <p>{m.descrizione}</p>
                        <span class="conti-materia">{conti(m)}</span>
                      </div>
                      <span class="piede-scheda pulsanti-scheda">
                        <a class="pulsante-scheda pulsante-teoria" href={link(lingua, `/${m.slug}`)}>
                          <Fragment set:html={icona.teoria} />Teoria ed esercizi<span aria-hidden="true">→</span>{m.prezzo && <span class="ok"><Fragment set:html={icona.ok} />Sbloccata</span>}
                        </a>
                        {v && <a class="pulsante-scheda pulsante-video" href={`/videocorsi/${v.slug}`}><Fragment set:html={icona.video} />Videocorso<span class="ok"><Fragment set:html={icona.ok} />Sbloccato</span></a>}
                      </span>
                      <small class="accesso-scheda">{m.prezzo ? <><span class="nota-anteprima-scheda">Anteprima gratuita</span><span class="nota-accesso-scheda">Accesso completo</span></> : 'Tutto gratuito'}</small>
                    </>
                  );
                })() : m.attiva ? (
                  <a href={link(lingua, `/${m.slug}`)}>
                    <h3>{nome}</h3>
                    <p>{m.descrizione}</p>
                    <span class="piede-scheda"><Stato prezzo={m.prezzo} lingua={lingua} /></span>
                  </a>
                ) : (
                  <div>
                    <h3>{nome}</h3>
                    <p>{m.descrizione}</p>
                    <span class="conteggio">{t.inPreparazione}</span>
                  </div>
                )}
              </li>
            ))}
            {riga && voci.some(({ m }) => !m.attiva) && (
              <li class="riga-preparazione">In preparazione: {voci.filter(({ m }) => !m.attiva).map(({ nome }) => nome).join(', ')}.</li>
            )}
          </ul>
        );
        return blocchiGruppo(MATERIE, g).map((b) => b.sotto ? (
          <details class="sottogruppo">
            <summary class="nome-sottogruppo"><h3>{b.sotto}</h3><span class="conta-gruppo">{b.materie.filter(({ m }) => m.attiva).length || (lingua === 'it' ? 'In preparazione' : 'Coming soon')}</span></summary>
            {griglia(b.materie)}
          </details>
        ) : griglia(b.materie));
      })()}
    </details>
  ))}
</Base>
<style>
  .pacchetti-studente{padding-top:1rem}
  .home-intro{margin-bottom:1.4rem}
  .solo-lettori{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .home-intro .sommario{margin-top:0}
  .home-personale{margin-bottom:1.4rem}.catalogo-testa{scroll-margin-top:6rem;display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.3rem 1rem;margin:2rem 0 .8rem;font-family:var(--ui)}
  .catalogo-testa h2{margin:0;font-size:1.3rem}.catalogo-testa>span{color:var(--inchiostro-2);font-size:.88rem}
  :global(.home-chiarezza .griglia-materie>li.con-pulsanti){border-color:#e8e2d7;border-left:3px solid var(--azione);box-shadow:none;background:#fffdf9}
  .scheda-materia{display:flex;flex-direction:column;gap:.55rem;padding:1rem 1.1rem .75rem;flex:1}
  .scheda-materia h3{margin:0;color:var(--inchiostro);font:600 1.05rem/1.35 var(--ui)}
  .scheda-materia p{margin:0;font-size:.95rem;line-height:1.5;color:var(--inchiostro-2);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .conti-materia{font:400 .76rem/1.4 var(--ui);color:var(--inchiostro-2);margin-top:auto}
  :global(.home-chiarezza .pulsanti-scheda){justify-content:flex-start;flex-wrap:wrap;padding:.2rem 1.1rem .3rem;gap:.6rem;border:0;background:none}
  :global(.home-chiarezza .pulsante-scheda){font-size:.85rem;background:none;border:0;border-radius:0;padding:.25rem 0;color:var(--azione);gap:.35rem}
  :global(.home-chiarezza .pulsante-scheda:hover){text-decoration:underline;background:none}
  .accesso-scheda{display:block;font:400 .76rem var(--ui);padding:0 1.1rem 1rem;color:var(--inchiostro-2)}
  .nota-accesso-scheda{display:none}
  :global(html.collegato.home-chiarezza .risorse-home){margin-top:1rem;font-size:.9rem}
  @media(max-width:560px){.catalogo-testa{margin-top:1.5rem}.scheda-materia{padding:.9rem}.accesso-scheda{padding-left:.9rem}:global(.home-chiarezza .pulsanti-scheda){padding-left:.9rem}}
</style>
<script>
  function apriPercorso(hash: string) {
    const gruppo = document.getElementById(hash.slice(1));
    if (!(gruppo instanceof HTMLDetailsElement) || !gruppo.classList.contains('gruppo')) return;
    document.querySelectorAll<HTMLAnchorElement>('.percorsi-home a').forEach((a) => {
      if (a.hash === hash) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
    gruppo.open = true;
    gruppo.scrollIntoView({ block: 'start' });
    gruppo.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
  }
  document.querySelectorAll<HTMLAnchorElement>('.percorsi-home a').forEach((a) => {
    a.addEventListener('click', () => apriPercorso(a.hash));
  });
  addEventListener('hashchange', () => apriPercorso(location.hash));
  if (location.hash) apriPercorso(location.hash);
</script>
