---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import Base from '../layouts/Base.astro';
import Stato from '../components/Stato.astro';
import { materieL, gruppiL, link, T, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const MATERIE = materieL(lingua);
---
<Base titolo={t.nomeSito} descrizione={SEO(lingua).homeDescr} lingua={lingua} seo={{ titolo: SEO(lingua).home, schema: [{
  '@type': 'WebSite', '@id': `${SITO}/#sito`, name: t.nomeSito, url: assoluto(link(lingua, '/')), inLanguage: lingua,
  publisher: { '@id': `${SITO}/#organizzazione` },
  potentialAction: { '@type': 'SearchAction', target: `${assoluto(link(lingua, '/cerca'))}?q={q}`, 'query-input': 'required name=q' },
}] }}>
  <p class="sopratitolo">{t.homeSopra}</p>
  <h1>{t.homeTitolo}</h1>
  <p class="sommario">{t.homeSommario}</p>
  <form class="cerca-home" action={link(lingua, '/cerca')} role="search">
    <div class="con-lente"><svg class="lente" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
    <input type="search" name="q" placeholder={t.cercaSegnaposto} aria-label={t.cercaNelSito} autocomplete="off" />
    </div>
    <button type="submit">{t.cerca}</button>
  </form>
  <p class="nota-anteprima"><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1.8 10S4.8 4.5 10 4.5 18.2 10 18.2 10 15.2 15.5 10 15.5 1.8 10 1.8 10Z"/><circle cx="10" cy="10" r="2.5"/></svg>{t.homeAnteprima}</p>
  {gruppiL(lingua).map((g) => (
    <section class="gruppo">
      <h2 class="nome-gruppo">{g}</h2>
      <ul class="griglia-materie">
        {MATERIE.filter((m) => m.gruppo === g).map((m) => (
          <li class:list={{ 'in-preparazione': !m.attiva }} style={`--accento: ${m.colore}`} data-materia={m.slug}>
            {m.attiva ? (
              <a href={link(lingua, `/${m.slug}`)}>
                <h3>{m.titolo}</h3>
                <p>{m.descrizione}</p>
                <span class="piede-scheda"><Stato prezzo={m.prezzo} lingua={lingua} /></span>
              </a>
            ) : (
              <div>
                <h3>{m.titolo}</h3>
                <p>{m.descrizione}</p>
                <span class="conteggio">{t.inPreparazione}</span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
