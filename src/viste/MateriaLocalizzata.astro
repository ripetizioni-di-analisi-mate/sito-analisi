---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { link, T } from '../i18n';
import { lingueLocalizzate, type LinguaCatalogo } from '../lib/lingue-sito';
import type { Materia } from '../data/materie';
import { catalogoDomande } from '../lib/domande';

interface Props { m: Materia; lingua: LinguaCatalogo }
const { m, lingua } = Astro.props;
const t = T(lingua);
const testo = lingua === 'es' ? {
  quiz: 'Preguntas con tiempo', nota: 'Junto a cada recurso se indica en qué idiomas puedes consultarlo.',
  acquisto: (prezzo: number) => `Acceso completo por ${prezzo} € (compra en italiano)`,
  lingue: { de: 'Alemán', es: 'Español', it: 'Italiano', en: 'Inglés' },
  etichetta: (titolo: string, nome: string) => `${titolo} en ${nome.toLowerCase()}`,
} : {
  quiz: 'Quiz mit Zeitlimit', nota: 'Bei jedem Thema siehst du, in welcher Sprache die Lernmaterialien verfügbar sind.',
  acquisto: (prezzo: number) => `Vollzugang für ${prezzo} € (Kauf auf Italienisch)`,
  lingue: { de: 'Deutsch', es: 'Spanisch', it: 'Italienisch', en: 'Englisch' },
  etichetta: (titolo: string, nome: string) => `${titolo} auf ${nome}`,
};
const [teoria, teoriaEn, svolti, svoltiEn, dafare, dafareEn, quiz, quizEn] = await Promise.all([
  getCollection('teoria'), getCollection('teoria_en'),
  getCollection('svolti'), getCollection('svolti_en'),
  getCollection('dafare'), getCollection('dafare_en'),
  catalogoDomande('it'), catalogoDomande('en'),
]);
const presenti = (lista: { id: string }[], id: string) => lista.filter((v) => v.id.startsWith(`${id}/`));
const completi = (it: { id: string }[], en: { id: string }[]) => it.length > 0 && it.every((v) => en.some((x) => x.id === v.id));
const risorsa = (id: string, sezione: string, titolo: string, it: boolean, en: boolean) => {
  const path = `/${id}/${sezione}`;
  const lingue = [...lingueLocalizzate(path).sort((a, b) => Number(b === lingua) - Number(a === lingua)),
    ...(it ? ['it' as const] : []), ...(en ? ['en' as const] : [])];
  return { titolo, lingue: lingue.map((codice) => ({
    codice, href: link(codice, path) + (codice === lingua ? '' : `?lingua=${codice}`), nome: testo.lingue[codice],
  })) };
};
const capitoli = m.argomenti.map((a) => {
  const id = `${m.slug}/${a.slug}`;
  const schede = presenti(svolti, id), esercizi = presenti(dafare, id);
  return { ...a, risorse: [
    risorsa(id, 'teoria', t.sezioni.teoria, teoria.some((x) => x.id === id), teoriaEn.some((x) => x.id === id)),
    risorsa(id, 'esercizi-svolti', t.sezioni['esercizi-svolti'], schede.length > 0, completi(schede, presenti(svoltiEn, id))),
    risorsa(id, 'esercizi', t.sezioni.esercizi, m.eserciziDaFare !== false && esercizi.length > 0, m.eserciziDaFare !== false && completi(esercizi, presenti(dafareEn, id))),
    risorsa(id, 'domande', testo.quiz, quiz[m.slug]?.includes(a.slug), quizEn[m.slug]?.includes(a.slug)),
  ].filter((r) => r.lingue.length) };
});
---
<Base titolo={m.titolo} descrizione={m.descrizione} lingua={lingua} sezione="catalogo" materia={m.slug} seo={{ titolo: `${m.titolo} | ${t.nomeSito}` }}>
  <p class="sopratitolo">{m.gruppo}</p>
  <h1>{m.titolo}</h1>
  <p class="sommario">{m.descrizione}</p>
  <p class="nota-accesso">{testo.nota}</p>
  {m.prezzo
    ? <p><a class="bottone-secondario" href={link('it', `/${m.slug}/sblocca`) + '?lingua=it'} hreflang="it">{testo.acquisto(m.prezzo)}</a></p>
    : <p class="nota-accesso">{t.tuttoGratis}</p>}
  <h2>{t.programma}</h2>
  <ol class="elenco-esercizi capitoli-localizzati">
    {capitoli.map((a) => <li id={a.slug}>
      <h3>{a.titolo}</h3>
      {a.risorse.length > 0
        ? <ul>{a.risorse.map((r) => <li>
          <strong>{r.titolo}</strong>
          {r.lingue.map(({ codice, href, nome }) => <a href={href} hreflang={codice} aria-label={testo.etichetta(r.titolo, nome)}>{nome}</a>)}
        </li>)}</ul>
        : <p>{t.inPreparazione}</p>}
    </li>)}
  </ol>
</Base>

<style>
  .capitoli-localizzati > li { padding: .85rem 0; border-bottom: 1px solid var(--riga); scroll-margin-top: 6rem; }
  .capitoli-localizzati h3 { margin: 0 0 .35rem; }
  .capitoli-localizzati ul { list-style: none; padding: 0; margin: 0; }
  .capitoli-localizzati ul li { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .9rem; }
  .capitoli-localizzati ul li a { display: inline; padding: .15rem 0; color: var(--azione); text-decoration: underline; }
  .capitoli-localizzati ul li strong { font-weight: 600; }
</style>
