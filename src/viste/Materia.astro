---
import { MATERIE_COMPATIBILITA } from '../data/compatibilita';
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NotaSemestreFiltro from '../components/NotaSemestreFiltro.astro';
import { materiaL, sezioniL, link, vociL, T, type Lingua } from '../i18n';
import { materia as materiaIt } from '../data/materie';
interface Props { lingua: Lingua; materia: string }
const { lingua, materia } = Astro.props;
const t = T(lingua);
const m = materiaL(lingua, materia);
const SEZIONI = sezioniL(lingua);
// Sopratitolo per tipo di materia: l'esame per l'università, il programma per le superiori, il concorso per i concorsi.
const gruppo = materiaIt(materia).gruppo;
const sopra = !m.prezzo ? t.programma : gruppo === 'Concorsi' ? t.argomentiConcorso : gruppo === 'Superiori' ? t.programma : t.argomentiEsame;
const teorie = new Set((await getCollection('teoria')).map((v) => v.id));
// Riassunto di ogni argomento: la pagina è il programma del corso, non la copia dell'indice.
const riassunti = Object.fromEntries((await vociL(lingua, 'teoria')).map((v) => [v.id, v.data.sommario]));
const svolti = await getCollection('svolti');
const dafare = await getCollection('dafare');
// Domande a tempo: quante per argomento.
const domande = await getCollection(lingua === 'en' ? 'domande_en' : 'domande');
const conta = (lista: { id: string }[], a: string) => lista.filter((v) => v.id.startsWith(`${materia}/${a}/`)).length;
const domandeMateria = domande.filter((v) => v.id.startsWith(`${materia}/`)).length;
import { RIPASSO, RIPASSO_OGGI } from '../data/livelli';
import { risultatoDi } from '../lib/risposte';
// Progressi (con l'account): esercizi da fare con la verifica della risposta, per argomento.
const verificabili = (a: string) => dafare.filter((v) => v.id.startsWith(`${materia}/${a}/`) && risultatoDi(v)).length;
const en = lingua === 'en';
const semestreFiltro = materia === 'fisica-semestre-filtro';
const nomeRipasso = semestreFiltro ? (en ? 'Practice and review' : 'Allenamento e ripasso') : (en ? 'Exam practice' : 'Prove d\'esame');
const nomeCompito = semestreFiltro ? (en ? 'Exercise practice' : 'Allenamento con esercizi') : (en ? 'Exam simulation' : m.gruppo === 'Concorsi' ? 'Simulazione della prova' : 'Simulazione d\'esame');
// Indice analitico (teoremi e definizioni) della materia.
import { indiceAnalitico } from '../lib/indice-analitico';
const indice = await indiceAnalitico(lingua, materia, m.argomenti.map((a) => a.slug));
const nTeoremi = indice.reduce((n, a) => n + a.voci.filter((v) => v.tipo !== 'definizione').length, 0);
const nDefinizioni = indice.reduce((n, a) => n + a.voci.filter((v) => v.tipo === 'definizione').length, 0);
// Videocorso proprio della materia (solo in italiano, stessa regola della home): rimando nel riquadro dell'accesso attivo,
// nascosto a chi ha già il videocorso, da solo o nel pacchetto.
import { VIDEOCORSI, chiaveVideo } from '../data/videocorsi';
const video = lingua === 'it' ? VIDEOCORSI.find((v) => !v.pacchettoDi && v.sblocca[0] === materia) : undefined;
const giaVideo = video ? [video.slug, ...VIDEOCORSI.filter((p) => p.pacchettoDi?.includes(video.slug)).map((p) => p.slug)]
  .map((s) => `html[data-materie~="${chiaveVideo(s)}"] .rimando-videocorso{display:none}`).join('') : '';
---
<Base titolo={sopra} descrizione={SEO(lingua).materiaDescr(m.titolo, m.descrizione, m.argomenti.length)} materia={materia} lingua={lingua} seo={{ titolo: SEO(lingua).materia(m.titolo), schema: [{
  '@type': 'Course', '@id': `${assoluto(link(lingua, `/${m.slug}`))}#corso`, name: m.titolo, description: m.descrizione,
  url: assoluto(link(lingua, `/${m.slug}`)), inLanguage: lingua, educationalLevel: SEO(lingua).livello,
  provider: { '@id': `${SITO}/#organizzazione` },
  syllabusSections: m.argomenti.map((a) => ({ '@type': 'Syllabus', name: a.titolo, url: assoluto(link(lingua, `/${m.slug}/${a.slug}/teoria`)) })),
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'Online', courseWorkload: 'P30D' },
  ...(m.prezzo ? { offers: { '@type': 'Offer', category: 'Paid', price: m.prezzo, priceCurrency: 'EUR', availability: 'https://schema.org/InStock', url: assoluto(link(lingua, `/${m.slug}/sblocca`)) }, isAccessibleForFree: false } : { isAccessibleForFree: true }),
}] }}>
  {giaVideo && <style is:inline set:html={giaVideo}></style>}
  <p class="sopratitolo">{sopra}</p>
  <h1>{m.titolo}</h1>
  <p class="sommario">{m.descrizione}</p>
  {semestreFiltro && <NotaSemestreFiltro lingua={lingua} />}
  {m.prezzo && (
    <div class="riquadro-stato" data-materia={m.slug}>
      <div class="stato-sbloccata">
        <span class="pillola" title={t.accessoAttivoTesto(m.titolo)}><svg class="icona" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9.5" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><strong>{t.accessoAttivo}</strong></span>
        {video && <a class="rimando-videocorso" href={`/videocorsi/${video.slug}`}>Se ti serve anche il videocorso →</a>}
      </div>
      <div class="stato-bloccata">
        <svg class="icona" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20S10 9 20 9s16 11 16 11-6 11-16 11S4 20 4 20Z"/><circle cx="20" cy="20" r="5"/></svg>
        <div class="testo"><strong>{t.anteprima}</strong><span>{t.anteprimaTesto}</span></div>
        <div class="azioni-anteprima">
          <a class="bottone-sblocca" href={link(lingua, `/${materia}/${m.argomenti[0].slug}/teoria`)}>{t.iniziaAnteprima} →</a>
          <a class="link-sblocca" href={link(lingua, `/${m.slug}/sblocca`)}>{t.sbloccaTutto} · {m.prezzo} €</a>
          {/* «Compatibilità con il tuo esame» (versione A scelta da Carmine il 04/11) */}
          {lingua === 'it' && MATERIE_COMPATIBILITA.includes(materia) && <a class="link-sblocca" href={`/compatibilita?materia=${materia}`}>Il materiale copre il tuo esame? Controllalo</a>}
        </div>
      </div>
    </div>
  )}
  {!m.prezzo && (
    <div class="riquadro-stato">
      <div class="stato-bloccata">
        <svg class="icona" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11c-3.5-2.6-8.5-3.4-14-2.6v21c5.5-.8 10.5 0 14 2.6 3.5-2.6 8.5-3.4 14-2.6v-21c-5.5-.8-10.5 0-14 2.6z"/><path d="M20 11v21"/></svg>
        <div class="testo"><strong>{t.tuttoGratis}</strong><span>{t.tuttoGratisTesto}</span></div>
        <div class="azioni-anteprima">
          <a class="bottone-sblocca" href={link(lingua, `/${materia}/${m.argomenti[0].slug}/teoria`)}>{t.iniziaPrimo} →</a>
        </div>
      </div>
    </div>
  )}
  <div class="esame-materia solo-collegati" data-materia={materia} data-titolo={m.titolo} hidden>
    <div class="esame-icona" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="9" width="28" height="25" rx="4"/><path d="M6 17h28M13 5v7M27 5v7"/></svg>
    </div>
    <div class="esame-corpo">
      <strong class="esame-titolo">{en ? 'Exam date' : 'Data dell\'esame'}</strong>
      <span class="esame-testo" hidden></span>
      <div class="esame-modulo" hidden>
        <select class="esame-g" aria-label={en ? 'Day' : 'Giorno'}></select>
        <select class="esame-m" aria-label={en ? 'Month' : 'Mese'}></select>
        <select class="esame-a" aria-label={en ? 'Year' : 'Anno'}></select>
        <span class="esame-azioni"><button type="button" class="esame-salva">{en ? 'Save' : 'Salva'}</button>
        <button type="button" class="esame-annulla" hidden>{en ? 'Cancel' : 'Annulla'}</button>
        <button type="button" class="esame-togli" hidden>{en ? 'Remove date' : 'Togli la data'}</button></span>
        <span class="esame-errore" hidden>{en ? 'This date does not exist.' : 'Questa data non esiste.'}</span>
      </div>
    </div>
    <button type="button" class="esame-apri">{en ? 'Add' : 'Aggiungi'}</button>
    <button type="button" class="esame-modifica" hidden>{en ? 'Change' : 'Cambia'}</button>
  </div>
  <ol class="griglia-argomenti">
    {m.argomenti.map((a) => {
      const pronto = teorie.has(`${materia}/${a.slug}`);
      const ns = conta(svolti, a.slug), nd = conta(dafare, a.slug);
      return (
        <li class:list={{ 'in-preparazione': !pronto }}>
          <h2>{pronto ? <a href={link(lingua, `/${materia}/${a.slug}/teoria`)}>{a.titolo}</a> : a.titolo}</h2>
          {pronto && riassunti[`${materia}/${a.slug}`] && <p class="riassunto">{riassunti[`${materia}/${a.slug}`]}</p>}
          {pronto ? (
            <nav aria-label={a.titolo}>
              {SEZIONI.map((s) => <a href={link(lingua, `/${materia}/${a.slug}/${s.slug}`)}>{s.titolo}{s.slug === 'esercizi-svolti' && ns ? ` (${ns})` : ''}{s.slug === 'esercizi' && nd ? ` (${nd})` : ''}</a>)}
              {conta(domande, a.slug) > 0 && <a href={link(lingua, `/${materia}/${a.slug}/domande`)}>{lingua === 'en' ? 'Timed questions' : 'Domande a tempo'} ({conta(domande, a.slug)})</a>}
            </nav>
            <div class="progresso-argomento" data-argomento={a.slug} data-schede={ns} data-verificabili={verificabili(a.slug)} data-domande={conta(domande, a.slug)} hidden>
              <span class="progresso-barra" aria-hidden="true"><i></i></span>
              <span class="progresso-testo"></span>
            </div>
          ) : (
            <span class="conteggio">{t.inPreparazione}</span>
          )}
        </li>
      );
    })}
    {domandeMateria > 0 && (
      <li>
        <h2><a href={link(lingua, `/${materia}/${RIPASSO}/domande`)}>{nomeRipasso}</a></h2>
        <p class="riassunto">{semestreFiltro ? (en ? 'Review questions across all units, timed exercise practice and, with an account, review of questions answered incorrectly. These independent exercises do not reproduce the official exam format.' : 'Domande di ripasso su tutte le unità, compiti di allenamento a tempo e, con l’account, ripasso delle domande sbagliate. Queste esercitazioni indipendenti non riproducono il formato della prova ufficiale.') : lingua === 'en' ? `Review questions on all the topics of ${m.titolo}, a timed exam simulation built from the exercises of the different topics and, with the account, the review of the questions answered wrongly.` : m.gruppo === 'Concorsi' ? `Domande di ripasso su tutti gli argomenti di ${m.titolo}, una simulazione della prova a quiz corretta in automatico e, con l'account, il ripasso delle domande sbagliate.` : `Domande di ripasso su tutti gli argomenti di ${m.titolo}, una simulazione d'esame a tempo con esercizi di argomenti diversi e, con l'account, il ripasso delle domande sbagliate.`}</p>
        <nav aria-label={nomeRipasso}>
          <a href={link(lingua, `/${materia}/${RIPASSO}/domande`)}>{lingua === 'en' ? 'Review questions' : 'Domande di ripasso'} ({domandeMateria})</a>
          <a href={link(lingua, `/${materia}/simulazione`)}>{nomeCompito}</a>
          <a class="solo-collegati" href={link(lingua, `/${materia}/${RIPASSO_OGGI}/domande`)}>{lingua === 'en' ? 'Today’s review' : 'Il tuo ripasso di oggi'}<span class="conta-ripasso" data-materia={materia}></span></a>
        </nav>
      </li>
    )}
    {indice.length > 0 && (
      <li>
        <h2><a href={link(lingua, `/${materia}/teoremi`)}>{en ? 'Definitions and theorems' : 'Teoremi e definizioni'}</a></h2>
        <p class="riassunto">{en ? `The list of all the definitions and theorems of ${m.titolo}, topic by topic, each linked to its box in the theory.` : `L'elenco di tutte le definizioni e di tutti i teoremi di ${m.titolo}, argomento per argomento, con il collegamento al riquadro della teoria.`}</p>
        <nav aria-label={en ? 'Definitions and theorems' : 'Teoremi e definizioni'}>
          <a href={link(lingua, `/${materia}/teoremi`)}>{en ? `${nTeoremi} theorems · ${nDefinizioni} definitions` : `${nTeoremi} teoremi · ${nDefinizioni} definizioni`}</a>
        </nav>
      </li>
    )}
  </ol>
</Base>

<script is:inline define:vars={{ en }}>
  // Con l'account: progressi di ogni argomento (teoria aperta, schede viste, esercizi verificati, domande indovinate) e data dell'esame.
  (() => {
    if (!document.documentElement.classList.contains('collegato')) return;
    const box = document.querySelector('.esame-materia');
    if (!box) return;
    const materia = box.dataset.materia;
    const $ = (c) => box.querySelector(c);
    const testo = $('.esame-testo'), titolo = $('.esame-titolo'), modulo = $('.esame-modulo');
    const selG = $('.esame-g'), selM = $('.esame-m'), selA = $('.esame-a'), errore = $('.esame-errore');
    const apri = $('.esame-apri'), modifica = $('.esame-modifica'), annulla = $('.esame-annulla'), togli = $('.esame-togli'), salva = $('.esame-salva');
    const lingua = en ? 'en-GB' : 'it-IT';
    const oggi = new Date();
    const opzione = (sel, v, t) => { const o = document.createElement('option'); o.value = v; o.textContent = t; sel.append(o); };
    for (let g = 1; g <= 31; g++) opzione(selG, g, g);
    for (let m = 0; m < 12; m++) opzione(selM, m + 1, new Date(2026, m, 15).toLocaleDateString(lingua, { month: 'long' }));
    for (let a = oggi.getFullYear(); a <= oggi.getFullYear() + 2; a++) opzione(selA, a, a);
    let attuale = null;
    const metti = (data) => {
      const d = data ? new Date(data + 'T12:00:00') : new Date(oggi.getTime() + 30 * 86400000);
      if (!data && !attuale) { selG.value = d.getDate(); selM.value = d.getMonth() + 1; selA.value = d.getFullYear(); return; }
      if (![...selA.options].some((o) => Number(o.value) === d.getFullYear())) opzione(selA, d.getFullYear(), d.getFullYear());
      selG.value = d.getDate(); selM.value = d.getMonth() + 1; selA.value = d.getFullYear();
    };
    const apriModulo = () => {
      modulo.hidden = false; apri.hidden = true; modifica.hidden = true; errore.hidden = true;
      annulla.hidden = false; togli.hidden = !attuale; metti(attuale); selG.focus();
    };
    const mostraEsame = (data) => {
      attuale = data || null;
      box.hidden = false; modulo.hidden = true; errore.hidden = true;
      box.classList.toggle('con-data', Boolean(data));
      apri.hidden = Boolean(data); modifica.hidden = !data;
      if (!data) { titolo.textContent = en ? 'Exam date' : 'Data dell\'esame'; testo.textContent = ''; testo.hidden = true; return; }
      const d = new Date(data + 'T12:00:00');
      const giorni = Math.round((d - new Date(new Date().setHours(12, 0, 0, 0))) / 86400000);
      const quando = d.toLocaleDateString(lingua, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
      titolo.textContent = giorni > 1 ? (en ? `${giorni} days to the exam` : `Mancano ${giorni} giorni all'esame`)
        : giorni === 1 ? (en ? 'Exam tomorrow' : 'L\'esame è domani')
        : giorni === 0 ? (en ? 'Exam today' : 'L\'esame è oggi')
        : (en ? 'Exam date passed' : 'La data dell\'esame è passata');
      testo.textContent = quando; testo.hidden = false;
    };
    const invia = async (data) => {
      salva.disabled = togli.disabled = true;
      const r = await fetch('/api/esame', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ materia, data }) }).catch(() => null);
      salva.disabled = togli.disabled = false;
      if (r && r.ok) mostraEsame(data);
    };
    salva.addEventListener('click', () => {
      const g = Number(selG.value), m = Number(selM.value), a = Number(selA.value);
      const d = new Date(a, m - 1, g);
      const ieri = new Date(); ieri.setHours(0, 0, 0, 0);
      if (d.getDate() !== g) { errore.textContent = en ? 'This date does not exist.' : 'Questa data non esiste.'; errore.hidden = false; return; }
      if (d < ieri) { errore.textContent = en ? 'This date has already passed.' : 'Questa data è già passata.'; errore.hidden = false; return; }
      invia(`${a}-${String(m).padStart(2, '0')}-${String(g).padStart(2, '0')}`);
    });
    togli.addEventListener('click', () => invia(null));
    apri.addEventListener('click', apriModulo);
    modifica.addEventListener('click', apriModulo);
    annulla.addEventListener('click', () => mostraEsame(attuale));
    for (const s of [selG, selM, selA]) s.addEventListener('change', () => { errore.hidden = true; });
    fetch(`/api/progressi?materia=${encodeURIComponent(materia)}`).then((r) => (r.ok ? r.json() : null)).then((d) => {
      if (!d) return;
      mostraEsame(d.esame);
      for (const el of document.querySelectorAll('.progresso-argomento')) {
        const p = d.argomenti[el.dataset.argomento] || { teoria: false, schede: 0, esercizi: 0, domande: 0 };
        const tot = { schede: Number(el.dataset.schede), esercizi: Number(el.dataset.verificabili), domande: Number(el.dataset.domande) };
        const parti = [en ? (p.teoria ? 'Theory read' : 'Theory to read') : (p.teoria ? 'Teoria letta' : 'Teoria da leggere')];
        const quote = [p.teoria ? 1 : 0];
        if (tot.schede) { parti.push(en ? `worked sheets ${Math.min(p.schede, tot.schede)} of ${tot.schede}` : `schede svolte ${Math.min(p.schede, tot.schede)} su ${tot.schede}`); quote.push(Math.min(1, p.schede / tot.schede)); }
        if (tot.esercizi) { parti.push(en ? `exercises checked ${Math.min(p.esercizi, tot.esercizi)} of ${tot.esercizi}` : `esercizi verificati ${Math.min(p.esercizi, tot.esercizi)} su ${tot.esercizi}`); quote.push(Math.min(1, p.esercizi / tot.esercizi)); }
        if (tot.domande) { parti.push(en ? `questions answered correctly ${Math.min(p.domande, tot.domande)} of ${tot.domande}` : `domande indovinate ${Math.min(p.domande, tot.domande)} su ${tot.domande}`); quote.push(Math.min(1, p.domande / tot.domande)); }
        const media = quote.reduce((a, b) => a + b, 0) / quote.length;
        el.querySelector('.progresso-testo').textContent = parti.join(' · ');
        el.querySelector('.progresso-barra i').style.width = `${Math.round(media * 100)}%`;
        el.hidden = false;
      }
    }).catch(() => {});
  })();
</script>

<script is:inline>
  // Con l'account: quante domande ci sono da ripassare oggi in questa materia.
  (() => {
    const el = document.querySelector('.conta-ripasso');
    if (!el || !document.documentElement.classList.contains('collegato')) return;
    fetch('/api/ripasso').then((r) => (r.ok ? r.json() : null)).then((d) => {
      const n = d && (d.oggi || []).find((x) => x.materia === el.dataset.materia)?.n;
      if (n) el.textContent = ` (${n})`;
    }).catch(() => {});
  })();
</script>
