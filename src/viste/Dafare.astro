---
import { originale } from '../lib/canonici';
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto, accesso } from '../lib/seo';
import { getCollection, render } from 'astro:content';
import { dataContenuto } from '../lib/date';
import { titoliAncore } from '../lib/ancore';
import Base from '../layouts/Base.astro';
import { argomentoL, materiaL, link, voceL, T, type Lingua } from '../i18n';
import { numero, perArgomento, vicini, disponibilitaStudio } from '../lib/nav';
import { risultatoDi } from '../lib/risposte';
import VerificaRisposta from '../components/VerificaRisposta.astro';
interface Props { lingua: Lingua; materia: string; argomento: string; n: string }
const { lingua, materia, argomento, n } = Astro.props;
const t = T(lingua);
const id = `${materia}/${argomento}/${n}`;
const eserciziMateria = (await getCollection(lingua === 'es' ? 'dafare_es' : 'dafare')).filter((v) => v.id.startsWith(`${materia}/`));
const fratelli = perArgomento(eserciziMateria, materia, argomento);
const risultato = risultatoDi(fratelli.find((x) => x.id === id));
const i = fratelli.findIndex((x) => x.id === id);
const { voce, tradotta } = await voceL(lingua, 'dafare', id);
const titolo = async (v?: { id: string }) => v && (await voceL(lingua, 'dafare', v.id)).voce.data.titolo;
const [tPrec, tSucc] = [await titolo(fratelli[i - 1]), await titolo(fratelli[i + 1])];
const haAltra = (await voceL(lingua === 'it' ? 'en' : 'it', 'dafare', id)).tradotta;
const arg = argomentoL(lingua, materia, argomento);
const titoloRipetuto = eserciziMateria.filter((v) => v.data.titolo === voce.data.titolo).length > 1;
const titoloSeo = SEO(lingua).dafare(voce.data.titolo, materiaL(lingua, materia).breve, arg.breve, titoloRipetuto ? n : undefined);
const { Content } = await render(voce);
const ancore = titoliAncore((await voceL(lingua, 'teoria', `${materia}/${argomento}`)).voce?.body);
const base = `/${materia}/${argomento}`;
const lista = link(lingua, `${base}/esercizi`);
const passo = (v: { id: string } | undefined, tt?: string) => v && { titolo: `${t.esercizio} ${numero(v.id)}`, sotto: tt, href: link(lingua, `${base}/esercizi/${numero(v.id)}`) };
// Inizio della traccia in testo semplice (senza formule): serve alla descrizione degli esercizi con un titolo generico.
const traccia = (() => {
  const primo = (voce.body ?? '').split(/^:::/m)[0].trim().split(/\n\s*\n/)[0] ?? '';
  return /[$<\\]/.test(primo) ? '' : primo.replace(/[*_`]/g, '').replace(/\s+/g, ' ').trim();
})();
const descrizioneSeo = SEO(lingua).dafareDescr(voce.data.titolo, arg.titolo, materiaL(lingua, materia).titolo, traccia);
const fineEsercizi = vicini(materia, argomento, 'esercizi', lingua, await disponibilitaStudio(materia, argomento, lingua)).successivo;
---
<Base
  titolo={`${arg.breve} · ${t.esercizioDaFare} ${n}`}
  descrizione={descrizioneSeo}
  seo={{ canonico: originale(materia, argomento, 'esercizi', n), titolo: titoloSeo, tipo: 'article', soloQuestaLingua: !haAltra, data: dataContenuto(lingua, 'dafare', id), schema: [{ ...{
  '@type': 'LearningResource', name: voce.data.titolo, description: descrizioneSeo, learningResourceType: 'Exercise', inLanguage: lingua,
  educationalLevel: SEO(lingua).livelloDi(materiaL(lingua, materia).titolo), url: assoluto(Astro.url.pathname),
  isPartOf: { '@type': 'Course', '@id': `${assoluto(link(lingua, `/${materia}`))}#corso`, name: materiaL(lingua, materia).titolo },
  provider: { '@id': `${SITO}/#organizzazione` },
  author: { '@id': `${SITO}/#carmine` },
  ...accesso(!materiaL(lingua, materia).prezzo),
} }] }}
  percorso={[{ titolo: arg.breve, href: link(lingua, `${base}/teoria`) }, { titolo: t.sezioni.esercizi, href: lista }, { titolo: `${t.esercizio} ${n}` }]}
  materia={materia} argomento={argomento} sezione="esercizi"
  precedente={passo(fratelli[i - 1], tPrec) ?? { titolo: t.tuttiDaFare, sotto: arg.breve, href: lista }}
  successivo={passo(fratelli[i + 1], tSucc) ?? fineEsercizi}
  lingua={lingua} nonTradotta={!tradotta}
>
  <p class="sopratitolo">{t.esercizioDaFare} {n}</p>
  <h1>{voce.data.titolo}</h1>
  {voce.data.teoria.length > 0 && (
    <p class="collegamenti">{t.teoriaUsata}: {voce.data.teoria.map((x: string) => <a href={link(lingua, `${base}/teoria#${x}`)}>{ancore[x] ?? x.replace(/-/g, ' ')}</a>)}</p>
  )}
  <div class="testo-studio"><Content /></div>
  <VerificaRisposta id={id} tipo={risultato?.tipo} primitiva={risultato?.primitiva} lingua={lingua} />
</Base>
