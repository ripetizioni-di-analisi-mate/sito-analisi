---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CampoCorso from '../components/CampoCorso.astro';
import ConsensoEmail from '../components/ConsensoEmail.astro';
import { MATERIE_COMPATIBILITA } from '../data/compatibilita';
import { VIDEOCORSI } from '../data/videocorsi';
import { SCONTO_INVITO } from '../data/inviti';
import { SCONTO_BENVENUTO } from '../data/benvenuto';
import { materiaL, link, testiJs, T, prefisso, type Lingua } from '../i18n';
import { materiaUsa } from '../data/stem-usa/catalog-view';
import { courseUrl } from '../data/stem-usa/catalog.mjs';
import { usContentCounts } from '../lib/stem-usa-banks';
import { url } from '../lib/url';
interface Props { lingua: Lingua; materia: string; usa?: boolean }
const { lingua, materia, usa = false } = Astro.props;
const t = T(lingua);
const m = usa ? materiaUsa(materia)! : materiaL(lingua, materia);
const usCounts = usa ? usContentCounts(materia, m.argomenti.length) : undefined;
const svolti = usCounts?.worked ?? (await getCollection('svolti')).filter((v) => v.id.startsWith(`${materia}/`)).length;
const dafare = usCounts?.exercises ?? (await getCollection('dafare')).filter((v) => v.id.startsWith(`${materia}/`)).length;
const scienza = materia === 'scienza-delle-costruzioni';
const domande = scienza ? (await getCollection('domande')).filter((v) => v.id.startsWith(`${materia}/`)).length : 0;
const en = lingua === 'en';
const js = testiJs(lingua);
const pref = prefisso(lingua);
const hrefMateria = usa ? url(courseUrl(materia)) : link(lingua, '/' + materia);

// «Compatibilità con il tuo esame» prima dell'acquisto: link sotto il tasto, solo materie universitarie e in italiano.
const conCompat = lingua === 'it' && MATERIE_COMPATIBILITA.includes(materia);
const compat = conCompat ? `/compatibilita?materia=${materia}` : '';
const video = lingua === 'it' ? VIDEOCORSI.filter((v) => v.sblocca.includes(materia)) : [];
// «Invita un amico»: righe sullo sconto, mostrate dallo script solo a chi ne ha diritto.
const invito = lingua === 'en' ? {
  ospite: `You were invited by a friend: your first subject is ${SCONTO_INVITO}% off. The discount is applied at checkout, once your account is created.`,
  amico: `You were invited by a friend: this purchase is ${SCONTO_INVITO}% off. The discount is applied at checkout.`,
  premio: `A friend you invited unlocked a subject: this purchase is ${SCONTO_INVITO}% off. The discount is applied at checkout.`,
  benvenuto: `Welcome discount: this purchase is ${SCONTO_BENVENUTO}% off. The discount is applied at checkout.`,
} : {
  ospite: `Sei arrivato con l'invito di un amico: sul primo acquisto di una materia hai il ${SCONTO_INVITO}% di sconto, applicato al pagamento dopo la creazione dell'account.`,
  amico: `Sei arrivato con l'invito di un amico: su questo acquisto hai il ${SCONTO_INVITO}% di sconto, applicato al pagamento.`,
  premio: `Una persona che hai invitato ha sbloccato una materia: su questo acquisto hai il ${SCONTO_INVITO}% di sconto, applicato al pagamento.`,
  benvenuto: `Sconto di benvenuto: su questo acquisto hai il ${SCONTO_BENVENUTO}% di sconto, applicato al pagamento.`,
};
---
<Base titolo={t.sbloccaTitolo(m.titolo)} descrizione={t.sbloccaDescrizione(m.titolo)} materia={materia} percorso={[{ titolo: t.sblocca }]} lingua={lingua} usa={usa} seo={{ titolo: t.sbloccaSeo(m.titolo) }}>
  <p class="sopratitolo">{m.titolo}</p>
  <h1>{t.sbloccaTitolo(m.titolo)}</h1>
  <p class="sommario">{t.sbloccaSommario}</p>
  <ul class="cosa-include">
    {usa ? <li><strong>Lessons for all {m.argomenti.length} topics</strong></li> : <li set:html={t.includeTeoria(m.argomenti.length)} />}
    {usa ? <li><strong>{svolti} worked examples</strong> with solutions</li> : <li set:html={t.includeSvolti(svolti)} />}
    {usa ? <>
      {dafare > 0 && <li><strong>{dafare} practice exercises</strong> with solutions</li>}
      {usCounts!.timed > 0 && <li><strong>{usCounts!.timed} timed questions</strong> with explanations</li>}
      {usCounts!.review > 0 && <li><strong>{usCounts!.review} review questions</strong> with explanations</li>}
    </> : scienza ? <li><strong>{domande} {en ? 'timed questions' : 'domande a tempo'}</strong> {en ? 'in Italian, with explanations and review across all topics' : 'con spiegazione e ripasso su tutti gli argomenti'}</li> : <li set:html={t.includeSoluzioni(dafare)} />}
  </ul>
  {!usa && <p class="gratis-ora">{scienza ? (en
    ? 'Free preview without an account. Read the beginning of each topic, open one sheet of worked examples and try one question per topic.'
    : 'Senza account puoi leggere l’inizio di ogni argomento, consultare una scheda svolta e provare una domanda per argomento.') : t.gratisOra}</p>}
  {video.length > 0 && (
    <p class="anche-nel-video">Questa materia è inclusa anche {video.length > 1 ? 'nei videocorsi' : 'nel videocorso'} {video.map((v, i) => <>{i > 0 && (i === video.length - 1 ? ' e ' : ', ')}<a href={`/videocorsi/${v.slug}`}>{v.titolo.replace('Videocorso di ', '')}</a> ({v.lezioni} lezioni, {v.prezzo} €)</>)}: chi compra il videocorso la trova già sbloccata.</p>
  )}
  <a class="autore-acquisto" href={link(lingua, '/chi-sono')}>
    <img src="/chi-sono/carmine-320.webp" width="320" height="320" alt="" />
    <span>{lingua === 'it'
      ? <>Il materiale è dell'<b>Ing. Carmine Tornincasa</b>, che ha seguito oltre mille studenti in più di diecimila ore di lezione.</>
      : <>The material is by <b>Carmine Tornincasa</b>, a civil engineer who has taught more than a thousand students over more than ten thousand hours.</>}</span>
  </a>
  <div class="riquadro-acquisto">
    <p class="prezzo"><strong>{m.prezzo} €</strong> <span>{t.unaVoltaSola}</span></p>
    <p class="nota-invito" id="nota-invito" hidden></p>
    <div id="azione"><p class="esito-modulo">{t.unMomento}</p></div>
    <form class="modulo modulo-acquisto" id="modulo-acquisto" novalidate hidden>
      <label>{t.nome}<input type="text" name="nome" autocomplete="given-name" maxlength="40" /></label>
      <label>Email<input type="email" name="email" autocomplete="email" required /></label>
      <label>Password<span class="campo-password"><input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder={t.almenoOtto} /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
      {lingua === 'it' && <CampoCorso />}
      <ConsensoEmail lingua={lingua} />
      <p class="esito-modulo" id="esito-acquisto" role="status"></p>
      <button class="bottone-primario" type="submit" id="invia-acquisto">{js.creaEPaga}</button>
      {compat && <a class="tasto-compat" href={compat}><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h6l4 4v14H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v4h4"/><path d="m9.5 14 2 2 4-4"/></svg><span>Controlla la compatibilità con il tuo esame</span></a>}
      <p class="nota-accesso">{js.haiAccount} <a id="link-accedi" href={`${pref}/accedi`}>{js.accedi}</a></p>
    </form>
    <p class="nota-termini-breve">{lingua === 'it' ? <>Acquistando accetti i <a href="/termini">termini d’uso</a>.</> : <>By purchasing you accept the <a href="/en/termini">terms of use</a>.</>}</p>
  </div>

  <script is:inline define:vars={{ materia, titolo: m.titolo, js, pref, lingua, invito, compat, usa, hrefMateria }}>
    (async () => {
      const f = (s, x) => s.replace('§', x);
      const azione = document.getElementById('azione');
      const modulo = document.getElementById('modulo-acquisto');
      const qui = location.pathname;
      const [rIo, rConf] = await Promise.all([fetch('/api/io').catch(() => null), fetch('/api/config').catch(() => null)]);
      let io = rIo && rIo.ok ? await rIo.json() : null;
      const attivo = Boolean(rConf?.ok && (await rConf.json()).stripe);
      const paga = () => { location.assign(pref + '/acquisto?' + new URLSearchParams({ tipo: 'materia', slug: materia })); };
      // «Invita un amico»: riga sullo sconto (cookie dell'invito per gli ospiti, stato dell'account per gli iscritti).
      const notaInvito = document.getElementById('nota-invito');
      const mostraInvito = (testo) => { notaInvito.textContent = testo; notaInvito.hidden = !testo; };
      const notaOfferta = async () => {
        const r = await fetch('/api/email/offerta?' + new URLSearchParams({ materia })).catch(() => null);
        const d = r?.ok ? await r.json() : {};
        if (!d.percentuale) return '';
        return lingua === 'en'
          ? `Your personal ${d.percentuale}% discount on ${titolo} applies at checkout.`
          : `La tua offerta riservata del ${d.percentuale}% su ${titolo} si applica al pagamento.`;
      };
      // senza sconto dell'invito, lo sconto di benvenuto di chi ha creato l'account dalla barra in basso
      const notaBenvenuto = async () => {
        const r = await fetch('/api/benvenuto').catch(() => null);
        const d = r && r.ok ? await r.json() : {};
        return d.percentuale ? invito.benvenuto : '';
      };
      const aggiornaInvito = async () => {
        if (usa) return;
        if (!io) { mostraInvito(/(?:^|;\s*)invito=[A-Z0-9]{7}/.test(document.cookie) ? invito.ospite : ''); return; }
        if (io.materie.includes(materia)) { mostraInvito(''); return; }
        const offerta = await notaOfferta();
        if (offerta) { mostraInvito(offerta); return; }
        const r = await fetch('/api/invito').catch(() => null);
        const d = r && r.ok ? await r.json() : null;
        const testo = d && d.attivo ? (d.scontoAmico ? invito.amico : d.premiDisponibili > 0 ? invito.premio : '') : '';
        mostraInvito(testo || await notaBenvenuto());
      };
      aggiornaInvito().catch(() => {});
      // Stato per chi ha già un account: materia già sbloccata, pagamento non attivo, tasto di acquisto.
      const mostraAccount = (premessa = '') => {
        modulo.hidden = true;
        azione.hidden = false;
        if (io.materie.includes(materia)) {
          azione.innerHTML = `<p class="stato-ok">${f(js.giaSbloccata, titolo)}</p><a class="bottone-primario" href="${hrefMateria}">${js.vaiArgomenti}</a>`;
          return false;
        }
        if (!attivo) {
          azione.textContent = lingua === 'en' ? 'Payment is temporarily unavailable. Please try again shortly.' : 'Il pagamento è temporaneamente indisponibile. Riprova tra poco.';
          return false;
        }
        azione.innerHTML = `${premessa}<button type="button" class="bottone-primario" id="compra">${js.sbloccaOra}</button>
          ${compat ? `<a class="tasto-compat" href="${compat}"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h6l4 4v14H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M14 3v4h4"/><path d="m9.5 14 2 2 4-4"/></svg><span>Controlla la compatibilità con il tuo esame</span></a>` : ''}
          <p class="nota-accesso"><span data-account></span></p>`;
        azione.querySelector('[data-account]').textContent = f(js.acquistoCollegato, io.email);
        document.getElementById('compra').addEventListener('click', paga);
        return true;
      };
      if (io) { mostraAccount(); return; }

      // Un prezzo non configurato non deve invitare l'ospite a creare un account per pagare.
      if (!attivo) {
        modulo.hidden = true;
        azione.hidden = false;
        azione.innerHTML = `<p>${usa ? 'Purchasing this subject is temporarily unavailable.' : lingua === 'en'
          ? 'Purchasing this subject is not available yet. You can explore the free preview and practise with the timed questions.'
          : 'L’acquisto di questa materia non è ancora disponibile. Puoi consultare l’anteprima gratuita e allenarti con le domande a tempo.'}</p><a class="bottone-primario" href="${hrefMateria}">${usa ? 'View course topics' : lingua === 'en' ? 'Explore the free preview' : 'Esplora l’anteprima gratuita'}</a>`;
        return;
      }

      // Ospite: iscrizione dentro il riquadro del prezzo; dopo l'iscrizione si apre subito il pagamento.
      azione.hidden = true;
      modulo.hidden = false;
      document.getElementById('link-accedi').href = `${pref}/accedi?dopo=${encodeURIComponent(qui)}`;
      const esito = document.getElementById('esito-acquisto');
      const invia = document.getElementById('invia-acquisto');
      const excorso = document.getElementById('excorso');
      const preregistrato = document.getElementById('preregistrato');
      const exStudente = () => Boolean((excorso && excorso.checked) || (preregistrato && preregistrato.checked));
      const aggiornaCorso = () => {
        document.getElementById('dettagli-corso').hidden = !excorso.checked;
        document.getElementById('dettagli-preregistrato').hidden = !preregistrato.checked;
        document.getElementById('nota-corso').hidden = !exStudente();
        invia.textContent = exStudente() ? js.creaAccount : js.creaEPaga;
      };
      if (excorso) { excorso.addEventListener('change', aggiornaCorso); preregistrato.addEventListener('change', aggiornaCorso); }
      const scelti = (nome) => [...modulo.querySelectorAll(`input[name="${nome}"]:checked`)].map((x) => x.value).join(', ');
      const corsoSeguito = () => {
        if (!excorso) return '';
        const parti = [];
        if (excorso.checked) parti.push('Corso dal vivo: ' + [scelti('corso'), modulo.corsonote.value.trim()].filter(Boolean).join(' · '));
        if (preregistrato.checked) parti.push('Preregistrato: ' + scelti('corsopre'));
        return parti.join('; ');
      };

      modulo.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = modulo.email.value.trim().toLowerCase();
        const password = modulo.password.value;
        const errore = (t) => { esito.textContent = t; esito.className = 'esito-modulo errore'; };
        if (!modulo.nome.value.trim()) return errore(js.nomeMancante);
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return errore(js.emailNonValida);
        if (password.length < 8) return errore(js.passwordCorta);
        if (excorso && excorso.checked && !modulo.querySelector('input[name="corso"]:checked') && !modulo.corsonote.value.trim()) return errore('Indica quale corso, oppure togli la spunta.');
        if (preregistrato && preregistrato.checked && !scelti('corsopre')) return errore('Indica quale corso preregistrato hai acquistato, oppure togli la spunta.');
        invia.disabled = true; esito.textContent = '…'; esito.className = 'esito-modulo';
        try {
          const r = await fetch('/api/registrati', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, password, nome: modulo.nome.value.trim(), corso: corsoSeguito(), lingua: pref ? 'en' : 'it',
              offerte: modulo.offerte.checked, materiaEmail: materia }),
          });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) { invia.disabled = false; return errore(d.errore || js.erroreGenerico); }
          const rNuovo = await fetch('/api/io').catch(() => null);
          io = rNuovo && rNuovo.ok ? await rNuovo.json() : null;
          if (!io) { location.reload(); return; }
          aggiornaInvito().catch(() => {});
          if (exStudente()) { mostraAccount(`<p class="stato-ok">${js.accountCreatoEx}</p>`); return; }
          if (mostraAccount(`<p class="esito-modulo">${js.aperturaPagamento}</p>`)) paga();
        } catch {
          invia.disabled = false; errore(js.connessione);
        }
      });
    })();
  </script>
</Base>

<style is:global>
  .tasto-compat { display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; box-sizing: border-box; margin: 0.6rem 0 0;
    font-family: var(--ui); font-weight: 600; font-size: 0.95rem; color: var(--azione); background: white; border: 1px solid var(--azione);
    border-radius: 999px; padding: 0.6rem 1.2rem; text-decoration: none; transition: background 0.15s; }
  .tasto-compat:hover { background: #eef5f3; }
  .tasto-compat svg { width: 1.15rem; height: 1.15rem; flex: none; }
  .nota-termini-breve { font-family: var(--ui); font-size: 0.8rem; color: var(--inchiostro-2); margin: 0.9rem 0 0; }
  #azione .tasto-compat { max-width: 22rem; margin: 0.6rem auto 0; }
</style>

