---
// Domande a tempo di un argomento: una alla volta, due minuti ciascuna, spiegazione subito dopo la conferma.
// I testi arrivano dal Worker (/api/domande/…): la risposta corretta non è mai nella pagina.
import Base from '../layouts/Base.astro';
import NotaSemestreFiltro from '../components/NotaSemestreFiltro.astro';
import { argomentoL, materiaL, link, prefisso, type Lingua } from '../i18n';
import { originale } from '../lib/canonici';
import { tutteLeVoci } from '../lib/voci-teoria';
import { raccolteSvolti } from '../lib/raccolte-svolti';
import { DOMANDE_SESSIONE, RIPASSO, RIPASSO_OGGI } from '../data/livelli';
import { BOCCONI } from '../data/bocconi.mjs';
import { nomiAllenamento } from '../lib/allenamento.mjs';
import { catalogoDomande, conteggiDomande } from '../lib/domande';
import { linkArgomentoUsa, materiaUsa } from '../data/stem-usa/catalog-view';
import { courseUrl, usStudyPreviewPage } from '../data/stem-usa/catalog.mjs';
import { url } from '../lib/url';
interface Props { lingua: Lingua; materia: string; argomento: string; totale: number; usa?: boolean }
const { lingua, materia, argomento, totale, usa = false } = Astro.props;
const en = lingua === 'en';
const es = lingua === 'es';
const bocconi = materia === BOCCONI.slug;
const m = usa ? materiaUsa(materia)! : materiaL(lingua, materia);
const quizStatistica = materia === 'statistica'
  ? Object.values((await conteggiDomande('it')).statistica ?? {}).reduce((somma, numero) => somma + numero, 0).toLocaleString(en ? 'en-US' : 'it-IT', { useGrouping: 'always' })
  : '';
const semestreFiltro = materia.endsWith('-semestre-filtro');
const nomiProve = nomiAllenamento(m, lingua);
// Prove d'esame: capitolo finale della materia, con domande di ripasso pescate da tutti gli argomenti.
// Ripasso di oggi: le domande sbagliate dello studente che tornano dopo 1, 3 e 7 giorni (scelte dal Worker).
const personale = argomento === RIPASSO_OGGI;
const ripasso = argomento === RIPASSO || personale;
const argomentiInglesi = !usa && !en ? (await catalogoDomande('en'))[materia] ?? [] : [];
const senzaInglese = !usa && !en && (ripasso ? !argomentiInglesi.length : !argomentiInglesi.includes(argomento));
const anteprimaScienza = materia === 'scienza-delle-costruzioni' && m.prezzo;
const anteprimaUsa = usa && usStudyPreviewPage(materia, argomento + '/domande');
const notaAnteprima = personale
  ? (en ? 'Spaced review is included in full access.' : 'Il ripasso personale è incluso nell’accesso completo.')
  : ripasso
    ? (en ? `Try ${m.argomenti.length} sample questions, one per topic.` : `Puoi provare ${m.argomenti.length} domande gratuite, una per argomento.`)
    : (en ? 'The first question is available in the free preview.' : 'Puoi rispondere gratis alla prima domanda della serie.');
const arg = personale ? { slug: RIPASSO_OGGI, titolo: en ? 'Today’s review' : 'Il tuo ripasso di oggi', breve: en ? 'Today’s review' : 'Ripasso di oggi' }
  : ripasso ? { slug: RIPASSO, titolo: nomiProve.ripasso, breve: nomiProve.ripasso }
  : usa ? m.argomenti.find(a => a.slug === argomento)! : argomentoL(lingua, materia, argomento);
if (semestreFiltro && ripasso && !personale) {
  arg.titolo = en ? 'Review of all units' : 'Ripasso su tutte le unità';
  arg.breve = en ? 'Review' : 'Ripasso';
}
const base = `/${materia}/${argomento}`;
const pref = prefisso(lingua);
const hrefSezione = (sezione: string) => usa ? linkArgomentoUsa(materia, argomento, sezione) : link(lingua, `${base}/${sezione}`);
const tornaAllaMateria = ripasso || m.eserciziDaFare === false;
const hrefMateria = usa ? url(courseUrl(materia)) : link(lingua, '/' + materia);
const hrefSblocca = usa ? url(courseUrl(materia) + '/sblocca') : link(es ? 'it' : lingua, '/' + materia + '/sblocca') + (es ? '?lingua=it' : '');
const hrefRitorno = tornaAllaMateria ? hrefMateria : hrefSezione('esercizi');
const n = Math.min(DOMANDE_SESSIONE, totale);
// Nome breve di ogni argomento, per indicare nel ripasso da quale argomento viene la domanda.
const brevi = Object.fromEntries(m.argomenti.map((a) => [a.slug, a.breve]));
const comeScelte = en
  ? (totale > n ? `${n} multiple-choice questions chosen at random among the ${totale} ${ripasso ? `of all the topics of ${m.titolo}` : 'of this topic'}` : `${totale} multiple-choice questions ${ripasso ? `on all the topics of ${m.titolo}` : 'on this topic'}, in random order`)
  : (totale > n ? `${n} domande a risposta multipla scelte a caso tra le ${totale} ${ripasso ? `di tutti gli argomenti di ${m.titolo}` : 'di questo argomento'}` : `${totale} domande a risposta multipla ${ripasso ? `su tutti gli argomenti di ${m.titolo}` : 'su questo argomento'}, in ordine casuale`);
const T = es ? {
  titolo: 'Preguntas cronometradas', descr: `Preguntas de opción múltiple sobre ${arg.titolo}. Tienes dos minutos por pregunta.`,
  termina: 'Terminar la sesión', sommario: `La sesión incluye ${n} preguntas de opción múltiple en orden aleatorio. Tienes dos minutos para responder a cada una y verás la explicación después.`,
  ospite: 'Puedes responder sin cuenta. Si creas una cuenta gratuita, se guardarán tus puntos y tus avances.', accedi: 'Crear una cuenta o iniciar sesión',
  caricamento: 'Cargando la pregunta…', risposte: 'Respuestas', conferma: 'Confirmar respuesta', prossima: 'Siguiente pregunta', svolti: 'Ejercicios resueltos de este tema', nuovaSerie: 'Nueva serie de preguntas',
  navigazione: 'Preguntas', precedente: '← Anterior', successiva: 'Siguiente →',
  inizia: 'Empezar', avvio: 'El tiempo empieza cuando pulsas «Empezar».',
  anteprima: 'Vista previa gratuita', bloccata: 'Esta pregunta requiere acceso completo al curso.', sblocca: 'Desbloquear el curso',
} : en ? {
  titolo: personale ? 'Spaced review' : ripasso ? 'Review questions' : 'Timed questions', descr: ripasso ? `Review questions on all the topics of ${m.titolo}, two minutes each, with the explanation after every answer.` : `Multiple-choice questions on ${arg.titolo} (${m.titolo}), two minutes each, with the explanation after every answer.`,
  termina: 'End the session', sommario: personale ? `The questions of ${m.titolo} you got wrong come back here one day later; each correct answer given on the scheduled day moves the question further on, to 3 and then 7 days, and after three correct answers it leaves the review.` : `Each session offers ${comeScelte}, one at a time, two minutes each. The explanation appears after every answer.`,
  ospite: (anteprimaScienza || anteprimaUsa) ? 'Experience points and progress are saved with a free account.' : 'You can answer the questions without an account. Experience points, level and goals are saved with a free account.', accedi: 'Create an account or log in',
  caricamento: 'Loading the question…', risposte: 'Answers', conferma: 'Confirm your answer', prossima: 'Next question', svolti: 'Worked examples of this topic', nuovaSerie: 'New set of questions',
  navigazione: 'Questions', precedente: '← Previous', successiva: 'Next →',
  inizia: 'Start', avvio: 'The timer starts when you press Start.',
  anteprima: 'Free preview', bloccata: 'This question requires full access to the course.', sblocca: 'Unlock the course',
} : {
  titolo: personale ? 'Ripasso dilazionato' : ripasso ? 'Domande di ripasso' : 'Domande a tempo', descr: ripasso ? `Domande di ripasso su tutti gli argomenti di ${m.titolo}, con due minuti per ciascuna e la spiegazione dopo ogni risposta.` : `Domande a risposta multipla su ${arg.titolo} (${m.titolo}), con due minuti per ciascuna e la spiegazione dopo ogni risposta.`,
  termina: 'Termina la sessione', sommario: personale ? `Le domande di ${m.titolo} a cui hai risposto in modo sbagliato tornano qui il giorno dopo; ogni risposta corretta data nel giorno previsto sposta la domanda più avanti, a 3 e poi a 7 giorni, e dopo tre risposte corrette la domanda esce dal ripasso.` : `Ogni sessione propone ${comeScelte}, una alla volta, con due minuti per ciascuna. Dopo ogni risposta compare la spiegazione.`,
  ospite: (anteprimaScienza || anteprimaUsa) ? 'I punti esperienza e i progressi si salvano con un account gratuito.' : 'Le domande si possono fare anche senza account. I punti esperienza, il livello e gli obiettivi si salvano con un account gratuito.', accedi: 'Crea un account o accedi',
  caricamento: 'Caricamento della domanda…', risposte: 'Risposte', conferma: 'Conferma la risposta', prossima: 'Domanda successiva', svolti: 'Esercizi svolti di questo argomento', nuovaSerie: 'Nuova serie di domande',
  navigazione: 'Domande', precedente: '← Precedente', successiva: 'Successiva →',
  inizia: 'Inizia', avvio: 'Il tempo parte quando premi «Inizia».',
  anteprima: 'Anteprima gratuita', bloccata: 'Questa domanda è riservata a chi ha acquistato l’accesso completo alla materia.', sblocca: 'Sblocca la materia',
};
// La pagina pubblica descrive il quiz e collega il materiale dello stesso argomento.
const pubblica = !usa && !personale && totale > 0;
const titoloQuiz = ripasso ? T.titolo + ' · ' + m.titolo : arg.titolo + ' · ' + T.titolo;
const numeroPerArgomento = pubblica && ripasso && (lingua === 'it' || en) ? (await conteggiDomande(en ? 'en' : 'it'))[materia] ?? {} : {};
const capitoli = m.argomenti.filter((a) => numeroPerArgomento[a.slug] > 0);
const esempi = pubblica && !ripasso && (lingua === 'it' || lingua === 'en')
  ? (await raccolteSvolti(lingua)).get(materia)?.find((c) => c.slug === argomento)?.schede.slice(0, 3) ?? [] : [];
const voci = pubblica && !ripasso && (lingua === 'it' || lingua === 'en')
  ? ((await tutteLeVoci(lingua)).get(materia + '/' + argomento) ?? []).filter((v) => v.titolo).slice(0, 4) : [];
const canonicoQuiz = pubblica && !ripasso ? originale(materia, argomento, 'domande') : undefined;
// Testi usati dallo script nel browser.
const JS = es ? {
  caricamento: T.caricamento, errore: 'No se han podido cargar las preguntas. Recarga la página.', bonus: 'Quedan § segundos para conseguir puntos extra por rapidez',
  giusta: 'Respuesta correcta', scaduto: 'Se ha agotado el tiempo. La respuesta correcta es §', corretta: 'La respuesta correcta es §',
  veloce: ' (con puntos extra por rapidez)', ripetuta: '. Mitad de puntos porque ya acertaste esta pregunta esta semana',
  tardi: ' fuera de tiempo. No suma puntos', nonArrivata: 'No se ha podido enviar la respuesta. Recarga la página.',
  spiegazione: 'Explicación', conclusa: 'Sesión de estudio completada', minuto: '1 minuto de estudio activo', minuti: '§ minutos de estudio activo', sessioneConclusa: 'Sesión completada',
  unaCorretta: '1 respuesta correcta', piuCorrette: '§ respuestas correctas', su: 'de', righeCorrette: 'Respuestas correctas', righeStudio: 'Estudio activo', totale: 'Total',
  numero: 'Pregunta § de', scaduto2: 'Se ha agotado el tiempo. Puedes responder sin sumar puntos o pasar a otra pregunta.',
  numeroBloccato: 'Pregunta §, requiere acceso completo',
  livello: 'Nivel', massimo: 'Nivel máximo', alLivello: 'para el nivel', obiettivi: 'Objetivos semanales', completato: 'Completado', tornaEsercizi: 'Volver a los ejercicios', tornaMateria: 'Volver al temario', percorso: 'Tu progreso',
} : en ? {
  caricamento: T.caricamento, errore: 'The questions did not load. Reload the page.', bonus: 'Speed bonus for another § seconds',
  giusta: 'Correct answer', scaduto: 'Time is up. The correct answer is §', corretta: 'The correct answer is §',
  veloce: ' (with speed bonus)', ripetuta: ', half points because already answered correctly this week',
  tardi: ', but after the time limit: no points', nonArrivata: 'The answer did not arrive. Reload the page.',
  spiegazione: 'Explanation', conclusa: 'Study session completed', minuto: '1 minute of active study', minuti: '§ minutes of active study', sessioneConclusa: 'Session completed',
  unaCorretta: '1 correct answer', piuCorrette: '§ correct answers', su: 'out of', righeCorrette: 'Correct answers', righeStudio: 'Active study', totale: 'Total',
  numero: 'Question § of', scaduto2: 'Time is up: you can still answer, without points, or move to another question.',
  numeroBloccato: 'Question §, full access required',
  livello: 'Level', massimo: 'Maximum level', alLivello: 'to level', obiettivi: 'Weekly goals', completato: 'Completed', tornaEsercizi: 'Back to the exercises', tornaMateria: 'Back to the topics', percorso: 'Your progress',
} : {
  caricamento: T.caricamento, errore: 'Le domande non si sono caricate. Ricarica la pagina.', bonus: 'Bonus velocità ancora per § secondi',
  giusta: 'Risposta corretta', scaduto: 'Tempo scaduto. La risposta corretta è la §', corretta: 'La risposta corretta è la §',
  veloce: ' (con bonus velocità)', ripetuta: ', metà punti perché già indovinata questa settimana',
  tardi: ', ma oltre il tempo: nessun punto', nonArrivata: 'La risposta non è arrivata. Ricarica la pagina.',
  spiegazione: 'Spiegazione', conclusa: 'Sessione di studio conclusa', minuto: '1 minuto di studio attivo', minuti: '§ minuti di studio attivo', sessioneConclusa: 'Sessione conclusa',
  unaCorretta: '1 risposta corretta', piuCorrette: '§ risposte corrette', su: 'su', righeCorrette: 'Risposte corrette', righeStudio: 'Studio attivo', totale: 'Totale',
  numero: 'Domanda § di', scaduto2: 'Tempo scaduto: puoi ancora rispondere, senza punti, oppure passare a un\'altra domanda.',
  numeroBloccato: 'Domanda §, accesso completo richiesto',
  livello: 'Livello', massimo: 'Livello massimo', alLivello: 'al livello', obiettivi: 'Obiettivi della settimana', completato: 'Completato', tornaEsercizi: 'Torna agli esercizi', tornaMateria: 'Torna agli argomenti', percorso: 'Il tuo percorso',
};
---
<Base
  titolo={`${arg.titolo} · ${T.titolo}`}
  descrizione={T.descr}
  percorso={ripasso ? [{ titolo: arg.breve }, { titolo: T.titolo }] : [{ titolo: arg.breve, href: hrefSezione('teoria') }, { titolo: T.titolo }]}
  materia={materia} argomento={argomento} sezione="domande" lingua={lingua} usa={usa}
  seo={{ titolo: ripasso ? titoloQuiz : titoloQuiz + ' | ' + m.breve, noindex: !pubblica, canonico: canonicoQuiz, senzaInglese, soloQuestaLingua: (materia === 'scienza-delle-costruzioni' || m.eserciziDaFare === false) && senzaInglese }}
>
  <div class="domande" data-materia={materia} data-bocconi-quiz={bocconi || undefined} data-argomento={argomento} data-titolo={arg.titolo} data-lingua={lingua} data-pref={pref} data-testi={JSON.stringify(JS)} data-ripasso={ripasso ? '1' : ''} data-torna-alla-materia={tornaAllaMateria ? '1' : ''} data-ritorno={hrefRitorno} data-brevi={JSON.stringify(brevi)}>
    <div class="domande-testa">
      <div>
        <p class="sopratitolo">{pubblica ? m.titolo : T.titolo}</p>
        <h1>{pubblica ? titoloQuiz : arg.titolo}</h1>
      </div>
      <button type="button" class="bottone-secondario termina" hidden>{T.termina}</button>
    </div>
    <p class="sommario">{T.sommario}</p>
    {(anteprimaScienza || anteprimaUsa) && <p class="nota nota-anteprima-scienza" data-usa-preview={anteprimaUsa || undefined}>
      {notaAnteprima} <a href={hrefSblocca}>{T.sblocca} · {m.prezzo} €</a>
    </p>}
    {['tolc-i', 'tolc-s'].includes(materia) && <p class="nota">{en ? 'Ten sample questions are available before unlocking ' + materia.toUpperCase() + '. Full access includes all questions and the section-timed simulation.' : <>Prima dello sblocco sono disponibili dieci quesiti dimostrativi complessivi. <a href={`/${materia}/sblocca`}>L’accesso {materia.toUpperCase()}</a> comprende tutti i quiz e la simulazione con tempi per sezione.</>}</p>}
    {materia === 'tiec' && <p class="nota">{en ? 'Ten sample questions are available before unlocking the TIEC course. Full access includes all questions and the full 48-question simulation.' : <>Prima dello sblocco sono disponibili dieci quesiti dimostrativi complessivi. <a href={`/${materia}/sblocca`}>L’accesso TIEC</a> comprende tutti i quiz e la simulazione completa da 48 quesiti in 60 minuti.</>}</p>}
    {materia === 'statistica' && <p class="nota">{en ? <>Ten sample questions are available across the course. <a href={`/en/${materia}/sblocca`}>Full access</a> includes all {quizStatistica} questions with explanations. Materials are in Italian.</> : <>Prima dello sblocco sono disponibili dieci quesiti dimostrativi complessivi nel corso. <a href={`/${materia}/sblocca`}>L’accesso completo a Statistica e probabilità</a> comprende tutti i {quizStatistica} quiz con spiegazione.</>}</p>}
    {materia === 'biologia-semestre-filtro' && <p class="nota">{en ? <>Ten sample questions are available across the course. <a href={`/en/${materia}/sblocca`}>Full access</a> includes all 315 questions with explanations.</> : <>Prima dello sblocco sono disponibili dieci quesiti dimostrativi complessivi nel corso. <a href={`/${materia}/sblocca`}>L’accesso completo a Biologia</a> comprende tutti i 315 quiz con spiegazione.</>}</p>}
    {semestreFiltro && materia !== 'matematica-semestre-filtro' && <NotaSemestreFiltro lingua={lingua} materia={materia} />}
    {materia === 'matematica-semestre-filtro' && <p class="nota">{en ? 'Mathematics practice for Physics and Chemistry. These questions train the prerequisites; they are not an official filter-semester exam.' : 'Allenamento di matematica per Fisica e Chimica. Queste domande servono a consolidare i prerequisiti; non costituiscono una prova ufficiale del semestre filtro.'}</p>}

    <div class="nota-ospite" hidden>
      <p>{T.ospite}</p>
      <p class="azioni"><a class="bottone-secondario" href={`${pref}/accedi?dopo=${hrefSezione('domande')}`}>{T.accedi}</a></p>
    </div>

    <nav class="navigazione-domande" aria-label={T.navigazione} hidden>
      <button type="button" class="bottone-secondario precedente">{T.precedente}</button>
      <ol class="numeri-domande"></ol>
      <button type="button" class="bottone-secondario successiva">{T.successiva}</button>
    </nav>

    <section class="scheda-domanda" aria-live="polite">
      <div class="avvio-domande" hidden>
        <button type="button" class="bottone-primario avvia">{T.inizia}</button>
        <p>{T.avvio}</p>
      </div>
      <p class="numero-domanda"></p>
      <div class="velo-blocco velo-scheda blocco-domande" hidden>
        {bocconi ? <>
          <h2>{en ? 'Timed questions are included in the full Bocconi course' : 'I quiz a tempo sono inclusi nel corso completo Bocconi'}</h2>
          <p><a class="bottone-sblocca" href={hrefSblocca}>{T.sblocca}</a></p>
          <a href={link(lingua, `/${materia}/simulazione#diagnostico`)}>{nomiProve.diagnostico}</a>
        </> : <>
          <p class="sopratitolo">{T.anteprima}</p>
          <h2>{T.bloccata}</h2>
          <a class="bottone-sblocca" href={hrefSblocca}>{T.sblocca}</a>
        </>}
      </div>
      <div class="tempo" hidden>
        <svg viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="12" r="8" /><path d="M11 8v4l2.5 2M9 2h4" /></svg>
        <div class="barra-tempo"><span></span></div>
        <span class="secondi">2:00</span>
      </div>
      <p class="nota-tempo" hidden></p>
      <div class="testo-domanda testo-studio"><p class="caricamento">{T.caricamento}</p></div>
      <div class="scelte" role="radiogroup" aria-label={T.risposte}></div>
      <p class="esito" hidden></p>
      <div class="spiegazione testo-studio" hidden></div>
      <div class="azioni-domanda">
        <button type="button" class="bottone-primario conferma" disabled hidden>{T.conferma}</button>
        <button type="button" class="bottone-primario prossima" hidden>{T.prossima}</button>
        <button type="button" class="bottone-primario nuova-serie" hidden>{T.nuovaSerie}</button>
        <a class="link-svolti" href={ripasso ? hrefMateria : hrefSezione('esercizi-svolti')} hidden>{T.svolti}</a>
      </div>
    </section>

    <section class="riepilogo-sessione" hidden></section>
  </div>
  {voci.length > 0 && <nav aria-label={en ? 'Theory for this quiz' : 'Teoria per questo quiz'}>
    <h2>{en ? 'What to review' : 'Cosa ripassare'}</h2>
    <ul>{voci.map((v) => <li><a href={link(lingua, base + '/teoria/' + v.ancora)}>{v.titolo}</a></li>)}</ul>
  </nav>}
  {pubblica && (capitoli.length > 0 || esempi.length > 0) && (
    <details class="quiz-argomenti">
      <summary>{ripasso ? (en ? 'Topics covered in this review' : 'Argomenti del ripasso')
        : (en ? 'Worked examples for this quiz' : 'Esercizi svolti per preparare il quiz')}</summary>
      <ul>
        {ripasso ? capitoli.map((a) => <li><a href={link(lingua, '/' + materia + '/' + a.slug + '/domande')}>{a.titolo}</a> · {numeroPerArgomento[a.slug]} {en ? 'questions' : 'domande'}</li>)
          : esempi.map((s) => <li><a href={link(lingua, s.percorso)}>{s.titolo}</a></li>)}
      </ul>
    </details>
  )}
</Base>

<style>
  :global(html.sbloccato) .nota-anteprima-scienza { display: none; }
  .avvio-domande { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap; padding: .4rem 0 .2rem; }
  .avvio-domande[hidden] { display: none; }
  .avvio-domande p { margin: 0; color: var(--inchiostro); opacity: .75; font-family: var(--ui); font-size: .92rem; }
</style>

<script>
  const radice = document.querySelector<HTMLElement>('.domande')!;
  const { materia, argomento, titolo, lingua, pref } = radice.dataset as { materia: string; argomento: string; titolo: string; lingua: string; pref: string };
  const bocconi = radice.hasAttribute('data-bocconi-quiz');
  const L = JSON.parse(radice.dataset.testi || '{}') as Record<string, string>;
  const f = (k: string, x: string | number) => L[k].replace('§', String(x));
  const $ = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
  const testo = $('.testo-domanda'), scelte = $('.scelte'), esito = $('.esito'), spieg = $('.spiegazione');
  const conferma = $<HTMLButtonElement>('.conferma'), prossima = $<HTMLButtonElement>('.prossima'), svolti = $<HTMLAnchorElement>('.link-svolti');
  const nuovaSerie = $<HTMLButtonElement>('.nuova-serie');
  const ripasso = radice.dataset.ripasso === '1';
  const tornaAllaMateria = radice.dataset.tornaAllaMateria === '1';
  const brevi = JSON.parse(radice.dataset.brevi || '{}') as Record<string, string>;
  const argDi = (id: string) => id.split('/')[0];
  // Domande proposte nelle ultime sessioni: il server le ripropone solo dopo quelle mai viste.
  const chiaveRecenti = `domande-recenti-${materia}-${argomento}`;
  let recenti: string[] = [];
  try { recenti = JSON.parse(localStorage.getItem(chiaveRecenti) || '[]'); } catch { /* niente memoria */ }
  const tempo = $('.tempo'), barra = $('.barra-tempo span'), secondiEl = $('.secondi'), notaTempo = $('.nota-tempo');
  const termina = $<HTMLButtonElement>('.termina'), scheda = $('.scheda-domanda'), riepilogo = $('.riepilogo-sessione');
  const nav = $('.navigazione-domande'), numeri = $('.numeri-domande'), numeroEl = $('.numero-domanda');
  const blocco = $('.blocco-domande');
  const prec = $<HTMLButtonElement>('.precedente'), succ = $<HTMLButtonElement>('.successiva');
  const LETTERE = ['A', 'B', 'C', 'D', 'E'];
  const post = (url: string, dati: unknown) => fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(dati) });
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  const num = (x: number) => x.toLocaleString(lingua === 'en' ? 'en-US' : 'it-IT');
  const adatta = () => dispatchEvent(new Event('resize')); // le formule in display si adattano alla larghezza

  // Stato della pagina: l'ordine delle domande e, per ognuna, la domanda caricata, la scelta e l'esito.
  interface Domanda { token: string; id: string; numero: number; testo: string; scelte: string[]; secondi: number; collegato: boolean }
  interface Esito { giusta: boolean; corretta: number; spiegazione: string; punti: number; veloce?: boolean; motivo?: string; scelta: number; scaduto: boolean }
  let ordine: string[] = [];
  let pos = 0, lunghezzaSerie = 0;
  const domande = new Map<string, Domanda>();
  const esiti = new Map<string, Esito>();
  let corrente: Domanda | null = null;
  let scelta = 0, inizio = 0, timer = 0, ultimaRichiesta = 0;

  function aggiornaTempo() {
    if (!corrente) return;
    const passati = Math.floor((Date.now() - inizio) / 1000);
    const resto = Math.max(0, corrente.secondi - passati);
    secondiEl.textContent = mmss(resto);
    barra.style.width = `${(resto / corrente.secondi) * 100}%`;
    const bonus = 60 - passati;
    if (resto === 0) { notaTempo.hidden = false; notaTempo.textContent = L.scaduto2; clearInterval(timer); return; }
    notaTempo.hidden = !corrente.collegato || bonus <= 0;
    notaTempo.textContent = bonus > 0 ? f('bonus', bonus) : '';
  }

  function disegnaNumeri() {
    numeri.innerHTML = '';
    for (let i = 0; i < lunghezzaSerie; i++) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = String(i + 1);
      const id = ordine[i];
      const e = id ? esiti.get(id) : undefined;
      b.className = ['numero', e ? (e.giusta ? 'numero-giusto' : 'numero-sbagliato') : '', id ? '' : 'numero-bloccato', i === pos ? 'numero-attivo' : ''].join(' ').trim();
      if (!id) b.setAttribute('aria-label', f('numeroBloccato', i + 1));
      if (i === pos) b.setAttribute('aria-current', 'step');
      b.addEventListener('click', () => vai(i));
      li.appendChild(b);
      numeri.appendChild(li);
    }
    prec.disabled = pos <= 0;
    succ.disabled = pos >= lunghezzaSerie - 1;
    const daArg = ripasso && ordine[pos] && brevi[argDi(ordine[pos])] ? ` · ${brevi[argDi(ordine[pos])]}` : '';
    numeroEl.textContent = lunghezzaSerie ? `${f('numero', pos + 1)} ${lunghezzaSerie}${daArg}` : '';
  }

  function mostraScelte(d: Domanda, e?: Esito) {
    scelte.innerHTML = '';
    d.scelte.forEach((html, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'scelta'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', 'false');
      b.innerHTML = `<span class="lettera">${LETTERE[i]}</span><span class="valore">${html}</span>`;
      if (e) {
        b.classList.add('scelta-chiusa');
        if (i + 1 === e.corretta) b.classList.add('scelta-giusta');
        else if (i + 1 === e.scelta) b.classList.add('scelta-sbagliata');
      } else {
        b.addEventListener('click', () => {
          scelta = i + 1;
          scelte.querySelectorAll('.scelta').forEach((x, j) => { x.classList.toggle('scelta-attiva', j === i); x.setAttribute('aria-checked', String(j === i)); });
          conferma.disabled = false;
        });
      }
      scelte.appendChild(b);
    });
  }

  function mostraEsito(e: Esito) {
    let frase = e.giusta ? L.giusta : f(e.scaduto ? 'scaduto' : 'corretta', LETTERE[e.corretta - 1]);
    if (e.punti > 0) frase += ` · +${e.punti} ${lingua === 'en' ? 'XP' : 'EXP'}` + (e.veloce ? L.veloce : '') + (e.motivo === 'ripetuta' ? L.ripetuta : '');
    else if (e.giusta && e.motivo === 'tempo-scaduto') frase += L.tardi;
    esito.textContent = `${frase}.`;
    esito.className = `esito ${e.giusta ? 'esito-giusto' : 'esito-sbagliato'}`;
    esito.hidden = false;
    spieg.innerHTML = `<h2>${L.spiegazione}</h2>${e.spiegazione}`;
    spieg.hidden = false;
    conferma.hidden = true;
    prossima.hidden = pos >= lunghezzaSerie - 1;
    nuovaSerie.hidden = pos < lunghezzaSerie - 1;
    if (ripasso && corrente) svolti.href = `${pref}/${materia}/${argDi(corrente.id)}/esercizi-svolti`;
    svolti.hidden = false;
  }

  // Apre la domanda in posizione i. Una domanda non ancora risolta si ricarica con un tempo nuovo di due minuti.
  async function vai(i: number) {
    clearInterval(timer);
    const richiesta = ++ultimaRichiesta;
    pos = Math.max(0, Math.min(i, lunghezzaSerie - 1));
    corrente = null;
    scelta = 0;
    esito.hidden = true; spieg.hidden = true; prossima.hidden = true; nuovaSerie.hidden = true; svolti.hidden = true; notaTempo.hidden = true;
    conferma.hidden = true; conferma.disabled = true; tempo.hidden = true;
    const id = ordine[pos];
    const bloccata = ordine.length > 0 && !id;
    blocco.hidden = !bloccata;
    testo.hidden = bloccata;
    if (bloccata) {
      scelte.replaceChildren();
      disegnaNumeri();
      return;
    }
    const e = id ? esiti.get(id) : undefined;
    if (e) {
      corrente = domande.get(id)!;
      testo.innerHTML = corrente.testo;
      mostraScelte(corrente, e);
      mostraEsito(e);
      disegnaNumeri();
      adatta();
      return;
    }
    scelte.innerHTML = '';
    testo.innerHTML = `<p class="caricamento">${L.caricamento}</p>`;
    const r = await post('/api/domande/prossima', id ? { materia, argomento, id, lingua } : { materia, argomento, recenti, lingua }).catch(() => null);
    const d0 = r ? await r.json().catch(() => null) : null;
    const d = r && r.ok ? d0 : null;
    // Con una rete lenta e più tocchi di fila conta solo l'ultima domanda chiesta.
    if (richiesta !== ultimaRichiesta) return;
    if (!d) {
      if (bocconi && r?.status === 403) {
        blocco.hidden = false;
        testo.hidden = true;
        nav.hidden = true;
        return;
      }
      // Il Worker spiega il motivo (per esempio: ripasso di oggi senza account, oppure nessuna domanda da ripassare).
      const p = document.createElement('p');
      p.textContent = d0?.errore || L.errore;
      testo.replaceChildren(p);
      if (r?.status === 401) (radice.querySelector('.nota-ospite') as HTMLElement).hidden = false;
      return;
    }
    if (!ordine.length) {
      ordine = d.ordine; nav.hidden = false;
      lunghezzaSerie = d.lunghezzaSerie ?? ordine.length;
      recenti = [...recenti.filter((x) => !ordine.includes(x)), ...ordine].slice(-300);
      try { localStorage.setItem(chiaveRecenti, JSON.stringify(recenti)); } catch { /* niente memoria */ }
    }
    // Numero in alto e domanda mostrata restano allineati anche se il server ne restituisce un'altra.
    if (ordine.indexOf(d.id) >= 0) pos = ordine.indexOf(d.id);
    if (esiti.has(d.id)) { vai(pos); return; }
    corrente = d;
    domande.set(d.id, d);
    (radice.querySelector('.nota-ospite') as HTMLElement).hidden = d.collegato;
    termina.hidden = !d.collegato;
    testo.innerHTML = d.testo;
    mostraScelte(d);
    conferma.hidden = false;
    disegnaNumeri();
    adatta();
    inizio = Date.now();
    tempo.hidden = false;
    aggiornaTempo();
    timer = window.setInterval(aggiornaTempo, 1000);
  }

  async function invia() {
    if (!corrente || !scelta || esiti.has(corrente.id)) return;
    clearInterval(timer);
    conferma.hidden = true; notaTempo.hidden = true;
    const d0 = corrente;
    const scaduto = Date.now() - inizio > d0.secondi * 1000;
    const r = await post('/api/domande/rispondi', { token: d0.token, scelta }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    if (!d) {
      if (corrente?.id !== d0.id) return;
      if (bocconi && r?.status === 403) {
        blocco.hidden = false; testo.hidden = true; tempo.hidden = true; nav.hidden = true;
        scelte.replaceChildren();
      } else { esito.hidden = false; esito.textContent = L.nonArrivata; }
      return;
    }
    const e: Esito = { ...d, scelta, scaduto };
    esiti.set(d0.id, e);
    if (corrente?.id !== d0.id) return;
    mostraScelte(d0, e);
    mostraEsito(e);
    disegnaNumeri();
    adatta();
    if (d.stato) dispatchEvent(new CustomEvent('livello', { detail: d.stato }));
    if (d.nuovi?.length) dispatchEvent(new CustomEvent('premi', { detail: d.nuovi }));
  }

  conferma.addEventListener('click', () => invia());
  const sposta = (i: number) => { vai(i); scheda.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
  prossima.addEventListener('click', () => sposta(pos + 1));
  nuovaSerie.addEventListener('click', () => {
    // Chi chiede una nuova serie ha già premuto «Inizia»: la serie nuova parte subito.
    try { sessionStorage.setItem('domande-avvio-subito', '1'); } catch { /* niente memoria */ }
    location.reload();
  });
  succ.addEventListener('click', () => sposta(pos + 1));
  prec.addEventListener('click', () => sposta(pos - 1));

  termina.addEventListener('click', async () => {
    clearInterval(timer);
    nav.hidden = true;
    const r = await post('/api/sessione/riepilogo', { chiudi: true, lingua }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    scheda.hidden = true; termina.hidden = true;
    const s = d?.sessione;
    const st = d?.stato;
    const righe = s ? [
      [`${L.righeCorrette} (${s.corrette})`, s.puntiCorrette],
      [`${L.righeStudio} (${s.minuti} min)`, s.puntiStudio],
      ...s.premi.map((p: { nome: string; punti: number }) => [p.nome, p.punti]),
    ] : [];
    const obiettivi = (d?.obiettivi || []).map((o: { testo: string; fatto: number; totale: number; completato: boolean }) =>
      `<li><span>${o.testo}</span><span>${o.completato ? L.completato : `${o.fatto} / ${o.totale}`}</span><span class="barra-exp"><span style="width:${Math.round((o.fatto / o.totale) * 100)}%"></span></span></li>`).join('');
    riepilogo.innerHTML = `
      <p class="sopratitolo">${L.conclusa} · ${s?.titolo || titolo}</p>
      <h2>${s ? (s.minuti === 1 ? L.minuto : f('minuti', s.minuti)) : L.sessioneConclusa}</h2>
      ${s ? `<p>${s.corrette === 1 ? L.unaCorretta : f('piuCorrette', s.corrette)} ${L.su} ${s.risposte}</p>` : ''}
      ${righe.length ? `<dl class="conti-exp">${righe.map(([k, v]) => `<div><dt>${k}</dt><dd>+${v}</dd></div>`).join('')}<div class="totale"><dt>${L.totale}</dt><dd>+${s.punti} ${lingua === 'en' ? 'XP' : 'EXP'}</dd></div></dl>` : ''}
      ${st ? `<p class="riep-livello"><strong>${L.livello} ${st.livello} · ${st.fascia}</strong></p>
        <div class="barra-exp grande"><span style="width:${st.perc}%"></span></div>
        <p class="riep-numeri"><span>${num(st.exp)} ${lingua === 'en' ? 'XP' : 'EXP'}</span><span>${st.prossimo === null ? L.massimo : `${num(st.mancano)} ${L.alLivello} ${st.livello + 1}`}</span></p>` : ''}
      ${obiettivi ? `<h3>${L.obiettivi}</h3><ul class="obiettivi">${obiettivi}</ul>` : ''}
      <p class="azioni-riepilogo"><a class="bottone-primario" href="${radice.dataset.ritorno}">${tornaAllaMateria ? L.tornaMateria : L.tornaEsercizi}</a> <a class="bottone-secondario" href="${pref}/account#percorso">${L.percorso}</a></p>`;
    riepilogo.hidden = false;
    riepilogo.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Il tempo della prima domanda parte solo quando lo studente preme «Inizia» (richiesta di Carmine del 16/11/2026:
  // prima il cronometro partiva all'apertura della pagina, mentre si leggevano le istruzioni).
  const avvio = $('.avvio-domande');
  let subito = false;
  try { subito = sessionStorage.getItem('domande-avvio-subito') === '1'; sessionStorage.removeItem('domande-avvio-subito'); } catch { /* niente memoria */ }
  if (subito) vai(0);
  else {
    testo.hidden = true;
    avvio.hidden = false;
    $<HTMLButtonElement>('.avvia').addEventListener('click', () => {
      avvio.hidden = true;
      testo.hidden = false;
      vai(0);
    }, { once: true });
  }
</script>
