  .dq-link a { display: inline-flex; align-items: center; gap: 0.4rem; font: 600 0.9rem var(--ui); color: var(--verde); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--verde) 35%, transparent); text-underline-offset: 3px; }
  .dq-link a svg { width: 1.05rem; height: 1.05rem; flex: none; }
  .dq-segnala { display: inline-flex; align-items: center; gap: 0.35rem; margin-left: auto; padding: 0; border: 0; background: none; font: 0.84rem var(--ui); color: var(--inchiostro-2); cursor: pointer; }
  .dq-segnala[hidden] { display: none; }
  .dq-segnala svg { width: 1rem; height: 1rem; }
  .dq-sotto { margin: 0.7rem 0 0; text-align: right; }
  .dq-sotto .termina { padding: 0; border: 0; background: none; font: 0.84rem var(--ui); color: var(--inchiostro-2); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

  /* Risultato della serie */
  .dq-risultato { margin-top: 1.2rem; padding: 1.6rem 1.6rem 1.4rem; background: #fff; border: 1px solid var(--riga); border-radius: 16px; font-family: var(--ui); }
  .dq-risultato[hidden] { display: none; }
  .dq-voto p { margin: 0; font: 600 1.5rem/1 var(--titoli); color: var(--inchiostro-2); }
  .dq-voto b { font-size: 3.2rem; font-weight: 700; color: var(--inchiostro); letter-spacing: -0.02em; }
  .dq-voto span { display: block; margin-top: 0.35rem; font-size: 0.95rem; color: var(--inchiostro-2); }
  .dq-barra { display: flex; gap: 4px; margin-top: 1rem; }
  .dq-barra i { flex: 1; height: 8px; border-radius: 4px; background: var(--riga); }
  .dq-barra i.ok { background: var(--verde); }
  .dq-barra i.no { background: color-mix(in srgb, var(--c-esempio) 70%, #fff); }
  .dq-risultato h2 { display: flex; align-items: center; gap: 0.5rem; margin: 1.7rem 0 0.2rem; font: 700 1.05rem var(--ui); }
  .dq-risultato h2::before { content: ''; width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--verde); }
  .dq-risultato h2.no::before { background: color-mix(in srgb, var(--c-esempio) 80%, #fff); }
  .dq-lista { list-style: none; margin: 0; padding: 0; }
