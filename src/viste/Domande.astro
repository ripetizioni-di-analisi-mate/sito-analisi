  .dq-cosa { flex: 1; min-width: 0; display: grid; gap: 0.3rem; }
  .dq-cosa b { font: 600 1.08rem/1.3 var(--titoli); }
  .dq-err { flex: none; font: 600 0.84rem var(--ui); color: var(--dq-ocra); background: color-mix(in srgb, var(--c-esempio) 13%, transparent); padding: 0.3rem 0.65rem; border-radius: 999px; }
  .dq-bene { list-style: none; margin: 0.6rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .dq-bene li { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; padding: 0.35rem 0.75rem 0.35rem 0.6rem; border-radius: 999px; background: color-mix(in srgb, var(--verde) 8%, transparent); }
  .dq-bene svg { width: 0.95rem; height: 0.95rem; color: var(--verde); }
  .dq-pulito { margin: 1.2rem 0 0; font-size: 1rem; color: var(--verde); font-weight: 600; }
  .dq-azioni { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem 1.4rem; margin-top: 1.6rem; }
  .dq-testo { padding: 0; border: 0; background: none; font: 600 0.95rem var(--ui); color: var(--verde); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .dq-ospite { margin: 1.2rem 0 0; padding-top: 1rem; border-top: 1px solid var(--riga); font-size: 0.86rem; color: var(--inchiostro-2); }

  @media (max-width: 720px) {
    .dq-avvio { min-height: calc(100vh - 16rem); row-gap: 1.8rem; }
