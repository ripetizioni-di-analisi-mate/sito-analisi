---
// Domande a tempo di un argomento: una alla volta, due minuti ciascuna, spiegazione subito dopo la conferma.
// I testi arrivano dal Worker (/api/domande/…): la risposta corretta non è mai nella pagina.
import Base from '../layouts/Base.astro';
import { argomentoL, materiaL, link } from '../i18n';
interface Props { materia: string; argomento: string; totale: number }
const { materia, argomento, totale } = Astro.props;
const arg = argomentoL('it', materia, argomento);
const m = materiaL('it', materia);
const base = `/${materia}/${argomento}`;
---
<Base
  titolo={`${arg.titolo} · Domande a tempo`}
  descrizione={`Domande a risposta multipla su ${arg.titolo} (${m.titolo}), con due minuti per ciascuna e la spiegazione dopo ogni risposta.`}
  seo={{ soloQuestaLingua: true }}
  percorso={[{ titolo: arg.breve, href: link('it', `${base}/teoria`) }, { titolo: 'Domande a tempo' }]}
  materia={materia} argomento={argomento} sezione="domande"
>
  <div class="domande" data-materia={materia} data-argomento={argomento} data-titolo={arg.titolo}>
    <div class="domande-testa">
      <div>
        <p class="sopratitolo">Domande a tempo</p>
        <h1>{arg.titolo}</h1>
      </div>
      <button type="button" class="bottone-secondario termina" hidden>Termina la sessione</button>
    </div>
    <p class="sommario">{totale} domande a risposta multipla sugli esercizi di questo argomento, una alla volta, con due minuti per ciascuna. Dopo ogni risposta compare la spiegazione.</p>

    <div class="nota-ospite" hidden>
      <p>Le domande si possono fare anche senza account. I punti esperienza, il livello e gli obiettivi si salvano con un account gratuito.</p>
      <p class="azioni"><a class="bottone-secondario" href={`/accedi?dopo=${base}/domande`}>Crea un account o accedi</a></p>
    </div>

    <section class="scheda-domanda" aria-live="polite">
      <div class="tempo" hidden>
        <svg viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="12" r="8" /><path d="M11 8v4l2.5 2M9 2h4" /></svg>
        <div class="barra-tempo"><span></span></div>
        <span class="secondi">2:00</span>
      </div>
      <p class="nota-tempo" hidden></p>
      <div class="testo-domanda testo-studio"><p class="caricamento">Caricamento della domanda…</p></div>
      <div class="scelte" role="radiogroup" aria-label="Risposte"></div>
      <p class="esito" hidden></p>
      <div class="spiegazione testo-studio" hidden></div>
      <div class="azioni-domanda">
        <button type="button" class="bottone-primario conferma" disabled hidden>Conferma la risposta</button>
        <button type="button" class="bottone-primario prossima" hidden>Domanda successiva</button>
        <a class="link-svolti" href={link('it', `${base}/esercizi-svolti`)} hidden>Esercizi svolti di questo argomento</a>
      </div>
    </section>

    <section class="riepilogo-sessione" hidden></section>
  </div>
</Base>

<script>
  const radice = document.querySelector<HTMLElement>('.domande')!;
  const { materia, argomento, titolo } = radice.dataset as { materia: string; argomento: string; titolo: string };
  const $ = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
  const testo = $('.testo-domanda'), scelte = $('.scelte'), esito = $('.esito'), spieg = $('.spiegazione');
  const conferma = $<HTMLButtonElement>('.conferma'), prossima = $<HTMLButtonElement>('.prossima'), svolti = $('.link-svolti');
  const tempo = $('.tempo'), barra = $('.barra-tempo span'), secondiEl = $('.secondi'), notaTempo = $('.nota-tempo');
  const termina = $<HTMLButtonElement>('.termina'), scheda = $('.scheda-domanda'), riepilogo = $('.riepilogo-sessione');
  const LETTERE = ['A', 'B', 'C', 'D'];
  const chiaveViste = `domande-viste-${materia}-${argomento}`;
  let viste: string[] = [];
  try { viste = JSON.parse(localStorage.getItem(chiaveViste) || '[]'); } catch {}
  let corrente: { token: string; id: string; secondi: number; collegato: boolean } | null = null;
  let scelta = 0, inizio = 0, timer = 0, chiusa = false;
  const post = (url: string, dati: unknown) => fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(dati) });
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  const num = (x: number) => x.toLocaleString('it-IT');
  const adatta = () => dispatchEvent(new Event('resize')); // le formule in display si adattano alla larghezza

  function aggiornaTempo() {
    const passati = Math.floor((Date.now() - inizio) / 1000);
    const resto = Math.max(0, (corrente?.secondi || 120) - passati);
    secondiEl.textContent = mmss(resto);
    barra.style.width = `${(resto / (corrente?.secondi || 120)) * 100}%`;
    const bonus = 60 - passati;
    notaTempo.hidden = !corrente?.collegato || bonus <= 0;
    notaTempo.textContent = bonus > 0 ? `Bonus velocità ancora per ${bonus} secondi` : '';
    if (resto === 0 && !chiusa) invia(true);
  }

  async function carica() {
    chiusa = false; scelta = 0;
    esito.hidden = true; spieg.hidden = true; prossima.hidden = true; svolti.hidden = true;
    conferma.hidden = false; conferma.disabled = true;
    scelte.innerHTML = '';
    testo.innerHTML = '<p class="caricamento">Caricamento della domanda…</p>';
    const r = await post('/api/domande/prossima', { materia, argomento, viste }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    if (!d) { testo.innerHTML = '<p>Le domande non si sono caricate. Ricarica la pagina.</p>'; conferma.hidden = true; return; }
    corrente = d;
    (radice.querySelector('.nota-ospite') as HTMLElement).hidden = d.collegato;
    termina.hidden = !d.collegato;
    viste = [...viste.filter((x) => x !== d.id), d.id].slice(-200);
    try { localStorage.setItem(chiaveViste, JSON.stringify(viste)); } catch {}
    testo.innerHTML = d.testo;
    d.scelte.forEach((html: string, i: number) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'scelta'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', 'false');
      b.innerHTML = `<span class="lettera">${LETTERE[i]}</span><span class="valore">${html}</span>`;
      b.addEventListener('click', () => {
        if (chiusa) return;
        scelta = i + 1;
        scelte.querySelectorAll('.scelta').forEach((x, j) => { x.classList.toggle('scelta-attiva', j === i); x.setAttribute('aria-checked', String(j === i)); });
        conferma.disabled = false;
      });
      scelte.appendChild(b);
    });
    adatta();
    inizio = Date.now();
    tempo.hidden = false;
    clearInterval(timer);
    aggiornaTempo();
    timer = window.setInterval(aggiornaTempo, 1000);
  }

  async function invia(scaduto = false) {
    if (chiusa || !corrente) return;
    chiusa = true;
    clearInterval(timer);
    conferma.hidden = true; notaTempo.hidden = true;
    const r = await post('/api/domande/rispondi', { token: corrente.token, scelta: scaduto ? 0 : scelta }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    if (!d) { esito.hidden = false; esito.textContent = 'La risposta non è arrivata. Ricarica la pagina.'; return; }
    scelte.querySelectorAll<HTMLElement>('.scelta').forEach((b, j) => {
      b.classList.add('scelta-chiusa');
      if (j + 1 === d.corretta) b.classList.add('scelta-giusta');
      else if (j + 1 === scelta) b.classList.add('scelta-sbagliata');
    });
    let frase = d.giusta ? 'Risposta corretta' : scaduto ? `Tempo scaduto. La risposta corretta è la ${LETTERE[d.corretta - 1]}` : `La risposta corretta è la ${LETTERE[d.corretta - 1]}`;
    if (d.punti > 0) frase += ` · +${d.punti} EXP` + (d.veloce ? ' (con bonus velocità)' : '') + (d.motivo === 'ripetuta' ? ', metà punti perché già indovinata questa settimana' : '');
    else if (d.giusta && d.motivo === 'troppo-presto') frase += ', ma data in meno di 10 secondi: nessun punto';
    else if (d.giusta && d.motivo === 'tempo-scaduto') frase += ', ma oltre il tempo: nessun punto';
    esito.textContent = `${frase}.`;
    esito.className = `esito ${d.giusta ? 'esito-giusto' : 'esito-sbagliato'}`;
    esito.hidden = false;
    spieg.innerHTML = `<h2>Spiegazione</h2>${d.spiegazione}`;
    spieg.hidden = false;
    prossima.hidden = false; svolti.hidden = false;
    adatta();
    if (d.stato) dispatchEvent(new CustomEvent('livello', { detail: d.stato }));
    if (d.nuovi?.length) dispatchEvent(new CustomEvent('premi', { detail: d.nuovi }));
  }

  conferma.addEventListener('click', () => invia());
  prossima.addEventListener('click', () => { carica(); scheda.scrollIntoView({ behavior: 'smooth', block: 'start' }); });

  termina.addEventListener('click', async () => {
    clearInterval(timer);
    const r = await post('/api/sessione/riepilogo', { chiudi: true }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    scheda.hidden = true; termina.hidden = true;
    const s = d?.sessione;
    const st = d?.stato;
    const righe = s ? [
      [`Risposte corrette (${s.corrette})`, s.puntiCorrette],
      [`Studio attivo (${s.minuti} min)`, s.puntiStudio],
      ...s.premi.map((p: { nome: string; punti: number }) => [p.nome, p.punti]),
    ] : [];
    const obiettivi = (d?.obiettivi || []).map((o: { testo: string; fatto: number; totale: number; completato: boolean }) =>
      `<li><span>${o.testo}</span><span>${o.completato ? 'Completato' : `${o.fatto} / ${o.totale}`}</span><span class="barra-exp"><span style="width:${Math.round((o.fatto / o.totale) * 100)}%"></span></span></li>`).join('');
    riepilogo.innerHTML = `
      <p class="sopratitolo">Sessione di studio conclusa · ${s?.titolo || titolo}</p>
      <h2>${s ? `${s.minuti} minuti di studio attivo` : 'Sessione conclusa'}</h2>
      ${s ? `<p>${s.corrette} risposte corrette su ${s.risposte}</p>` : ''}
      ${righe.length ? `<dl class="conti-exp">${righe.map(([k, v]) => `<div><dt>${k}</dt><dd>+${v}</dd></div>`).join('')}<div class="totale"><dt>Totale</dt><dd>+${s.punti} EXP</dd></div></dl>` : ''}
      ${st ? `<p class="riep-livello"><strong>Livello ${st.livello} · ${st.fascia}</strong></p>
        <div class="barra-exp grande"><span style="width:${st.perc}%"></span></div>
        <p class="riep-numeri"><span>${num(st.exp)} EXP</span><span>${st.prossimo === null ? 'Livello massimo' : `${num(st.mancano)} al livello ${st.livello + 1}`}</span></p>` : ''}
      ${obiettivi ? `<h3>Obiettivi della settimana</h3><ul class="obiettivi">${obiettivi}</ul>` : ''}
      <p class="azioni-riepilogo"><a class="bottone-primario" href="/${materia}/${argomento}/esercizi">Torna agli esercizi</a> <a class="bottone-secondario" href="/account#percorso">Il tuo percorso</a></p>`;
    riepilogo.hidden = false;
    riepilogo.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  carica();
</script>
