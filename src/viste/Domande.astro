  html.dq-v-b .dq-dati b { font-size: 1.3rem; letter-spacing: 0; }
  html.dq-v-b .dq-dati li > span:last-child { font-size: 0.88rem; }
  html.dq-v-b .dq-note { margin-top: 0.8rem; }
  /* C · Cornice sottile */
  html.dq-v-c .dq-riquadro { background: rgb(255 255 255 / 0.55); border-radius: 14px; padding: 1.8rem 1.8rem 1.7rem; row-gap: 1.25rem; }
  html.dq-v-c .dq-capitolo { font-size: 1.5rem; }
  html.dq-v-c .dq-dati { width: auto; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.4rem 1.3rem; }
  html.dq-v-c .dq-dati li { display: flex; align-items: center; gap: 0.4rem; padding: 0; border: 0; }
  html.dq-v-c .dq-sim { margin: 0; }
  html.dq-v-c .dq-sim svg { width: 1.35rem; height: 1.35rem; stroke-width: 2.6; }
  html.dq-v-c .dq-dati b { font: 700 1rem var(--ui); letter-spacing: 0; }
  html.dq-v-c .dq-dati li > span:last-child { font-size: 0.95rem; }
  html.dq-v-c .dq-avvio .avvia { padding: 0.68rem 2.4rem; margin-top: 0.2rem; }

  /* Durante */
  .dq .navigazione-domande { display: flex; flex-wrap: nowrap; align-items: center; gap: 0.55rem; margin-top: 0.2rem; }
  .dq .navigazione-domande[hidden] { display: none; }
  .dq .navigazione-domande > button { flex: none; display: grid; place-items: center; width: 2rem; height: 2rem; padding: 0; border-radius: 50%; background: #fff; }
  .dq .navigazione-domande > button svg { width: 1rem; height: 1rem; }
  .dq .navigazione-domande .precedente svg { transform: scaleX(-1); }
  .dq .navigazione-domande > button:disabled { opacity: 0.35; }
  .dq .numeri-domande { flex: 1; order: 0; flex-basis: auto; display: flex; flex-wrap: nowrap; justify-content: stretch; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .dq .numeri-domande li { flex: 1; }
  .dq .numeri-domande .numero { position: relative; display: block; width: 100%; min-width: 0; height: 1.6rem; padding: 0; border: 0; border-radius: 0; background: none; font-size: 0; outline: 0; cursor: pointer; }
  .dq .numeri-domande .numero::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 6px; translate: 0 -50%; border-radius: 3px; background: var(--riga); transition: height 0.15s, background 0.15s; }
  .dq .numeri-domande .numero:hover::after, .dq .numeri-domande .numero:focus-visible::after { height: 10px; }
  .dq .numeri-domande .numero-attivo::after { height: 10px; background: color-mix(in srgb, var(--verde) 38%, #fff); }
  .dq .numeri-domande .numero-giusto::after { background: var(--verde); }
  .dq .numeri-domande .numero-sbagliato::after { background: color-mix(in srgb, var(--c-esempio) 75%, #fff); }
  .dq .numeri-domande .numero-bloccato::after { background: repeating-linear-gradient(90deg, var(--riga) 0 4px, transparent 4px 7px); }
  .dq .scheda-domanda { margin-top: 0.9rem; padding: 1.15rem 1.35rem 1.3rem; background: #fff; border: 1px solid var(--riga); border-radius: 16px; }
  .dq .scheda-domanda[hidden] { display: none; }
  .dq-stato { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2rem; }
  .dq-stato .numero-domanda { margin: 0; font: 700 0.72rem var(--ui); letter-spacing: 0.1em; text-transform: uppercase; color: var(--verde); }
  .dq-stato .tempo { gap: 0.4rem; padding: 0.3rem 0.7rem 0.3rem 0.5rem; border-radius: 999px; background: var(--bronzo-fondo); color: var(--bronzo-scuro); }
  .dq-stato .tempo svg { width: 1.05rem; height: 1.05rem; stroke: var(--bronzo-icona); stroke-width: 1.5; }
  .dq-stato .tempo .secondi { min-width: 0; font-size: 0.92rem; }
  .dq-stato .tempo.poco { background: color-mix(in srgb, var(--c-attenzione) 10%, #fff); color: var(--c-attenzione); }
  .dq-stato .tempo.poco svg { stroke: var(--c-attenzione); }
  .dq .nota-tempo { margin: 0.4rem 0 0; font-size: 0.8rem; }
  .dq .scelta { border-radius: 12px; background: var(--carta); transition: border-color 0.15s, background 0.15s, transform 0.12s; }
  .dq .scelta:not(.scelta-chiusa):hover { border-color: color-mix(in srgb, var(--verde) 55%, var(--riga)); background: #fff; }
  .dq .scelta:not(.scelta-chiusa):active { transform: scale(0.995); }
  .dq .scelta-attiva { background: color-mix(in srgb, var(--accento) 7%, #fff); }
  .dq .scelta-giusta { background: color-mix(in srgb, var(--verde) 9%, #fff); }
  .dq .esito { display: inline-flex; align-items: center; padding: 0.4rem 0.8rem; border-radius: 999px; font-size: 0.9rem; }
  .dq .esito[hidden] { display: none; }
  .dq .esito-giusto { background: color-mix(in srgb, var(--verde) 10%, transparent); }
  .dq .esito-sbagliato { background: color-mix(in srgb, var(--c-esempio) 13%, transparent); }
  .dq .spiegazione { border: 0; border-radius: 12px; background: color-mix(in srgb, var(--carta-2) 60%, #fff); padding: 0.3rem 1.1rem 0.9rem; box-shadow: inset 3px 0 var(--verde); }
  .dq .azioni-domanda { gap: 0.7rem 1rem; }

  /* Dopo una risposta sbagliata */
  .dq-ripassa { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.3rem 0.9rem; margin-top: 0.9rem; font-family: var(--ui); }
