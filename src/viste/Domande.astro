---
// Domande a tempo di un argomento: una alla volta, due minuti ciascuna, spiegazione subito dopo la conferma,
// risultato della serie per argomento con ciò che è da ripassare.
// I testi arrivano dal Worker (/api/domande/…): la risposta corretta non è mai nella pagina.
import Base from '../layouts/Base.astro';
import NotaSemestreFiltro from '../components/NotaSemestreFiltro.astro';
import { argomentoL, materiaL, link, prefisso, type Lingua } from '../i18n';
import { originale } from '../lib/canonici';
import { DOMANDE_SESSIONE, PUNTI, RIPASSO, RIPASSO_OGGI } from '../data/livelli';
import { BOCCONI } from '../data/bocconi.mjs';
import { nomiAllenamento } from '../lib/allenamento.mjs';
import { catalogoDomande, conteggiDomande } from '../lib/domande';
import { linkArgomentoUsa, materiaUsa } from '../data/stem-usa/catalog-view';
import { courseUrl, usStudyPreviewPage } from '../data/stem-usa/catalog.mjs';
import { url } from '../lib/url';
interface Props { lingua: Lingua; materia: string; argomento: string; totale: number; usa?: boolean }
const { lingua, materia, argomento, totale, usa = false } = Astro.props;
const en = lingua === 'en';
const es = lingua === 'es';
const bocconi = materia === BOCCONI.slug;
const m = usa ? materiaUsa(materia)! : materiaL(lingua, materia);
const quizStatistica = materia === 'statistica'
  ? Object.values((await conteggiDomande(en ? 'en' : 'it')).statistica ?? {}).reduce((somma, numero) => somma + numero, 0).toLocaleString(en ? 'en-US' : 'it-IT', { useGrouping: 'always' })
  : '';
const semestreFiltro = materia.endsWith('-semestre-filtro');
const nomiProve = nomiAllenamento(m, lingua);
// Prove d'esame: capitolo finale della materia, con domande di ripasso pescate da tutti gli argomenti.
// Ripasso di oggi: le domande sbagliate dello studente che tornano dopo 1, 3 e 7 giorni (scelte dal Worker).
const personale = argomento === RIPASSO_OGGI;
const ripasso = argomento === RIPASSO || personale;
const argomentiInglesi = !usa && !en ? (await catalogoDomande('en'))[materia] ?? [] : [];
const senzaInglese = !usa && !en && (ripasso ? !argomentiInglesi.length : !argomentiInglesi.includes(argomento));
const anteprimaScienza = materia === 'scienza-delle-costruzioni' && m.prezzo;
const anteprimaUsa = usa && usStudyPreviewPage(materia, argomento + '/domande');
const notaAnteprima = personale
  ? (en ? 'Spaced review is included in full access.' : 'Il ripasso personale è incluso nell’accesso completo.')
  : ripasso
    ? (en ? `Try ${m.argomenti.length} sample questions, one per topic.` : `Puoi provare ${m.argomenti.length} domande gratuite, una per argomento.`)
    : (en ? 'The first question is available in the free preview.' : 'Puoi rispondere gratis alla prima domanda della serie.');
const arg = personale ? { slug: RIPASSO_OGGI, titolo: en ? 'Today’s review' : 'Il tuo ripasso di oggi', breve: en ? 'Today’s review' : 'Ripasso di oggi' }
  : ripasso ? { slug: RIPASSO, titolo: nomiProve.ripasso, breve: nomiProve.ripasso }
  : usa ? m.argomenti.find(a => a.slug === argomento)! : argomentoL(lingua, materia, argomento);
if (semestreFiltro && ripasso && !personale) {
  arg.titolo = en ? 'Review of all units' : 'Ripasso su tutte le unità';
  arg.breve = en ? 'Review' : 'Ripasso';
}
const base = `/${materia}/${argomento}`;
const pref = prefisso(lingua);
const hrefSezione = (sezione: string) => usa ? linkArgomentoUsa(materia, argomento, sezione) : link(lingua, `${base}/${sezione}`);
const tornaAllaMateria = ripasso || m.eserciziDaFare === false;
const hrefMateria = usa ? url(courseUrl(materia)) : link(lingua, '/' + materia);
const hrefSblocca = !usa && !m.prezzo ? hrefMateria : usa ? url(courseUrl(materia) + '/sblocca') : link(es ? 'it' : lingua, '/' + materia + '/sblocca') + (es ? '?lingua=it' : '');
const hrefRitorno = tornaAllaMateria ? hrefMateria : hrefSezione('esercizi');
const n = Math.min(DOMANDE_SESSIONE, totale);
// Nome breve di ogni argomento, per indicare nel ripasso da quale argomento viene la domanda.
const brevi = Object.fromEntries(m.argomenti.map((a) => [a.slug, a.breve]));
const comeScelte = en
  ? (totale > n ? `${n} multiple-choice questions chosen at random among the ${totale} ${ripasso ? `of all the topics of ${m.titolo}` : 'of this topic'}` : `${totale} multiple-choice questions ${ripasso ? `on all the topics of ${m.titolo}` : 'on this topic'}, in random order`)
  : (totale > n ? `${n} domande a risposta multipla scelte a caso tra le ${totale} ${ripasso ? `di tutti gli argomenti di ${m.titolo}` : 'di questo argomento'}` : `${totale} domande a risposta multipla ${ripasso ? `su tutti gli argomenti di ${m.titolo}` : 'su questo argomento'}, in ordine casuale`);
const T = es ? {
  titolo: 'Preguntas cronometradas', descr: `Preguntas de opción múltiple sobre ${arg.titolo}. Tienes dos minutos por pregunta.`,
  termina: 'Terminar la sesión', sommario: `La sesión incluye ${n} preguntas de opción múltiple en orden aleatorio. Tienes dos minutos para responder a cada una y verás la explicación después.`,
  ospite: 'Puedes responder sin cuenta. Si creas una cuenta gratuita, se guardarán tus puntos y tus avances.', accedi: 'Crear una cuenta o iniciar sesión',
  caricamento: 'Cargando la pregunta…', risposte: 'Respuestas', conferma: 'Confirmar respuesta', prossima: 'Siguiente pregunta', svolti: 'Ejercicios resueltos de este tema', nuovaSerie: 'Nueva serie de preguntas',
  navigazione: 'Preguntas', precedente: '← Anterior', successiva: 'Siguiente →',
  inizia: 'Empezar', avvio: 'El tiempo empieza cuando pulsas «Empezar».',
  anteprima: 'Vista previa gratuita', bloccata: 'Esta pregunta requiere acceso completo al curso.', sblocca: 'Desbloquear el curso',
} : en ? {
  titolo: personale ? 'Spaced review' : ripasso ? 'Review questions' : 'Timed questions', descr: ripasso ? `Review questions on all the topics of ${m.titolo}, two minutes each, with the explanation after every answer.` : `Multiple-choice questions on ${arg.titolo} (${m.titolo}), two minutes each, with the explanation after every answer.`,
  termina: 'End the session', sommario: personale ? `The questions of ${m.titolo} you got wrong come back here one day later; each correct answer given on the scheduled day moves the question further on, to 3 and then 7 days, and after three correct answers it leaves the review.` : `Each session offers ${comeScelte}, one at a time, two minutes each. The explanation appears after every answer.`,
  ospite: (anteprimaScienza || anteprimaUsa) ? 'Experience points and progress are saved with a free account.' : 'You can answer the questions without an account. Experience points, level and goals are saved with a free account.', accedi: 'Create an account or log in',
  caricamento: 'Loading the question…', risposte: 'Answers', conferma: 'Confirm your answer', prossima: 'Next question', svolti: 'Worked examples of this topic', nuovaSerie: 'New set of questions',
  navigazione: 'Questions', precedente: '← Previous', successiva: 'Next →',
  inizia: 'Start', avvio: 'The timer starts when you press Start.',
  anteprima: 'Free preview', bloccata: 'This question requires full access to the course.', sblocca: 'Unlock the course',
} : {
  titolo: personale ? 'Ripasso dilazionato' : ripasso ? 'Domande di ripasso' : 'Domande a tempo', descr: ripasso ? `Domande di ripasso su tutti gli argomenti di ${m.titolo}, con due minuti per ciascuna e la spiegazione dopo ogni risposta.` : `Domande a risposta multipla su ${arg.titolo} (${m.titolo}), con due minuti per ciascuna e la spiegazione dopo ogni risposta.`,
  termina: 'Termina la sessione', sommario: personale ? `Le domande di ${m.titolo} a cui hai risposto in modo sbagliato tornano qui il giorno dopo; ogni risposta corretta data nel giorno previsto sposta la domanda più avanti, a 3 e poi a 7 giorni, e dopo tre risposte corrette la domanda esce dal ripasso.` : `Ogni sessione propone ${comeScelte}, una alla volta, con due minuti per ciascuna. Dopo ogni risposta compare la spiegazione.`,
  ospite: (anteprimaScienza || anteprimaUsa) ? 'I punti esperienza e i progressi si salvano con un account gratuito.' : 'Le domande si possono fare anche senza account. I punti esperienza, il livello e gli obiettivi si salvano con un account gratuito.', accedi: 'Crea un account o accedi',
  caricamento: 'Caricamento della domanda…', risposte: 'Risposte', conferma: 'Conferma la risposta', prossima: 'Domanda successiva', svolti: 'Esercizi svolti di questo argomento', nuovaSerie: 'Nuova serie di domande',
  navigazione: 'Domande', precedente: '← Precedente', successiva: 'Successiva →',
  inizia: 'Inizia', avvio: 'Il tempo parte quando premi «Inizia».',
  anteprima: 'Anteprima gratuita', bloccata: 'Questa domanda è riservata a chi ha acquistato l’accesso completo alla materia.', sblocca: 'Sblocca la materia',
};
// La pagina pubblica è quella che i motori di ricerca possono indicizzare.
const pubblica = !usa && !personale && totale > 0;
const titoloQuiz = ripasso ? T.titolo + ' · ' + m.titolo : arg.titolo + ' · ' + T.titolo;
const canonicoQuiz = pubblica && !ripasso ? originale(materia, argomento, 'domande') : undefined;
// Testi usati dallo script nel browser.
const JS = es ? {
  caricamento: T.caricamento, errore: 'No se han podido cargar las preguntas. Recarga la página.', bonus: 'Quedan § segundos para conseguir puntos extra por rapidez',
  giusta: 'Respuesta correcta', scaduto: 'Se ha agotado el tiempo. La respuesta correcta es §', corretta: 'La respuesta correcta es §',
  veloce: ' (con puntos extra por rapidez)', ripetuta: '. Mitad de puntos porque ya acertaste esta pregunta esta semana',
  tardi: ' fuera de tiempo. No suma puntos', nonArrivata: 'No se ha podido enviar la respuesta. Recarga la página.',
  spiegazione: 'Explicación', conclusa: 'Sesión de estudio completada', minuto: '1 minuto de estudio activo', minuti: '§ minutos de estudio activo', sessioneConclusa: 'Sesión completada',
  unaCorretta: '1 respuesta correcta', piuCorrette: '§ respuestas correctas', su: 'de', righeCorrette: 'Respuestas correctas', righeStudio: 'Estudio activo', totale: 'Total',
  numero: 'Pregunta § de', scaduto2: 'Se ha agotado el tiempo. Puedes responder sin sumar puntos o pasar a otra pregunta.',
  numeroBloccato: 'Pregunta §, requiere acceso completo',
  livello: 'Nivel', massimo: 'Nivel máximo', alLivello: 'para el nivel', obiettivi: 'Objetivos semanales', completato: 'Completado', tornaEsercizi: 'Volver a los ejercicios', tornaMateria: 'Volver al temario', percorso: 'Tu progreso',
} : en ? {
  caricamento: T.caricamento, errore: 'The questions did not load. Reload the page.', bonus: 'Speed bonus for another § seconds',
  giusta: 'Correct answer', scaduto: 'Time is up. The correct answer is §', corretta: 'The correct answer is §',
  veloce: ' (with speed bonus)', ripetuta: ', half points because already answered correctly this week',
  tardi: ', but after the time limit: no points', nonArrivata: 'The answer did not arrive. Reload the page.',
  spiegazione: 'Explanation', conclusa: 'Study session completed', minuto: '1 minute of active study', minuti: '§ minutes of active study', sessioneConclusa: 'Session completed',
  unaCorretta: '1 correct answer', piuCorrette: '§ correct answers', su: 'out of', righeCorrette: 'Correct answers', righeStudio: 'Active study', totale: 'Total',
  numero: 'Question § of', scaduto2: 'Time is up: you can still answer, without points, or move to another question.',
  numeroBloccato: 'Question §, full access required',
  livello: 'Level', massimo: 'Maximum level', alLivello: 'to level', obiettivi: 'Weekly goals', completato: 'Completed', tornaEsercizi: 'Back to the exercises', tornaMateria: 'Back to the topics', percorso: 'Your progress',
} : {
  caricamento: T.caricamento, errore: 'Le domande non si sono caricate. Ricarica la pagina.', bonus: 'Bonus velocità ancora per § secondi',
  giusta: 'Risposta corretta', scaduto: 'Tempo scaduto. La risposta corretta è la §', corretta: 'La risposta corretta è la §',
  veloce: ' (con bonus velocità)', ripetuta: ', metà punti perché già indovinata questa settimana',
  tardi: ', ma oltre il tempo: nessun punto', nonArrivata: 'La risposta non è arrivata. Ricarica la pagina.',
  spiegazione: 'Spiegazione', conclusa: 'Sessione di studio conclusa', minuto: '1 minuto di studio attivo', minuti: '§ minuti di studio attivo', sessioneConclusa: 'Sessione conclusa',
  unaCorretta: '1 risposta corretta', piuCorrette: '§ risposte corrette', su: 'su', righeCorrette: 'Risposte corrette', righeStudio: 'Studio attivo', totale: 'Totale',
  numero: 'Domanda § di', scaduto2: 'Tempo scaduto: puoi ancora rispondere, senza punti, oppure passare a un\'altra domanda.',
  numeroBloccato: 'Domanda §, accesso completo richiesto',
  livello: 'Livello', massimo: 'Livello massimo', alLivello: 'al livello', obiettivi: 'Obiettivi della settimana', completato: 'Completato', tornaEsercizi: 'Torna agli esercizi', tornaMateria: 'Torna agli argomenti', percorso: 'Il tuo percorso',
};
// Percorso nuovo (26/11/2026, scelte di Carmine sulle anteprime): prima un solo blocco al centro con i tre dati della serie,
// durante solo la domanda, dopo un errore «Da ripassare», a fine serie il risultato per argomento.
const tempoDomanda = `${Math.floor(PUNTI.secondiDomanda / 60)}:${String(PUNTI.secondiDomanda % 60).padStart(2, '0')}`;
const expMassimi = PUNTI.corretta + PUNTI.veloce;
const P = es ? {
  domande: 'preguntas', perDomanda: 'por pregunta', exp: 'EXP como máximo por respuesta',
  precedente: 'Pregunta anterior', successiva: 'Pregunta siguiente', vedi: 'Ver el resultado', segnala: 'Informar de un error',
} : en ? {
  domande: 'questions', perDomanda: 'per question', exp: 'XP at most per answer',
  precedente: 'Previous question', successiva: 'Next question', vedi: 'See the result', segnala: 'Report an error',
} : {
  domande: 'domande', perDomanda: 'per ogni domanda', exp: 'EXP al massimo per risposta',
  precedente: 'Domanda precedente', successiva: 'Domanda successiva', vedi: 'Vedi il risultato', segnala: 'Segnala un errore',
};
const JS2 = es ? {
  daRipassare: 'Para repasar', teoria: 'Teoría', teoriaCap: 'Teoría del tema', scheda: 'Ficha resuelta §', svoltiCap: 'Ejercicios resueltos',
  corrette: 'respuestas correctas', unaCorrettaR: 'respuesta correcta', senzaRisposta: '§ sin responder', andatiBene: 'Bien resueltas',
  errore1: '1 error', erroriN: '§ errores', nessunErrore: 'Sin errores en esta serie.', rifai1: 'Repetir la pregunta fallada', rifaiN: 'Repetir las § preguntas falladas',
  nuova: 'Nueva serie', ospiteRis: 'Con una cuenta gratuita se guardan tus puntos y avances.', accedi: T.accedi, domandaN: 'Pregunta §',
} : en ? {
  daRipassare: 'To review', teoria: 'Theory', teoriaCap: 'Chapter theory', scheda: 'Worked sheet §', svoltiCap: 'Worked examples',
  corrette: 'correct answers', unaCorrettaR: 'correct answer', senzaRisposta: '§ unanswered', andatiBene: 'Went well',
  errore1: '1 mistake', erroriN: '§ mistakes', nessunErrore: 'No mistakes in this set.', rifai1: 'Retry the wrong question', rifaiN: 'Retry the § wrong questions',
  nuova: 'New set', ospiteRis: 'With a free account your points and progress are saved.', accedi: T.accedi, domandaN: 'Question §',
} : {
  daRipassare: 'Da ripassare', teoria: 'Teoria', teoriaCap: 'Teoria del capitolo', scheda: 'Scheda svolta §', svoltiCap: 'Esercizi svolti',
  corrette: 'risposte corrette', unaCorrettaR: 'risposta corretta', senzaRisposta: '§ senza risposta', andatiBene: 'Andati bene',
  errore1: '1 errore', erroriN: '§ errori', nessunErrore: 'Nessun errore in questa serie.', rifai1: 'Rifai la domanda sbagliata', rifaiN: 'Rifai le § domande sbagliate',
  nuova: 'Nuova serie', ospiteRis: 'Con un account gratuito punti e progressi si salvano.', accedi: T.accedi, domandaN: 'Domanda §',
};
// Simboli a due toni della schermata di partenza: fumetto (domande), clessidra (tempo), scintilla (esperienza).
const simbolo = (d: string) => `<svg viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const SIMBOLI = {
  domande: simbolo('<rect class="t" x="14" y="5" width="29" height="25" rx="7"/><path class="b" d="M12 11h22a6 6 0 0 1 6 6v13a6 6 0 0 1-6 6H22.5l-7.5 6.5V36h-3a6 6 0 0 1-6-6V17a6 6 0 0 1 6-6z"/><path class="s" d="M19.2 20.3a4 4 0 1 1 6 3.45c-1.3.75-2 1.5-2 2.85"/><circle class="p" cx="23.2" cy="30.6" r="1.35"/>'),
  tempo: simbolo('<path class="b" d="M16 7v6c0 5 8 7 8 11s-8 6-8 11v6h16v-6c0-5-8-7-8-11s8-6 8-11V7z"/><path class="t" d="M18.6 14h10.800c-.9 2.800-4.100 4.300-5.400 6.200-1.300-1.900-4.500-3.400-5.400-6.200z"/><path class="t" d="M18 39.500c.600-3.300 3.800-5.200 6-6.700 2.200 1.500 5.400 3.400 6 6.700z"/><path class="s" d="M12.500 7h23M12.500 41h23"/>'),
  exp: simbolo('<path class="b tt" d="M21 7c1.700 8.700 5.300 12.300 14 14-8.700 1.700-12.300 5.300-14 14-1.700-8.700-5.300-12.300-14-14 8.700-1.700 12.300-5.300 14-14z"/><path class="p" d="M37 28c.700 3.500 2.500 5.300 6 6-3.500.700-5.300 2.500-6 6-.700-3.500-2.500-5.300-6-6 3.500-.700 5.300-2.500 6-6z"/>'),
};
const freccia = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 10h11M10.5 4.5L16 10l-5.500 5.500"/></svg>';
---
<Base
  titolo={`${arg.titolo} · ${T.titolo}`}
  descrizione={T.descr}
  percorso={ripasso ? [{ titolo: arg.breve }, { titolo: T.titolo }] : [{ titolo: arg.breve, href: hrefSezione('teoria') }, { titolo: T.titolo }]}
  materia={materia} argomento={argomento} sezione="domande" lingua={lingua} usa={usa}
  seo={{ titolo: ripasso ? titoloQuiz : titoloQuiz + ' | ' + m.breve, noindex: !pubblica, canonico: canonicoQuiz, senzaInglese, soloQuestaLingua: (materia === 'scienza-delle-costruzioni' || m.eserciziDaFare === false) && senzaInglese }}
>
  <script is:inline>try { if (sessionStorage.getItem('domande-avvio-subito') === '1') document.documentElement.classList.add('dq-subito'); } catch (e) {}</script>
  <script is:inline>try { var v = new URLSearchParams(location.search).get('riquadro'); if (v === 'a' || v === 'b' || v === 'c') { document.documentElement.classList.add('dq-v-' + v); sessionStorage.setItem('dq-riquadro', v); } else if (v === 'oggi') sessionStorage.removeItem('dq-riquadro'); else if (/^[abc]$/.test(sessionStorage.getItem('dq-riquadro') || '')) document.documentElement.classList.add('dq-v-' + sessionStorage.getItem('dq-riquadro')); } catch (e) {}</script>
  <div class="domande dq" data-materia={materia} data-bocconi-quiz={bocconi || undefined} data-argomento={argomento} data-titolo={arg.titolo} data-lingua={lingua} data-pref={pref} data-testi={JSON.stringify({ ...JS, ...JS2 })} data-ripasso={ripasso ? '1' : ''} data-torna-alla-materia={tornaAllaMateria ? '1' : ''} data-ritorno={hrefRitorno} data-brevi={JSON.stringify(brevi)}
    data-teoria={ripasso || usa ? '' : hrefSezione('teoria')} data-svolti={ripasso ? '' : hrefSezione('esercizi-svolti')} data-accedi={`${pref}/accedi?dopo=${hrefSezione('domande')}`}>
    <h1 class="dq-lettori">{pubblica ? titoloQuiz : arg.titolo}</h1>
    <p class="dq-lettori">{T.sommario}</p>

    <section class="dq-avvio">
      <div class="dq-riquadro">
      <p class="dq-capitolo" aria-hidden="true">{arg.titolo}</p>
      {ripasso && <p class="dq-materia">{m.titolo}</p>}
      {personale ? <p class="dq-spiega">{T.sommario}</p> : (
        <ul class="dq-dati">
          <li class="dq-k-d"><span class="dq-sim" set:html={SIMBOLI.domande} /><b>{n}</b><span>{P.domande}</span></li>
          <li class="dq-k-t"><span class="dq-sim" set:html={SIMBOLI.tempo} /><b>{tempoDomanda}</b><span>{P.perDomanda}</span></li>
          <li class="dq-k-e"><span class="dq-sim" set:html={SIMBOLI.exp} /><b>{expMassimi}</b><span>{P.exp}</span></li>
        </ul>
      )}
      <button type="button" class="bottone-primario avvia">{T.inizia}<Fragment set:html={freccia} /></button>
      <div class="dq-note">
    {(anteprimaScienza || anteprimaUsa) && <p class="nota nota-anteprima-scienza" data-usa-preview={anteprimaUsa || undefined}>
      {notaAnteprima} <a href={hrefSblocca}>{T.sblocca} · {m.prezzo} €</a>
    </p>}
    {['tolc-i', 'tolc-s'].includes(materia) && <p class="nota">{en ? 'Ten sample questions are available before unlocking ' + materia.toUpperCase() + '. Full access includes all questions and the section-timed simulation.' : <>Prima dello sblocco sono disponibili dieci quesiti dimostrativi complessivi. <a href={`/${materia}/sblocca`}>L’accesso {materia.toUpperCase()}</a> comprende tutti i quiz e la simulazione con tempi per sezione.</>}</p>}
    {materia === 'tiec' && <p class="nota">{en ? 'Ten sample questions are available before unlocking the TIEC course. Full access includes all questions and the full 48-question simulation.' : <>Prima dello sblocco sono disponibili dieci quesiti dimostrativi complessivi. <a href={`/${materia}/sblocca`}>L’accesso TIEC</a> comprende tutti i quiz e la simulazione completa da 48 quesiti in 60 minuti.</>}</p>}
    {materia === 'statistica' && <p class="nota">{en ? <>Ten sample questions are available across the course. <a href={`/en/${materia}/sblocca`}>Full access to Statistics and Probability</a> includes all {quizStatistica} questions with explanations.</> : <>Prima dello sblocco sono disponibili dieci quesiti dimostrativi complessivi nel corso. <a href={`/${materia}/sblocca`}>L’accesso completo a Statistica e probabilità</a> comprende tutti i {quizStatistica} quiz con spiegazione.</>}</p>}
    {semestreFiltro && materia !== 'matematica-semestre-filtro' && <NotaSemestreFiltro lingua={lingua} materia={materia} />}
    {materia === 'matematica-semestre-filtro' && <p class="nota">{en ? 'Mathematics practice for the filter semester. These questions train the prerequisites; they are not an official filter-semester exam.' : 'Allenamento di matematica per il semestre filtro. Queste domande servono a consolidare i prerequisiti; non costituiscono una prova ufficiale del semestre filtro.'}</p>}
      </div>
      </div>
      <nav class="dq-prova" aria-label="Versioni del riquadro" hidden>
        <span>Prova del riquadro</span><a href="?riquadro=oggi" data-v="oggi">Oggi</a><a href="?riquadro=a" data-v="a">A</a><a href="?riquadro=b" data-v="b">B</a><a href="?riquadro=c" data-v="c">C</a>
      </nav>
      <script is:inline>try { var n = document.currentScript.previousElementSibling, q = new URLSearchParams(location.search).get('riquadro'), c = document.documentElement.className.match(/dq-v-([abc])/); if (q || c) { n.hidden = false; var at = c ? c[1] : 'oggi'; n.querySelectorAll('a').forEach(function (a) { if (a.dataset.v === at) a.setAttribute('aria-current', 'true'); }); } } catch (e) {}</script>
    </section>

    <div class="nota-ospite" hidden>
      <p>{T.ospite}</p>
      <p class="azioni"><a class="bottone-secondario" href={`${pref}/accedi?dopo=${hrefSezione('domande')}`}>{T.accedi}</a></p>
    </div>

    <nav class="navigazione-domande" aria-label={T.navigazione} hidden>
      <button type="button" class="bottone-secondario precedente" aria-label={P.precedente} title={P.precedente} set:html={freccia} />
      <ol class="numeri-domande"></ol>
      <button type="button" class="bottone-secondario successiva" aria-label={P.successiva} title={P.successiva} set:html={freccia} />
    </nav>

    <section class="scheda-domanda" aria-live="polite" hidden>
      <div class="dq-stato">
        <p class="numero-domanda"></p>
        <div class="tempo" hidden>
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="11" r="6.5" /><path d="M10 7.500V11l2.200 1.600M8 2.500h4" /></svg>
          <span class="secondi">{tempoDomanda}</span>
        </div>
      </div>
      <div class="velo-blocco velo-scheda blocco-domande" hidden>
        {bocconi ? <>
          <h2>{en ? 'Timed questions are included in the full Bocconi course' : 'I quiz a tempo sono inclusi nel corso completo Bocconi'}</h2>
          <p><a class="bottone-sblocca" href={hrefSblocca}>{T.sblocca}</a></p>
          <a href={link(lingua, `/${materia}/simulazione#diagnostico`)}>{nomiProve.diagnostico}</a>
        </> : <>
          <p class="sopratitolo">{T.anteprima}</p>
          <h2>{T.bloccata}</h2>
          <a class="bottone-sblocca" href={hrefSblocca}>{T.sblocca}</a>
        </>}
      </div>
      <p class="nota-tempo" hidden></p>
      <div class="testo-domanda testo-studio"><p class="caricamento">{T.caricamento}</p></div>
      <div class="scelte" role="radiogroup" aria-label={T.risposte}></div>
      <p class="esito" hidden></p>
      <div class="spiegazione testo-studio" hidden></div>
      <div class="dq-ripassa" hidden></div>
      <div class="azioni-domanda">
        <button type="button" class="bottone-primario conferma" disabled hidden>{T.conferma}</button>
        <button type="button" class="bottone-primario prossima" hidden>{T.prossima}</button>
        <button type="button" class="bottone-primario vedi-risultato" hidden>{P.vedi}</button>
        <button type="button" class="dq-segnala" hidden><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 17V3.500M5 4h9l-1.800 3 1.800 3H5" /></svg>{P.segnala}</button>
      </div>
    </section>

    <section class="dq-risultato" hidden></section>
    <p class="dq-sotto"><button type="button" class="termina" hidden>{T.termina}</button></p>
    <section class="riepilogo-sessione" hidden></section>
  </div>
</Base>

<style is:global>
  /* Domande a tempo, percorso nuovo: tutto sotto .dq, così duelli e simulazioni non cambiano. */
  .dq { --dq-ocra: #8a5f1f; }
  .dq-lettori { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  html.sbloccato .nota-anteprima-scienza { display: none; }
  /* In questa pagina: niente «Argomento successivo» né «Segnala un errore» in fondo; al telefono niente «Cerca nel capitolo». */
  main:has(.dq) nav.passi, main:has(.dq) p.segnala-errore, main:has(.dq) .cerca-capitolo-mobile { display: none; }

  /* Prima */
  .dq-avvio { display: grid; justify-items: center; align-content: center; row-gap: 2.2rem; min-height: min(35rem, calc(100vh - 13rem)); padding-bottom: 1.5rem; text-align: center; font-family: var(--ui); }
  .dq-avvio[hidden], html.dq-subito .dq-avvio { display: none; }
  .dq-capitolo { margin: 0; font: 700 2rem/1.2 var(--titoli); color: var(--inchiostro); text-wrap: balance; }
  .dq-materia { margin: -1.8rem 0 0; font-size: 1rem; color: var(--inchiostro-2); }
  .dq-spiega { margin: -1rem 0 0; max-width: 34rem; font-size: 1rem; line-height: 1.5; color: var(--inchiostro-2); }
  .dq-dati { list-style: none; margin: 0; padding: 0; width: min(39rem, 100%); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .dq-dati li { display: grid; justify-items: center; align-content: start; gap: 0.45rem; padding: 0.3rem 1rem; border-left: 1px solid var(--riga); }
  .dq-dati li:first-child { border-left: 0; }
  .dq-k-d { --k: var(--c-definizione); } .dq-k-t { --k: var(--c-esempio); } .dq-k-e { --k: var(--c-osservazione); }
  .dq-sim { display: block; margin-bottom: 0.8rem; }
  .dq-sim svg { display: block; width: 3.9rem; height: 3.9rem; stroke-width: 2; }
  .dq-sim .b { fill: #fff; stroke: var(--k); }
  .dq-sim .t { fill: color-mix(in srgb, var(--k) 26%, #fff); stroke: none; }
  .dq-sim .b.tt { fill: color-mix(in srgb, var(--k) 20%, #fff); }
  .dq-sim .s { stroke: var(--k); }
  .dq-sim .p { fill: var(--k); stroke: none; }
  .dq-dati b { font: 700 3.3rem/1 var(--titoli); letter-spacing: -0.025em; color: var(--inchiostro); font-variant-numeric: tabular-nums; }
  .dq-dati li > span:last-child { font-size: 0.9rem; line-height: 1.3; color: var(--inchiostro-2); }
  .dq-avvio .avvia { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.95rem 4.5rem; font-size: 1.08rem; }
  .dq-avvio .avvia svg { width: 1.1em; height: 1.1em; }
  .dq-note { max-width: 36rem; font-size: 0.86rem; color: var(--inchiostro-2); }
  .dq-note:empty { display: none; }
  .dq-note .nota { margin: 0.4rem 0 0; }

  /* Prova delle versioni del riquadro iniziale (?riquadro=a|b|c); senza parametro resta la versione di oggi. */
  .dq-riquadro { display: contents; }
  .dq-prova { position: fixed; left: 50%; bottom: 1rem; translate: -50% 0; z-index: 1000; display: flex; align-items: center; gap: 0.3rem; padding: 0.35rem 0.4rem 0.35rem 0.9rem; border: 1px solid var(--riga); border-radius: 999px; background: #fff; box-shadow: 0 4px 18px rgb(0 0 0 / 0.08); font: 0.85rem var(--ui); color: var(--inchiostro-2); }
  .dq-prova[hidden] { display: none; }
  .dq-prova span { margin-right: 0.3rem; }
  .dq-prova a { padding: 0.3rem 0.75rem; border-radius: 999px; color: var(--inchiostro); text-decoration: none; font-weight: 600; }
  .dq-prova a[aria-current] { background: var(--verde); color: #fff; }
  html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-avvio { row-gap: 0; }
  html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-riquadro { display: grid; justify-items: center; width: min(42rem, 100%); border: 1px solid var(--riga); }
  html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-capitolo { font-size: 1.6rem; }
  html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-materia { margin: -0.9rem 0 0; }
  html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-spiega { margin: 0; }
  html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-avvio .avvia { padding: 0.72rem 2.6rem; font-size: 1rem; }
  html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-note { padding-inline: 1rem; }
  /* A · Riquadro bianco */
  html.dq-v-a .dq-riquadro { width: min(40rem, 100%); background: #fff; border-radius: 16px; padding: 2rem 2rem 1.9rem; row-gap: 1.6rem; }
  html.dq-v-a .dq-dati { width: 100%; }
  html.dq-v-a .dq-dati li { gap: 0.25rem; padding: 0.1rem 0.6rem; }
  html.dq-v-a .dq-sim { margin-bottom: 0.35rem; }
  html.dq-v-a .dq-sim svg { width: 2.4rem; height: 2.4rem; }
  html.dq-v-a .dq-dati b { font-size: 1.9rem; letter-spacing: -0.02em; }
  html.dq-v-a .dq-dati li > span:last-child { font-size: 0.84rem; }
  /* B · Riquadro con fascia */
  html.dq-v-b .dq-riquadro { background: #fff; border-radius: 16px; overflow: hidden; padding-bottom: 1.5rem; }
  html.dq-v-b .dq-capitolo { padding: 1.9rem 2rem 1.5rem; }
  html.dq-v-b .dq-materia { margin: -1rem 0 1.2rem; }
  html.dq-v-b .dq-spiega { padding: 0 2rem 1.4rem; }
  html.dq-v-b .dq-dati { width: 100%; display: flex; justify-content: center; flex-wrap: wrap; gap: 0.6rem 1.6rem; padding: 0.95rem 1.2rem; margin-bottom: 1.4rem; background: color-mix(in srgb, var(--carta-2) 70%, #fff); border-block: 1px solid var(--riga); }
  html.dq-v-b .dq-dati li { display: flex; align-items: center; gap: 0.55rem; padding: 0; border: 0; }
  html.dq-v-b .dq-sim { margin: 0; }
