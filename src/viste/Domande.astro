---
// Domande a tempo di un argomento: una alla volta, due minuti ciascuna, spiegazione subito dopo la conferma.
// I testi arrivano dal Worker (/api/domande/…): la risposta corretta non è mai nella pagina.
import Base from '../layouts/Base.astro';
import { argomentoL, materiaL, link, prefisso, type Lingua } from '../i18n';
interface Props { lingua: Lingua; materia: string; argomento: string; totale: number }
const { lingua, materia, argomento, totale } = Astro.props;
const arg = argomentoL(lingua, materia, argomento);
const m = materiaL(lingua, materia);
const base = `/${materia}/${argomento}`;
const pref = prefisso(lingua);
const en = lingua === 'en';
const T = en ? {
  titolo: 'Timed questions', descr: `Multiple-choice questions on ${arg.titolo} (${m.titolo}), two minutes each, with the explanation after every answer.`,
  termina: 'End the session', sommario: `${totale} multiple-choice questions on the exercises of this topic, one at a time, two minutes each. The explanation appears after every answer.`,
  ospite: 'You can answer the questions without an account. Experience points, level and goals are saved with a free account.', accedi: 'Create an account or log in',
  caricamento: 'Loading the question…', risposte: 'Answers', conferma: 'Confirm your answer', prossima: 'Next question', svolti: 'Worked examples of this topic',
} : {
  titolo: 'Domande a tempo', descr: `Domande a risposta multipla su ${arg.titolo} (${m.titolo}), con due minuti per ciascuna e la spiegazione dopo ogni risposta.`,
  termina: 'Termina la sessione', sommario: `${totale} domande a risposta multipla sugli esercizi di questo argomento, una alla volta, con due minuti per ciascuna. Dopo ogni risposta compare la spiegazione.`,
  ospite: 'Le domande si possono fare anche senza account. I punti esperienza, il livello e gli obiettivi si salvano con un account gratuito.', accedi: 'Crea un account o accedi',
  caricamento: 'Caricamento della domanda…', risposte: 'Risposte', conferma: 'Conferma la risposta', prossima: 'Domanda successiva', svolti: 'Esercizi svolti di questo argomento',
};
// Testi usati dallo script nel browser.
const JS = en ? {
  caricamento: T.caricamento, errore: 'The questions did not load. Reload the page.', bonus: 'Speed bonus for another § seconds',
  giusta: 'Correct answer', scaduto: 'Time is up. The correct answer is §', corretta: 'The correct answer is §',
  veloce: ' (with speed bonus)', ripetuta: ', half points because already answered correctly this week',
  presto: ', but given in less than 10 seconds: no points', tardi: ', but after the time limit: no points', nonArrivata: 'The answer did not arrive. Reload the page.',
  spiegazione: 'Explanation', conclusa: 'Study session completed', minuto: '1 minute of active study', minuti: '§ minutes of active study', sessioneConclusa: 'Session completed',
  unaCorretta: '1 correct answer', piuCorrette: '§ correct answers', su: 'out of', righeCorrette: 'Correct answers', righeStudio: 'Active study', totale: 'Total',
  livello: 'Level', massimo: 'Maximum level', alLivello: 'to level', obiettivi: 'Weekly goals', completato: 'Completed', tornaEsercizi: 'Back to the exercises', percorso: 'Your progress',
} : {
  caricamento: T.caricamento, errore: 'Le domande non si sono caricate. Ricarica la pagina.', bonus: 'Bonus velocità ancora per § secondi',
  giusta: 'Risposta corretta', scaduto: 'Tempo scaduto. La risposta corretta è la §', corretta: 'La risposta corretta è la §',
  veloce: ' (con bonus velocità)', ripetuta: ', metà punti perché già indovinata questa settimana',
  presto: ', ma data in meno di 10 secondi: nessun punto', tardi: ', ma oltre il tempo: nessun punto', nonArrivata: 'La risposta non è arrivata. Ricarica la pagina.',
  spiegazione: 'Spiegazione', conclusa: 'Sessione di studio conclusa', minuto: '1 minuto di studio attivo', minuti: '§ minuti di studio attivo', sessioneConclusa: 'Sessione conclusa',
  unaCorretta: '1 risposta corretta', piuCorrette: '§ risposte corrette', su: 'su', righeCorrette: 'Risposte corrette', righeStudio: 'Studio attivo', totale: 'Totale',
  livello: 'Livello', massimo: 'Livello massimo', alLivello: 'al livello', obiettivi: 'Obiettivi della settimana', completato: 'Completato', tornaEsercizi: 'Torna agli esercizi', percorso: 'Il tuo percorso',
};
---
<Base
  titolo={`${arg.titolo} · ${T.titolo}`}
  descrizione={T.descr}
  percorso={[{ titolo: arg.breve, href: link(lingua, `${base}/teoria`) }, { titolo: T.titolo }]}
  materia={materia} argomento={argomento} sezione="domande" lingua={lingua}
>
  <div class="domande" data-materia={materia} data-argomento={argomento} data-titolo={arg.titolo} data-lingua={lingua} data-pref={pref} data-testi={JSON.stringify(JS)}>
    <div class="domande-testa">
      <div>
        <p class="sopratitolo">{T.titolo}</p>
        <h1>{arg.titolo}</h1>
      </div>
      <button type="button" class="bottone-secondario termina" hidden>{T.termina}</button>
    </div>
    <p class="sommario">{T.sommario}</p>

    <div class="nota-ospite" hidden>
      <p>{T.ospite}</p>
      <p class="azioni"><a class="bottone-secondario" href={`${pref}/accedi?dopo=${pref}${base}/domande`}>{T.accedi}</a></p>
    </div>

    <section class="scheda-domanda" aria-live="polite">
      <div class="tempo" hidden>
        <svg viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="12" r="8" /><path d="M11 8v4l2.5 2M9 2h4" /></svg>
        <div class="barra-tempo"><span></span></div>
        <span class="secondi">2:00</span>
      </div>
      <p class="nota-tempo" hidden></p>
      <div class="testo-domanda testo-studio"><p class="caricamento">{T.caricamento}</p></div>
      <div class="scelte" role="radiogroup" aria-label={T.risposte}></div>
      <p class="esito" hidden></p>
      <div class="spiegazione testo-studio" hidden></div>
      <div class="azioni-domanda">
        <button type="button" class="bottone-primario conferma" disabled hidden>{T.conferma}</button>
        <button type="button" class="bottone-primario prossima" hidden>{T.prossima}</button>
        <a class="link-svolti" href={link(lingua, `${base}/esercizi-svolti`)} hidden>{T.svolti}</a>
      </div>
    </section>

    <section class="riepilogo-sessione" hidden></section>
  </div>
</Base>

<script>
  const radice = document.querySelector<HTMLElement>('.domande')!;
  const { materia, argomento, titolo, lingua, pref } = radice.dataset as { materia: string; argomento: string; titolo: string; lingua: string; pref: string };
  const L = JSON.parse(radice.dataset.testi || '{}') as Record<string, string>;
  const f = (k: string, x: string | number) => L[k].replace('§', String(x));
  const $ = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
  const testo = $('.testo-domanda'), scelte = $('.scelte'), esito = $('.esito'), spieg = $('.spiegazione');
  const conferma = $<HTMLButtonElement>('.conferma'), prossima = $<HTMLButtonElement>('.prossima'), svolti = $('.link-svolti');
  const tempo = $('.tempo'), barra = $('.barra-tempo span'), secondiEl = $('.secondi'), notaTempo = $('.nota-tempo');
  const termina = $<HTMLButtonElement>('.termina'), scheda = $('.scheda-domanda'), riepilogo = $('.riepilogo-sessione');
  const LETTERE = ['A', 'B', 'C', 'D'];
  const chiaveViste = `domande-viste-${materia}-${argomento}`;
  let viste: string[] = [];
  try { viste = JSON.parse(localStorage.getItem(chiaveViste) || '[]'); } catch {}
  let corrente: { token: string; id: string; secondi: number; collegato: boolean } | null = null;
  let scelta = 0, inizio = 0, timer = 0, chiusa = false;
  const post = (url: string, dati: unknown) => fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(dati) });
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  const num = (x: number) => x.toLocaleString(lingua === 'en' ? 'en-US' : 'it-IT');
  const adatta = () => dispatchEvent(new Event('resize')); // le formule in display si adattano alla larghezza

  function aggiornaTempo() {
    const passati = Math.floor((Date.now() - inizio) / 1000);
    const resto = Math.max(0, (corrente?.secondi || 120) - passati);
    secondiEl.textContent = mmss(resto);
    barra.style.width = `${(resto / (corrente?.secondi || 120)) * 100}%`;
    const bonus = 60 - passati;
    notaTempo.hidden = !corrente?.collegato || bonus <= 0;
    notaTempo.textContent = bonus > 0 ? f('bonus', bonus) : '';
    if (resto === 0 && !chiusa) invia(true);
  }

  async function carica() {
    chiusa = false; scelta = 0;
    esito.hidden = true; spieg.hidden = true; prossima.hidden = true; svolti.hidden = true;
    conferma.hidden = false; conferma.disabled = true;
    scelte.innerHTML = '';
    testo.innerHTML = `<p class="caricamento">${L.caricamento}</p>`;
    const r = await post('/api/domande/prossima', { materia, argomento, viste, lingua }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    if (!d) { testo.innerHTML = `<p>${L.errore}</p>`; conferma.hidden = true; return; }
    corrente = d;
    (radice.querySelector('.nota-ospite') as HTMLElement).hidden = d.collegato;
    termina.hidden = !d.collegato;
    viste = [...viste.filter((x) => x !== d.id), d.id].slice(-200);
    try { localStorage.setItem(chiaveViste, JSON.stringify(viste)); } catch {}
    testo.innerHTML = d.testo;
    d.scelte.forEach((html: string, i: number) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'scelta'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', 'false');
      b.innerHTML = `<span class="lettera">${LETTERE[i]}</span><span class="valore">${html}</span>`;
      b.addEventListener('click', () => {
        if (chiusa) return;
        scelta = i + 1;
        scelte.querySelectorAll('.scelta').forEach((x, j) => { x.classList.toggle('scelta-attiva', j === i); x.setAttribute('aria-checked', String(j === i)); });
        conferma.disabled = false;
      });
      scelte.appendChild(b);
    });
    adatta();
    inizio = Date.now();
    tempo.hidden = false;
    clearInterval(timer);
    aggiornaTempo();
    timer = window.setInterval(aggiornaTempo, 1000);
  }

  async function invia(scaduto = false) {
    if (chiusa || !corrente) return;
    chiusa = true;
    clearInterval(timer);
    conferma.hidden = true; notaTempo.hidden = true;
    const r = await post('/api/domande/rispondi', { token: corrente.token, scelta: scaduto ? 0 : scelta }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    if (!d) { esito.hidden = false; esito.textContent = L.nonArrivata; return; }
    scelte.querySelectorAll<HTMLElement>('.scelta').forEach((b, j) => {
      b.classList.add('scelta-chiusa');
      if (j + 1 === d.corretta) b.classList.add('scelta-giusta');
      else if (j + 1 === scelta) b.classList.add('scelta-sbagliata');
    });
    let frase = d.giusta ? L.giusta : f(scaduto ? 'scaduto' : 'corretta', LETTERE[d.corretta - 1]);
    if (d.punti > 0) frase += ` · +${d.punti} EXP` + (d.veloce ? L.veloce : '') + (d.motivo === 'ripetuta' ? L.ripetuta : '');
    else if (d.giusta && d.motivo === 'troppo-presto') frase += L.presto;
    else if (d.giusta && d.motivo === 'tempo-scaduto') frase += L.tardi;
    esito.textContent = `${frase}.`;
    esito.className = `esito ${d.giusta ? 'esito-giusto' : 'esito-sbagliato'}`;
    esito.hidden = false;
    spieg.innerHTML = `<h2>${L.spiegazione}</h2>${d.spiegazione}`;
    spieg.hidden = false;
    prossima.hidden = false; svolti.hidden = false;
    adatta();
    if (d.stato) dispatchEvent(new CustomEvent('livello', { detail: d.stato }));
    if (d.nuovi?.length) dispatchEvent(new CustomEvent('premi', { detail: d.nuovi }));
  }

  conferma.addEventListener('click', () => invia());
  prossima.addEventListener('click', () => { carica(); scheda.scrollIntoView({ behavior: 'smooth', block: 'start' }); });

  termina.addEventListener('click', async () => {
    clearInterval(timer);
    const r = await post('/api/sessione/riepilogo', { chiudi: true, lingua }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    scheda.hidden = true; termina.hidden = true;
    const s = d?.sessione;
    const st = d?.stato;
    const righe = s ? [
      [`${L.righeCorrette} (${s.corrette})`, s.puntiCorrette],
      [`${L.righeStudio} (${s.minuti} min)`, s.puntiStudio],
      ...s.premi.map((p: { nome: string; punti: number }) => [p.nome, p.punti]),
    ] : [];
    const obiettivi = (d?.obiettivi || []).map((o: { testo: string; fatto: number; totale: number; completato: boolean }) =>
      `<li><span>${o.testo}</span><span>${o.completato ? L.completato : `${o.fatto} / ${o.totale}`}</span><span class="barra-exp"><span style="width:${Math.round((o.fatto / o.totale) * 100)}%"></span></span></li>`).join('');
    riepilogo.innerHTML = `
      <p class="sopratitolo">${L.conclusa} · ${s?.titolo || titolo}</p>
      <h2>${s ? (s.minuti === 1 ? L.minuto : f('minuti', s.minuti)) : L.sessioneConclusa}</h2>
      ${s ? `<p>${s.corrette === 1 ? L.unaCorretta : f('piuCorrette', s.corrette)} ${L.su} ${s.risposte}</p>` : ''}
      ${righe.length ? `<dl class="conti-exp">${righe.map(([k, v]) => `<div><dt>${k}</dt><dd>+${v}</dd></div>`).join('')}<div class="totale"><dt>${L.totale}</dt><dd>+${s.punti} EXP</dd></div></dl>` : ''}
      ${st ? `<p class="riep-livello"><strong>${L.livello} ${st.livello} · ${st.fascia}</strong></p>
        <div class="barra-exp grande"><span style="width:${st.perc}%"></span></div>
        <p class="riep-numeri"><span>${num(st.exp)} EXP</span><span>${st.prossimo === null ? L.massimo : `${num(st.mancano)} ${L.alLivello} ${st.livello + 1}`}</span></p>` : ''}
      ${obiettivi ? `<h3>${L.obiettivi}</h3><ul class="obiettivi">${obiettivi}</ul>` : ''}
      <p class="azioni-riepilogo"><a class="bottone-primario" href="${pref}/${materia}/${argomento}/esercizi">${L.tornaEsercizi}</a> <a class="bottone-secondario" href="${pref}/account#percorso">${L.percorso}</a></p>`;
    riepilogo.hidden = false;
    riepilogo.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  carica();
</script>
