    .dq-dati li { padding: 0.2rem 0.4rem; }
    .dq-dati b { font-size: 2.1rem; }
    .dq-dati li > span:last-child { font-size: 0.76rem; }
    .dq-sim svg { width: 3rem; height: 3rem; }
    .dq-avvio .avvia { width: 100%; justify-content: center; padding-inline: 1rem; }
    html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-capitolo { font-size: 1.3rem; }
    html:is(.dq-v-a, .dq-v-b, .dq-v-c) .dq-avvio .avvia { width: 100%; }
    html.dq-v-a .dq-riquadro { padding: 1.5rem 1rem 1.2rem; row-gap: 1.3rem; }
    html.dq-v-a .dq-dati li { padding: 0 0.3rem; }
    html.dq-v-a .dq-sim svg { width: 2rem; height: 2rem; }
    html.dq-v-a .dq-dati b { font-size: 1.5rem; }
    html.dq-v-a .dq-dati li > span:last-child { font-size: 0.74rem; }
    html.dq-v-b .dq-riquadro { padding-bottom: 1rem; }
    html.dq-v-b .dq-capitolo { padding: 1.4rem 1rem 1.1rem; }
    html.dq-v-b .dq-dati { gap: 0.5rem 1.1rem; padding: 0.8rem; margin-bottom: 1rem; }
    html.dq-v-b .dq-dati li { gap: 0.4rem; }
    html.dq-v-b .dq-sim svg { width: 1.6rem; height: 1.6rem; }
    html.dq-v-b .dq-dati b { font-size: 1.1rem; }
    html.dq-v-b .dq-dati li > span:last-child { font-size: 0.8rem; }
    html.dq-v-b .dq-avvio .avvia { width: calc(100% - 2rem); }
    html.dq-v-c .dq-riquadro { padding: 1.4rem 1rem 1.2rem; row-gap: 1rem; }
    html.dq-v-c .dq-capitolo { font-size: 1.25rem; }
    html.dq-v-c .dq-dati { flex-direction: column; align-items: flex-start; gap: 0.45rem; }
    .dq-prova { bottom: 0.6rem; font-size: 0.8rem; }
    .dq-prova span { display: none; }
    .dq .numeri-domande { gap: 3px; }
    .dq .scheda-domanda { padding: 1rem 0.95rem 1.1rem; }
    .dq .azioni-domanda .bottone-primario { width: 100%; }
    .dq-segnala { margin-left: 0; }
    .dq-risultato { padding: 1.2rem 1rem; }
    .dq-voto b { font-size: 2.7rem; }
    .dq-lista li { flex-wrap: wrap; gap: 0.5rem; }
    .dq-azioni .bottone-primario { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .dq .scelta, .dq .numeri-domande .numero::after { transition: none; } }
</style>

<script>
  const radice = document.querySelector<HTMLElement>('.domande')!;
  const { materia, argomento, titolo, lingua, pref } = radice.dataset as { materia: string; argomento: string; titolo: string; lingua: string; pref: string };
  const bocconi = radice.hasAttribute('data-bocconi-quiz');
  const L = JSON.parse(radice.dataset.testi || '{}') as Record<string, string>;
  const f = (k: string, x: string | number) => L[k].replace('§', String(x));
  const $ = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
  const testo = $('.testo-domanda'), scelte = $('.scelte'), esito = $('.esito'), spieg = $('.spiegazione');
  const conferma = $<HTMLButtonElement>('.conferma'), prossima = $<HTMLButtonElement>('.prossima'), vedi = $<HTMLButtonElement>('.vedi-risultato');
  const ripassa = $('.dq-ripassa'), segnala = $<HTMLButtonElement>('.dq-segnala');
  const ripasso = radice.dataset.ripasso === '1';
  const tornaAllaMateria = radice.dataset.tornaAllaMateria === '1';
  const brevi = JSON.parse(radice.dataset.brevi || '{}') as Record<string, string>;
  const argDi = (id: string) => id.split('/')[0];
  // Domande proposte nelle ultime sessioni: il server le ripropone solo dopo quelle mai viste.
  const chiaveRecenti = `domande-recenti-${materia}-${argomento}`;
  let recenti: string[] = [];
  try { recenti = JSON.parse(localStorage.getItem(chiaveRecenti) || '[]'); } catch { /* niente memoria */ }
  const tempo = $('.tempo'), secondiEl = $('.secondi'), notaTempo = $('.nota-tempo');
  const termina = $<HTMLButtonElement>('.termina'), scheda = $('.scheda-domanda'), riepilogo = $('.riepilogo-sessione');
  const risultato = $('.dq-risultato'), avvio = $('.dq-avvio');
  const nav = $('.navigazione-domande'), numeri = $('.numeri-domande'), numeroEl = $('.numero-domanda');
  const blocco = $('.blocco-domande');
  const prec = $<HTMLButtonElement>('.precedente'), succ = $<HTMLButtonElement>('.successiva');
  const LETTERE = ['A', 'B', 'C', 'D', 'E'];
  const post = (url: string, dati: unknown) => fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(dati) });
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  const num = (x: number) => x.toLocaleString(lingua === 'en' ? 'en-US' : 'it-IT');
  const adatta = () => dispatchEvent(new Event('resize')); // le formule in display si adattano alla larghezza
  const IC = {
    libro: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 5.5C8.5 4.3 6.3 4 3.5 4v11c2.8 0 5 .3 6.500 1.500 1.500-1.200 3.700-1.500 6.500-1.500V4c-2.800 0-5 .3-6.500 1.500zM10 5.500v11"/></svg>',
    foglio: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3.500" width="14" height="13" rx="2.500"/><path d="M6.500 8h7M6.500 12h4.500"/></svg>',
    spunta: '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.500 10.500l3.500 3.500 7.500-8"/></svg>',
  };

  // Stato della pagina: l'ordine delle domande e, per ognuna, la domanda caricata, la scelta e l'esito.
  interface Domanda { token: string; id: string; numero: number; testo: string; scelte: string[]; secondi: number; collegato: boolean }
  interface Rimandi { k: string; argomento: string; abilita: string; t: { id: string; titolo: string }[]; s: { n: number; titolo: string }[] }
  interface Esito { giusta: boolean; corretta: number; spiegazione: string; punti: number; veloce?: boolean; motivo?: string; scelta: number; scaduto: boolean; rimandi?: Rimandi }
  let ordine: string[] = [];
  let pos = 0, lunghezzaSerie = 0, collegato = false;
  const domande = new Map<string, Domanda>();
  const esiti = new Map<string, Esito>();
  let corrente: Domanda | null = null;
  let scelta = 0, inizio = 0, timer = 0, ultimaRichiesta = 0;

  function aggiornaTempo() {
    if (!corrente) return;
    const passati = Math.floor((Date.now() - inizio) / 1000);
    const resto = Math.max(0, corrente.secondi - passati);
    secondiEl.textContent = mmss(resto);
    tempo.classList.toggle('poco', resto <= 20);
    const bonus = 60 - passati;
    if (resto === 0) { notaTempo.hidden = false; notaTempo.textContent = L.scaduto2; clearInterval(timer); return; }
    notaTempo.hidden = !corrente.collegato || bonus <= 0;
    notaTempo.textContent = bonus > 0 ? f('bonus', bonus) : '';
  }

  // L'avanzamento: un segmento per domanda (verde giusta, ocra sbagliata), cliccabile.
  function disegnaNumeri() {
    numeri.innerHTML = '';
    for (let i = 0; i < lunghezzaSerie; i++) {
      const li = document.createElement('li');
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = String(i + 1);
      const id = ordine[i];
      const e = id ? esiti.get(id) : undefined;
      b.className = ['numero', e ? (e.giusta ? 'numero-giusto' : 'numero-sbagliato') : '', id ? '' : 'numero-bloccato', i === pos ? 'numero-attivo' : ''].join(' ').trim();
      b.setAttribute('aria-label', id ? f('domandaN', i + 1) : f('numeroBloccato', i + 1));
      b.title = f('domandaN', i + 1);
      if (i === pos) b.setAttribute('aria-current', 'step');
      b.addEventListener('click', () => vai(i));
      li.appendChild(b);
      numeri.appendChild(li);
    }
    prec.disabled = pos <= 0;
    succ.disabled = pos >= lunghezzaSerie - 1;
    const daArg = ripasso && ordine[pos] && brevi[argDi(ordine[pos])] ? ` · ${brevi[argDi(ordine[pos])]}` : '';
    numeroEl.textContent = lunghezzaSerie ? `${f('numero', pos + 1)} ${lunghezzaSerie}${daArg}` : '';
  }

  function mostraScelte(d: Domanda, e?: Esito) {
    scelte.innerHTML = '';
    d.scelte.forEach((html, i) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'scelta'; b.setAttribute('role', 'radio'); b.setAttribute('aria-checked', 'false');
      b.innerHTML = `<span class="lettera">${LETTERE[i]}</span><span class="valore">${html}</span>`;
      if (e) {
        b.classList.add('scelta-chiusa');
        if (i + 1 === e.corretta) b.classList.add('scelta-giusta');
        else if (i + 1 === e.scelta) b.classList.add('scelta-sbagliata');
      } else {
        b.addEventListener('click', () => {
          scelta = i + 1;
          scelte.querySelectorAll('.scelta').forEach((x, j) => { x.classList.toggle('scelta-attiva', j === i); x.setAttribute('aria-checked', String(j === i)); });
          conferma.disabled = false;
        });
      }
      scelte.appendChild(b);
    });
  }

  // Collegamenti di una domanda: il paragrafo di teoria e la scheda svolta della sua abilità (se la materia è
  // classificata), altrimenti la teoria e gli esercizi svolti del capitolo.
  function collegamenti(r: Rimandi | undefined, id: string): string {
    if (r && (r.t.length || r.s.length)) {
      const base = `${pref}/${materia}/${r.argomento}`;
      return [
        ...r.t.map((t) => `<a href="${base}/teoria#${t.id}">${IC.libro}${t.titolo}</a>`),
        ...r.s.map((s) => `<a href="${base}/esercizi-svolti/${s.n}">${IC.foglio}${f('scheda', s.n)}</a>`),
      ].join('');
    }
    const teoria = ripasso ? `${pref}/${materia}/${argDi(id)}/teoria` : radice.dataset.teoria;
    const svolti = ripasso ? `${pref}/${materia}/${argDi(id)}/esercizi-svolti` : radice.dataset.svolti;
    return [teoria ? `<a href="${teoria}">${IC.libro}${L.teoriaCap}</a>` : '', svolti ? `<a href="${svolti}">${IC.foglio}${L.svoltiCap}</a>` : ''].join('');
  }

  // Le domande libere della serie hanno tutte una risposta (nell'anteprima con domande bloccate il risultato non c'è).
  const libere = () => ordine.filter(Boolean);
  const serieFinita = () => lunghezzaSerie > 0 && libere().length === lunghezzaSerie
    && (libere().every((id) => esiti.has(id)) || (pos >= lunghezzaSerie - 1 && esiti.has(ordine[pos])));

  function mostraEsito(e: Esito) {
    let frase = e.giusta ? L.giusta : f(e.scaduto ? 'scaduto' : 'corretta', LETTERE[e.corretta - 1]);
    if (e.punti > 0) frase += ` · +${e.punti} ${lingua === 'en' ? 'XP' : 'EXP'}` + (e.veloce ? L.veloce : '') + (e.motivo === 'ripetuta' ? L.ripetuta : '');
    else if (e.giusta && e.motivo === 'tempo-scaduto') frase += L.tardi;
    esito.textContent = `${frase}.`;
    esito.className = `esito ${e.giusta ? 'esito-giusto' : 'esito-sbagliato'}`;
    esito.hidden = false;
    spieg.innerHTML = `<h2>${L.spiegazione}</h2>${e.spiegazione}`;
    spieg.hidden = false;
    const link = e.giusta || !corrente ? '' : collegamenti(e.rimandi, corrente.id);
    ripassa.innerHTML = link ? `<span>${L.daRipassare}</span><span class="dq-link">${link}</span>` : '';
    ripassa.hidden = !link;
    conferma.hidden = true; tempo.hidden = true;
    vedi.hidden = !serieFinita();
    prossima.hidden = pos >= lunghezzaSerie - 1 || !vedi.hidden;
    segnala.hidden = false;
  }

  // Apre la domanda in posizione i. Una domanda non ancora risolta si ricarica con un tempo nuovo di due minuti.
  async function vai(i: number) {
    clearInterval(timer);
    const richiesta = ++ultimaRichiesta;
    pos = Math.max(0, Math.min(i, lunghezzaSerie - 1));
    corrente = null;
    scelta = 0;
    esito.hidden = true; spieg.hidden = true; prossima.hidden = true; vedi.hidden = true; ripassa.hidden = true; segnala.hidden = true; notaTempo.hidden = true;
    conferma.hidden = true; conferma.disabled = true; tempo.hidden = true;
    const id = ordine[pos];
    const bloccata = ordine.length > 0 && !id;
    blocco.hidden = !bloccata;
    testo.hidden = bloccata;
    if (bloccata) {
      scelte.replaceChildren();
      disegnaNumeri();
      return;
    }
    const e = id ? esiti.get(id) : undefined;
    if (e) {
      corrente = domande.get(id)!;
      testo.innerHTML = corrente.testo;
      mostraScelte(corrente, e);
      mostraEsito(e);
      disegnaNumeri();
      adatta();
      return;
    }
    scelte.innerHTML = '';
    testo.innerHTML = `<p class="caricamento">${L.caricamento}</p>`;
    const r = await post('/api/domande/prossima', id ? { materia, argomento, id, lingua } : { materia, argomento, recenti, lingua }).catch(() => null);
    const d0 = r ? await r.json().catch(() => null) : null;
    const d = r && r.ok ? d0 : null;
    // Con una rete lenta e più tocchi di fila conta solo l'ultima domanda chiesta.
    if (richiesta !== ultimaRichiesta) return;
    if (!d) {
      if (bocconi && r?.status === 403) {
        blocco.hidden = false;
        testo.hidden = true;
        nav.hidden = true;
        return;
      }
      // Il Worker spiega il motivo (per esempio: ripasso di oggi senza account, oppure nessuna domanda da ripassare).
      const p = document.createElement('p');
      p.textContent = d0?.errore || L.errore;
      testo.replaceChildren(p);
      if (r?.status === 401) (radice.querySelector('.nota-ospite') as HTMLElement).hidden = false;
      return;
    }
    if (!ordine.length) {
      ordine = d.ordine; nav.hidden = false;
      lunghezzaSerie = d.lunghezzaSerie ?? ordine.length;
      recenti = [...recenti.filter((x) => !ordine.includes(x)), ...ordine].slice(-300);
      try { localStorage.setItem(chiaveRecenti, JSON.stringify(recenti)); } catch { /* niente memoria */ }
    }
    // Numero in alto e domanda mostrata restano allineati anche se il server ne restituisce un'altra.
    if (ordine.indexOf(d.id) >= 0) pos = ordine.indexOf(d.id);
    if (esiti.has(d.id)) { vai(pos); return; }
    corrente = d;
    domande.set(d.id, d);
    collegato = d.collegato;
    termina.hidden = !d.collegato;
    testo.innerHTML = d.testo;
    mostraScelte(d);
    conferma.hidden = false;
    disegnaNumeri();
    adatta();
    inizio = Date.now();
    tempo.hidden = false;
    aggiornaTempo();
    timer = window.setInterval(aggiornaTempo, 1000);
  }

  async function invia() {
    if (!corrente || !scelta || esiti.has(corrente.id)) return;
    clearInterval(timer);
    conferma.hidden = true; notaTempo.hidden = true;
    const d0 = corrente;
    const scaduto = Date.now() - inizio > d0.secondi * 1000;
    const r = await post('/api/domande/rispondi', { token: d0.token, scelta }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    if (!d) {
      if (corrente?.id !== d0.id) return;
      if (bocconi && r?.status === 403) {
        blocco.hidden = false; testo.hidden = true; tempo.hidden = true; nav.hidden = true;
        scelte.replaceChildren();
      } else { esito.hidden = false; esito.textContent = L.nonArrivata; }
      return;
    }
    const e: Esito = { ...d, scelta, scaduto };
    esiti.set(d0.id, e);
    if (corrente?.id !== d0.id) return;
    mostraScelte(d0, e);
    mostraEsito(e);
    disegnaNumeri();
    adatta();
    if (d.stato) dispatchEvent(new CustomEvent('livello', { detail: d.stato }));
    if (d.nuovi?.length) dispatchEvent(new CustomEvent('premi', { detail: d.nuovi }));
  }

  // Risultato della serie: quante corrette, gli argomenti da ripassare con i collegamenti, quelli andati bene.
  function mostraRisultato() {
    clearInterval(timer);
    const righe = ordine.map((id) => ({ id, e: esiti.get(id) }));
    const ok = righe.filter((x) => x.e?.giusta).length;
    const sbagliate = righe.filter((x) => x.e && !x.e.giusta);
    const saltate = righe.filter((x) => !x.e).length;
    // Per argomento (abilità) quando la materia è classificata; altrimenti un solo gruppo con i collegamenti del capitolo.
    const gruppi = new Map<string, { nome: string; link: string; err: number; tot: number }>();
    for (const x of righe) {
      if (!x.e) continue;
      const r = x.e.rimandi;
      const k = r?.k ?? (ripasso ? argDi(x.id) : '');
      const g = gruppi.get(k) ?? { nome: r?.abilita ?? (ripasso ? brevi[argDi(x.id)] ?? titolo : titolo), link: collegamenti(r, x.id), err: 0, tot: 0 };
      g.tot++; if (!x.e.giusta) g.err++;
      gruppi.set(k, g);
    }
    const tutti = [...gruppi.values()];
    const deboli = tutti.filter((g) => g.err).sort((a, b) => b.err - a.err);
    const forti = tutti.filter((g) => !g.err);
    const classificata = righe.some((x) => x.e?.rimandi) || ripasso;
    const n = sbagliate.length;
    risultato.innerHTML = `
      <div class="dq-voto"><p><b>${ok}</b> ${L.su} ${lunghezzaSerie}</p><span>${ok === 1 ? L.unaCorrettaR : L.corrette}${saltate ? ` · ${f('senzaRisposta', saltate)}` : ''}</span></div>
      <div class="dq-barra" aria-hidden="true">${righe.map((x) => `<i class="${x.e ? (x.e.giusta ? 'ok' : 'no') : ''}"></i>`).join('')}</div>
      ${deboli.length ? `<h2 class="no">${L.daRipassare}</h2>
        <ul class="dq-lista">${deboli.map((g) => `<li><div class="dq-cosa"><b>${g.nome}</b><span class="dq-link">${g.link}</span></div><span class="dq-err">${g.err === 1 ? L.errore1 : f('erroriN', g.err)}</span></li>`).join('')}</ul>` : `<p class="dq-pulito">${L.nessunErrore}</p>`}
      ${classificata && forti.length && deboli.length ? `<h2>${L.andatiBene}</h2><ul class="dq-bene">${forti.map((g) => `<li>${IC.spunta}${g.nome}</li>`).join('')}</ul>` : ''}
      <div class="dq-azioni">${n ? `<button type="button" class="bottone-primario dq-rifai">${n === 1 ? L.rifai1 : f('rifaiN', n)}</button><button type="button" class="dq-testo dq-nuova">${L.nuova}</button>`
        : `<button type="button" class="bottone-primario dq-nuova">${L.nuova}</button>`}</div>
      ${collegato ? '' : `<p class="dq-ospite">${L.ospiteRis} <a href="${radice.dataset.accedi}">${L.accedi}</a></p>`}`;
    risultato.querySelector('.dq-rifai')?.addEventListener('click', () => rifai(sbagliate.map((x) => x.id)));
    risultato.querySelector('.dq-nuova')?.addEventListener('click', nuovaSerie);
    scheda.hidden = true; nav.hidden = true; risultato.hidden = false;
    adatta();
    scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Le sole domande sbagliate, di nuovo: stesse domande, tempo nuovo.
  function rifai(ids: string[]) {
    ordine = ids; lunghezzaSerie = ids.length;
    ids.forEach((id) => { esiti.delete(id); domande.delete(id); });
    risultato.hidden = true; scheda.hidden = false; nav.hidden = false;
    vai(0);
  }
  function nuovaSerie() {
    // Chi chiede una nuova serie ha già premuto «Inizia»: la serie nuova parte subito.
    try { sessionStorage.setItem('domande-avvio-subito', '1'); } catch { /* niente memoria */ }
    location.reload();
  }

  conferma.addEventListener('click', () => invia());
  const sposta = (i: number) => { vai(i); scheda.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
  prossima.addEventListener('click', () => sposta(pos + 1));
  vedi.addEventListener('click', mostraRisultato);
  succ.addEventListener('click', () => sposta(pos + 1));
  prec.addEventListener('click', () => sposta(pos - 1));
  // «Segnala un errore» apre la stessa finestra del tasto in fondo alle altre pagine di studio.
  segnala.addEventListener('click', () => document.querySelector<HTMLElement>('[data-apri-segnala]')?.click());

  termina.addEventListener('click', async () => {
    clearInterval(timer);
    nav.hidden = true;
    const r = await post('/api/sessione/riepilogo', { chiudi: true, lingua }).catch(() => null);
    const d = r && r.ok ? await r.json() : null;
    scheda.hidden = true; risultato.hidden = true; termina.hidden = true;
    const s = d?.sessione;
    const st = d?.stato;
    const righe = s ? [
      [`${L.righeCorrette} (${s.corrette})`, s.puntiCorrette],
      [`${L.righeStudio} (${s.minuti} min)`, s.puntiStudio],
      ...s.premi.map((p: { nome: string; punti: number }) => [p.nome, p.punti]),
    ] : [];
    const obiettivi = (d?.obiettivi || []).map((o: { testo: string; fatto: number; totale: number; completato: boolean }) =>
      `<li><span>${o.testo}</span><span>${o.completato ? L.completato : `${o.fatto} / ${o.totale}`}</span><span class="barra-exp"><span style="width:${Math.round((o.fatto / o.totale) * 100)}%"></span></span></li>`).join('');
    riepilogo.innerHTML = `
      <p class="sopratitolo">${L.conclusa} · ${s?.titolo || titolo}</p>
      <h2>${s ? (s.minuti === 1 ? L.minuto : f('minuti', s.minuti)) : L.sessioneConclusa}</h2>
      ${s ? `<p>${s.corrette === 1 ? L.unaCorretta : f('piuCorrette', s.corrette)} ${L.su} ${s.risposte}</p>` : ''}
      ${righe.length ? `<dl class="conti-exp">${righe.map(([k, v]) => `<div><dt>${k}</dt><dd>+${v}</dd></div>`).join('')}<div class="totale"><dt>${L.totale}</dt><dd>+${s.punti} ${lingua === 'en' ? 'XP' : 'EXP'}</dd></div></dl>` : ''}
      ${st ? `<p class="riep-livello"><strong>${L.livello} ${st.livello} · ${st.fascia}</strong></p>
        <div class="barra-exp grande"><span style="width:${st.perc}%"></span></div>
        <p class="riep-numeri"><span>${num(st.exp)} ${lingua === 'en' ? 'XP' : 'EXP'}</span><span>${st.prossimo === null ? L.massimo : `${num(st.mancano)} ${L.alLivello} ${st.livello + 1}`}</span></p>` : ''}
      ${obiettivi ? `<h3>${L.obiettivi}</h3><ul class="obiettivi">${obiettivi}</ul>` : ''}
      <p class="azioni-riepilogo"><a class="bottone-primario" href="${radice.dataset.ritorno}">${tornaAllaMateria ? L.tornaMateria : L.tornaEsercizi}</a> <a class="bottone-secondario" href="${pref}/account#percorso">${L.percorso}</a></p>`;
    riepilogo.hidden = false;
    riepilogo.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // Il tempo della prima domanda parte solo quando lo studente preme «Inizia» (richiesta di Carmine del 16/11/2026:
  // prima il cronometro partiva all'apertura della pagina, mentre si leggevano le istruzioni).
  const parti = () => { avvio.hidden = true; scheda.hidden = false; vai(0); };
  let subito = false;
  try { subito = sessionStorage.getItem('domande-avvio-subito') === '1'; sessionStorage.removeItem('domande-avvio-subito'); } catch { /* niente memoria */ }
  if (subito) parti();
  else $<HTMLButtonElement>('.avvia').addEventListener('click', parti, { once: true });
</script>
