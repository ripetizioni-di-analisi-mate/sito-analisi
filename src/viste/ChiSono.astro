---
// Pagina biografica: tutta la home del sito ripetizioni-di-analisi-matematica.it
// (presentazione, studenti, missione, risultati, servizi, università).
import Base from '../layouts/Base.astro';
import { SITO, INSTAGRAM, assoluto } from '../lib/seo';
import { type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const WHATSAPP = 'https://wa.me/393885680393';
const THREADS = 'https://www.threads.com/@ripetizioni_di_analisi_mate';
const IN_EVIDENZA = 'https://www.instagram.com/stories/highlights/18377269690180577/';

// Ordine del vecchio sito ripetizioni-di-analisi-matematica.it.
const UNIVERSITA: [string, string, number, number][] = [
  ['tor-vergata', 'Università di Roma Tor Vergata', 222, 252],
  ['bergamo', 'Università degli Studi di Bergamo', 254, 102],
  ['pisa', 'Università di Pisa', 290, 253],
  ['politecnico-milano', 'Politecnico di Milano', 320, 115],
  ['federico-ii', 'Università degli Studi di Napoli Federico II', 320, 172],
  ['vanvitelli', 'Università degli Studi della Campania Luigi Vanvitelli', 262, 95],
  ['bocconi', 'Università Bocconi', 320, 105],
  ['calabria', 'Università della Calabria', 320, 112],
  ['firenze-economia', 'Università degli Studi di Firenze, Scuola di Economia e Management', 320, 172],
  ['uninettuno', 'Università Telematica Internazionale Uninettuno', 320, 67],
  ['roma-tre', 'Università degli Studi Roma Tre', 320, 163],
  ['sapienza', 'Sapienza Università di Roma', 320, 93],
  ['torino', 'Università degli Studi di Torino', 320, 155],
  ['firenze-scienze-politiche', 'Università degli Studi di Firenze, Scuola di Scienze Politiche Cesare Alfieri', 320, 70],
  ['cattolica', 'Università Cattolica del Sacro Cuore', 320, 132],
  ['foggia', 'Università di Foggia', 320, 224],
];

const TESTI = {
  it: {
    titolo: 'Chi sono',
    descrizione: 'Carmine Tornincasa, insegnante privato di Analisi matematica e content creator: oltre mille studenti seguiti in tutta Italia e più di diecimila ore di lezione.',
    nome: 'Ing. Carmine Tornincasa',
    laurea: 'Laureato in Ingegneria civile con 110 e lode all’Università degli Studi della Campania «Luigi Vanvitelli».',
    sottotitolo: 'Insegnante privato e content creator del canale',
    seguimi: 'Seguimi su',
    // ogni punto: pezzi di testo, quelli con true in grassetto
    punti: [
      [['Laurea in Ingegneria civile', true], [' e master in matematica', false]],
      [['Oltre mille studenti', true], [' seguiti e ', false], ['più di diecimila ore', true], [' di lezione', false]],
      [['Insegno matematica ', false], ['da quando ero alle superiori', true]],
      [['Lezioni individuali, ', false], ['corsi di gruppo', true], [' online e ', false], ['videocorsi', true]],
    ] as [string, boolean][][],
    studenti: 'I miei studenti',
    dove: 'Da dove arrivano gli studenti del 2025',
    province: ['Studenti da ', '78 province', ', soprattutto da Roma, Milano e Napoli.'],
    mappa: 'Mappa dell’Italia con le province di provenienza degli studenti: i cerchi più grandi sono su Roma, Milano e Napoli',
    citta: [['400+', 'studenti da Roma'], ['250+', 'da Milano'], ['120+', 'da Napoli'], ['90+', 'da Palermo'], ['80+', 'da Torino']],
    missione: 'La mia missione educativa',
    paragrafi: [
      'Dopo migliaia di ore di lezione con studenti diversi ho imparato a partire dal punto in cui ciascuno si blocca. Sul sito la teoria segue l’ordine delle mie lezioni, con le ipotesi scritte per intero, e gli esercizi svolti sono divisi per tipologia, con il calcolo sopra e la spiegazione sotto.',
      'Voglio che ogni studente si senta capace, accompagnandolo nel miglioramento dei voti e dell’autostima. Attraverso Instagram e altri canali, cerco di diffondere contenuti utili e accessibili, costruendo una rete di apprendimento affidabile.',
    ],
    risultati: 'I vostri risultati',
    risultato: 'Messaggio di uno studente dopo l’esame, dalle storie in evidenza su Instagram',
    altri: 'e molti altri ancora',
    servizi: 'Quali servizi offro?',
    righeServizi: [
      ['Lezioni individuali', ['Hai la mia piena disponibilità e le lezioni sono calibrate su misura in base alla tua preparazione.']],
      ['Corso live', [
        'I corsi prevedono un’organizzazione personalizzata in base alle prove d’esame inviate, con almeno tre incontri settimanali da un’ora.',
        'Le lezioni sono registrate, così da poterle recuperare in caso di assenza. Per iscriversi servono nome, cognome e numero di telefono.',
      ]],
      ['Corso on demand', ['Le lezioni registrate di un corso completo, ciascuna con il video e il PDF.']],
    ] as [string, string[]][],
    durata: 'Durata prevista:',
    lezioni: ['circa 30 lezioni per Analisi 1', 'circa 20 lezioni per Analisi 2'],
    supportate: 'Alcune delle Università supportate',
    prenota: 'Prenota la tua lezione',
    prova: 'Prova gratis il materiale del sito',
    videocorsi: 'Vedi i videocorsi',
    ruolo: 'Insegnante privato di Analisi matematica',
  },
  en: {
    titolo: 'About me',
    descrizione: 'Carmine Tornincasa, private Calculus tutor and content creator: over a thousand students taught across Italy and more than ten thousand hours of lessons.',
    nome: 'Carmine Tornincasa',
    laurea: 'Graduated in Civil Engineering with full marks and honours (110 cum laude) from the University of Campania Luigi Vanvitelli.',
    sottotitolo: 'Private tutor and content creator of the channel',
    seguimi: 'Follow me on',
    punti: [
      [['Degree in Civil Engineering', true], [' and a master’s in mathematics', false]],
      [['Over a thousand students', true], [' taught and ', false], ['more than ten thousand hours', true], [' of lessons', false]],
      [['I have taught mathematics ', false], ['since I was in high school', true]],
      [['One-to-one lessons, online ', false], ['group courses', true], [' and ', false], ['video courses', true]],
    ] as [string, boolean][][],
    studenti: 'My students',
    dove: 'Where my 2025 students come from',
    province: ['Students from ', '78 provinces', ', mostly from Rome, Milan and Naples.'],
    mappa: 'Map of Italy with the provinces my students come from: the largest circles are on Rome, Milan and Naples',
    citta: [['400+', 'students from Rome'], ['250+', 'from Milan'], ['120+', 'from Naples'], ['90+', 'from Palermo'], ['80+', 'from Turin']],
    missione: 'My teaching mission',
    paragrafi: [
      'After thousands of hours of lessons with very different students, I have learned to start from the point where each of them gets stuck. On the website the theory follows the order of my lessons, with the hypotheses written in full, and the worked examples are grouped by type, with the computation first and the explanation below.',
      'I want every student to feel capable, and I accompany them as their grades and self-confidence improve. Through Instagram and other channels I share useful, accessible content, building a reliable learning network.',
    ],
    risultati: 'Your results',
    risultato: 'Message from a student after the exam, from the Instagram story highlights',
    altri: 'and many more',
    servizi: 'What services do I offer?',
    righeServizi: [
      ['One-to-one lessons', ['You have my full availability, and the lessons are tailored to your preparation.']],
      ['Live course', [
        'The courses are organised around the past exam papers you send, with at least three one-hour meetings per week.',
        'Lessons are recorded, so you can catch up if you miss one. To enrol you only need your name, surname and phone number.',
      ]],
      ['On-demand course', ['The recorded lessons of a complete course, each with its video and PDF.']],
    ] as [string, string[]][],
    durata: 'Expected length:',
    lezioni: ['about 30 lessons for Calculus 1', 'about 20 lessons for Calculus 2'],
    supportate: 'Some of the universities we support',
    prenota: 'Book your lesson',
    prova: 'Try the website material for free',
    videocorsi: 'See the video courses (in Italian)',
    ruolo: 'Private Calculus tutor',
  },
  de: {
    titolo: 'Über mich',
    descrizione: 'Carmine Tornincasa, Nachhilfelehrer für Analysis. Mehr als 1.000 Lernende und über 10.000 Unterrichtsstunden.',
    nome: 'Carmine Tornincasa',
    laurea: 'Abschluss in Bauingenieurwesen an der Universität Kampanien „Luigi Vanvitelli“ mit der italienischen Bestnote 110/110 und Auszeichnung.',
    sottotitolo: 'Nachhilfelehrer und Betreiber des Kanals',
    seguimi: 'Folge mir auf',
    punti: [
      [['Abschluss in Bauingenieurwesen', true], [' und Masterabschluss in Mathematik', false]],
      [['Über 1.000 Lernende', true], [' betreut und ', false], ['mehr als 10.000 Unterrichtsstunden', true], [' gegeben', false]],
      [['Ich unterrichte Mathematik ', false], ['seit meiner Schulzeit', true]],
      [['Einzelunterricht, ', false], ['Online-Gruppenkurse', true], [' und ', false], ['Videokurse', true]],
    ] as [string, boolean][][],
    studenti: 'Meine Schülerinnen, Schüler und Studierenden',
    dove: 'Woher die Lernenden im Jahr 2025 kamen',
    province: ['Lernende aus ', '78 Provinzen', ', vor allem aus Rom, Mailand und Neapel.'],
    mappa: 'Karte Italiens mit den Herkunftsprovinzen. Die größten Kreise liegen bei Rom, Mailand und Neapel.',
    citta: [['400+', 'aus Rom'], ['250+', 'aus Mailand'], ['120+', 'aus Neapel'], ['90+', 'aus Palermo'], ['80+', 'aus Turin']],
    missione: 'So unterrichte ich',
    paragrafi: [
      'Im Unterricht setze ich dort an, wo du nicht weiterkommst. Auf der Website folgt die Theorie der Reihenfolge meiner Stunden. Zu jedem Satz stehen die Voraussetzungen dabei. Die Beispiele sind nach Aufgabentypen geordnet. Auf die Rechnung folgt jeweils die Erklärung.',
      'Ich möchte, dass du Aufgaben zunehmend selbstständig lösen kannst. Auf Instagram und anderen Kanälen teile ich zusätzliche Erklärungen und Aufgaben.',
    ],
    risultati: 'Rückmeldungen nach der Prüfung',
    risultato: 'Rückmeldung auf Italienisch aus den Instagram-Story-Highlights',
    altri: 'Weitere Rückmeldungen auf Instagram',
    servizi: 'Unterricht und Kurse',
    righeServizi: [
      ['Einzelunterricht', ['Ich passe die Stunden an deinen Wissensstand an.']],
      ['Live-Gruppenkurs', [
        'Die eingesandten Altklausuren bestimmen den Inhalt des Kurses. Es finden mindestens drei einstündige Treffen pro Woche statt.',
        'Die Stunden werden aufgezeichnet. Zur Anmeldung brauchst du deinen Vor- und Nachnamen sowie deine Telefonnummer.',
      ]],
      ['Videokurs', ['Die Aufzeichnungen eines vollständigen Kurses, jeweils mit Video und PDF.']],
    ] as [string, string[]][],
    durata: 'Geplanter Umfang',
    lezioni: ['etwa 30 Stunden für Analysis I', 'etwa 20 Stunden für Analysis II'],
    supportate: 'Hochschulen, an denen meine Studierenden eingeschrieben sind',
    prenota: 'Unterricht per WhatsApp anfragen',
    prova: 'Lernmaterial kostenlos ansehen',
    videocorsi: 'Videokurse auf Italienisch ansehen',
    ruolo: 'Nachhilfelehrer für Analysis',
  },
  es: {
    titolo: 'Sobre mí',
    descrizione: 'Carmine Tornincasa, profesor particular de cálculo. Más de 1.000 estudiantes y 10.000 horas de clase.',
    nome: 'Carmine Tornincasa',
    laurea: 'Graduado en Ingeniería Civil por la Universidad de Campania Luigi Vanvitelli con la máxima calificación del sistema italiano, 110/110 con honores.',
    sottotitolo: 'Profesor particular y creador del canal',
    seguimi: 'Sígueme en',
    punti: [
      [['Graduado en Ingeniería Civil', true], [' y con un máster en Matemáticas', false]],
      [['Más de 1.000 estudiantes', true], [' y ', false], ['10.000 horas de clase', true]],
      [['Doy clases de matemáticas ', false], ['desde que iba al instituto', true]],
      [['Clases particulares, ', false], ['cursos en grupo en línea', true], [' y ', false], ['videocursos', true]],
    ] as [string, boolean][][],
    studenti: 'Mis estudiantes',
    dove: 'De dónde eran mis estudiantes en 2025',
    province: ['Estudiantes de ', '78 provincias italianas', ', sobre todo de Roma, Milán y Nápoles.'],
    mappa: 'Mapa de Italia con las provincias de origen. Los círculos más grandes están en Roma, Milán y Nápoles.',
    citta: [['400+', 'de Roma'], ['250+', 'de Milán'], ['120+', 'de Nápoles'], ['90+', 'de Palermo'], ['80+', 'de Turín']],
    missione: 'Cómo doy clase',
    paragrafi: [
      'En clase empezamos por el punto en el que te has atascado. En la web, la teoría sigue el mismo orden que en mis clases. Cada teorema incluye sus hipótesis y los ejemplos se agrupan por tipo de ejercicio. Después de cada cálculo explico cómo se llega al resultado.',
      'Mi objetivo es que ganes autonomía al resolver ejercicios. En Instagram y en otros canales comparto explicaciones y ejercicios adicionales.',
    ],
    risultati: 'Opiniones después del examen',
    risultato: 'Opinión en italiano de las historias destacadas de Instagram',
    altri: 'Más opiniones en Instagram',
    servizi: 'Clases y cursos',
    righeServizi: [
      ['Clases particulares', ['Adapto cada clase a tu nivel y a lo que necesitas practicar.']],
      ['Curso en grupo en directo', [
        'El contenido se basa en los exámenes de años anteriores que envía el grupo. Hay al menos tres clases de una hora por semana.',
        'Las clases se graban. Para inscribirte, indica tu nombre, tus apellidos y tu número de teléfono.',
      ]],
      ['Videocurso', ['Grabaciones de un curso completo con vídeos y material en PDF.']],
    ] as [string, string[]][],
    durata: 'Duración aproximada',
    lezioni: ['unas 30 horas para Cálculo I', 'unas 20 horas para Cálculo II'],
    supportate: 'Universidades en las que estudian mis alumnos',
    prenota: 'Pide una clase por WhatsApp',
    prova: 'Prueba gratis el material de estudio',
    videocorsi: 'Ver los videocursos en italiano',
    ruolo: 'Profesor particular de cálculo',
  },
}[lingua];

const RISULTATI = Array.from({ length: 14 }, (_, i) => `/chi-sono/risultati/${String(i + 1).padStart(2, '0')}.webp`);

const persona = {
  '@type': 'Person',
  '@id': `${SITO}/#carmine`,
  name: 'Carmine Tornincasa',
  jobTitle: TESTI.ruolo,
  image: `${SITO}/chi-sono/carmine.webp`,
  url: assoluto(Astro.url.pathname),
  sameAs: [INSTAGRAM, THREADS, 'https://ripetizioni-di-analisi-matematica.it/'],
  worksFor: { '@id': `${SITO}/#organizzazione` },
};
---
<Base
  titolo={TESTI.titolo}
  descrizione={TESTI.descrizione}
  percorso={[{ titolo: TESTI.titolo }]}
  lingua={lingua}
  seo={{ tipo: 'profile', schema: [{ '@type': 'AboutPage', name: TESTI.titolo, url: assoluto(Astro.url.pathname), mainEntity: persona }, persona] }}
>
  <section class="bio-testa">
    <img class="bio-foto" src="/chi-sono/carmine.webp" srcset="/chi-sono/carmine-320.webp 320w, /chi-sono/carmine.webp 640w" sizes="(max-width: 40rem) 11rem, 14rem" width="640" height="640" alt="Carmine Tornincasa" />
    <div>
      <h1>{TESTI.nome}</h1>
      <p class="bio-laurea">{TESTI.laurea}</p>
      <p class="bio-ruolo">{TESTI.sottotitolo} <a href={INSTAGRAM} target="_blank" rel="noopener">ripetizioni_di_analisi_mate</a></p>
      <p class="bio-social">
        <span>{TESTI.seguimi}</span>
        <a href={INSTAGRAM} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none"/></svg><span>Instagram</span></a>
        <a href={THREADS} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z"/></svg><span>Threads</span></a>
        <a href={WHATSAPP} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48a.92.92 0 0 0-.66.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.29Z"/></svg><span>WhatsApp</span></a>
      </p>
    </div>
  </section>

  <ul class="bio-punti">
    {TESTI.punti.map((pezzi) => <li><span>{pezzi.map(([testo, forte]) => (forte ? <strong>{testo}</strong> : testo))}</span></li>)}
  </ul>

  <h2>{TESTI.studenti}</h2>
  <div class="bio-studenti">
    <div>
      <p class="bio-dove">{TESTI.dove}</p>
      <p>{TESTI.province[0]}<strong>{TESTI.province[1]}</strong>{TESTI.province[2]}</p>
      <ul class="bio-citta">
        {TESTI.citta.map(([n, s]) => <li><strong>{n}</strong> {s}</li>)}
      </ul>
    </div>
    <img class="bio-mappa" src="/chi-sono/mappa-studenti.webp" width="640" height="702" loading="lazy" alt={TESTI.mappa} />
  </div>
  <p class="bio-centro"><a class="bio-bottone" href={WHATSAPP} target="_blank" rel="noopener">{TESTI.prenota}</a><br /><a class="bio-secondario" href={lingua === 'it' ? '/' : `/${lingua}`}>{TESTI.prova}</a></p>

  <h2>{TESTI.missione}</h2>
  {TESTI.paragrafi.map((p) => <p>{p}</p>)}

  <h2 class="bio-centrato">{TESTI.risultati}</h2>
  <div class="bio-risultati">
    {RISULTATI.map((src) => (
      <a href={IN_EVIDENZA} target="_blank" rel="noopener"><img src={src} width="640" height="640" loading="lazy" alt={TESTI.risultato} /></a>
    ))}
  </div>
  <p class="bio-centro bio-altri"><a href={IN_EVIDENZA} target="_blank" rel="noopener">… {TESTI.altri}</a></p>

  <h2 id="servizi">{TESTI.servizi}</h2>
  <div class="bio-servizi">
    {TESTI.righeServizi.map(([nome, testi], i) => (
      <div class="bio-servizio">
        <strong>{nome}</strong>
        <div>
          {testi.map((t) => <p>{t}</p>)}
          {i === 2 && <p><a href={['de', 'es'].includes(lingua) ? '/videocorsi?lingua=it' : '/videocorsi'}>{TESTI.videocorsi}</a></p>}
          {i === 1 && (
            <>
              <p class="bio-durata">{TESTI.durata}</p>
              <ul>{TESTI.lezioni.map((l) => <li>{l}</li>)}</ul>
            </>
          )}
        </div>
      </div>
    ))}
  </div>

  <h2 class="bio-centrato">{TESTI.supportate}</h2>
  <div class="bio-loghi chiari">
    {UNIVERSITA.map(([file, nome, w, h]) => <img src={`/chi-sono/universita/${file}.webp`} width={w} height={h} loading="lazy" alt={nome} title={nome} />)}
  </div>
</Base>

<style>
  .bio-bottone { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; background: var(--accento); color: #fff; text-decoration: none; font-family: var(--ui); font-weight: 600; }
  .bio-bottone:hover { filter: brightness(1.1); }
  .bio-testa { display: flex; align-items: center; gap: 1.5rem; margin: 0.5rem 0 1.25rem; }
  .bio-testa h1 { margin: 0 0 0.35rem; }
  .bio-foto { width: 14rem; height: 14rem; border-radius: 50%; object-fit: cover; flex: none; box-shadow: 0 0 0 4px var(--carta-2); }
  .bio-laurea { margin: 0 0 0.5rem; max-width: 32rem; font-family: var(--ui); color: var(--inchiostro-2); line-height: 1.45; }
