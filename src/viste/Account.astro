---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import Base from '../layouts/Base.astro';
import { materieL, testiJs, T, prefisso, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const js = testiJs(lingua);
const pref = prefisso(lingua);
const aPagamento = materieL(lingua).filter((m) => m.attiva && m.prezzo).map((m) => ({ slug: m.slug, titolo: m.titolo, prezzo: m.prezzo, colore: m.colore }));
const sblocca = t.sblocca;
---
<Base titolo={t.ilTuoAccount} percorso={[{ titolo: t.account }]} descrizione={t.accountDescrizione} lingua={lingua} seo={{ noindex: true }}>
  <h1>{t.ilTuoAccount}</h1>
  <p class="sommario" id="chi">{t.caricamento}</p>

  <section id="pannello" hidden>
    {lingua === 'it' && (
      <div id="percorso" class="percorso-account" hidden>
        <h2>Il tuo percorso</h2>
        <div class="scheda-livello">
          <svg class="anello-grande" viewBox="0 0 96 96" role="img" aria-label="Livello"><circle cx="48" cy="48" r="40" class="anello-fondo" /><circle cx="48" cy="48" r="40" class="anello-avanzamento" stroke-dasharray="251.3" stroke-dashoffset="251.3" transform="rotate(-90 48 48)" /><text x="48" y="44" text-anchor="middle" class="anello-sopra">LIVELLO</text><text x="48" y="67" text-anchor="middle" class="anello-numero">1</text></svg>
          <div class="dati-livello">
            <p class="fascia-livello"><strong></strong> <span></span></p>
            <div class="barra-exp grande"><span></span></div>
            <p class="numeri-livello"><span class="exp-totale"></span><span class="exp-mancano"></span></p>
          </div>
        </div>
        <h3>Questa settimana</h3>
        <div class="settimana-account">
          <div><span>Studio attivo</span><strong class="sett-minuti"></strong></div>
          <div><span>Risposte corrette</span><strong class="sett-corrette"></strong></div>
          <div><span>Giorni di studio</span><span class="giorni-settimana"></span></div>
        </div>
        <h3>Obiettivi della settimana <small>Nuovi obiettivi lunedì</small></h3>
        <ul class="obiettivi"></ul>
        <h3>Traguardi</h3>
        <ul class="traguardi"></ul>
        <h3>Ultime sessioni di studio</h3>
        <ul class="sessioni-account"></ul>
        <p><a href="/livelli-e-punti">Come funzionano livelli e punti</a></p>
      </div>
    )}
    <div id="videocorsi" hidden>
      <h2>I tuoi videocorsi</h2>
      <ul class="videocorsi-account" id="elenco-videocorsi"></ul>
    </div>
    <h2>{t.leTueMaterie}</h2>
    <ul class="materie-account" id="materie"></ul>

    <div class="azioni-account">
      <details class="impostazioni-account">
        <summary><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>{t.impostazioni}</summary>
        <div class="pannello-impostazioni">
          <h2>{t.tuoNome}</h2>
          <form class="modulo modulo-riga" id="form-nome" novalidate>
            <input type="text" name="nome" autocomplete="given-name" maxlength="40" aria-label={t.tuoNome} />
            <button class="bottone-secondario" type="submit">{t.salva}</button>
            <p class="esito-modulo" id="esito-nome" role="status"></p>
          </form>
          <h2>{t.tuoiDispositivi}</h2>
          <p class="nota-accesso">{t.notaDispositivi}</p>
          <ul class="elenco-dispositivi" id="dispositivi"></ul>
          <h2>{t.cambiaPassword}</h2>
          <form class="modulo" id="cambio" novalidate>
            <label>{t.passwordAttuale}<span class="campo-password"><input type="password" name="attuale" autocomplete="current-password" required /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
            <label>{t.nuovaPassword}<span class="campo-password"><input type="password" name="nuova" autocomplete="new-password" minlength="8" required /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
            <p class="esito-modulo" id="esito-cambio" role="status"></p>
            <button class="bottone-secondario" type="submit">{t.aggiornaPassword}</button>
          </form>
        </div>
      </details>
      <button class="bottone-secondario" type="button" id="esci">{t.esci}</button>
    </div>
  </section>

  {lingua === 'it' && (
    <script is:inline>
      (async () => {
        const r = await fetch('/api/percorso').catch(() => null);
        if (!r || !r.ok) return;
        const d = await r.json();
        const box = document.getElementById('percorso');
        const q = (s) => box.querySelector(s);
        const num = (x) => x.toLocaleString('it-IT');
        const esc = (x) => String(x).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const st = d.stato;
        q('.anello-avanzamento').setAttribute('stroke-dashoffset', (251.3 * (1 - st.perc / 100)).toFixed(1));
        q('.anello-numero').textContent = st.livello;
        q('.anello-grande').setAttribute('aria-label', `Livello ${st.livello}, ${st.perc} per cento verso il livello successivo`);
        q('.fascia-livello strong').textContent = st.fascia;
        q('.fascia-livello span').textContent = st.frase;
        q('.dati-livello .barra-exp span').style.width = `${st.perc}%`;
        q('.exp-totale').textContent = `${num(st.exp)} EXP in totale`;
        q('.exp-mancano').textContent = st.prossimo === null ? 'Livello massimo' : `${num(st.mancano)} EXP al livello ${st.livello + 1}`;
        const ore = Math.floor(d.settimana.minuti / 60), min = d.settimana.minuti % 60;
        q('.sett-minuti').textContent = ore ? `${ore} h ${min} min` : `${min} min`;
        q('.sett-corrette').textContent = d.settimana.corrette;
        const iniziali = ['L', 'M', 'M', 'G', 'V', 'S', 'D'];
        q('.giorni-settimana').innerHTML = d.settimana.giorni.map((g, i) => `<span class="giorno${g.attivo ? ' attivo' : ''}${g.oggi ? ' oggi' : ''}" title="${g.giorno}"><i></i>${iniziali[i]}</span>`).join('');
        q('.obiettivi').innerHTML = d.obiettivi.map((o) => `<li class="${o.completato ? 'completato' : ''}"><span>${esc(o.testo)}</span><span>${o.completato ? `Completato · +${o.punti} EXP` : `${o.fatto} / ${o.totale} · ${o.punti} EXP`}</span><span class="barra-exp"><span style="width:${Math.round((o.fatto / o.totale) * 100)}%"></span></span></li>`).join('');
        q('.traguardi').innerHTML = [
          ...d.traguardi.map((t) => `<li class="preso"><strong>${esc(t.nome)}</strong><span>+${t.punti} EXP</span></li>`),
          ...d.daFare.map((t) => `<li><strong>${esc(t.nome)}</strong><span>+${t.punti} EXP</span></li>`),
        ].join('');
        const data = (ms) => new Date(ms).toLocaleDateString('it-IT', { weekday: 'long', day: 'numeric', month: 'long' });
        q('.sessioni-account').innerHTML = d.sessioni.length
          ? d.sessioni.map((s) => `<li><span>${esc(s.titolo || 'Studio')} · ${data(s.inizio)}</span><span>${s.minuti} min · ${s.corrette} / ${s.risposte} · +${s.punti}</span></li>`).join('')
          : '<li><span>Nessuna sessione ancora. Il tempo di studio conta sulle pagine di teoria ed esercizi.</span></li>';
        box.hidden = false;
        if (location.hash === '#percorso') setTimeout(() => box.scrollIntoView(), 50);
      })();
    </script>
  )}
  <script is:inline define:vars={{ aPagamento, js, pref, sblocca }}>
    (async () => {
      const r = await fetch('/api/io').catch(() => null);
      if (!r || r.status === 401) { location.href = `${pref}/accedi?dopo=${pref}/account`; return; }
      const io = await r.json();
      document.getElementById('chi').textContent = js.collegatoCome.replace('§', io.nome ? `${io.nome} (${io.email})` : io.email);
      const lista = document.getElementById('materie');
      for (const m of aPagamento) {
        const li = document.createElement('li');
        li.style.setProperty('--accento', m.colore);
        const ha = io.materie.includes(m.slug);
        li.innerHTML = `<span class="tacca"></span><span class="nome">${m.titolo}</span>` + (ha
          ? `<span class="stato-ok">${js.sbloccataOk}</span> <a class="bottone-secondario" href="${pref}/${m.slug}">${js.studia}</a>`
          : `<a class="bottone-primario" href="${pref}/${m.slug}/sblocca">${sblocca} · ${m.prezzo} €</a>`);
        lista.appendChild(li);
      }
      const fn = document.getElementById('form-nome');
      fn.nome.value = io.nome || '';
      fn.addEventListener('submit', async (e) => {
        e.preventDefault();
        const en = document.getElementById('esito-nome');
        if (!fn.nome.value.trim()) { en.textContent = js.nomeMancante; en.className = 'esito-modulo errore'; return; }
        const r = await fetch('/api/nome', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ nome: fn.nome.value }) });
        en.textContent = r.ok ? js.nomeSalvato : js.erroreGenerico; en.className = r.ok ? 'esito-modulo' : 'esito-modulo errore';
        if (r.ok) setTimeout(() => location.reload(), 600);
      });
      const ld = document.getElementById('dispositivi');
      for (const d of io.dispositivi || []) {
        const li = document.createElement('li');
        li.textContent = d.nome + (d.questo ? ` (${js.questoDispositivo})` : '');
        ld.appendChild(li);
      }
      document.getElementById('pannello').hidden = false;

      if (io.materie.some((m) => m.startsWith('video-'))) {
        const rv = await fetch('/api/videocorsi').catch(() => null);
        const dv = rv && rv.ok ? await rv.json() : null;
        const ev = document.getElementById('elenco-videocorsi');
        for (const v of (dv && dv.videocorsi) || []) {
          const li = document.createElement('li');
          li.innerHTML = `<strong>${v.titolo}</strong><span class="nota-video">${v.lezioni} lezioni con video e PDF</span>` + (v.drive
            ? `<a class="bottone-primario" href="${v.drive}" target="_blank" rel="noopener">Apri i video del corso</a>
               <span class="nota-video">Su Google Drive chiedi l'accesso con l'email <strong>${io.email}</strong>: Carmine lo conferma appena possibile.</span>`
            : `<span class="nota-video">Il link alla cartella dei video sta per comparire qui. Se ti serve subito, scrivi a Carmine su <a href="https://wa.me/393885680393" target="_blank" rel="noopener">WhatsApp</a>.</span>`);
          ev.appendChild(li);
        }
        if (ev.children.length) document.getElementById('videocorsi').hidden = false;
        if (location.hash === '#videocorsi') document.getElementById('videocorsi').scrollIntoView();
      }

      document.getElementById('esci').addEventListener('click', async () => {
        await fetch('/api/esci', { method: 'POST' }).catch(() => {});
        location.href = pref || '/';
      });

      const cambio = document.getElementById('cambio');
      const esito = document.getElementById('esito-cambio');
      cambio.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (cambio.nuova.value.length < 8) { esito.textContent = js.nuovaCorta; esito.className = 'esito-modulo errore'; return; }
        const r = await fetch('/api/password', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ attuale: cambio.attuale.value, nuova: cambio.nuova.value }) });
        const d = await r.json().catch(() => ({}));
        esito.textContent = r.ok ? js.passwordAggiornata : (d.errore || js.passwordNonAggiornata);
        esito.className = r.ok ? 'esito-modulo' : 'esito-modulo errore';
        if (r.ok) cambio.reset();
      });
    })();
  </script>
</Base>
