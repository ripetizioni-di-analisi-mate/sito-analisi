---
import Base from '../layouts/Base.astro';
import InvitaAmico from '../components/InvitaAmico.astro';
import OrientamentoAccount from '../components/OrientamentoAccount.astro';
import { materieL, testiJs, T, prefisso, type Lingua } from '../i18n';
import { usaProducts } from '../data/stem-usa/pricing';
import { courseUrl } from '../data/stem-usa/catalog.mjs';
import { accountTesti } from '../lib/account-testi.mjs';
import '../styles/account.css';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const en = lingua === 'en', de = lingua === 'de', es = lingua === 'es', fr = lingua === 'fr';
const t = T(lingua), js = testiJs(lingua), s = accountTesti(lingua), pref = prefisso(lingua);
const materie = [
  ...materieL(lingua).filter((m) => m.attiva && m.prezzo).map((m) => ({ slug: m.slug, titolo: m.titolo, href: `${pref}/${m.slug}` })),
  ...usaProducts.map((m) => ({ slug: m.slug, titolo: m.titolo, href: courseUrl(m.slug) })),
];
const configurazione = JSON.stringify({ lingua, pref, materie, js }).replace(/</g, '\\u003c');
---
<Base titolo={t.ilTuoAccount} percorso={[{ titolo: t.account }]} descrizione={t.accountDescrizione} lingua={lingua} seo={{ noindex: true }}>
  <div class="pagina-account" id="account-page">
    <p id="chi" class="account-caricamento" role="status">{t.caricamento}</p>
    <div id="pannello" hidden>
      {/* Copertina: stessa fascia calda dello spazio personale in home, con nome, rango e avanzamento del livello. */}
      <header class="ac-copertina">
        <div class="ac-dati">
          <h1 class="account-sopratitolo">{s.studio}</h1>
          <p class="ac-nome" id="ac-nome"></p>
          <p class="fascia-livello"></p>
          <div class="ac-cammino">
            <div class="barra-exp" id="barra-livello" role="progressbar" aria-label={fr ? 'Progression vers le niveau suivant' : es ? 'Progreso hasta el siguiente nivel' : de ? 'Fortschritt bis zur nächsten Stufe' : en ? 'Level progress' : 'Avanzamento del livello'} aria-valuemin="0" aria-valuemax="100"><span></span></div>
            <p class="numeri-livello"><span class="exp-totale"></span><span class="exp-mancano"></span></p>
          </div>
        </div>
        <div class="stemma-account" role="img" aria-label={s.livello}></div>
      </header>
      <div id="riprendi-account" class="riprendi-account" hidden>
        <a class="ac-continua" id="riprendi-link" href={pref || '/'}>
          <span class="ac-c-testo"><small class="ac-c-su">{s.ultima}</small><strong id="ultima-materia"></strong><span id="ultimo-argomento"></span></span>
          <span class="ac-c-tasto"><span>{s.riprendi}</span><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5"/></svg></span>
        </a>
      </div>

      <section id="studio-account" class="ac-sezione" aria-labelledby="titolo-studio">
        <h2 class="account-titolo-sezione" id="titolo-studio">{s.contenuti}</h2>
        <ul class="contenuti-account" id="contenuti-account"></ul>
        <p class="account-nota" id="materie-vuote" hidden>{s.vuoto} <a href={pref || '/'}>{s.esplora}</a></p>
        <p class="account-nota" id="video-errore" hidden></p>
        {lingua === 'it' && <OrientamentoAccount />}
      </section>

      <section id="progressi-account" class="ac-sezione" aria-labelledby="titolo-progressi">
        <h2 class="account-titolo-sezione" id="titolo-progressi">{s.progressi}</h2>
        <p class="account-nota" id="progressi-caricamento" role="status">{t.caricamento}</p><button class="bottone-secondario" type="button" id="progressi-riprova" hidden>{s.riprova}</button>
        <div id="percorso" hidden>
          <p class="account-sopratitolo">{s.settimana}</p>
          <div class="account-statistiche"><div><strong id="sett-minuti"></strong><span>{s.minuti}</span></div><div><strong id="sett-corrette"></strong><span>{s.corrette}</span></div><div><strong id="sett-giorni"></strong><span>{s.giorni}</span></div></div>
          <div id="obiettivo-account"><p class="account-sopratitolo">{s.obiettivo}</p><div class="account-obiettivo-testo"><span id="obiettivo-testo"></span><span id="obiettivo-numeri"></span></div><div class="barra-exp" id="barra-obiettivo" role="progressbar" aria-label={s.obiettivo} aria-valuemin="0" aria-valuemax="100"><span></span></div></div>
          <p class="account-nota" id="obiettivi-completati" hidden>{s.completati}</p>
          <div class="ac-righe">
          <details class="account-dettagli" id="altri-traguardi"><summary><span>{s.raggiunti}</span><span class="ac-valore" id="traguardi-conto"></span></summary><ul class="account-traguardi" id="traguardi-raggiunti"></ul><p class="account-nota" id="traguardi-vuoti" hidden>{s.vuotoTraguardi}</p></details>
          <details class="account-dettagli"><summary>{s.attivita}</summary><ul class="account-sessioni" id="sessioni-account"></ul></details>
          </div>
          <p class="account-nota account-guida"><a href={de || es || fr ? '/en/livelli-e-punti?lingua=en' : `${pref}/livelli-e-punti`}>{fr ? 'Fonctionnement des niveaux et des points (en anglais)' : es ? 'Cómo funcionan los niveles y los puntos (en inglés)' : de ? 'So funktionieren Stufen und Punkte (Englisch)' : en ? 'How levels and points work' : 'Come funzionano livelli e punti'}</a></p>
        </div>
      </section>

      <section id="impostazioni-account" class="ac-sezione" aria-labelledby="titolo-impostazioni">
        <h2 class="account-titolo-sezione" id="titolo-impostazioni">{s.impostazioni}</h2>
        <div class="ac-righe">
          <details class="account-dettagli"><summary><span>{s.nome}</span><span class="ac-valore" id="nome-account"></span></summary><form class="modulo modulo-riga" id="form-nome" novalidate>
            <input type="text" name="nome" autocomplete="given-name" maxlength="40" aria-label={t.tuoNome} />
            <button class="bottone-secondario" type="submit">{t.salva}</button>
            <p class="esito-modulo" id="esito-nome" role="status"></p>
          </form></details>
          <div class="ac-riga"><span>Email</span><span class="ac-valore" id="email-account"></span></div>
          <details class="account-dettagli"><summary>{s.password}</summary><form class="modulo" id="cambio" novalidate>
            <label>{t.passwordAttuale}<span class="campo-password"><input type="password" name="attuale" autocomplete="current-password" required /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
            <label>{t.nuovaPassword}<span class="campo-password"><input type="password" name="nuova" autocomplete="new-password" minlength="8" required /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
            <p class="esito-modulo" id="esito-cambio" role="status"></p>
            <button class="bottone-secondario" type="submit">{t.aggiornaPassword}</button>
          </form></details>
          <form class="ac-riga ac-preferenze" id="form-preferenze-email">
            <label class="account-email-spunta"><span>{fr ? 'Rappels de révision par e-mail (en anglais)' : es ? 'Recordatorios de estudio por correo (en inglés)' : de ? 'Lernerinnerungen per E-Mail (Englisch)' : en ? 'Reminders to pick up where I left off' : 'Promemoria per riprendere da dove ero'}</span><input name="studio" type="checkbox" role="switch" disabled /></label>
            <button type="submit" hidden disabled>{t.salva}</button>
            <p class="esito-modulo" id="esito-email" role="status"></p>
          </form>
          <details class="account-dettagli dispositivi-account" id="dispositivi"><summary><span id="dispositivi-titolo">{s.dispositivi}</span><span class="ac-valore" id="dispositivi-conto"></span></summary><p class="account-nota">{s.notaDispositivi}</p><p class="account-nota" id="esito-dispositivi" role="status"></p><ul class="account-dispositivi" id="elenco-dispositivi" aria-busy="false"></ul><button class="account-azione-testo" type="button" id="aggiorna-dispositivi">{s.aggiorna}</button></details>
          <details class="account-dettagli" id="inviti-account" hidden><summary>{s.inviti}</summary><InvitaAmico lingua={lingua} /></details>
        </div>
        <button class="account-esci" type="button" id="esci" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4M14 8l4 4-4 4M9 12h11"/></svg>
          <span id="esci-testo">{s.esci}</span>
        </button>
        <p class="esito-modulo" id="esito-esci" role="status" aria-live="polite"></p>
      </section>
    </div>
    <dialog class="account-conferma" id="conferma-dispositivo" aria-labelledby="conferma-dispositivo-titolo" aria-describedby="conferma-dispositivo-nome conferma-dispositivo-nota"><h2 id="conferma-dispositivo-titolo">{s.conferma}</h2><p id="conferma-dispositivo-nome"></p><p id="conferma-dispositivo-nota">{s.spiegazione}</p><p id="errore-conferma-dispositivo" role="alert"></p><div class="account-conferma-azioni"><button type="button" class="bottone-secondario" id="annulla-scollega">{s.annulla}</button><button type="button" class="bottone-primario" id="conferma-scollega">{s.scollega}</button></div></dialog>
    <script type="application/json" id="configurazione-account" is:inline set:html={configurazione}></script>
  </div>
  <script>import '../scripts/account.mjs';</script>
</Base>
