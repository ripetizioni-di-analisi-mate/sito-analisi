---
import Base from '../layouts/Base.astro';
import InvitaAmico from '../components/InvitaAmico.astro';
import ConsensoEmail from '../components/ConsensoEmail.astro';
import { materieL, testiJs, T, prefisso, type Lingua } from '../i18n';
import { usaProducts } from '../data/stem-usa/pricing';
import { courseUrl } from '../data/stem-usa/catalog.mjs';
import { accountTesti } from '../lib/account-testi.mjs';
import '../styles/account.css';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const en = lingua === 'en';
const t = T(lingua), js = testiJs(lingua), s = accountTesti(lingua), pref = prefisso(lingua);
const materie = [
  ...materieL(lingua).filter((m) => m.attiva && m.prezzo).map((m) => ({ slug: m.slug, titolo: m.titolo, href: `${pref}/${m.slug}` })),
  ...usaProducts.map((m) => ({ slug: m.slug, titolo: m.titolo, href: courseUrl(m.slug) })),
];
const configurazione = JSON.stringify({ lingua, pref, materie, js }).replace(/</g, '\\u003c');
---
<Base titolo={t.ilTuoAccount} percorso={[{ titolo: t.account }]} descrizione={t.accountDescrizione} lingua={lingua} seo={{ noindex: true }}>
  <div class="pagina-account" id="account-page">
    <h1>{s.studio}</h1>
    <p id="chi" class="account-caricamento" role="status">{t.caricamento}</p>
    <div id="pannello" hidden>
      <div class="schede-account" role="tablist" aria-label={t.ilTuoAccount}>
        <button type="button" id="scheda-studio" role="tab" aria-controls="studio-account" aria-selected="true" data-area="studio">{en ? 'Study' : 'Studio'}</button>
        <button type="button" id="scheda-progressi" role="tab" aria-controls="progressi-account" aria-selected="false" data-area="progressi">{s.progressi}</button>
        <button type="button" id="scheda-impostazioni" role="tab" aria-controls="impostazioni-account" aria-selected="false" data-area="impostazioni">{s.impostazioni}</button>
      </div>
      <section id="studio-account" role="tabpanel" aria-labelledby="scheda-studio">
        <div id="riprendi-account" class="riprendi-account" hidden><div><p class="account-sopratitolo">{s.ultima}</p><h2 id="ultima-materia"></h2><p id="ultimo-argomento"></p></div><a class="bottone-primario" id="riprendi-link" href={pref || '/'}>{s.riprendi}<span aria-hidden="true"> →</span></a></div>
        <h2 class="account-titolo-sezione">{s.contenuti}</h2>
        <ul class="contenuti-account" id="contenuti-account"></ul>
        <p class="account-nota" id="materie-vuote" hidden>{s.vuoto} <a href={pref || '/'}>{s.esplora}</a></p>
        <p class="account-nota" id="video-errore" hidden></p>
      </section>
      <section id="progressi-account" role="tabpanel" aria-labelledby="scheda-progressi" hidden>
        <p class="account-nota" id="progressi-caricamento" role="status">{t.caricamento}</p><button class="bottone-secondario" type="button" id="progressi-riprova" hidden>{s.riprova}</button>
        <div id="percorso" hidden>
          <div class="account-livello"><div class="stemma-account" role="img" aria-label={s.livello}></div><div class="account-livello-dati"><h2 class="fascia-livello"></h2><p id="numero-livello"></p><div class="barra-exp" id="barra-livello" role="progressbar" aria-label={en ? 'Level progress' : 'Avanzamento del livello'} aria-valuemin="0" aria-valuemax="100"><span></span></div><p class="numeri-livello"><span class="exp-totale"></span><span class="exp-mancano"></span></p></div></div>
          <h2 class="account-titolo-sezione">{s.settimana}</h2>
          <div class="account-statistiche"><div><strong id="sett-minuti"></strong><span>{s.minuti}</span></div><div><strong id="sett-corrette"></strong><span>{s.corrette}</span></div><div><strong id="sett-giorni"></strong><span>{s.giorni}</span></div></div>
          <div id="obiettivo-account"><h2 class="account-titolo-sezione">{s.obiettivo}</h2><div class="account-obiettivo-testo"><span id="obiettivo-testo"></span><span id="obiettivo-numeri"></span></div><div class="barra-exp" id="barra-obiettivo" role="progressbar" aria-label={s.obiettivo} aria-valuemin="0" aria-valuemax="100"><span></span></div></div>
          <p class="account-nota" id="obiettivi-completati" hidden>{s.completati}</p>
          <h2 class="account-titolo-sezione">{s.raggiunti}</h2><ul class="account-traguardi" id="traguardi-raggiunti"></ul><p class="account-nota" id="traguardi-vuoti" hidden>{s.vuotoTraguardi}</p>
          <details class="account-dettagli" id="altri-traguardi" hidden><summary>{s.tutti}</summary><ul class="account-traguardi" id="elenco-altri-traguardi"></ul></details>
          <details class="account-dettagli"><summary>{s.attivita}</summary><ul class="account-sessioni" id="sessioni-account"></ul></details>
          <p class="account-nota account-guida"><a href={`${pref}/livelli-e-punti`}>{en ? 'How levels and points work' : 'Come funzionano livelli e punti'}</a></p>
        </div>
      </section>
      <section id="impostazioni-account" role="tabpanel" aria-labelledby="scheda-impostazioni" hidden>
        <section class="account-gruppo" aria-labelledby="dati-account-titolo"><h2 class="account-titolo-sezione" id="dati-account-titolo">{s.dati}</h2><dl class="account-dati"><div><dt>{s.nome}</dt><dd id="nome-account"></dd></div><div><dt>Email</dt><dd id="email-account"></dd></div></dl><details class="account-dettagli"><summary>{s.modifica}</summary><form class="modulo modulo-riga" id="form-nome" novalidate>
            <input type="text" name="nome" autocomplete="given-name" maxlength="40" aria-label={t.tuoNome} />
            <button class="bottone-secondario" type="submit">{t.salva}</button>
            <p class="esito-modulo" id="esito-nome" role="status"></p>
          </form></details></section>
        <section class="account-gruppo" aria-labelledby="email-account-titolo">
          <h2 class="account-titolo-sezione" id="email-account-titolo">{en ? 'Email preferences' : 'Preferenze email'}</h2>
          <form class="modulo" id="form-preferenze-email">
            <label class="account-email-spunta"><input name="studio" type="checkbox" disabled /> {en ? 'Reminders to pick up where I left off' : 'Promemoria per riprendere da dove ero'}</label>
            <ConsensoEmail lingua={lingua} scegliMateria />
            <button class="bottone-secondario" type="submit" disabled>{t.salva}</button>
            <p class="esito-modulo" id="esito-email" role="status"></p>
          </form>
        </section>
        <section class="account-gruppo dispositivi-account" id="dispositivi" aria-labelledby="dispositivi-titolo"><div class="account-sezione-testata"><h2 class="account-titolo-sezione" id="dispositivi-titolo">{s.dispositivi}</h2><span id="dispositivi-conto"></span></div><p class="account-nota">{s.notaDispositivi}</p><p class="account-nota" id="esito-dispositivi" role="status"></p><ul class="account-dispositivi" id="elenco-dispositivi" aria-busy="false"></ul><button class="account-azione-testo" type="button" id="aggiorna-dispositivi">{s.aggiorna}</button></section>
        <section class="account-gruppo"><details class="account-dettagli"><summary>{s.password}</summary><form class="modulo" id="cambio" novalidate>
            <label>{t.passwordAttuale}<span class="campo-password"><input type="password" name="attuale" autocomplete="current-password" required /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
            <label>{t.nuovaPassword}<span class="campo-password"><input type="password" name="nuova" autocomplete="new-password" minlength="8" required /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
            <p class="esito-modulo" id="esito-cambio" role="status"></p>
            <button class="bottone-secondario" type="submit">{t.aggiornaPassword}</button>
          </form></details><details class="account-dettagli" id="inviti-account" hidden><summary>{s.inviti}</summary><InvitaAmico lingua={lingua} /></details></section>
        <button class="account-azione-testo account-esci" type="button" id="esci">{t.esci}</button><p class="esito-modulo" id="esito-esci" role="status"></p>
      </section>
    </div>
    <dialog class="account-conferma" id="conferma-dispositivo" aria-labelledby="conferma-dispositivo-titolo" aria-describedby="conferma-dispositivo-nome conferma-dispositivo-nota"><h2 id="conferma-dispositivo-titolo">{s.conferma}</h2><p id="conferma-dispositivo-nome"></p><p id="conferma-dispositivo-nota">{s.spiegazione}</p><p id="errore-conferma-dispositivo" role="alert"></p><div class="account-conferma-azioni"><button type="button" class="bottone-secondario" id="annulla-scollega">{s.annulla}</button><button type="button" class="bottone-primario" id="conferma-scollega">{s.scollega}</button></div></dialog>
    <script type="application/json" id="configurazione-account" is:inline set:html={configurazione}></script>
  </div>
  <script>import '../scripts/account.mjs';</script>
</Base>

<style>
  .account-email-spunta{display:flex;align-items:center;gap:.45rem}
  .account-email-spunta input{width:1rem;height:1rem;accent-color:#214f50}
</style>
