---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import Base from '../layouts/Base.astro';
import CampoCorso from '../components/CampoCorso.astro';
import '../styles/dispositivi-login.css';
import { RANGHI } from '../../worker/stemmi.mjs';
import { FASCE } from '../data/livelli';
import { SCENE } from '../lib/accedi-disegni.mjs';
import { link, testiJs, T, prefisso, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const js = testiJs(lingua);
const pref = prefisso(lingua);

// Pagina «Sali scorrendo», versione A «Aperta» (scelta di Carmine del 19/11/2026): nessun riquadro; a sinistra un solo
// anello dei livelli che resta in vista, a destra titolo, vantaggi e modulo e, sotto, le quattro tappe illustrate.
// Scorrendo il livello dell'anello sale da 1 a 100. Le tappe sono solo in italiano (Studio guidato, leghe e duelli
// esistono solo in italiano); nelle altre lingue resta la parte alta.
const P = {
  it: { occ: 'Account gratuito', titolo: 'Iscriviti e sali di livello', frase: 'Mentre studi il sito tiene il conto per te. Vedi i tuoi progressi crescere, giorno dopo giorno.',
    occA: 'Il tuo account', titoloA: 'Bentornato', fraseA: 'Ritrovi le materie acquistate, il tuo livello e i progressi dove li avevi lasciati.',
    livello: 'LIVELLO', di: 'di 100', livelli: 'LIVELLI', titoli: 'dieci titoli',
    mon: [['Tempo di studio', 'minuto per minuto'], ['Risposte giuste', 'domanda per domanda'], ['Progressi', 'capitolo per capitolo']],
    con: 'Con l’iscrizione', van: [['tempo', 'Livelli, punti e lega settimanale'], ['mirino', 'Studio guidato con la diagnosi delle lacune'], ['calendario', 'Progressi e giorni mancanti all’esame'], ['sconto', '10% di sconto sulla prima materia']],
    iscriviti: 'Iscriviti', studente: 'Sei già uno studente di Carmine?', privacy: 'Privacy' },
  en: { occ: 'Free account', titolo: 'Sign up and level up', frase: 'While you study, the site keeps count for you. Watch your progress grow, day after day.',
    occA: 'Your account', titoloA: 'Welcome back', fraseA: 'Your subjects, your level and your progress are where you left them.',
    livello: 'LEVEL', di: 'of 100', livelli: 'LEVELS', titoli: 'ten titles',
    mon: [['Study time', 'minute by minute'], ['Correct answers', 'question by question'], ['Progress', 'chapter by chapter']],
    con: 'With your account', van: [['tempo', 'Levels and points for your study'], ['calendario', 'Progress and days left to your exam'], ['sconto', '10% off your first subject']],
    iscriviti: 'Sign up', studente: '', privacy: 'Privacy' },
  es: { occ: 'Cuenta gratuita', titolo: 'Regístrate y sube de nivel', frase: 'Mientras estudias, el sitio lleva la cuenta por ti. Tus progresos crecen día a día.',
    occA: 'Tu cuenta', titoloA: 'Hola de nuevo', fraseA: 'Tus asignaturas, tu nivel y tus progresos están donde los dejaste.',
    livello: 'NIVEL', di: 'de 100', livelli: 'NIVELES', titoli: 'diez títulos',
    mon: [['Tiempo de estudio', 'minuto a minuto'], ['Respuestas correctas', 'pregunta a pregunta'], ['Progresos', 'capítulo a capítulo']],
    con: 'Con tu cuenta', van: [['tempo', 'Niveles y puntos por tu estudio'], ['calendario', 'Progresos y días que faltan para el examen']],
    iscriviti: 'Regístrate', studente: '', privacy: 'Privacidad' },
  fr: { occ: 'Compte gratuit', titolo: 'Inscris-toi et monte de niveau', frase: 'Pendant que tu travailles, le site tient le compte pour toi. Tes progrès augmentent jour après jour.',
    occA: 'Ton compte', titoloA: 'Bon retour', fraseA: 'Tes matières, ton niveau et tes progrès sont là où tu les avais laissés.',
    livello: 'NIVEAU', di: 'sur 100', livelli: 'NIVEAUX', titoli: 'dix titres',
    mon: [['Temps de travail', 'minute par minute'], ['Bonnes réponses', 'question par question'], ['Progrès', 'chapitre par chapitre']],
    con: 'Avec ton compte', van: [['tempo', 'Niveaux et points pour ton travail'], ['calendario', 'Progrès et jours restants avant l’examen']],
    iscriviti: 'S’inscrire', studente: '', privacy: 'Confidentialité' },
  de: { occ: 'Kostenloses Konto', titolo: 'Registriere dich und steige auf', frase: 'Während du lernst, zählt die Seite für dich mit. Dein Fortschritt wächst Tag für Tag.',
    occA: 'Dein Konto', titoloA: 'Willkommen zurück', fraseA: 'Deine Fächer, dein Level und dein Fortschritt sind dort, wo du aufgehört hast.',
    livello: 'LEVEL', di: 'von 100', livelli: 'LEVEL', titoli: 'zehn Titel',
    mon: [['Lernzeit', 'Minute für Minute'], ['Richtige Antworten', 'Frage für Frage'], ['Fortschritt', 'Kapitel für Kapitel']],
    con: 'Mit deinem Konto', van: [['tempo', 'Level und Punkte für dein Lernen'], ['calendario', 'Fortschritt und Tage bis zur Prüfung']],
    iscriviti: 'Registrieren', studente: '', privacy: 'Datenschutz' },
}[lingua] ?? null;
const p = P!;
const sconto = lingua === 'it' || lingua === 'en';
const privacyHref = lingua === 'it' || lingua === 'en' ? link(lingua, '/privacy') : '/privacy?lingua=it';
// Anello: un arco per ciascuno dei dieci ranghi, nei colori degli stemmi.
const punto = (a: number) => [130 + 112 * Math.cos((a * Math.PI) / 180), 130 + 112 * Math.sin((a * Math.PI) / 180)].map((v) => v.toFixed(2)).join(',');
const archi = RANGHI.map((r, i) => ({ colore: r.it === 'Argento' ? '#9aa5ae' : r.medio, d: `M${punto(-90 + 36 * i + 3.2)} A112,112 0 0 1 ${punto(-90 + 36 * (i + 1) - 3.2)}` }));
const ICONE: Record<string, string> = {
  tempo: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  mirino: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3"/>',
  calendario: '<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>',
  sconto: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.3"/>',
  giuste: '<circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.5"/>',
  barre: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
};
const scene = lingua === 'it' ? SCENE : [];
const LUNG = ((112 * Math.PI * 2 * (36 - 6.4)) / 360).toFixed(2);
const nomiFasce = FASCE.map((f) => (lingua === 'en' ? f.nomeEn : lingua === 'es' ? f.nomeEs : lingua === 'fr' ? f.nomeFr : f.nome));
const conTitolo = lingua !== 'de';
const SPUNTA = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
---
<Base titolo={t.accedi} percorso={[{ titolo: t.accedi }]} descrizione={t.accediDescrizione} lingua={lingua} seo={{ noindex: true }}>
  <section class:list={['sl', { 'sl-solo': !scene.length }]}>
  <div class="sl-griglia">
    <aside class="sl-fisso">
      <svg class="sl-anello" viewBox="0 0 260 260" aria-hidden="true">
        {archi.map((x) => <Fragment><path d={x.d} class="sl-base" style={`--c:${x.colore}`} /><path d={x.d} class="sl-pieno" stroke={x.colore} stroke-dasharray={LUNG} stroke-dashoffset={LUNG} /></Fragment>)}
        <text x="130" y="96" text-anchor="middle" class="a1">{p.livello}</text><text x="130" y="158" text-anchor="middle" class="a2" data-sl="n">1</text><text x="130" y="184" text-anchor="middle" class="a3">{p.di}</text>
      </svg>
      {conTitolo && <p class="sl-titolo" data-sl="t">{nomiFasce[0]}</p>}
      {scene.length > 0 && <div class="sl-sotto">
        <p class="sl-scorri">Scorri e guarda il livello salire<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></p>
        <div class="sl-nav">
          <ol class="sl-indice">{scene.map(([breve], i) => <li><a href={`#sl-${i}`}><i>0{i + 1}</i>{breve}</a></li>)}</ol>
          <a class="bottone-primario sl-cta" href="#cima" data-sl-iscriviti>Iscriviti gratis</a>
        </div>
      </div>}
    </aside>
    <div class="sl-scene">
  <div class="acc sl-hero" data-acc="accedi" id="cima">
  <div class="sl-hero-a">
    <p class="acc-occ"><span data-acc-r>{p.occ}</span><span data-acc-a>{p.occA}</span></p>
    <h1><span data-acc-r>{p.titolo}</span><span data-acc-a>{p.titoloA}</span></h1>
    <p class="acc-frase"><span data-acc-r>{p.frase}</span><span data-acc-a>{p.fraseA}</span></p>
    <div class="acc-vantaggi" id="acc-vantaggi" hidden>
      <p class="acc-vt">{p.con}</p>
      <ul>
        {p.van.filter(([k]) => k !== 'sconto' || sconto).map(([k, testo]) => <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONE[k]} /><span>{testo}</span><svg class="acc-v" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></li>)}
      </ul>
    </div>
  </div>
  <div class="sl-hero-b">
  <div class="schede-accesso" role="tablist">
    <button type="button" role="tab" aria-selected="false" data-scheda="registrati">{t.creaUnAccount}</button>
    <button type="button" role="tab" aria-selected="true" data-scheda="accedi">{t.accedi}</button>
  </div>

  <form class="modulo" id="modulo" novalidate>
    <label id="campo-nome" hidden>{t.nome}<input type="text" name="nome" autocomplete="given-name" maxlength="40" /></label>
    <label>{lingua === 'fr' ? 'Adresse e-mail' : lingua === 'es' ? 'Correo electrónico' : lingua === 'de' ? 'E-Mail-Adresse' : 'Email'}<input type="email" name="email" autocomplete="email" required /></label>
    <label>{lingua === 'fr' ? 'Mot de passe' : lingua === 'es' ? 'Contraseña' : lingua === 'de' ? 'Passwort' : 'Password'}<span class="campo-password"><input type="password" name="password" autocomplete="current-password" required minlength="8" /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
    {lingua === 'it' && <CampoCorso nascosto />}
    <p class="esito-modulo" id="esito" role="status"></p>
    <button class="bottone-primario" type="submit" id="invia">{t.accedi}</button>
  </form>
  <p class="acc-note" id="acc-note-registrati" hidden>
    {p.studente ? <a href="#campo-corso" id="apri-corso" aria-expanded="false">{p.studente}</a> : <span></span>}
    <a href={privacyHref} hreflang={lingua === 'it' || lingua === 'en' ? undefined : 'it'}>{p.privacy}</a>
  </p>
  <p class="nota-accesso" id="nota-password"><a href="#recupera" id="apri-recupero">{t.passwordDimenticata}</a></p>

  <section class="dispositivi-login" id="gestione-dispositivi-login" aria-labelledby="titolo-dispositivi-login" hidden>
    <h2 id="titolo-dispositivi-login"></h2>
    <p class="nota-accesso">{lingua === 'fr' ? 'Choisis un appareil à déconnecter pour te connecter sur celui-ci. Les autres appareils resteront connectés.' : lingua === 'es' ? 'Elige un dispositivo para desconectarlo y acceder desde este. Los demás dispositivos seguirán conectados.' : lingua === 'de' ? 'Wähle ein Gerät aus, das du abmelden möchtest. Anschließend kannst du dich hier anmelden.' : lingua === 'en'
      ? 'Choose a device to disconnect, then sign in here. The other devices will stay connected.'
      : 'Scegli un dispositivo da scollegare per accedere da questo. Gli altri rimangono collegati.'}</p>
    <ul class="dispositivi-login-elenco" id="dispositivi-login-elenco"></ul>
    <p class="esito-modulo" id="esito-dispositivi-login" role="status" aria-live="polite"></p>
    <button type="button" class="bottone-secondario" id="torna-accesso-dispositivi">{t.tornaAccesso}</button>
  </section>

  <form class="modulo" id="modulo-recupero" novalidate hidden>
    <p class="nota-accesso">{t.recuperoSpiegazione}</p>
    <label>{lingua === 'fr' ? 'Adresse e-mail' : lingua === 'es' ? 'Correo electrónico' : lingua === 'de' ? 'E-Mail-Adresse' : 'Email'}<input type="email" name="email" autocomplete="email" required /></label>
    <p class="esito-modulo" id="esito-recupero" role="status"></p>
    <button class="bottone-primario" type="submit" id="invia-recupero">{t.inviaLink}</button>
    <p class="nota-accesso"><a href="#" id="torna-accesso">{t.tornaAccesso}</a></p>
  </form>

  </div>
  </div>
      {scene.map(([, titolo, descr, esempio, disegno], i) => <article class="sl-scena" id={`sl-${i}`}>
        <div class="sl-fig" set:html={disegno} />
        <div class="sl-testo"><p class="acc-occ">0{i + 1}</p><h2>{titolo}</h2><p class="sl-d">{descr}</p><p class="sl-es"><b>Per esempio</b>{esempio}</p><p class="sl-incl"><Fragment set:html={SPUNTA} />Compreso nell’account gratuito</p></div>
      </article>)}
    </div>
  </div>
  {scene.length > 0 && <div class="sl-fine"><p class="acc-occ">Account gratuito</p><h2>Si parte dal livello 1</h2><p>Tutto quello che hai visto è compreso nell’account gratuito.</p><ul class="sl-tre"><li><Fragment set:html={SPUNTA} />Gratuito</li><li><Fragment set:html={SPUNTA} />Si crea in un minuto</li><li><Fragment set:html={SPUNTA} />10% di sconto sulla prima materia</li></ul><a class="bottone-primario" href="#cima" data-sl-iscriviti>Iscriviti gratis</a></div>}
  </section>

  <script is:inline define:vars={{ js, pref, lingua, sconto, testoIscriviti: p.iscriviti }}>
    (() => {
      const modulo = document.getElementById('modulo');
      const esito = document.getElementById('esito');
      const invia = document.getElementById('invia');
      const campoNome = document.getElementById('campo-nome');
      const campoCorso = document.getElementById('campo-corso');
      const excorso = document.getElementById('excorso');
      const preregistrato = document.getElementById('preregistrato');
      const aggiornaCorso = () => {
        document.getElementById('dettagli-corso').hidden = !excorso.checked;
        document.getElementById('dettagli-preregistrato').hidden = !preregistrato.checked;
        document.getElementById('nota-corso').hidden = !excorso.checked && !preregistrato.checked;
      };
      if (excorso) { excorso.addEventListener('change', aggiornaCorso); preregistrato.addEventListener('change', aggiornaCorso); }
      const scelti = (nome) => [...modulo.querySelectorAll(`input[name="${nome}"]:checked`)].map((x) => x.value).join(', ');
      const corsoSeguito = () => {
        if (!excorso) return '';
        const parti = [];
        if (excorso.checked) parti.push('Corso dal vivo: ' + [scelti('corso'), modulo.corsonote.value.trim()].filter(Boolean).join(' · '));
        if (preregistrato.checked) parti.push('Preregistrato: ' + scelti('corsopre'));
        return parti.join('; ');
      };
      const dopo = new URLSearchParams(location.search).get('dopo');
      const destinazione = dopo && dopo.startsWith('/') && !dopo.startsWith('//') ? dopo : `${pref}/account`;
      // Si apre sull'iscrizione; chi è già entrato da questo browser (o arriva per recuperare la password) trova l'accesso.
      let giaEntrato = false; try { giaEntrato = localStorage.getItem('gia-entrato') === '1'; } catch (_) {}
      let scheda = new URLSearchParams(location.search).get('nuovo') ? 'registrati' : (giaEntrato || location.hash === '#recupera') ? 'accedi' : 'registrati';
      const riquadro = document.querySelector('.acc');
      const vantaggi = document.getElementById('acc-vantaggi');
      const noteRegistrati = document.getElementById('acc-note-registrati');
      const apriCorso = document.getElementById('apri-corso');
      let corsoAperto = false;
      if (apriCorso) apriCorso.addEventListener('click', (e) => {
        e.preventDefault(); corsoAperto = !corsoAperto;
        campoCorso.hidden = !corsoAperto; apriCorso.setAttribute('aria-expanded', String(corsoAperto));
      });
      const en = lingua === 'en', de = lingua === 'de', es = lingua === 'es', fr = lingua === 'fr';
      const gestioneDispositivi = document.getElementById('gestione-dispositivi-login');
      const elencoDispositivi = document.getElementById('dispositivi-login-elenco');
      const esitoDispositivi = document.getElementById('esito-dispositivi-login');
      const tornaDispositivi = document.getElementById('torna-accesso-dispositivi');
      const testiDispositivi = fr ? {
        limite: 'Tu as atteint la limite de {max} appareils',
        ultimo: 'Dernière utilisation : ', dispositivo: 'Appareil', scegli: 'Déconnecter et se connecter ici',
        conferma: 'Déconnecter {nome} ? Tu devras te reconnecter sur cet appareil.',
        scollega: 'Déconnecter et continuer', annulla: 'Annuler', attesa: 'Déconnexion…',
        scaduto: 'Par sécurité, saisis à nouveau ton mot de passe pour gérer tes appareils.',
        aggiornata: 'La liste des appareils a changé. Choisis un appareil dans la liste mise à jour.',
        vuota: 'Aucun appareil à déconnecter. Reconnecte-toi pour continuer.',
      } : es ? {
        limite: 'Has alcanzado el límite de {max} dispositivos',
        ultimo: 'Último uso: ', dispositivo: 'Dispositivo', scegli: 'Desconectar e iniciar sesión aquí',
        conferma: '¿Desconectar {nome}? Tendrás que volver a iniciar sesión en ese dispositivo.',
        scollega: 'Desconectar y continuar', annulla: 'Cancelar', attesa: 'Desconectando…',
        scaduto: 'Por seguridad, vuelve a introducir tu contraseña para gestionar tus dispositivos.',
        aggiornata: 'La lista de dispositivos ha cambiado. Elige uno de la lista actualizada.',
        vuota: 'No hay dispositivos que desconectar. Vuelve a iniciar sesión para continuar.',
      } : de ? {
        limite: 'Du hast bereits {max} Geräte verbunden',
        ultimo: 'Zuletzt verwendet: ', dispositivo: 'Gerät', scegli: 'Gerät abmelden und hier anmelden',
        conferma: 'Möchtest du {nome} abmelden? Auf diesem Gerät musst du dich anschließend erneut anmelden.',
        scollega: 'Gerät abmelden und fortfahren', annulla: 'Abbrechen', attesa: 'Gerät wird abgemeldet …',
        scaduto: 'Gib zur Sicherheit erneut dein Passwort ein, um deine Geräte zu verwalten.',
        aggiornata: 'Die Geräteliste hat sich geändert. Wähle ein Gerät aus der aktuellen Liste.',
        vuota: 'Es sind keine Geräte zum Abmelden vorhanden. Melde dich erneut an.',
      } : en ? {
        limite: 'You have reached the limit of {max} devices',
        ultimo: 'Last used: ', dispositivo: 'Device', scegli: 'Disconnect and sign in here',
        conferma: 'Disconnect {nome}? You will need to sign in again on that device. The other devices will stay connected.',
        scollega: 'Disconnect and continue', annulla: 'Cancel', attesa: 'Disconnecting…',
        scaduto: 'For your security, please enter your password again to manage your devices.',
        aggiornata: 'The device list has changed. Choose a device from the updated list.',
        vuota: 'No devices to disconnect. Sign in again to continue.',
      } : {
        limite: 'Hai raggiunto il limite di {max} dispositivi',
        ultimo: 'Ultimo utilizzo: ', dispositivo: 'Dispositivo', scegli: 'Scollega e accedi qui',
        conferma: 'Scollegare {nome}? Su quel dispositivo sarà necessario accedere di nuovo. Gli altri rimangono collegati.',
        scollega: 'Scollega e continua', annulla: 'Annulla', attesa: 'Scollegamento in corso…',
        scaduto: 'Per sicurezza, inserisci di nuovo la password per gestire i dispositivi.',
        aggiornata: 'La lista dei dispositivi è cambiata. Scegli un dispositivo dall’elenco aggiornato.',
        vuota: 'Non ci sono dispositivi da scollegare. Accedi di nuovo per continuare.',
      };
      let scadenzaGestione;
      let dispositivoInAttesa = false;
      let chiudiConfermaDispositivo = () => {};
      const esitoGestione = (testo, errore = false) => {
        esitoDispositivi.textContent = testo;
        esitoDispositivi.className = errore ? 'esito-modulo errore' : 'esito-modulo';
      };
      const chiudiGestione = (messaggio = '') => {
        clearTimeout(scadenzaGestione);
        gestioneDispositivi.hidden = true;
        elencoDispositivi.replaceChildren();
        modulo.hidden = false;
        document.querySelector('.schede-accesso').hidden = false;
        imposta(scheda);
        modulo.password.value = '';
        invia.disabled = false;
        esito.textContent = messaggio;
        esito.className = messaggio ? 'esito-modulo errore' : 'esito-modulo';
        modulo.password.focus();
      };
      const inAttesaDispositivi = (attesa) => {
        dispositivoInAttesa = attesa;
        gestioneDispositivi.setAttribute('aria-busy', String(attesa));
        gestioneDispositivi.querySelectorAll('button').forEach((b) => { b.disabled = attesa; });
      };
      const disegnaDispositivi = (dispositivi) => {
        chiudiConfermaDispositivo = () => {};
        elencoDispositivi.replaceChildren();
        const disponibili = dispositivi.filter((d) => d && typeof d.id === 'string' && !d.questo);
        for (const [indice, dispositivo] of disponibili.entries()) {
          const nome = typeof dispositivo.nome === 'string' ? dispositivo.nome : testiDispositivi.dispositivo;
          const li = document.createElement('li');
