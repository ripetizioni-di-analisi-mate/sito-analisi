---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import Base from '../layouts/Base.astro';
import { link, testiJs, T, prefisso, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const js = testiJs(lingua);
const pref = prefisso(lingua);
---
<Base titolo={t.accedi} percorso={[{ titolo: t.accedi }]} descrizione={t.accediDescrizione} lingua={lingua} seo={{ noindex: true }}>
  <h1>{t.ilTuoAccount}</h1>
  <p class="sommario">{t.accediSommario}</p>

  <div class="schede-accesso" role="tablist">
    <button type="button" role="tab" aria-selected="true" data-scheda="accedi">{t.accedi}</button>
    <button type="button" role="tab" aria-selected="false" data-scheda="registrati">{t.creaUnAccount}</button>
  </div>

  <form class="modulo" id="modulo" novalidate>
    <label id="campo-nome" hidden>{t.nome}<input type="text" name="nome" autocomplete="given-name" maxlength="40" /></label>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    <label>Password<span class="campo-password"><input type="password" name="password" autocomplete="current-password" required minlength="8" /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
    <label id="campo-conferma" hidden>{t.ripetiPassword}<span class="campo-password"><input type="password" name="conferma" autocomplete="new-password" minlength="8" /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
    {lingua === 'it' && (
      <fieldset class="campo-corso" id="campo-corso" hidden>
        <legend>Sei già uno studente di Carmine? <small>(facoltativo)</small></legend>
        <label class="spunta"><input type="checkbox" name="excorso" id="excorso" /><span>Ho seguito o sto seguendo un corso con Carmine</span></label>
        <div class="dettagli-corso" id="dettagli-corso" hidden>
          <span class="domanda-corso">Quale corso?</span>
          <label class="spunta"><input type="checkbox" name="corso" value="Analisi 1" /> Analisi 1</label>
          <label class="spunta"><input type="checkbox" name="corso" value="Analisi 2" /> Analisi 2</label>
          <label><span>Anno, numero del corso o altre informazioni <small>(facoltativo)</small></span><input type="text" name="corsonote" maxlength="80" placeholder="Per esempio: corso di marzo 2026" /></label>
        </div>
        <label class="spunta"><input type="checkbox" name="preregistrato" id="preregistrato" /><span>Ho acquistato un corso preregistrato di Analisi 1 o Analisi 2</span></label>
        <div class="dettagli-corso" id="dettagli-preregistrato" hidden>
          <span class="domanda-corso">Quale corso preregistrato?</span>
          <label class="spunta"><input type="checkbox" name="corsopre" value="Analisi 1" /> Analisi 1</label>
          <label class="spunta"><input type="checkbox" name="corsopre" value="Analisi 2" /> Analisi 2</label>
        </div>
        <p class="nota-corso" id="nota-corso" hidden>Carmine controlla l'iscrizione e ti attiva gratis le materie collegate al corso.</p>
      </fieldset>
    )}
    <p class="esito-modulo" id="esito" role="status"></p>
    <button class="bottone-primario" type="submit" id="invia">{t.accedi}</button>
    <p class="nota-privacy" id="nota-privacy" hidden>{lingua === 'it'
      ? <>I tuoi dati servono solo a far funzionare l'account e non vengono venduti né ceduti a terzi. <a href={link(lingua, '/privacy')}>Informativa sulla privacy</a></>
      : <>Your data are used only to run your account and are never sold or passed on to third parties. <a href={link(lingua, '/privacy')}>Privacy policy</a></>}</p>
  </form>
  <p class="nota-accesso" id="nota-password">{t.passwordDimenticata} <a href={link(lingua, '/contatti')}>{t.contatti}</a> {t.eTeNeImposto}</p>

  <script is:inline define:vars={{ js, pref }}>
    (() => {
      const modulo = document.getElementById('modulo');
      const esito = document.getElementById('esito');
      const invia = document.getElementById('invia');
      const conferma = document.getElementById('campo-conferma');
      const campoNome = document.getElementById('campo-nome');
      const campoCorso = document.getElementById('campo-corso');
      const excorso = document.getElementById('excorso');
      const preregistrato = document.getElementById('preregistrato');
      const aggiornaCorso = () => {
        document.getElementById('dettagli-corso').hidden = !excorso.checked;
        document.getElementById('dettagli-preregistrato').hidden = !preregistrato.checked;
        document.getElementById('nota-corso').hidden = !excorso.checked && !preregistrato.checked;
      };
      if (excorso) { excorso.addEventListener('change', aggiornaCorso); preregistrato.addEventListener('change', aggiornaCorso); }
      const scelti = (nome) => [...modulo.querySelectorAll(`input[name="${nome}"]:checked`)].map((x) => x.value).join(', ');
      const corsoSeguito = () => {
        if (!excorso) return '';
        const parti = [];
        if (excorso.checked) parti.push('Corso dal vivo: ' + [scelti('corso'), modulo.corsonote.value.trim()].filter(Boolean).join(' · '));
        if (preregistrato.checked) parti.push('Preregistrato: ' + scelti('corsopre'));
        return parti.join('; ');
      };
      const dopo = new URLSearchParams(location.search).get('dopo');
      const destinazione = dopo && dopo.startsWith('/') && !dopo.startsWith('//') ? dopo : `${pref}/account`;
      let scheda = new URLSearchParams(location.search).get('nuovo') ? 'registrati' : 'accedi';

      const imposta = (s) => {
        scheda = s;
        document.querySelectorAll('[data-scheda]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.scheda === s)));
        conferma.hidden = s !== 'registrati';
        campoNome.hidden = s !== 'registrati';
        if (campoCorso) campoCorso.hidden = s !== 'registrati';
        document.getElementById('nota-privacy').hidden = s !== 'registrati';
        invia.textContent = s === 'registrati' ? js.creaAccount : js.accedi;
        modulo.password.autocomplete = s === 'registrati' ? 'new-password' : 'current-password';
        esito.textContent = ''; esito.className = 'esito-modulo';
      };
      document.querySelectorAll('[data-scheda]').forEach((b) => b.addEventListener('click', () => imposta(b.dataset.scheda)));
      imposta(scheda);

      modulo.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = modulo.email.value.trim().toLowerCase();
        const password = modulo.password.value;
        const errore = (t) => { esito.textContent = t; esito.className = 'esito-modulo errore'; };
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return errore(js.emailNonValida);
        if (password.length < 8) return errore(js.passwordCorta);
        if (scheda === 'registrati' && password !== modulo.conferma.value) return errore(js.passwordDiverse);
        if (scheda === 'registrati' && !modulo.nome.value.trim()) return errore(js.nomeMancante);
        if (scheda === 'registrati' && excorso && excorso.checked && !modulo.querySelector('input[name="corso"]:checked') && !modulo.corsonote.value.trim()) return errore('Indica quale corso, oppure togli la spunta.');
        if (scheda === 'registrati' && preregistrato && preregistrato.checked && !scelti('corsopre')) return errore('Indica quale corso preregistrato hai acquistato, oppure togli la spunta.');
        invia.disabled = true; esito.textContent = '…'; esito.className = 'esito-modulo';
        try {
          const r = await fetch(scheda === 'registrati' ? '/api/registrati' : '/api/accedi', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, password, nome: modulo.nome.value.trim(), corso: scheda === 'registrati' ? corsoSeguito() : '', lingua: pref ? 'en' : 'it' }),
          });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) { invia.disabled = false; return errore(d.errore || js.erroreGenerico); }
          location.href = destinazione;
        } catch {
          invia.disabled = false; errore(js.connessione);
        }
      });
    })();
  </script>
</Base>
