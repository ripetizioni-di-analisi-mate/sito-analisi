---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto } from '../lib/seo';
import Base from '../layouts/Base.astro';
import CampoCorso from '../components/CampoCorso.astro';
import ConsensoEmail from '../components/ConsensoEmail.astro';
import '../styles/dispositivi-login.css';
import { link, testiJs, T, prefisso, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const t = T(lingua);
const js = testiJs(lingua);
const pref = prefisso(lingua);
---
<Base titolo={t.accedi} percorso={[{ titolo: t.accedi }]} descrizione={t.accediDescrizione} lingua={lingua} seo={{ noindex: true }}>
  <h1>{t.ilTuoAccount}</h1>
  <p class="sommario">{t.accediSommario}</p>

  <div class="schede-accesso" role="tablist">
    <button type="button" role="tab" aria-selected="true" data-scheda="accedi">{t.accedi}</button>
    <button type="button" role="tab" aria-selected="false" data-scheda="registrati">{t.creaUnAccount}</button>
  </div>

  <form class="modulo" id="modulo" novalidate>
    <label id="campo-nome" hidden>{t.nome}<input type="text" name="nome" autocomplete="given-name" maxlength="40" /></label>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    <label>Password<span class="campo-password"><input type="password" name="password" autocomplete="current-password" required minlength="8" /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
    <label id="campo-conferma" hidden>{t.ripetiPassword}<span class="campo-password"><input type="password" name="conferma" autocomplete="new-password" minlength="8" /><button type="button" class="mostra-password" data-mostra-password aria-label={t.mostraPassword} aria-pressed="false"><svg class="occhio-aperto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><svg class="occhio-chiuso" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.7 17.7 0 0 1-3.2 4.1M6.6 6.6C3.9 8.4 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button></span></label>
    {lingua === 'it' && <CampoCorso nascosto />}
    <ConsensoEmail lingua={lingua} scegliMateria nascosto />
    <p class="esito-modulo" id="esito" role="status"></p>
    <button class="bottone-primario" type="submit" id="invia">{t.accedi}</button>
    <p class="nota-privacy" id="nota-privacy" hidden>{lingua === 'it'
      ? <>Consulta come vengono trattati i dati del tuo account. <a href={link(lingua, '/privacy')}>Informativa sulla privacy</a></>
      : <>See how we handle your account data. <a href={link(lingua, '/privacy')}>Privacy policy</a></>}</p>
  </form>
  <p class="nota-accesso" id="nota-password"><a href="#recupera" id="apri-recupero">{t.passwordDimenticata}</a></p>

  <section class="dispositivi-login" id="gestione-dispositivi-login" aria-labelledby="titolo-dispositivi-login" hidden>
    <h2 id="titolo-dispositivi-login"></h2>
    <p class="nota-accesso">{lingua === 'en'
      ? 'Choose a device to disconnect, then sign in here. The other devices will stay connected.'
      : 'Scegli un dispositivo da scollegare per accedere da questo. Gli altri rimangono collegati.'}</p>
    <ul class="dispositivi-login-elenco" id="dispositivi-login-elenco"></ul>
    <p class="esito-modulo" id="esito-dispositivi-login" role="status" aria-live="polite"></p>
    <button type="button" class="bottone-secondario" id="torna-accesso-dispositivi">{lingua === 'en' ? 'Back to sign in' : 'Torna all’accesso'}</button>
  </section>

  <form class="modulo" id="modulo-recupero" novalidate hidden>
    <p class="nota-accesso">{t.recuperoSpiegazione}</p>
    <label>Email<input type="email" name="email" autocomplete="email" required /></label>
    <p class="esito-modulo" id="esito-recupero" role="status"></p>
    <button class="bottone-primario" type="submit" id="invia-recupero">{t.inviaLink}</button>
    <p class="nota-accesso"><a href="#" id="torna-accesso">{t.tornaAccesso}</a></p>
  </form>

  <script is:inline define:vars={{ js, pref }}>
    (() => {
      const modulo = document.getElementById('modulo');
      const esito = document.getElementById('esito');
      const invia = document.getElementById('invia');
      const conferma = document.getElementById('campo-conferma');
      const campoNome = document.getElementById('campo-nome');
      const campoCorso = document.getElementById('campo-corso');
      const excorso = document.getElementById('excorso');
      const preregistrato = document.getElementById('preregistrato');
      const aggiornaCorso = () => {
        document.getElementById('dettagli-corso').hidden = !excorso.checked;
        document.getElementById('dettagli-preregistrato').hidden = !preregistrato.checked;
        document.getElementById('nota-corso').hidden = !excorso.checked && !preregistrato.checked;
      };
      if (excorso) { excorso.addEventListener('change', aggiornaCorso); preregistrato.addEventListener('change', aggiornaCorso); }
      const scelti = (nome) => [...modulo.querySelectorAll(`input[name="${nome}"]:checked`)].map((x) => x.value).join(', ');
      const corsoSeguito = () => {
        if (!excorso) return '';
        const parti = [];
        if (excorso.checked) parti.push('Corso dal vivo: ' + [scelti('corso'), modulo.corsonote.value.trim()].filter(Boolean).join(' · '));
        if (preregistrato.checked) parti.push('Preregistrato: ' + scelti('corsopre'));
        return parti.join('; ');
      };
      const dopo = new URLSearchParams(location.search).get('dopo');
      const destinazione = dopo && dopo.startsWith('/') && !dopo.startsWith('//') ? dopo : `${pref}/account`;
      let scheda = new URLSearchParams(location.search).get('nuovo') ? 'registrati' : 'accedi';
      const en = pref === '/en';
      const gestioneDispositivi = document.getElementById('gestione-dispositivi-login');
      const elencoDispositivi = document.getElementById('dispositivi-login-elenco');
      const esitoDispositivi = document.getElementById('esito-dispositivi-login');
      const tornaDispositivi = document.getElementById('torna-accesso-dispositivi');
      const testiDispositivi = en ? {
        limite: 'You have reached the limit of {max} devices',
        ultimo: 'Last used: ', dispositivo: 'Device', scegli: 'Disconnect and sign in here',
        conferma: 'Disconnect {nome}? You will need to sign in again on that device. The other devices will stay connected.',
        scollega: 'Disconnect and continue', annulla: 'Cancel', attesa: 'Disconnecting…',
        scaduto: 'For your security, please enter your password again to manage your devices.',
        aggiornata: 'The device list has changed. Choose a device from the updated list.',
        vuota: 'No devices to disconnect. Sign in again to continue.',
      } : {
        limite: 'Hai raggiunto il limite di {max} dispositivi',
        ultimo: 'Ultimo utilizzo: ', dispositivo: 'Dispositivo', scegli: 'Scollega e accedi qui',
        conferma: 'Scollegare {nome}? Su quel dispositivo sarà necessario accedere di nuovo. Gli altri rimangono collegati.',
        scollega: 'Scollega e continua', annulla: 'Annulla', attesa: 'Scollegamento in corso…',
        scaduto: 'Per sicurezza, inserisci di nuovo la password per gestire i dispositivi.',
        aggiornata: 'La lista dei dispositivi è cambiata. Scegli un dispositivo dall’elenco aggiornato.',
        vuota: 'Non ci sono dispositivi da scollegare. Accedi di nuovo per continuare.',
      };
      let scadenzaGestione;
      let dispositivoInAttesa = false;
      let chiudiConfermaDispositivo = () => {};
      const esitoGestione = (testo, errore = false) => {
        esitoDispositivi.textContent = testo;
        esitoDispositivi.className = errore ? 'esito-modulo errore' : 'esito-modulo';
      };
      const chiudiGestione = (messaggio = '') => {
        clearTimeout(scadenzaGestione);
        gestioneDispositivi.hidden = true;
        elencoDispositivi.replaceChildren();
        modulo.hidden = false;
        document.querySelector('.schede-accesso').hidden = false;
        document.getElementById('nota-password').hidden = false;
        modulo.password.value = '';
        invia.disabled = false;
        esito.textContent = messaggio;
        esito.className = messaggio ? 'esito-modulo errore' : 'esito-modulo';
        modulo.password.focus();
      };
      const inAttesaDispositivi = (attesa) => {
        dispositivoInAttesa = attesa;
        gestioneDispositivi.setAttribute('aria-busy', String(attesa));
        gestioneDispositivi.querySelectorAll('button').forEach((b) => { b.disabled = attesa; });
      };
      const disegnaDispositivi = (dispositivi) => {
        chiudiConfermaDispositivo = () => {};
        elencoDispositivi.replaceChildren();
        const disponibili = dispositivi.filter((d) => d && typeof d.id === 'string' && !d.questo);
        for (const [indice, dispositivo] of disponibili.entries()) {
          const nome = typeof dispositivo.nome === 'string' ? dispositivo.nome : testiDispositivi.dispositivo;
          const li = document.createElement('li');
          const riga = document.createElement('div'); riga.className = 'dispositivi-login-riga';
          const dati = document.createElement('div'); dati.className = 'dispositivi-login-dati';
          const titolo = document.createElement('strong'); titolo.textContent = nome; dati.appendChild(titolo);
          const ultimo = new Date(dispositivo.ultimo_uso);
          if (dispositivo.ultimo_uso && !Number.isNaN(ultimo.getTime())) {
            const data = document.createElement('span');
            data.textContent = testiDispositivi.ultimo + ultimo.toLocaleString(en ? 'en-GB' : 'it-IT', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            dati.appendChild(data);
          }
          const scegli = document.createElement('button');
          scegli.type = 'button'; scegli.className = 'bottone-secondario'; scegli.textContent = testiDispositivi.scegli;
          scegli.setAttribute('aria-label', `${testiDispositivi.scegli}: ${nome}`);
          scegli.setAttribute('aria-expanded', 'false');
          const conferma = document.createElement('div');
          conferma.className = 'dispositivi-login-conferma'; conferma.hidden = true;
          conferma.id = `conferma-dispositivo-login-${indice}`;
          scegli.setAttribute('aria-controls', conferma.id);
          const spiegazione = document.createElement('p'); spiegazione.textContent = testiDispositivi.conferma.replace('{nome}', nome);
          spiegazione.id = `spiegazione-dispositivo-login-${indice}`;
          const azioni = document.createElement('div'); azioni.className = 'dispositivi-login-azioni';
          const continua = document.createElement('button');
          continua.type = 'button'; continua.className = 'bottone-primario'; continua.textContent = testiDispositivi.scollega;
          continua.setAttribute('aria-describedby', spiegazione.id);
          const annulla = document.createElement('button');
          annulla.type = 'button'; annulla.className = 'bottone-secondario'; annulla.textContent = testiDispositivi.annulla;
          const chiudi = () => { conferma.hidden = true; scegli.setAttribute('aria-expanded', 'false'); };
          scegli.addEventListener('click', () => {
            if (dispositivoInAttesa) return;
            chiudiConfermaDispositivo();
            conferma.hidden = false; scegli.setAttribute('aria-expanded', 'true');
            chiudiConfermaDispositivo = chiudi;
            continua.focus();
          });
          annulla.addEventListener('click', () => { chiudi(); scegli.focus(); });
          conferma.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !dispositivoInAttesa) { chiudi(); scegli.focus(); }
          });
          continua.addEventListener('click', () => sostituisciDispositivo(dispositivo.id));
          azioni.append(continua, annulla); conferma.append(spiegazione, azioni);
          riga.append(dati, scegli); li.append(riga, conferma); elencoDispositivi.appendChild(li);
        }
        if (!disponibili.length) esitoGestione(testiDispositivi.vuota);
      };
      const aggiornaDispositivi = async () => {
        const risposta = await fetch(`/api/dispositivi?gestione=1${en ? '&l=en' : ''}`, { cache: 'no-store', credentials: 'same-origin' });
        const dati = await risposta.json().catch(() => ({}));
        if (risposta.status === 401 || dati.scaduto) { chiudiGestione(testiDispositivi.scaduto); return false; }
        if (!risposta.ok || !Array.isArray(dati.dispositivi)) throw new Error(js.erroreGenerico);
        disegnaDispositivi(dati.dispositivi);
        return true;
      };
      const sostituisciDispositivo = async (id) => {
        if (dispositivoInAttesa) return;
        inAttesaDispositivi(true); esitoGestione(testiDispositivi.attesa);
        try {
          const risposta = await fetch(`/api/dispositivi/sostituisci${en ? '?l=en' : ''}`, {
            method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id }),
          });
          const dati = await risposta.json().catch(() => ({}));
          if (risposta.ok && dati.ok) { clearTimeout(scadenzaGestione); location.href = destinazione; return; }
          if (risposta.status === 401 || dati.scaduto) { chiudiGestione(testiDispositivi.scaduto); return; }
          if (risposta.status === 409 && dati.aggiorna) {
            if (await aggiornaDispositivi()) {
              esitoGestione(testiDispositivi.aggiornata);
              (elencoDispositivi.querySelector('button') || tornaDispositivi).focus();
            }
            return;
          }
          esitoGestione(dati.errore || js.erroreGenerico, true);
        } catch {
          // Rilegge solo l'elenco autorizzato da questo tentativo di accesso.
          try {
            if (await aggiornaDispositivi()) esitoGestione(js.connessione, true);
          } catch { esitoGestione(js.connessione, true); }
        } finally { inAttesaDispositivi(false); }
      };
      const mostraGestione = (dati) => {
        clearTimeout(scadenzaGestione);
        modulo.hidden = true;
        document.querySelector('.schede-accesso').hidden = true;
        document.getElementById('nota-password').hidden = true;
        modulo.password.value = '';
        esito.textContent = '';
        esitoGestione('');
        document.getElementById('titolo-dispositivi-login').textContent = testiDispositivi.limite.replace('{max}', dati.max || 3);
        disegnaDispositivi(dati.dispositivi);
        gestioneDispositivi.hidden = false;
        inAttesaDispositivi(false);
        (elencoDispositivi.querySelector('button') || tornaDispositivi).focus();
        scadenzaGestione = setTimeout(() => chiudiGestione(testiDispositivi.scaduto), 5 * 60 * 1000);
      };
      tornaDispositivi.addEventListener('click', () => { if (!dispositivoInAttesa) chiudiGestione(); });

      const imposta = (s) => {
        scheda = s;
        document.querySelectorAll('[data-scheda]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.scheda === s)));
        conferma.hidden = s !== 'registrati';
        campoNome.hidden = s !== 'registrati';
        if (campoCorso) campoCorso.hidden = s !== 'registrati';
        document.getElementById('nota-privacy').hidden = s !== 'registrati';
        modulo.querySelector('[data-consenso-email]').hidden = s !== 'registrati';
        invia.textContent = s === 'registrati' ? js.creaAccount : js.accedi;
        modulo.password.autocomplete = s === 'registrati' ? 'new-password' : 'current-password';
        esito.textContent = ''; esito.className = 'esito-modulo';
      };
      document.querySelectorAll('[data-scheda]').forEach((b) => b.addEventListener('click', () => imposta(b.dataset.scheda)));
      imposta(scheda);

      modulo.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = modulo.email.value.trim().toLowerCase();
        const password = modulo.password.value;
        const errore = (t) => { esito.textContent = t; esito.className = 'esito-modulo errore'; };
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return errore(js.emailNonValida);
        if (password.length < 8) return errore(js.passwordCorta);
        if (scheda === 'registrati' && password !== modulo.conferma.value) return errore(js.passwordDiverse);
        if (scheda === 'registrati' && !modulo.nome.value.trim()) return errore(js.nomeMancante);
        if (scheda === 'registrati' && excorso && excorso.checked && !modulo.querySelector('input[name="corso"]:checked') && !modulo.corsonote.value.trim()) return errore('Indica quale corso, oppure togli la spunta.');
        if (scheda === 'registrati' && preregistrato && preregistrato.checked && !scelti('corsopre')) return errore('Indica quale corso preregistrato hai acquistato, oppure togli la spunta.');
        invia.disabled = true; esito.textContent = '…'; esito.className = 'esito-modulo';
        try {
          const r = await fetch(scheda === 'registrati' ? '/api/registrati' : '/api/accedi', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, password, nome: modulo.nome.value.trim(), corso: scheda === 'registrati' ? corsoSeguito() : '', lingua: pref ? 'en' : 'it',
              offerte: scheda === 'registrati' && modulo.offerte.checked, materiaEmail: modulo.materiaEmail.value }),
          });
          const d = await r.json().catch(() => ({}));
          if (!r.ok) {
            invia.disabled = false;
            if (d.limite && d.gestione && Array.isArray(d.dispositivi)) { mostraGestione(d); return; }
            return errore(d.errore || js.erroreGenerico);
          }
          // conversione per Google Ads (src/data/misurazione.ts)
          if (scheda === 'registrati') { try { window.misura && window.misura('account', { email }); } catch (_) {} }
          location.href = destinazione;
        } catch {
          invia.disabled = false; errore(js.connessione);
        }
      });

      // Password dimenticata: si chiede il link via email.
      const recupero = document.getElementById('modulo-recupero');
      const notaPassword = document.getElementById('nota-password');
      const schede = document.querySelector('.schede-accesso');
      const mostraRecupero = (si) => {
        recupero.hidden = !si; modulo.hidden = si; schede.hidden = si; notaPassword.hidden = si;
        if (si) { recupero.email.value = modulo.email.value.trim(); recupero.email.focus(); }
      };
      document.getElementById('apri-recupero').addEventListener('click', (e) => { e.preventDefault(); mostraRecupero(true); });
      document.getElementById('torna-accesso').addEventListener('click', (e) => { e.preventDefault(); mostraRecupero(false); imposta('accedi'); });
      if (location.hash === '#recupera') mostraRecupero(true);
      recupero.addEventListener('submit', async (e) => {
        e.preventDefault();
        const er = document.getElementById('esito-recupero');
        const bottone = document.getElementById('invia-recupero');
        const email = recupero.email.value.trim().toLowerCase();
        const errore = (t) => { er.textContent = t; er.className = 'esito-modulo errore'; };
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return errore(js.emailNonValida);
        bottone.disabled = true; er.textContent = '…'; er.className = 'esito-modulo';
        try {
          const r = await fetch('/api/password-dimenticata', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email, lingua: pref ? 'en' : 'it' }),
          });
          const d = await r.json().catch(() => ({}));
          bottone.disabled = false;
          if (!r.ok) return errore(d.errore || js.erroreGenerico);
          er.textContent = js.linkInviato.replace('{email}', email); er.className = 'esito-modulo';
        } catch {
          bottone.disabled = false; errore(js.connessione);
        }
      });
    })();
  </script>
</Base>
