---
// Lega della settimana: classifica del gruppo dello studente (fino a 30 studenti della stessa lega),
// con l'EXP guadagnato da lunedì. Dati da /api/lega (worker/sfide.mjs). Solo italiano.
import Base from '../layouts/Base.astro';
import { LEGHE, LEGA_GRUPPO, quoteLega } from '../data/sfide';
const titolo = 'Lega della settimana';
const q = quoteLega(LEGA_GRUPPO, 4);
---
<Base titolo={titolo} descrizione="La classifica settimanale degli studenti: dieci leghe, gruppi di trenta, i primi salgono e gli ultimi scendono." percorso={[{ titolo }]}
  lingua="it" seo={{ noindex: true }}>
  <div class="lega" data-leghe={JSON.stringify(LEGHE)}>
    <div class="lega-barra">
      <p class="sopratitolo">{titolo}</p>
      <div class="lega-gm" hidden>
        <button type="button" class="lega-gm-apri" aria-label="Apri i comandi GM" aria-expanded="false" aria-controls="lega-gm-pannello">GM</button>
        <div class="lega-gm-pannello" id="lega-gm-pannello" role="group" aria-label="Comandi GM" hidden>
          <div class="lega-gm-titolo"><strong>Visualizza una lega</strong><button type="button" class="lega-gm-chiudi" aria-label="Chiudi i comandi GM">×</button></div>
          <label>Lega<select id="lega-gm-lega"><option value="mia">La mia lega</option>{LEGHE.map((nome, i) => <option value={i}>{nome}</option>)}</select></label>
          <label class="lega-gm-gruppo" hidden>Gruppo<select id="lega-gm-gruppo"></select></label>
          <p class="lega-gm-esito" role="status" aria-live="polite"></p>
          <div class="lega-gm-azioni"><button type="button" class="lega-gm-riprova" hidden>Riprova</button><button type="button" class="lega-gm-mia">Torna alla mia lega</button><button type="button" class="lega-gm-foto">Prepara screenshot</button></div>
          <p class="lega-gm-nota">Per rivedere i comandi dopo lo screenshot, premi Esc o tocca lo stemma della lega.</p>
        </div>
      </div>
    </div>
    <div class="lega-testa">
      <div class="lega-medaglia" aria-hidden="true"></div>
      <div>
        <h1 class="lega-nome">Classifica</h1>
        <p class="lega-tempo"></p>
      </div>
      <button type="button" class="lega-foto-ritorna" aria-label="Mostra di nuovo i comandi GM" hidden></button>
    </div>
    <ol class="lega-scala" aria-label="Le dieci leghe">{LEGHE.map((n, i) => <li data-i={i}><span>{n}</span></li>)}</ol>

    <p class="lega-esito" hidden></p>

    <div class="lega-ospite" hidden>
      <p>La lega si collega all'account: con un account gratuito si entra in un gruppo appena si guadagnano i primi EXP della settimana.</p>
      <p><a class="bottone-primario" href="/accedi?nuovo=1&dopo=/lega">Crea un account gratuito</a> <a class="bottone-secondario" href="/accedi?dopo=/lega">Accedi</a></p>
    </div>

    <p class="lega-attesa" hidden>Il gruppo di questa settimana si forma con i primi EXP: basta una risposta corretta a una domanda a tempo o qualche minuto di studio. <a href="/domande-a-tempo">Domande a tempo</a></p>
    <p class="lega-vuota" hidden>In questa lega non ci sono ancora gruppi per la settimana in corso.</p>

    <div class="lega-classifica" hidden>
      <p class="lega-gruppo" hidden></p>
      <table aria-label="Classifica del tuo gruppo">
        <thead><tr><th scope="col" aria-label="Posizione">#</th><th scope="col">Partecipante</th><th scope="col" class="num">EXP della settimana</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>

    <section class="lega-regole">
      <h2>Come funziona</h2>
      <p>Le leghe sono dieci, da {LEGHE[0]} a {LEGHE[LEGHE.length - 1]}. Ogni settimana, da lunedì a domenica, chi guadagna i primi EXP entra in un gruppo di al massimo {LEGA_GRUPPO} studenti della propria lega. Il tuo punteggio in classifica è la somma degli EXP guadagnati nella settimana con lo studio attivo, le domande a tempo, gli esercizi verificati e i duelli. Trovi il dettaglio in <a href="/livelli-e-punti">Livelli e punti</a>.</p>
      <p>Nei gruppi con pochi studenti puoi incontrare avversari simulati. Guadagnano EXP di tanto in tanto e nelle leghe più alte possono raggiungere punteggi maggiori. Per salire o scendere di lega conta la tua posizione tra gli studenti.</p>
      <p>Domenica a mezzanotte la classifica si chiude. In un gruppo completo di {LEGA_GRUPPO} studenti i primi {q.sale} salgono nella lega successiva e gli ultimi {q.scende} scendono in quella precedente. Nei gruppi più piccoli le quote sono proporzionali e sotto i 10 studenti nessuno scende. Tra due studenti con gli stessi EXP precede chi è entrato prima nel gruppo.</p>
    </section>

    <section class="lega-nome-pubblico" hidden>
      <h2>Le tue preferenze</h2>
      <form>
        <label>Nome mostrato agli altri studenti <input type="text" name="soprannome" maxlength="24" placeholder="" autocomplete="nickname" /></label>
        <label class="spunta"><input type="checkbox" name="pubblico" /> Mostra il mio nome nelle classifiche e nell'elenco degli studenti online dei duelli</label>
        <p class="nota">Senza la spunta il tuo nome compare come «Studente» e non sei nell'elenco degli studenti online; puoi comunque giocare i duelli con un link.</p>
        <label class="spunta"><input type="checkbox" name="avvisiLega" /> Avvisami via email quando uno studente mi supera e scendo in classifica</label>
        <button type="submit" class="bottone-secondario">Salva</button> <span class="salvato" hidden>Salvato.</span>
        <span class="errore-salvataggio" role="alert" hidden>Le preferenze non sono state salvate. Riprova.</span>
      </form>
    </section>
  </div>
</Base>

<style is:global>
  .lega-barra { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .lega-barra > .sopratitolo { margin: 0; }
  .lega-gm { position: relative; flex: none; font-family: var(--ui); }
  .lega-gm-apri { min-width: 44px; min-height: 44px; padding: 0.3rem 0.6rem; border: 0; border-radius: var(--raggio); background: none; color: var(--inchiostro-2); font: 600 0.75rem var(--ui); cursor: pointer; }
  .lega-gm-apri:hover, .lega-gm-apri[aria-expanded="true"] { color: var(--accento); background: var(--carta-2); }
  .lega-gm button:focus-visible, .lega-gm select:focus-visible { outline: 2px solid var(--accento); outline-offset: 3px; }
  .lega-gm-pannello { position: absolute; right: 0; top: calc(100% + 0.3rem); z-index: 35; width: min(20rem, calc(100vw - 3rem)); padding: 1rem; border: 1px solid var(--riga); border-radius: var(--raggio); background: var(--carta); box-shadow: 0 0.5rem 1.8rem rgb(0 0 0 / 12%); }
  .lega-gm-titolo { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; margin-bottom: 0.65rem; font-size: 0.92rem; }
  .lega-gm-chiudi { border: 0; background: none; color: var(--inchiostro-2); min-width: 36px; min-height: 36px; font: 1.4rem var(--ui); cursor: pointer; }
  .lega-gm-pannello label { display: block; margin-bottom: 0.75rem; font-size: 0.84rem; }
  .lega-gm-pannello select { display: block; width: 100%; min-height: 44px; margin-top: 0.3rem; padding: 0.5rem; border: 1px solid var(--riga); border-radius: var(--raggio); background: var(--carta); color: var(--inchiostro); font: 1rem var(--ui); }
  .lega-gm-azioni { display: grid; gap: 0.5rem; }
  .lega-gm-azioni button { min-height: 44px; padding: 0.5rem 0.65rem; border: 1px solid var(--riga); border-radius: var(--raggio); background: none; color: var(--inchiostro); font: 0.88rem var(--ui); cursor: pointer; }
  .lega-gm-azioni .lega-gm-foto { color: var(--accento); border-color: var(--accento); }
  .lega-gm button:disabled, .lega-gm select:disabled { opacity: 0.55; cursor: default; }
  .lega-gm-esito, .lega-gm-nota { margin: 0.7rem 0; font-size: 0.78rem; line-height: 1.45; color: var(--inchiostro-2); }
  .lega-gm-esito:empty { display: none; }
  .lega-gm-nota { margin-bottom: 0; }
  .lega-gm-esito.errore { color: var(--c-attenzione); }
  .lega-testa { position: relative; display: flex; align-items: center; gap: 1rem; margin: 0.4rem 0 0.8rem; }
  .lega-foto-ritorna { position: absolute; inset: 0; border: 0; background: transparent; cursor: pointer; }
  .lega-foto-ritorna:focus-visible { outline: 2px solid var(--accento); outline-offset: 4px; }
  .lega[data-foto] .lega-gm, .lega[data-foto] .lega-regole, .lega[data-foto] .lega-nome-pubblico, .lega[data-foto] .lega-esito,
  body.lega-foto .bottoni-fissi, body.lega-foto .pi-lancio, body.lega-foto .assistente, body.lega-foto .torna-su,
  body.lega-foto .bottone-whatsapp, body.lega-foto .avviso-premio, body.lega-foto .avviso-duello { display: none !important; }
  .lega-testa h1 { margin: 0; }
  .lega-tempo { margin: 0.15rem 0 0; font-family: var(--ui); color: var(--inchiostro-2); font-size: 0.92rem; }
  .lega-medaglia { flex: none; width: 3.6rem; height: 3.6rem; }
  .lega-medaglia:empty { display: none; }
  .lega-medaglia svg, .lega-scala svg { display: block; width: 100%; height: 100%; }
  .lega-scala { list-style: none; padding: 0; margin: 0 0 1.4rem; display: grid; grid-template-columns: repeat(10, 1fr); gap: 3px; font-family: var(--ui); }
  .lega-scala li { height: 6px; border-radius: 3px; background: var(--riga); position: relative; }
  .lega-scala li span { position: absolute; left: 0; top: 10px; font-size: 0.72rem; white-space: nowrap; color: var(--inchiostro-2); display: none; }
  .lega-scala li.passata { background: color-mix(in srgb, var(--accento) 45%, var(--riga)); }
  .lega-scala li.attuale { background: var(--accento); }
  .lega-scala li.attuale span { display: block; color: var(--accento); font-weight: 600; }
  .lega-scala li:first-child span { display: block; }
  .lega-scala li:last-child span { display: block; left: auto; right: 0; }
  .lega-scala.vicino-fine li:last-child:not(.attuale) span, .lega-scala.vicino-inizio li:first-child:not(.attuale) span { display: none; }
  .lega-esito { font-family: var(--ui); margin: 1.6rem 0 1rem; padding: 0.7rem 0.9rem; border-radius: var(--raggio); background: var(--carta-2); }
  .lega-esito.sale { background: color-mix(in srgb, #2f6f68 10%, var(--carta)); }
  .lega-ospite, .lega-attesa, .lega-vuota { font-family: var(--ui); margin-top: 1.6rem; }
  .lega-classifica { margin-top: 1.6rem; }
  .lega-gruppo { margin: 0 0 0.75rem; font: 0.88rem/1.45 var(--ui); color: var(--inchiostro-2); }
  .lega-classifica table { width: 100%; border-collapse: collapse; font-family: var(--ui); font-size: 0.95rem; }
  .lega-classifica th { text-align: left; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--inchiostro-2); font-weight: 600; padding: 0 0.5rem 0.4rem; border-bottom: 1px solid var(--riga); }
  .lega-classifica td { padding: 0.45rem 0.5rem; border-bottom: 1px solid color-mix(in srgb, var(--riga) 60%, transparent); vertical-align: middle; }
  .lega-classifica .num { text-align: right; font-variant-numeric: tabular-nums; }
  .lega-classifica td.pos { width: 2.2rem; color: var(--inchiostro-2); font-variant-numeric: tabular-nums; }
  .lega-classifica .chi { display: flex; align-items: center; gap: 0.55rem; }
  .lega-classifica .chi .mini { width: 1.35rem; height: 1.6rem; flex: none; }
  .lega-classifica .chi .mini svg { width: 100%; height: 100%; display: block; }
  .lega-classifica .chi small { color: var(--inchiostro-2); }
  .lega-classifica tr.io td { background: color-mix(in srgb, var(--accento) 8%, transparent); font-weight: 600; }
  .lega-classifica tr.sale td.pos { color: #2f6f68; font-weight: 700; }
  .lega-classifica tr.scende td.pos { color: #a3533f; font-weight: 700; }
  .lega-classifica tr.confine td { padding: 0.35rem 0.5rem; border-bottom: 0; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 600; }
  .lega-classifica tr.confine.sale td { color: #2f6f68; border-top: 1px dashed color-mix(in srgb, #2f6f68 50%, transparent); }
  .lega-classifica tr.confine.scende td { color: #a3533f; border-top: 1px dashed color-mix(in srgb, #a3533f 50%, transparent); }
  .lega-regole { margin-top: 2.4rem; }
  .lega-nome-pubblico form { font-family: var(--ui); display: grid; gap: 0.6rem; max-width: 30rem; }
  .lega-nome-pubblico input[type=text] { display: block; width: 100%; margin-top: 0.25rem; padding: 0.45rem 0.6rem; border: 1px solid var(--riga); border-radius: var(--raggio); font: inherit; background: white; }
  .lega-nome-pubblico .spunta { display: flex; gap: 0.5rem; align-items: flex-start; }
  .lega-nome-pubblico .nota { margin: 0; font-size: 0.85rem; color: var(--inchiostro-2); }
  .lega-nome-pubblico button { justify-self: start; }
  .lega-nome-pubblico .salvato { color: var(--accento); }
</style>

<script>
  import { stemmaSVG, rangoDi, gradoDi } from '../../worker/stemmi.mjs';
  import { medagliaLega } from '../scripts/medaglia-lega';
  const radice = document.querySelector<HTMLElement>('.lega')!;
  const $ = <T extends HTMLElement>(s: string) => radice.querySelector<T>(s)!;
  const num = (x: number) => x.toLocaleString('it-IT');
  const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  function mancano(fine: number) {
    const r = Math.max(0, fine - Date.now());
    const g = Math.floor(r / 86400000), h = Math.floor((r % 86400000) / 3600000), m = Math.floor((r % 3600000) / 60000);
    if (g > 0) return `${g} ${g === 1 ? 'giorno' : 'giorni'} e ${h} ${h === 1 ? 'ora' : 'ore'}`;
    if (h > 0) return `${h} ${h === 1 ? 'ora' : 'ore'} e ${m} minuti`;
    return `${m} minuti`;
  }

  type SceltaGM = { lega: number; gruppo?: number } | null;
  let scelta: SceltaGM = null;
  let ultimaRichiesta: SceltaGM = null;
  let autorizzato = false, fotografando = false;
  let richiesta: AbortController | undefined;
  let sequenza = 0;
  const gm = $('.lega-gm');
  const pannelloGM = $('.lega-gm-pannello');
  const apriGM = $<HTMLButtonElement>('.lega-gm-apri');
  const scegliLega = $<HTMLSelectElement>('#lega-gm-lega');
  const scegliGruppo = $<HTMLSelectElement>('#lega-gm-gruppo');
  const esitoGM = $('.lega-gm-esito');

  function chiudiGM(focus = false) {
    pannelloGM.hidden = true;
    apriGM.setAttribute('aria-expanded', 'false');
    if (focus && autorizzato) apriGM.focus({ preventScroll: true });
  }
  function mostraGM(focus = true) {
    if (!autorizzato || fotografando) return;
    pannelloGM.hidden = false;
    apriGM.setAttribute('aria-expanded', 'true');
    if (focus) scegliLega.focus();
  }
  function foto(attiva: boolean, focus = true) {
    if (attiva && !autorizzato) return;
    fotografando = attiva;
    radice.toggleAttribute('data-foto', attiva);
    document.body.classList.toggle('lega-foto', attiva);
    const ritorna = $<HTMLButtonElement>('.lega-foto-ritorna');
    ritorna.hidden = !attiva;
    chiudiGM();
    if (focus) {
      if (attiva) ritorna.focus({ preventScroll: true });
      else if (autorizzato) apriGM.focus({ preventScroll: true });
    }
  }
  function occupato(attivo: boolean) {
    pannelloGM.setAttribute('aria-busy', String(attivo));
    scegliLega.disabled = attivo;
    scegliGruppo.disabled = attivo;
    $<HTMLButtonElement>('.lega-gm-riprova').disabled = attivo;
    $<HTMLButtonElement>('.lega-gm-mia').disabled = attivo || !scelta;
    $<HTMLButtonElement>('.lega-gm-foto').disabled = attivo;
  }
  function mostraOspite() {
    autorizzato = false;
    scelta = null;
    gm.hidden = true;
    foto(false, false);
    $('.lega-ospite').hidden = false;
    for (const s of ['.lega-classifica', '.lega-attesa', '.lega-vuota', '.lega-esito', '.lega-nome-pubblico']) $(s).hidden = true;
    $('.lega-classifica tbody').replaceChildren();
    $('.lega-medaglia').replaceChildren();
    $('.lega-nome').textContent = 'Lega della settimana';
    $('.lega-tempo').textContent = '';
    radice.querySelectorAll('.lega-scala li').forEach((li) => li.classList.remove('attuale', 'passata'));
  }
  function mostra(d: any, rileggiPreferenze: boolean) {
    const osservazione = d.osservazione === true;
    autorizzato = d.gm === true;
    scelta = osservazione ? { lega: d.lega, ...(d.gruppoNumero ? { gruppo: d.gruppoNumero } : {}) } : null;
    gm.hidden = !autorizzato;
    if (!autorizzato) foto(false, false);
    scegliLega.value = scelta ? String(scelta.lega) : 'mia';
    scegliGruppo.replaceChildren(...(d.gruppi || []).map((g: any) => new Option(`Gruppo ${g.numero} · ${g.membri} studenti`, String(g.numero))));
    scegliGruppo.value = d.gruppoNumero ? String(d.gruppoNumero) : '';
    $('.lega-gm-gruppo').hidden = !osservazione || (d.gruppi || []).length < 2;
    $('.lega-classifica table').setAttribute('aria-label', osservazione ? `Classifica della lega ${d.nomeLega}, gruppo ${d.gruppoNumero || 1}` : 'Classifica del tuo gruppo');
    $('.lega-ospite').hidden = true;
    $('.lega-nome').textContent = `Lega ${d.nomeLega}`;
    $('.lega-medaglia').innerHTML = medagliaLega(d.lega, d.leghe[d.lega]);
    $('.lega-tempo').textContent = `La classifica si chiude domenica a mezzanotte: mancano ${mancano(d.fine)}.`;
    radice.querySelectorAll<HTMLElement>('.lega-scala li').forEach((li, i) => { li.classList.toggle('attuale', i === d.lega); li.classList.toggle('passata', i < d.lega); });
    $('.lega-scala').classList.toggle('vicino-fine', d.lega >= d.leghe.length - 2);
    $('.lega-scala').classList.toggle('vicino-inizio', d.lega <= 1);
    $('.lega-esito').hidden = osservazione || !d.esito;
    if (!osservazione && d.esito) {
      const e = d.esito, el = $('.lega-esito');
      const dove = e.a > e.da ? `e sei salito nella lega ${e.nomeA}` : e.a < e.da ? `e sei sceso nella lega ${e.nomeA}` : `e sei rimasto nella lega ${e.nomeA}`;
      el.textContent = `La settimana scorsa hai chiuso al ${e.posizione}° posto tra gli studenti del tuo gruppo nella lega ${e.nomeDa} ${dove}.`;
      el.classList.toggle('sale', e.a > e.da);
    }
    $('.lega-attesa').hidden = osservazione || !d.attesa;
    $('.lega-vuota').hidden = !osservazione || !d.attesa;
    $('.lega-classifica').hidden = !!d.attesa;
    if (d.attesa) $('.lega-classifica tbody').replaceChildren();
    if (!d.attesa) {
      const righe: string[] = [];
      const n = d.gruppo.length;
      const notaGruppo = $('.lega-gruppo');
      const io = !osservazione && d.gruppo.find((m: any) => m.io);
      notaGruppo.hidden = !d.conSimulati || !io;
      if (d.conSimulati && io) {
        const zona = io.zona === 'sale' ? ' · In zona promozione' : io.zona === 'scende' ? ' · In zona retrocessione' : '';
        notaGruppo.textContent = `Tra gli studenti sei al ${io.posizioneStudente}° posto${zona}.`;
      }
      d.gruppo.forEach((m: any, i: number) => {
        if (!d.conSimulati && d.sale && i === 0) righe.push(`<tr class="confine sale"><td colspan="3">Salgono nella lega ${esc(d.leghe[d.lega + 1] || '')}</td></tr>`);
        if (!d.conSimulati && d.scende && i === n - d.scende) righe.push(`<tr class="confine scende"><td colspan="3">Scendono nella lega ${esc(d.leghe[d.lega - 1] || '')}</td></tr>`);
        const rg = rangoDi(m.livello);
        const zona = d.conSimulati ? '' : m.zona || '';
        const sonoIo = !osservazione && m.io;
        righe.push(`<tr class="${sonoIo ? 'io ' : ''}${zona}"><td class="pos">${m.pos}</td><td><span class="chi"><span class="mini">${stemmaSVG(rg, { perc: 100, id: `l${i}`, grado: gradoDi(m.livello) })}</span><span>${esc(m.nome)}${sonoIo ? ' <small>(tu)</small>' : ''} <small>· Liv. ${m.livello}</small></span></span></td><td class="num">${num(m.exp)}</td></tr>`);
      });
      $('.lega-classifica tbody').innerHTML = righe.join('');
    }
    const sez = $('.lega-nome-pubblico');
    if (osservazione) { sez.hidden = true; return; }
    if (!sez.hidden && !rileggiPreferenze) return;
    const f = sez.querySelector('form')!;
    (f.elements.namedItem('soprannome') as HTMLInputElement).value = d.soprannome;
    (f.elements.namedItem('soprannome') as HTMLInputElement).placeholder = d.pubblico ? d.nome : 'Studente';
    (f.elements.namedItem('pubblico') as HTMLInputElement).checked = d.pubblico;
    (f.elements.namedItem('avvisiLega') as HTMLInputElement).checked = d.avvisiLega;
    sez.hidden = false;
  }
  async function carica(rileggiPreferenze = false, destinazione: SceltaGM = scelta, chiudiDopo = false): Promise<void> {
    const turno = ++sequenza;
    richiesta?.abort();
    const controller = new AbortController();
    richiesta = controller;
    ultimaRichiesta = destinazione;
    const timeout = setTimeout(() => controller.abort(), 12000);
    occupato(true);
    esitoGM.textContent = 'Caricamento…';
    esitoGM.classList.remove('errore');
    $('.lega-gm-riprova').hidden = true;
    try {
      const parametri = destinazione ? new URLSearchParams({ lega: String(destinazione.lega), ...(destinazione.gruppo ? { gruppo: String(destinazione.gruppo) } : {}) }) : null;
      const percorso = parametri ? '/api/lega/gm?' + parametri : '/api/lega';
      const opzioni = { credentials: 'same-origin' as const, cache: 'no-store' as const, signal: controller.signal };
      let r = await fetch(percorso, opzioni);
      if (turno !== sequenza) return;
      if (r.status === 403 && destinazione) {
        // Il permesso può essere revocato mentre questa pagina è aperta.
        autorizzato = false;
        scelta = null;
        gm.hidden = true;
        foto(false, false);
        for (const s of ['.lega-classifica', '.lega-vuota', '.lega-attesa', '.lega-esito', '.lega-nome-pubblico']) $(s).hidden = true;
        $('.lega-classifica tbody').replaceChildren();
        $('.lega-nome').textContent = 'Lega della settimana';
        $('.lega-medaglia').replaceChildren();
        r = await fetch('/api/lega', opzioni);
        rileggiPreferenze = true;
      }
      if (turno !== sequenza) return;
      if (r.status === 401) { mostraOspite(); return; }
      if (r.status === 404 && destinazione?.gruppo) ultimaRichiesta = { lega: destinazione.lega };
      if (!r.ok) throw new Error(r.status === 404 ? 'Il gruppo non è più disponibile. Scegli di nuovo la lega.' : 'Non è stato possibile caricare la classifica. Riprova.');
      const d = await r.json();
      if (turno !== sequenza) return;
      if (!Array.isArray(d.leghe) || typeof d.nomeLega !== 'string' || (d.osservazione && !d.gm)) throw new Error('Non è stato possibile caricare la classifica. Riprova.');
      mostra(d, rileggiPreferenze);
      esitoGM.textContent = '';
      if (chiudiDopo) chiudiGM(true);
    } catch (errore) {
      if (turno !== sequenza) return;
      const testo = controller.signal.aborted ? 'La connessione è lenta. Scegli di nuovo la lega per riprovare.' : (errore instanceof Error ? errore.message : 'Non è stato possibile caricare la classifica. Riprova.');
      scegliLega.value = scelta ? String(scelta.lega) : 'mia';
      scegliGruppo.value = scelta?.gruppo ? String(scelta.gruppo) : '';
      if (autorizzato) {
        esitoGM.textContent = testo;
        esitoGM.classList.add('errore');
        $('.lega-gm-riprova').hidden = false;
        mostraGM(false);
      } else if ($('.lega-nome-pubblico').hidden && $('.lega-ospite').hidden) $('.lega-tempo').textContent = 'La classifica è temporaneamente indisponibile.';
    } finally {
      clearTimeout(timeout);
      if (turno === sequenza) { richiesta = undefined; occupato(false); }
    }
  }
  apriGM.addEventListener('click', () => pannelloGM.hidden ? mostraGM() : chiudiGM());
  $('.lega-gm-chiudi').addEventListener('click', () => chiudiGM(true));
  scegliLega.addEventListener('change', () => carica(true, scegliLega.value === 'mia' ? null : { lega: Number(scegliLega.value) }, true));
  scegliGruppo.addEventListener('change', () => { if (scelta) carica(false, { lega: scelta.lega, gruppo: Number(scegliGruppo.value) }, true); });
  $('.lega-gm-mia').addEventListener('click', () => carica(true, null, true));
  $('.lega-gm-riprova').addEventListener('click', () => carica(true, ultimaRichiesta, true));
  $('.lega-gm-foto').addEventListener('click', (evento) => foto(true, (evento as MouseEvent).detail === 0));
  $('.lega-foto-ritorna').addEventListener('click', () => foto(false));
  document.addEventListener('pointerdown', (evento) => { if (!gm.contains(evento.target as Node)) chiudiGM(); });
  document.addEventListener('keydown', (evento) => {
    if (evento.key !== 'Escape') return;
    if (fotografando) { evento.preventDefault(); foto(false); }
    else if (!pannelloGM.hidden) { evento.preventDefault(); chiudiGM(true); }
  });
  window.addEventListener('pagehide', () => foto(false, false));
  radice.querySelector('.lega-nome-pubblico form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.target as HTMLFormElement;
    f.querySelector<HTMLElement>('.salvato')!.hidden = true;
    f.querySelector<HTMLElement>('.errore-salvataggio')!.hidden = true;
    const r = await fetch('/api/lega/nome', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({
      soprannome: (f.elements.namedItem('soprannome') as HTMLInputElement).value, pubblico: (f.elements.namedItem('pubblico') as HTMLInputElement).checked }) }).catch(() => null);
    const avvisi = await fetch('/api/lega/avvisi', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ attivi: (f.elements.namedItem('avvisiLega') as HTMLInputElement).checked }) }).catch(() => null);
    if (r?.ok && avvisi?.ok) { f.querySelector<HTMLElement>('.salvato')!.hidden = false; carica(true); }
    else f.querySelector<HTMLElement>('.errore-salvataggio')!.hidden = false;
  });
  const aggiornaSeVisibile = () => { if (document.visibilityState === 'visible' && !fotografando && !richiesta) carica(); };
  document.addEventListener('visibilitychange', aggiornaSeVisibile);
  window.setInterval(aggiornaSeVisibile, 120_000);
  carica();
</script>
