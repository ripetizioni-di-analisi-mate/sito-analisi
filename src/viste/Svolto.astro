---
import { SEO } from '../lib/seo-testi';
import { SITO, assoluto, accesso } from '../lib/seo';
import { getCollection, render } from 'astro:content';
import { titoliAncore } from '../lib/ancore';
import Base from '../layouts/Base.astro';
import { argomentoL, materiaL, link, voceL, T, type Lingua } from '../i18n';
import { numero, perArgomento, vicini, disponibilitaStudio } from '../lib/nav';
interface Props { lingua: Lingua; materia: string; argomento: string; n: string }
const { lingua, materia, argomento, n } = Astro.props;
const t = T(lingua);
const id = `${materia}/${argomento}/${n}`;
const fratelli = perArgomento(await getCollection('svolti'), materia, argomento);
const i = fratelli.findIndex((x) => x.id === id);
const { voce, tradotta } = await voceL(lingua, 'svolti', id);
const titolo = async (v?: { id: string }) => v && (await voceL(lingua, 'svolti', v.id)).voce.data.titolo;
const [tPrec, tSucc] = [await titolo(fratelli[i - 1]), await titolo(fratelli[i + 1])];
const haAltra = (await voceL(lingua === 'it' ? 'en' : 'it', 'svolti', id)).tradotta;
const arg = argomentoL(lingua, materia, argomento);
const resa = await render(voce);
const Content = resa.Content;
const salti = resa.headings.filter((h: { depth: number }) => h.depth === 2);
const ancore = titoliAncore((await voceL(lingua, 'teoria', `${materia}/${argomento}`)).voce?.body);
const base = `/${materia}/${argomento}`;
const lista = link(lingua, `${base}/esercizi-svolti`);
const passo = (v: { id: string } | undefined, tt?: string) => v && { titolo: `${t.scheda} ${numero(v.id)}`, sotto: tt, href: link(lingua, `${base}/esercizi-svolti/${numero(v.id)}`) };
const fineSchede = vicini(materia, argomento, 'esercizi-svolti', lingua, await disponibilitaStudio(materia, argomento, lingua)).successivo;
---
<Base
  titolo={`${arg.breve} · ${t.sezioni['esercizi-svolti']} ${n}`}
  descrizione={SEO(lingua).schedaDescr(voce.data.titolo, arg.titolo, materiaL(lingua, materia).titolo)}
  seo={{ titolo: SEO(lingua).scheda(voce.data.titolo, materiaL(lingua, materia).breve), tipo: 'article', soloQuestaLingua: !haAltra, schema: [{ ...{
  '@type': 'LearningResource', name: voce.data.titolo, description: SEO(lingua).schedaDescr(voce.data.titolo, arg.titolo, materiaL(lingua, materia).titolo), learningResourceType: 'Worked example', inLanguage: lingua,
  educationalLevel: SEO(lingua).livello, url: assoluto(Astro.url.pathname),
  isPartOf: { '@type': 'Course', '@id': `${assoluto(link(lingua, `/${materia}`))}#corso`, name: materiaL(lingua, materia).titolo },
  provider: { '@id': `${SITO}/#organizzazione` },
  author: { '@id': `${SITO}/#carmine` },
  ...accesso(!materiaL(lingua, materia).prezzo || Number(n) <= 3),
}, keywords: (voce.data.parole ?? []).join(', ') }] }}
  percorso={[{ titolo: arg.breve, href: link(lingua, `${base}/teoria`) }, { titolo: t.sezioni['esercizi-svolti'], href: lista }, { titolo: `${t.scheda} ${n}` }]}
  materia={materia} argomento={argomento} sezione="esercizi-svolti"
  precedente={passo(fratelli[i - 1], tPrec) ?? { titolo: t.tutteLeSchede, sotto: arg.breve, href: lista }}
  successivo={passo(fratelli[i + 1], tSucc) ?? fineSchede}
  lingua={lingua} nonTradotta={!tradotta}
>
  <p class="sopratitolo">{t.sezioni['esercizi-svolti']} · {t.scheda} {n}</p>
  <h1>{voce.data.titolo}</h1>
  {voce.data.teoria.length > 0 && (
    <p class="collegamenti">{t.teoriaUsata}: {voce.data.teoria.map((x: string) => <a href={link(lingua, `${base}/teoria#${x}`)}>{ancore[x] ?? x.replace(/-/g, ' ')}</a>)}</p>
  )}
  {salti.length > 1 && (
    <p class="salta-esercizi">{t.vaiA}: {salti.map((s: { slug: string; text: string }) => <a href={`#${s.slug}`}>{s.text}</a>)}</p>
  )}
  <div class="modalita-passi" hidden>
    <label><input type="checkbox" data-passi /> <span>{lingua === 'en' ? 'One step at a time' : 'Un passaggio alla volta'}</span></label>
    <small>{lingua === 'en' ? 'After the statement, the solution appears one step at a time.' : 'Dopo la traccia, lo svolgimento compare un passaggio alla volta.'}</small>
  </div>
  <div class="testo-studio"><Content /></div>
</Base>

<script is:inline define:vars={{ testi: lingua === 'en'
  ? { prossimo: 'Show the next step', tutto: 'show everything', di: 'of' }
  : { prossimo: 'Mostra il passaggio successivo', tutto: 'mostra tutto', di: 'di' } }}>
  // Modalità «un passaggio alla volta»: dopo la traccia (segno .fine-traccia) i passaggi dello svolgimento
  // e la spiegazione si scoprono uno alla volta. La scelta resta nel browser. Senza JavaScript la scheda è quella di sempre.
  (() => {
    const studio = document.querySelector('.testo-studio');
    const riquadro = document.querySelector('.modalita-passi');
    const scelta = riquadro && riquadro.querySelector('[data-passi]');
    if (!studio || !scelta) return;
    // Esercizi: per ogni titolo, i passaggi dopo il segno di fine traccia (i tasti di Pi restano sempre visibili).
    const esercizi = [];
    for (const h of studio.querySelectorAll(':scope > h2')) {
      const passi = [];
      let dopo = false;
      for (let n = h.nextElementSibling; n && n.tagName !== 'H2'; n = n.nextElementSibling) {
        if (n.classList.contains('fine-traccia')) { dopo = true; continue; }
        if (dopo && !n.matches('.chiedi-pi, .svolgimento-riservato, .passi-comandi')) passi.push(n);
      }
      if (passi.length >= 2) esercizi.push({ h, passi });
    }
    if (!esercizi.length) return;
    riquadro.hidden = false;
    const accendi = (si) => {
      document.querySelectorAll('.passi-comandi').forEach((x) => x.remove());
      for (const e of esercizi) {
        e.passi.forEach((x) => x.classList.toggle('passo-nascosto', si));
        if (!si) continue;
        let visti = 0;
        const comandi = document.createElement('div');
        comandi.className = 'passi-comandi';
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'passo-avanti';
        const conto = document.createElement('span');
        const tutto = document.createElement('button');
        tutto.type = 'button'; tutto.className = 'passo-tutto'; tutto.textContent = testi.tutto;
        const aggiorna = () => {
          b.textContent = testi.prossimo;
          conto.textContent = `${visti} ${testi.di} ${e.passi.length}`;
          if (visti >= e.passi.length) comandi.remove();
          else e.passi[visti].before(comandi);
        };
        b.addEventListener('click', () => {
          const p = e.passi[visti++];
          p.classList.remove('passo-nascosto');
          p.classList.add('passo-appena');
          setTimeout(() => p.classList.remove('passo-appena'), 900);
          aggiorna();
          if (comandi.isConnected) comandi.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        });
        tutto.addEventListener('click', () => { e.passi.forEach((x) => x.classList.remove('passo-nascosto')); visti = e.passi.length; aggiorna(); });
        comandi.append(b, conto, tutto);
        aggiorna();
      }
    };
    let salvata = false;
    try { salvata = localStorage.getItem('passi') === '1'; } catch (_) {}
    scelta.checked = salvata;
    if (salvata) accendi(true);
    scelta.addEventListener('change', () => {
      try { localStorage.setItem('passi', scelta.checked ? '1' : '0'); } catch (_) {}
      accendi(scelta.checked);
    });
  })();
</script>
