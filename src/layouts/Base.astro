---
import '@fontsource-variable/source-serif-4';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import fontMarchio from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import fontIndice from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import fontIndiceSemibold from '@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url';
import fontIndiceBold from '@fontsource/source-sans-3/files/source-sans-3-latin-700-normal.woff2?url';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Indice from '../components/Indice.astro';
import StudyCountry from '../components/StudyCountry.astro';
import { CATALOGO_PREDEFINITO, PARAMETRO_CATALOGO } from '../data/cataloghi-studio.mjs';
import { linkArgomentoUsa, materieUsa, materiaUsa } from '../data/stem-usa/catalog-view';
import { calculusSlug } from '../lib/stem-usa-practice';
import { usTimedTopics } from '../lib/stem-usa-banks';
import { courseUrl } from '../data/stem-usa/catalog.mjs';
import { RIPASSO } from '../data/livelli';
import Assistente from '../components/Assistente.astro';
import SegnalaErrore from '../components/SegnalaErrore.astro';
import BarraSconto from '../components/BarraSconto.astro';
import Concentrazione from '../components/Concentrazione.astro';
import ConsensoCookie from '../components/ConsensoCookie.astro';
import { GOOGLE_ADS_ID, GA4_ID, CONVERSIONI, VALORI, MISURAZIONE_ATTIVA } from '../data/misurazione';
import NavigazioneStudio from '../components/NavigazioneStudio.astro';
import { MATERIE } from '../data/materie';
import { url } from '../lib/url';
import { paginaLocalizzata, destinazioneLocalizzata, linguaCatalogo, lingueLocalizzate, LINGUE, LOCALE, nellaLingua, senzaLingua } from '../lib/lingue-sito';
import { materiaL, materieL, link, altraLingua, T, type Lingua } from '../i18n';
import { SITO, assoluto, ORGANIZZAZIONE, briciole, sitoWeb, paginaWeb } from '../lib/seo';
import { catalogoDomande } from '../lib/domande';
import { creaCatalogoStudio, tappeStudio } from '../lib/percorso-studio.mjs';
import { anteprima, altGenerale, ogGenerale } from '../lib/anteprime.mjs';

const NOME_SITO = 'Ripetizioni di Analisi';
const WHATSAPP = 'https://wa.me/393885680393';

interface Passo { titolo: string; sotto?: string; href: string; etichetta?: string }
interface Props {
  titolo: string;
  descrizione?: string;
  percorso?: { titolo: string; href?: string }[];
  materia?: string;
  argomento?: string;
  sezione?: string;
  usa?: boolean;
  precedente?: Passo;
  successivo?: Passo;
  prossimo?: { titolo: string; href: string };
  lingua?: Lingua;
  nonTradotta?: boolean; // pagina inglese non ancora tradotta: si mostra l'italiano con un avviso
  ricercaPrincipale?: boolean;
  // Motori di ricerca: titolo completo della scheda, dati strutturati, pagine da non indicizzare,
  // pagine senza versione nell'altra lingua.
  seo?: { titolo?: string; schema?: Record<string, unknown>[]; noindex?: boolean; tipo?: string; soloQuestaLingua?: boolean; senzaInglese?: boolean; data?: string; canonico?: string };
}
const { titolo, descrizione, percorso = [], materia, argomento, sezione, precedente, successivo, prossimo, lingua = 'it', usa = false, nonTradotta = false, ricercaPrincipale = false, seo = {} } = Astro.props;
const t = T(lingua);
const m = materia ? (usa ? materiaUsa(materia) : materiaL(lingua, materia)) : undefined;
const versioneIt = senzaLingua(Astro.url.pathname);
const de = lingua === 'de';
const es = lingua === 'es';
const fr = lingua === 'fr';
const localizzato = linguaCatalogo(lingua);
const cambioLingua = LINGUE.filter((l) => l.codice !== lingua).map((l) => ({
  ...l,
  href: usa ? `${link(l.codice, '/')}?${PARAMETRO_CATALOGO}=${CATALOGO_PREDEFINITO}&lingua=${l.codice}`
    : sezione === 'home' ? `${link(l.codice, '/')}?lingua=${l.codice}`
    : linguaCatalogo(l.codice) ? destinazioneLocalizzata(l.codice, versioneIt)
    : l.codice === 'en' && (seo.senzaInglese || (seo.soloQuestaLingua && !localizzato))
      ? link('en', '/') : altraLingua(Astro.url.pathname, l.codice),
}));
const versoIt = altraLingua(Astro.url.pathname, 'it');
const legali = ['/privacy', '/termini', '/rimborsi'].map((path) => ({
  path, href: localizzato ? `${link('it', path)}?lingua=it` : link(lingua, path),
}));
// Domande a tempo dell'argomento della pagina, se ci sono (collegamento nel pannello del livello).
const domandeDisponibili = await catalogoDomande(lingua);
const domandeMateria = (usa ? usTimedTopics : domandeDisponibili)[materia ?? ''] ?? [];
const domandeQui = Boolean(argomento && domandeMateria.includes(argomento));
const catalogoPercorso = {
  ...creaCatalogoStudio(materieL(lingua), domandeDisponibili, lingua),
  ...Object.fromEntries(Object.entries(usTimedTopics).map(([slug, topics]) => [slug, {
    titolo: materiaUsa(slug)!.titolo,
    argomenti: topics,
    domande: topics,
    ripasso: 'Timed review',
    base: courseUrl(slug),
  }])),
};
const en = lingua === 'en';
const homeCurriculum = usa ? url('/us') : link(lingua, '/');
const hrefMateria = m ? (usa ? url(courseUrl(m.slug)) : link(lingua, '/' + m.slug)) : homeCurriculum;
const titoloCompleto = seo.titolo ?? (m ? `${titolo} · ${m.titolo}` : titolo === NOME_SITO ? titolo : `${titolo} · ${NOME_SITO}`);

// Indirizzi per i motori di ricerca: pagina canonica, versioni nelle due lingue.
const qui = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';

const argomentoNormale = m?.argomenti.some((a) => a.slug === argomento);
const tappe = argomentoNormale && ['teoria', 'esercizi-svolti', 'esercizi', 'domande'].includes(sezione ?? '')
  ? tappeStudio(materia, argomento, domandeQui, lingua, m?.eserciziDaFare !== false)
    .filter((p) => !es || paginaLocalizzata('es', '/' + materia + '/' + argomento + '/' + p.slug))
    .map((p) => ({ ...p, href: usa ? linkArgomentoUsa(materia!, argomento!, p.slug) : url(p.href) })) : [];
const tappa = tappe.findIndex((p) => p.slug === sezione);
// Le pagine di elenco proseguono nello stesso argomento; le singole schede
// conservano il proprio ordine numerico.
const elencoSezione = usa
  ? qui === courseUrl(materia ?? '') + '/' + argomento + '/' + sezione
  : versioneIt === `/${materia}/${argomento}/${sezione}`;
const tappaDopo = elencoSezione ? tappe[tappa + 1] : undefined;
const avanti: Passo | undefined = tappaDopo ? {
  titolo: tappaDopo.titolo,
  sotto: m?.argomenti.find((a) => a.slug === argomento)?.breve,
  href: tappaDopo.href,
  etichetta: es ? 'Continuar con este tema' : en ? 'Continue with this topic' : 'Continua su questo argomento',
} : successivo;
const versioneEn = nellaLingua('en', versioneIt);
const versioniLocalizzate = lingueLocalizzate(versioneIt).map((l) => ({ l, path: nellaLingua(l, versioneIt) }));
// seo.canonico: la pagina è la copia di un'altra (src/lib/canonici.ts); ai motori si indica l'originale, nella stessa lingua,
// e non si dichiarano versioni in altre lingue (le dichiara l'originale).
const canonico = assoluto(nonTradotta ? versioneIt : seo.canonico ? link(lingua, seo.canonico) : qui);
const bilingue = !usa && !seo.soloQuestaLingua && !nonTradotta && sezione !== 'stampa' && !seo.canonico;
const alternati = [
  ...(bilingue || (localizzato && versioniLocalizzate.length > 0) ? [{ l: 'it', path: versioneIt }] : []),
  ...(bilingue && !seo.senzaInglese ? [{ l: 'en', path: versioneEn }, { l: 'x-default', path: versioneEn }] : []),
  ...versioniLocalizzate,
];
const noindex = seo.noindex || nonTradotta || sezione === 'stampa';
// Google e Bing mostrano circa 155-160 caratteri: le descrizioni più lunghe si chiudono a fine parola con «…».
const taglia = (x: string, n = 160) => (x.length <= n ? x : `${x.slice(0, x.lastIndexOf(' ', n - 1)).replace(/[\s,;:.]+$/, '')}…`);
const descrizioneSeo = taglia(descrizione ?? t.homeDescrizione);
const percorsoSchema = [
  { nome: t.materie, url: assoluto(homeCurriculum) },
  ...(m ? [{ nome: m.titolo, url: assoluto(hrefMateria) }] : []),
  ...percorso.map((p, i) => ({ nome: p.titolo, url: p.href && i < percorso.length - 1 ? assoluto(p.href) : canonico })),
];
// Freccia «indietro» nel percorso (scelta A3 di Carmine, 07/11/2026): torna alla pagina precedente della
// cronologia se si viene da una pagina del sito; altrimenti porta al livello sopra nel percorso.
const livelloSopra = percorsoSchema.length > 1 ? percorsoSchema[percorsoSchema.length - 2].url.replace(SITO, '') || '/' : undefined;
// Data dell'ultima modifica del contenuto (seo.data): finisce nella pagina e nei dati strutturati, così motori e
// assistenti IA sanno quanto è aggiornata la pagina. Senza data non si scrive nulla (non si inventa).
const conData = (x: Record<string, unknown>) => (seo.data && !('dateModified' in x) ? { ...x, dateModified: seo.data } : x);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [ORGANIZZAZIONE, sitoWeb(lingua), conData(paginaWeb(canonico, titoloCompleto, descrizioneSeo, lingua)), ...(percorsoSchema.length > 1 ? [briciole(percorsoSchema)] : []), ...(seo.schema ?? []).map(conData)],
};
// Immagine di anteprima dei link (WhatsApp, Instagram, Telegram…): una per materia e una per argomento e sezione,
// disegnate dopo la build da scripts/immagini-og.mjs; le altre pagine usano /og.png (in inglese /og-en.png, scripts/og-generale.mjs).
const og = !localizzato && !usa && anteprima({ lingua, materia: m, argomento, sezione, titoloArgomento: m && argomento ? m.argomenti.find((a) => a.slug === argomento)?.titolo : undefined });
const immagineOg = `${SITO}${og ? og.percorso : ogGenerale(lingua)}`;
const altOg = og ? og.alt : localizzato ? 'Ripetizioni di Analisi' : altGenerale(lingua);
// Le pagine con contenuti di studio ricevono le protezioni contro copia e stampa.
const contenuto = Boolean(materia && argomento) && sezione !== 'stampa';
// Spunte delle materie sbloccate: il Worker scrive su <html> data-materie="analisi-1 precorso ...".
const regoleStato = (usa ? materieUsa : MATERIE).filter((x) => x.prezzo).map((x) => {
  const sel = `html[data-materie~="${x.slug}"] [data-materia="${x.slug}"]`;
  return `${sel} .stato-bloccata{display:none}${sel} .stato-sbloccata{display:inline-flex}${sel}.riquadro-stato .stato-bloccata{display:none}${sel}.riquadro-stato .stato-sbloccata{display:flex}`;
}).join('');
---
<!doctype html>
<html lang={lingua} style={m ? `--accento: ${m.colore}` : undefined} class:list={{ contenuto, 'home-chiarezza': sezione === 'home' }} data-studio-materia={contenuto || sezione === 'domande' || sezione === 'simulazione' ? materia : undefined} data-studio-argomento={contenuto || sezione === 'domande' ? argomento : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  {/* Gli stessi font della navigazione sono disponibili fin dal primo disegno di ogni pagina. */}
  {[fontMarchio, fontIndice, fontIndiceSemibold, fontIndiceBold].map((href) => (
    <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
  ))}
  <style is:inline set:html={regoleStato}></style>
  <link rel="icon" href={url('/logo.svg')} type="image/svg+xml" />
  <title>{titoloCompleto}</title>
  <meta name="description" content={descrizioneSeo} />
  <link rel="canonical" href={canonico} />
  {alternati.map(({ l, path }) => <link rel="alternate" hreflang={l} href={assoluto(path)} />)}
  {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}
  {seo.data && <meta property="article:modified_time" content={seo.data} />}
  {seo.data && <meta name="last-modified" content={seo.data} />}
  <meta property="og:type" content={seo.tipo ?? 'website'} />
  <meta property="og:site_name" content={NOME_SITO} />
  <meta property="og:title" content={titoloCompleto} />
  <meta property="og:description" content={descrizioneSeo} />
  <meta property="og:url" content={canonico} />
  <meta property="og:image" content={immagineOg} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={altOg} />
  <meta property="og:locale" content={LOCALE[lingua]} />
  {alternati.filter(({ l }) => l !== lingua && l !== 'x-default').map(({ l }) => <meta property="og:locale:alternate" content={LOCALE[l as Lingua]} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={immagineOg} />
  <meta name="twitter:image:alt" content={altOg} />
  <link rel="apple-touch-icon" href={url('/logo-180.png')} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#faf8f2" />
  {/* Misurazione delle conversioni (Google Ads, Google Analytics): codici in src/data/misurazione.ts; senza codici non si carica nulla.
      Consent Mode v2: tutto negato finché il visitatore non accetta dal banner (ConsensoCookie.astro). */}
  <script is:inline define:vars={{ ads: GOOGLE_ADS_ID, ga4: GA4_ID, etichette: CONVERSIONI, valori: VALORI, attiva: MISURAZIONE_ATTIVA }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    window.gtag = gtag;
    if (attiva) {
      let scelta = null;
      try { scelta = localStorage.getItem('consenso'); } catch (e) {}
      const stato = scelta === 'si' ? 'granted' : 'denied';
      gtag('consent', 'default', { ad_storage: stato, ad_user_data: stato, ad_personalization: stato, analytics_storage: stato, wait_for_update: 500 });
      gtag('set', 'ads_data_redaction', true);
      gtag('set', 'url_passthrough', true);
      gtag('js', new Date());
      if (ads) gtag('config', ads, { allow_enhanced_conversions: true });
      if (ga4) gtag('config', ga4);
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ads || ga4);
      document.head.appendChild(s);
    }
    // window.misura(evento, dati): un solo punto d'ingresso per le conversioni del sito.
    // Eventi: acquisto {valore, valuta, id, voce, email} · lezione {valore, id, email} · gruppo {email} · account {email} · whatsapp · compatibilita.
    window.misura = function (evento, dati) {
      if (!attiva) return;
      dati = dati || {};
      try {
        if (dati.email) gtag('set', 'user_data', { email: String(dati.email).trim().toLowerCase() });
        const valuta = dati.valuta || 'EUR';
        const valore = dati.valore != null ? Number(dati.valore) : valori[evento];
        const base = {};
        if (valore != null && !isNaN(valore)) { base.value = valore; base.currency = valuta; }
        if (dati.id) base.transaction_id = String(dati.id);
        if (evento === 'acquisto') gtag('event', 'purchase', Object.assign({ items: [{ item_name: dati.voce || 'materia' }] }, base));
        else gtag('event', evento, Object.assign({}, base));
        if (ads && etichette[evento]) gtag('event', 'conversion', Object.assign({ send_to: ads + '/' + etichette[evento] }, base));
      } catch (e) {}
    };
    document.addEventListener('click', function (e) {
      const a = e.target && e.target.closest ? e.target.closest('a[href*="wa.me/"]') : null;
      if (a) window.misura('whatsapp');
    }, true);
  </script>
  <script is:inline>
    try { if (localStorage.getItem('indice') === 'chiuso') document.documentElement.classList.add('indice-chiuso'); } catch (e) {}
    // Chi sceglie una lingua nel menu la ritrova in tutto il sito (il Worker legge il cookie «lingua»).
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest ? e.target.closest('a[data-lingua]') : null;
      if (a) document.cookie = 'lingua=' + a.getAttribute('data-lingua') + '; Path=/; Max-Age=31536000; SameSite=Lax; Secure';
    });
  </script>
</head>
<body>
  <header class="testata">
    <div class="testata-interna">
      <a class="marchio" href={homeCurriculum}>
        <img class="logo" src={url('/logo.svg')} alt="" width="32" height="32" />
        <span>{NOME_SITO}</span>
      </a>
      <div class="account-testata">
        <a class="bottone-account" href={link(lingua, '/account')} aria-label={t.ilTuoAccount}>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10" cy="7" r="3.5"/><path d="M3.5 17.5c1-3.3 3.6-5 6.5-5s5.5 1.7 6.5 5"/></svg>
          <span class="iniziale" aria-hidden="true"></span>
          <span class="se-ospite">{t.accedi}</span><span class="se-collegato">{t.account}</span>
        </a>
        {!localizzato && (
          <>
            <button class="bottone-livello" type="button" aria-label={en ? 'Level' : 'Livello'} aria-expanded="false" aria-controls="pannello-livello">
              <span class="stemma-testata" aria-hidden="true"></span>
              <span class="righe-livello">
                <span class="nome-utente">{t.account}</span>
                <span class="fascia-testata"><span class="fascia-con-punto"><span class="fascia-nome">{en ? 'Bronze I' : 'Bronzo I'}</span> · </span><span class="liv-etichetta">{en ? 'Lv.' : 'Liv.'}</span> <span class="numero-livello">1</span><span class="exp-con-punto"> · <span class="exp-livello">0</span> {en ? 'XP' : 'EXP'}</span></span>
              </span>
              <span class="barra-testata" aria-hidden="true"><span></span></span>
            </button>
            <div class="pannello-livello" id="pannello-livello" hidden>
              <div class="pl-stemma" aria-hidden="true"></div>
              <p class="pl-fascia"><strong></strong><span></span></p>
              <p class="pl-mancano"></p>
              <div class="pl-oggi">
                <p><strong class="pl-oggi-minuti">–</strong><span>{en ? 'minutes of study today' : 'minuti di studio oggi'}</span></p>
                <p><strong class="pl-oggi-corrette">–</strong><span>{en ? 'correct answers today' : 'risposte corrette oggi'}</span></p>
                <p><strong class="pl-oggi-giorni">–</strong><span>{en ? 'days of study this week' : 'giorni di studio questa settimana'}</span></p>
              </div>
              <a class="pl-continua" data-qui={domandeQui ? '1' : ''} href={usa
                ? (domandeQui ? linkArgomentoUsa(materia!, argomento!, 'domande')
                  : materia && usTimedTopics[materia] ? linkArgomentoUsa(materia, RIPASSO, 'domande')
                  : url(courseUrl(materia || calculusSlug) + '#course-practice'))
                : link(lingua, domandeQui ? `/${materia}/${argomento}/domande` : '/domande-a-tempo')}>{en ? 'Continue with the timed questions' : 'Continua con le domande a tempo'}</a>
              {/* Lega della settimana e duelli (versione A2 scelta da Carmine il 03/11/2026) */}
              {!en && (
                <div class="pl-sfide">
                  <a href="/lega"><span class="pl-sf-medaglia" aria-hidden="true"></span><span class="pl-sf-lega">Lega della settimana</span></a>
                  <a href="/duelli"><span class="pl-sf-icona" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="7" r="2.4"/><circle cx="14" cy="7" r="2.4"/><path d="M2 16c.5-2.4 2-3.7 4-3.7s3.5 1.3 4 3.7M10 16c.5-2.4 2-3.7 4-3.7s3.5 1.3 4 3.7"/></svg></span><span>Duelli</span></a>
                </div>
              )}
              <a class="pl-account" href={link(lingua, '/account')}>{en ? 'Open your account' : 'Apri il tuo account'}</a>
            </div>
          </>
        )}
      </div>
      <details class="selettore-lingua">
        <summary class="bottone-lingua" aria-label={t.lingua} title={t.lingua}>{lingua.toUpperCase()}</summary>
        <ul>
          {cambioLingua.map(({ codice, nome, href }) => <li><a href={href} hreflang={codice} lang={codice} data-lingua={codice}>{nome}</a></li>)}
        </ul>
      </details>
      <button class="bottone-indice" type="button" aria-label={t.indice} data-apri-indice>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
        <span>{t.indice}</span>
      </button>
    </div>
  </header>

  <div class="corpo">
    <Indice materia={materia} argomento={argomento} sezione={sezione} lingua={lingua} usa={usa} ricercaPrincipale={ricercaPrincipale} />
    <main id="contenuto-principale">
      <div class="pagina">
        {m && (
          <div class="contesto-materia">
            <a class:list={['materia-corrente', { 'a-pagamento': m.prezzo }]} href={hrefMateria}>
              {m.prezzo && <svg class="lucchetto aperto" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 10.5l3.6 3.5L15.5 6.5"/></svg>}
              <span>{m.breve}</span>
              {m.prezzo && <span class="dicitura-sbloccata">{t.sbloccata}</span>}
            </a>
          </div>
        )}
        {(percorso.length > 0 || m) && (
          <nav class="percorso" aria-label={fr ? 'Fil d’Ariane' : es ? 'Ruta de navegación' : de ? 'Navigationspfad' : en ? 'Breadcrumb' : 'Percorso'}>
            {livelloSopra && <a class="indietro" href={livelloSopra} title={fr ? 'Retour' : es ? 'Volver' : de ? 'Zurück' : en ? 'Back' : 'Torna indietro'} aria-label={fr ? 'Retour' : es ? 'Volver' : de ? 'Zurück' : en ? 'Back' : 'Torna indietro'}><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 10h-11M9 4.5L3.5 10 9 15.5"/></svg></a>}
            <ol>
              <li><a href={homeCurriculum}>{t.materie}</a></li>
              {m && <li aria-current={percorso.length === 0 ? 'page' : undefined}>{percorso.length > 0 ? <a href={hrefMateria}>{m.titolo}</a> : m.titolo}</li>}
              {percorso.map((p, i) => (
                <li aria-current={i === percorso.length - 1 ? 'page' : undefined}>
                  {p.href && i < percorso.length - 1 ? <a href={p.href}>{p.titolo}</a> : p.titolo}
                </li>
              ))}
            </ol>
          </nav>
        )}
        {nonTradotta && <p class="avviso-lingua" lang="en">{t.nonTradotta} <a href={versoIt} data-lingua="it">Italiano</a></p>}
        {materia && argomento && ['teoria', 'esercizi-svolti', 'esercizi', 'domande'].includes(sezione ?? '') && <>
          <Concentrazione lingua={lingua} />
          <NavigazioneStudio materia={materia} argomento={argomento} sezione={sezione} lingua={lingua} usa={usa} />
        </>}
        <slot />
        {(precedente || avanti) && (
          <nav class="passi" aria-label={es ? "Página anterior y siguiente" : "Pagina precedente e successiva"}>
            {avanti && <a class="successivo" href={avanti.href}><small>{avanti.etichetta ?? t.successivo}</small><span>{avanti.titolo}{avanti.sotto ? <em> · {avanti.sotto}</em> : ''}</span><span class="freccia-avanti" aria-hidden="true">→</span></a>}
            {tappaDopo && successivo && successivo.href !== avanti?.href && <a class="altro-argomento" href={successivo.href}>{successivo.etichetta ?? t.argomentoSuccessivo}: {successivo.titolo} →</a>}
            {precedente && <a class="precedente" href={precedente.href}>← {precedente.titolo}{precedente.sotto ? ` · ${precedente.sotto}` : ''}</a>}
          </nav>
        )}
        {(contenuto || sezione === 'domande') && <SegnalaErrore lingua={lingua} />}
      </div>
    </main>
  </div>

  <footer class="pie">
    <nav class="pie-link" aria-label={fr ? 'Informations' : es ? 'Información' : de ? 'Informationen' : en ? 'Information' : 'Informazioni'}>
      <a href={link(lingua, '/chi-sono')}>{t.chiSono}</a>
      {lingua === 'it' && <a href="/ripetizioni-analisi">Ripetizioni online</a>}
      <a href={link(lingua, '/prezzi')}>{t.prezzi}</a>
      <a href={link(lingua, '/contatti')}>{t.contatti}</a>
      {legali.map(({ href }, i) => <a href={href} hreflang={localizzato ? 'it' : undefined}>{[t.privacy, t.termini, t.rimborsi][i]}{fr ? ' (en italien)' : es ? ' (en italiano)' : de ? ' (Italienisch)' : ''}</a>)}
      {cambioLingua.map(({ codice, nome, href }) => <a href={href} hreflang={codice} lang={codice} data-lingua={codice}>{nome}</a>)}
    </nav>
    <StudyCountry lingua={lingua} corrente={usa ? 'US' : CATALOGO_PREDEFINITO} />
    <span class="pie-copyright">{t.copyright}</span>
  </footer>

  <div class="bottoni-fissi">
    <button class="torna-su" type="button" aria-label={t.tornaSu} hidden>
      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 16V4M4.5 9.5 10 4l5.5 5.5"/></svg>
    </button>
    {sezione !== 'stampa' && <Assistente materia={materia} argomento={argomento} sezione={sezione} lingua={lingua} />}
    <a class="bottone-whatsapp" href={WHATSAPP} target="_blank" rel="noopener" aria-label={t.whatsapp}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48a.92.92 0 0 0-.66.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.29Z"/></svg>
    </a>
  </div>

  {!localizzato && sezione !== 'stampa' && <BarraSconto lingua={lingua} />}
  {sezione !== 'stampa' && MISURAZIONE_ATTIVA && <ConsensoCookie lingua={lingua} />}
  <script type="application/json" id="catalogo-percorso" is:inline set:html={JSON.stringify(catalogoPercorso)}></script>

  <div class="avviso-premio" role="status" aria-live="polite" hidden></div>
  <div class="avviso-duello" role="status" aria-live="polite" hidden></div>

  <dialog class="cassetto" id="cassetto-indice">
    <div class="cassetto-testa"><strong>{t.indice}</strong><button type="button" aria-label={t.chiudi} data-chiudi-indice>×</button></div>
    <Indice materia={materia} argomento={argomento} sezione={sezione} lingua={lingua} usa={usa} ricercaPrincipale={ricercaPrincipale} />
  </dialog>

  <script>
    const selettoreLingua = document.querySelector<HTMLDetailsElement>('.selettore-lingua');
    if (selettoreLingua) {
      document.addEventListener('click', (e) => {
        if (e.target instanceof Node && !selettoreLingua.contains(e.target)) selettoreLingua.open = false;
      });
      selettoreLingua.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !selettoreLingua.open) return;
        selettoreLingua.open = false;
        selettoreLingua.querySelector('summary')?.focus();
      });
    }
  </script>
  <style>
    .selettore-lingua { position: relative; flex: none; }
    .selettore-lingua summary { list-style: none; }
    .selettore-lingua summary::-webkit-details-marker { display: none; }
    .selettore-lingua ul { position: absolute; z-index: 45; top: calc(100% + .3rem); right: 0; margin: 0; padding: .25rem; min-width: 7.5rem; list-style: none; background: var(--carta); border: 1px solid var(--riga); border-radius: var(--raggio); box-shadow: 0 .3rem 1rem #172d2922; }
    .selettore-lingua a { display: block; padding: .45rem .6rem; color: var(--inchiostro); font: 600 .9rem var(--ui); text-decoration: none; border-radius: var(--raggio); }
    .selettore-lingua a:hover, .selettore-lingua a:focus-visible { background: var(--carta-2); }
    @media print { .selettore-lingua { display: none; } }
  </style>
  <script>
    import { stemmaSVG, rangoDi, gradoDi, nomeRango, stileRango } from '../../worker/stemmi.mjs';
    import { LINGUE_CATALOGO } from '../data/codici-lingua.mjs';
    import { medagliaLega } from '../scripts/medaglia-lega';
    import { caricaPercorsoStudio, leggiCatalogoStudio, prossimaAttivita } from '../lib/percorso-studio.mjs';
    // Adatta le formule in display alla larghezza dello schermo riducendo il corpo,
    // fino a un minimo; oltre quel minimo la formula scorre nel proprio riquadro.
    function adattaFormule() {
      document.querySelectorAll<HTMLElement>('.katex-display').forEach((d) => {
        const k = d.querySelector<HTMLElement>('.katex');
        if (!k) return;
        k.style.fontSize = '';
        const disp = d.clientWidth, larg = k.scrollWidth;
        if (larg > disp) k.style.fontSize = `${Math.max(0.74, (disp / larg) * 1.08 - 0.01)}em`;
      });
    }
    adattaFormule();
    document.fonts?.ready.then(adattaFormule);

    // Figure con cursore della teoria: il codice che le ridisegna si scarica solo nelle pagine che ne hanno.
    if (document.querySelector('[data-cursore]')) import('../scripts/cursori.ts');

    // Occhietto accanto alle password: mostra o nasconde quello che si è scritto.
    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-mostra-password]');
      if (!b) return;
      e.preventDefault();
      const campo = b.previousElementSibling as HTMLInputElement;
      const visibile = campo.type === 'password';
      campo.type = visibile ? 'text' : 'password';
      b.setAttribute('aria-pressed', String(visibile));
      campo.focus();
    });
    addEventListener('resize', adattaFormule);

    // ---- Livello in testata: anello, pannello al tocco, aggiornamento dopo ogni minuto di studio o risposta ----
    interface Stato { livello: number; fascia: string; frase?: string; exp: number; base: number; prossimo: number | null; mancano: number; perc: number }
    const bl = document.querySelector<HTMLButtonElement>('.bottone-livello');
    const pl = document.getElementById('pannello-livello');
    const inglese = document.documentElement.lang === 'en';
    const linguaCatalogo = LINGUE_CATALOGO.some((l) => l === document.documentElement.lang);
    const num = (x: number) => x.toLocaleString(inglese ? 'en-US' : 'it-IT');
    const XP = inglese ? 'XP' : 'EXP';
    function mostraLivello(st: Stato) {
      if (!bl || !pl) return;
      const r = rangoDi(st.livello);
      bl.setAttribute('style', stileRango(r));
      const box = bl.querySelector<HTMLElement>('.stemma-testata')!;
      const svg = box.querySelector('svg');
      const g = gradoDi(st.livello), rango = nomeRango(st.livello, inglese ? 'en' : 'it');
      if (svg && svg.getAttribute('data-rango') === `${r}-${g}`) (svg.querySelector('.stemma-pieno') as SVGElement).style.transform = `scaleY(${st.perc / 100})`;
      else box.innerHTML = stemmaSVG(r, { perc: st.perc, id: 't', grado: g });
      (bl.querySelector('.barra-testata > span') as HTMLElement).style.width = `${st.perc}%`;
      bl.querySelector('.numero-livello')!.textContent = String(st.livello);
      bl.querySelector('.fascia-nome')!.textContent = rango;
      bl.querySelector('.exp-livello')!.textContent = num(st.exp);
      bl.setAttribute('aria-label', `${bl.querySelector('.nome-utente')?.textContent || ''}, ${inglese ? 'level' : 'livello'} ${st.livello}, ${rango}, ${num(st.exp)} ${XP}`);
      pl.querySelector('.pl-stemma')!.innerHTML = stemmaSVG(r, { perc: st.perc, id: 'p', nastro: true, livello: st.livello, etichetta: inglese ? 'LV.' : 'LIV.' });
      pl.querySelector('.pl-fascia strong')!.textContent = `${rango} · ${st.fascia}`;
      if (st.frase) pl.querySelector('.pl-fascia span')!.textContent = st.frase;
      pl.querySelector('.pl-mancano')!.innerHTML = st.prossimo === null
        ? `${num(st.exp)} ${XP} · ${inglese ? 'maximum level' : 'livello massimo'}`
        : `${num(st.exp)} ${XP} · ${inglese ? '' : 'mancano '}<strong>${num(st.mancano)}&nbsp;${XP}</strong> ${inglese ? 'to&nbsp;level' : 'al&nbsp;livello'}&nbsp;${st.livello + 1}`;
    }
    // Studio di oggi e della settimana: si chiede al server quando il pannello si apre.
    let percorsoChiesto = 0;
    async function caricaPercorso() {
      if (!pl || Date.now() - percorsoChiesto < 30000) return;
      percorsoChiesto = Date.now();
      const d = await caricaPercorsoStudio(inglese ? 'en' : 'it');
      if (!d) { percorsoChiesto = 0; return; }
      if (d.stato) mostraLivello(d.stato);
      pl.querySelector('.pl-oggi-minuti')!.textContent = num(d.oggi?.minuti ?? 0);
      pl.querySelector('.pl-oggi-corrette')!.textContent = num(d.oggi?.corrette ?? 0);
      pl.querySelector('.pl-oggi-giorni')!.textContent = String((d.settimana?.giorni || []).filter((g: any) => g.attivo).length);
      // Fuori da un argomento, il tasto porta all'argomento dell'obiettivo della settimana o all'ultimo studiato.
      const cont = pl.querySelector<HTMLAnchorElement>('.pl-continua')!;
      if (!cont.dataset.qui) {
        const attivita = prossimaAttivita(d, leggiCatalogoStudio(), inglese ? 'en' : 'it');
        cont.href = attivita.href;
        cont.textContent = attivita.testo;
      }
      // Lega della settimana: nome, posizione e numero di studenti del gruppo
      const lg = d.lega, sf = pl.querySelector<HTMLElement>('.pl-sfide');
      if (lg && sf) {
        sf.querySelector('.pl-sf-lega')!.textContent = lg.posizione ? `Lega ${lg.nome} · ${lg.posizione}°` : `Lega ${lg.nome}`;
        sf.querySelector('.pl-sf-medaglia')!.innerHTML = medagliaLega(lg.lega, lg.nome, 'mp');
      }
    }
    if (bl?.dataset.stato) {
      try { const d = JSON.parse(bl.dataset.stato); mostraLivello({ livello: d.l, fascia: d.f, frase: d.r, exp: d.x, base: d.b, prossimo: d.p, mancano: d.m, perc: d.c }); } catch {}
    }
    bl?.addEventListener('click', () => {
      const apri = pl!.hidden;
      pl!.hidden = !apri;
      bl.setAttribute('aria-expanded', String(apri));
      if (apri) caricaPercorso();
    });
    document.addEventListener('click', (e) => {
      if (pl && !pl.hidden && !(e.target as HTMLElement).closest('.account-testata')) { pl.hidden = true; bl?.setAttribute('aria-expanded', 'false'); }
    });
    // Le pagine (domande a tempo, account) annunciano un nuovo stato con l'evento "livello".
    addEventListener('livello', (e) => mostraLivello((e as CustomEvent).detail));
    // Traguardi e obiettivi raggiunti: un avviso breve in basso.
    const avviso = document.querySelector<HTMLElement>('.avviso-premio');
    addEventListener('premi', (e) => {
      const premi = (e as CustomEvent).detail as { nome: string; punti: number }[];
      if (!avviso || !premi?.length) return;
      avviso.textContent = premi.map((p) => `${p.nome}: +${p.punti} ${XP}`).join(' · ');
      avviso.hidden = false;
      clearTimeout((avviso as any)._t);
      (avviso as any)._t = setTimeout(() => { avviso.hidden = true; }, 5000);
    });

    // ---- Studio attivo: un segnale al minuto, solo con la pagina in primo piano e un'azione negli ultimi 2 minuti ----
    const rad0 = document.documentElement;
    if (rad0.classList.contains('collegato') && rad0.dataset.studioMateria) {
      let ultimaAzione = Date.now();
      let ultimoMovimento = 0;
      const visti = new Set<string>();
      const segna = () => { ultimaAzione = Date.now(); };
      ['scroll', 'pointerdown', 'keydown', 'touchstart', 'wheel', 'toggle'].forEach((t) => addEventListener(t, segna, { passive: true, capture: true }));
      addEventListener('pointermove', () => { const o = Date.now(); if (o - ultimoMovimento > 5000) { ultimoMovimento = o; segna(); } }, { passive: true });
      setInterval(async () => {
        if (document.visibilityState !== 'visible' || !document.hasFocus() || Date.now() - ultimaAzione > 120000) return;
        const r = await fetch('/api/studio', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ materia: rad0.dataset.studioMateria, argomento: rad0.dataset.studioArgomento, lingua: inglese ? 'en' : 'it' }),
        }).catch(() => null);
        const d = r && r.ok ? await r.json().catch(() => null) : null;
        if (d?.stato) dispatchEvent(new CustomEvent('livello', { detail: d.stato }));
        if (d?.nuovi?.length) dispatchEvent(new CustomEvent('premi', { detail: d.nuovi }));
        // Invito a un duello ricevuto mentre si studia (worker/sfide.mjs): un avviso in basso con Accetta e Più tardi.
        const inv = (d?.inviti || []).find((x: any) => !visti.has(x.codice));
        const box = document.querySelector<HTMLElement>('.avviso-duello');
        if (inv && box && !inglese && !linguaCatalogo) {
          visti.add(inv.codice);
          const esc = (x: string) => String(x).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
          box.innerHTML = `<span><strong>${esc(inv.da)}</strong> ti sfida a un duello su ${esc(inv.argomento || inv.materia)}.</span>`
            + `<a class="bottone-primario" href="/duelli?d=${inv.codice}&accetta=1">Accetta</a><button type="button" class="bottone-secondario">Più tardi</button>`;
          box.querySelector('button')!.addEventListener('click', () => { box.hidden = true; });
          box.hidden = false;
        }
      }, 60000);
    }

    // Il tasto Indice: su schermi larghi apre e chiude la colonna laterale (scelta ricordata),
    // su telefono apre il cassetto.
    const d = document.getElementById('cassetto-indice') as HTMLDialogElement;
    const largo = matchMedia('(min-width: 60rem)');
    const bottone = document.querySelector<HTMLButtonElement>('[data-apri-indice]');
    const usaCassetto = () => !largo.matches || document.documentElement.classList.contains('studio-concentrato');
    const aggiorna = () => {
      const aperto = usaCassetto() ? d.open : !document.documentElement.classList.contains('indice-chiuso');
      bottone?.setAttribute('aria-pressed', String(aperto));
      bottone?.setAttribute('aria-expanded', String(aperto));
    };
    aggiorna(); largo.addEventListener('change', aggiorna); addEventListener('resize', aggiorna);
    bottone?.addEventListener('click', () => {
      if (!usaCassetto()) {
        const chiuso = document.documentElement.classList.toggle('indice-chiuso');
        try { localStorage.setItem('indice', chiuso ? 'chiuso' : 'aperto'); } catch {}
        aggiorna();
      } else { d.showModal(); aggiorna(); }
    });
    d.addEventListener('close', aggiorna);
    document.querySelector('[data-chiudi-indice]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
    document.querySelectorAll<HTMLAnchorElement>('.indice-cerca-link').forEach((a) => a.addEventListener('click', (e) => {
      const campo = document.querySelector<HTMLInputElement>('#ricerca-principale input[type="search"]');
      if (!campo) return;
      e.preventDefault();
      if (d.open) d.close();
      campo.scrollIntoView({ block: 'center' });
      campo.focus({ preventScroll: true });
    }));

    // Torna su: compare dopo un po' di scorrimento, riporta in cima.
    const su = document.querySelector<HTMLButtonElement>('.torna-su');
    if (su) {
      const mostra = () => { su.hidden = scrollY < 900; };
      mostra();
      addEventListener('scroll', mostra, { passive: true });
      su.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
    }

    // Il blocco della copia vale per chi non ha sbloccato la materia. Le protezioni
    // di stampa e cattura si applicano anche alle pagine sbloccate.
    const radice = document.documentElement;
    if (radice.classList.contains('contenuto')) {
      const sbloccato = radice.classList.contains('sbloccato');
      // La finestra dell'assistente resta libera: lì si scrive, si seleziona e si copia.
      // Si guarda anche la selezione: il bersaglio di copia e scorciatoie è spesso la pagina intera o un nodo di testo.
      const inPi = (n: Node | null | undefined) => {
        const el = n && (n.nodeType === 1 ? (n as Element) : n.parentElement);
        return Boolean(el?.closest?.('.assistente, .zona-libera'));
      };
      const libero = (e: Event) => {
        if (sbloccato || inPi(e.target as Node)) return true;
        const sel = getSelection();
        return Boolean(sel && sel.rangeCount && !sel.isCollapsed && inPi(sel.anchorNode) && inPi(sel.focusNode));
      };
      const blocca = (e: Event) => { if (!libero(e)) e.preventDefault(); };
      ['contextmenu', 'copy', 'cut', 'dragstart', 'selectstart'].forEach((t) => document.addEventListener(t, blocca));
      addEventListener('keydown', (e) => {
        const k = e.key.toLowerCase();
        if ((e.ctrlKey || e.metaKey) && ['p', 's', 'c', 'u', 'a'].includes(k) && !(libero(e) && ['c', 'a'].includes(k))) e.preventDefault();
        if (k === 'printscreen') { radice.classList.add('velato'); navigator.clipboard?.writeText('').catch(() => {}); }
      });
      addEventListener('keyup', (e) => { if (e.key.toLowerCase() === 'printscreen') setTimeout(() => radice.classList.remove('velato'), 1200); });
      if (sbloccato) {
        addEventListener('blur', () => radice.classList.add('velato'));
        addEventListener('focus', () => radice.classList.remove('velato'));
        document.addEventListener('visibilitychange', () => radice.classList.toggle('velato', document.hidden));
      }
    }
  </script>
  <script is:inline>
    // Formule nel testo: restano su una sola riga quando ci stanno (al telefono non si spezzano più a metà, per esempio dopo un segno meno).
    (() => {
      const sistema = () => {
        const f = [...document.querySelectorAll('.katex')].filter((k) => !k.closest('.katex-display'));
        f.forEach((k) => k.classList.add('intera'));
        const troppo = f.filter((k) => { const c = k.parentElement && k.parentElement.closest('p, li, td, th, div, span.risposta, label'); return c && k.getBoundingClientRect().width > c.clientWidth - 4; });
        troppo.forEach((k) => k.classList.remove('intera'));
      };
      sistema();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(sistema);
      let t; addEventListener('resize', () => { clearTimeout(t); t = setTimeout(sistema, 200); });
    })();
  </script>
  <script is:inline>
    // Freccia «indietro» nel percorso: torna alla pagina precedente se si viene da una pagina del sito,
    // altrimenti (arrivo da Google, Instagram, link diretto) segue il collegamento al livello sopra.
    (() => {
      const a = document.querySelector('.percorso .indietro');
      if (!a) return;
      a.addEventListener('click', (ev) => {
        let dalSito = false;
        try { dalSito = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin; } catch (_) {}
        if (dalSito && history.length > 1) { ev.preventDefault(); history.back(); }
      });
    })();
  </script>
  <script is:inline>
    // Percorso d'acquisto: solo conteggi anonimi (fine dell'anteprima vista, tasto di acquisto premuto), mostrati nella dashboard.
    (() => {
      const pezzi = location.pathname.replace(/^\/en(?=\/)/, '').split('/');
      const materia = pezzi[1] === 'videocorsi' ? (pezzi[2] ? 'video-' + pezzi[2].replace(/\.html$/, '') : '') : pezzi[1];
      if (!materia || !navigator.sendBeacon) return;
      const manda = (e) => { try { navigator.sendBeacon('/api/evento', new Blob([JSON.stringify({ e, m: materia })], { type: 'application/json' })); } catch (_) {} };
      const fine = document.querySelector('.fine-anteprima');
      if (fine && 'IntersectionObserver' in window) {
        const oss = new IntersectionObserver((voci) => { if (voci.some((v) => v.isIntersecting)) { manda('fine-anteprima'); oss.disconnect(); } });
        oss.observe(fine);
      }
      document.addEventListener('click', (ev) => { if (ev.target.closest && ev.target.closest('#invia-acquisto, #compra')) manda('tasto'); }, true);
    })();
  </script>
  <script>
    import '../scripts/luccichio-sconti';
  </script>
</body>
</html>
