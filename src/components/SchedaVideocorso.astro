---
// Scheda di un videocorso: usata in home, nella pagina dei videocorsi e nei prezzi.
import { MATERIE } from '../data/materie';
import { oreTotali, prezzoSeparato, valoreMateriale, type Videocorso } from '../data/videocorsi';
interface Props { v: Videocorso; compatta?: boolean }
const { v, compatta = false } = Astro.props;
const sblocca = v.sblocca.map((s) => MATERIE.find((m) => m.slug === s)).filter(Boolean);
const separato = prezzoSeparato(v);
const materiale = valoreMateriale(v);
---
<a class:list={['scheda-video', { compatta }]} href={`/videocorsi/${v.slug}`} style={`--accento: ${v.colore}`}>
  <span class="video-icona" aria-hidden="true">
    <span class="video-pi">π</span>
    <svg class="video-play" viewBox="0 0 20 20"><circle cx="10" cy="10" r="10" /><path d="M8 6.2v7.6l6-3.8z" fill="white" /></svg>
  </span>
  <span class="video-corpo">
    <span class="video-titolo">{v.titolo}</span>
    <span class="video-dati">{v.lezioni} lezioni · circa {oreTotali(v)} ore · video e PDF</span>
    {!compatta && <span class="video-sommario">{v.sommario}</span>}
    <span class="video-sblocca">
      <span class="video-sblocca-etichetta">Sblocca subito sul sito</span>
      {sblocca.map((m) => <span class="video-chip" style={`--c: ${m!.colore}`}>{m!.breve}</span>)}
    </span>
    {materiale > 0 && <span class="video-materiale">Risparmi {materiale} € di materiale didattico</span>}
    <span class="video-piede">
      <span class="video-prezzo">{v.prezzo} €</span>
      {separato > v.prezzo && <span class="video-risparmio">invece di {separato} € comprando i corsi separati</span>}
      <span class="video-vai">Scopri il corso →</span>
    </span>
  </span>
</a>

<style>
  .scheda-video { display: flex; gap: 1rem; padding: 1.1rem 1.15rem; border: 1px solid var(--riga); border-radius: 10px; background: white; text-decoration: none; color: var(--inchiostro); box-shadow: 0 1px 2px rgba(34,48,47,.05), 0 6px 18px rgba(34,48,47,.06); transition: transform .15s, box-shadow .15s; height: 100%; box-sizing: border-box; }
  .scheda-video:hover { transform: translateY(-2px); box-shadow: 0 2px 4px rgba(34,48,47,.06), 0 10px 26px rgba(34,48,47,.10); }
  .video-icona { position: relative; flex: none; width: 3.6rem; height: 3.6rem; border-radius: 50%; border: 2px solid var(--accento); display: grid; place-items: center; background: color-mix(in srgb, var(--accento) 8%, white); }
  .video-pi { font-family: var(--titoli); font-size: 2rem; font-weight: 600; color: var(--accento); line-height: 1; margin-top: -0.15rem; }
  .video-play { position: absolute; right: -0.25rem; bottom: -0.25rem; width: 1.35rem; height: 1.35rem; fill: var(--accento); }
  .video-corpo { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; flex: 1; }
  .video-titolo { font-family: var(--titoli); font-size: 1.22rem; font-weight: 600; line-height: 1.25; color: var(--accento); }
  .video-dati { font-family: var(--ui); font-size: 0.85rem; color: var(--inchiostro-2); }
  .video-sommario { font-size: 0.95rem; color: var(--inchiostro-2); line-height: 1.45; }
  .video-sblocca { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; font-family: var(--ui); margin-top: 0.1rem; }
  .video-sblocca-etichetta { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--inchiostro-2); margin-right: 0.15rem; }
  .video-materiale { font-family: var(--ui); font-size: 0.85rem; font-weight: 600; color: #2e7d4f; }
  .video-chip { font-size: 0.78rem; font-weight: 600; padding: 0.08rem 0.5rem; border-radius: 99px; color: var(--c); background: color-mix(in srgb, var(--c) 12%, white); }
  .video-piede { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.6rem; margin-top: auto; padding-top: 0.35rem; font-family: var(--ui); }
  .video-prezzo { font-size: 1.35rem; font-weight: 700; color: var(--inchiostro); }
  .video-risparmio { font-size: 0.82rem; font-weight: 600; color: #2e7d4f; }
  .video-vai { margin-left: auto; font-size: 0.9rem; font-weight: 600; color: var(--accento); }
  .compatta .video-icona { width: 3rem; height: 3rem; }
  .compatta .video-pi { font-size: 1.65rem; }
  .compatta .video-titolo { font-size: 1.08rem; }
</style>
