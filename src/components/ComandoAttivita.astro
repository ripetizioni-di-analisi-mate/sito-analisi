---
interface Props { pannello: string; titolo: string; en: boolean; progressi?: boolean }
const { pannello, titolo, en, progressi = false } = Astro.props;
---
<div class="pm-attivita-testa">
  <button type="button" hidden data-pm-attivita aria-controls={pannello} aria-expanded="true" aria-label={en ? `Activities for ${titolo}` : `Attività per ${titolo}`}>
    {en ? 'Activities' : 'Attività'}
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
  </button>
  {progressi && <em class="pm-stato" hidden></em>}
</div>
