---
interface Props { lingua?: 'it' | 'en' }
const { lingua = 'it' } = Astro.props;
const en = lingua === 'en';
const syllabus = 'https://www.mur.gov.it/sites/default/files/2026-06/Syllabus_FISICA_%20finale%202026.pdf';
---
<p class="nota-programma">
  {en ? 'The course topics are based on the ' : 'Gli argomenti del corso prendono come riferimento il '}
  <a href={syllabus} target="_blank" rel="noopener">{en ? '2026/2027 Physics programme for the filter semester published by the MUR' : 'programma di Fisica per il semestre filtro pubblicato dal MUR per il 2026/2027'}</a>.
</p>

<style>
  .nota-programma {
    margin: 0.75rem 0 1.25rem;
    color: var(--inchiostro-2);
    font-size: 0.95rem;
    line-height: 1.65;
  }
</style>
