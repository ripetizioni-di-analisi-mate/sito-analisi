---
import { BOCCONI } from '../data/bocconi.mjs';
import { link } from '../i18n';
import { nomiAllenamento } from '../lib/allenamento.mjs';
interface Props { lingua: 'it' | 'en' }
const { lingua } = Astro.props;
const en = lingua === 'en';
const prove = `/${BOCCONI.slug}/simulazione`;
const { diagnostico, simulazione } = nomiAllenamento(BOCCONI, lingua);
---
<section class="bocconi-prove" aria-labelledby="bocconi-prove-titolo">
  <div>
    <h2 id="bocconi-prove-titolo">{en ? 'Bocconi practice tests' : 'Prove del Test Bocconi'}</h2>
    <p>{en
      ? `The ${BOCCONI.diagnostico}-question diagnostic shows which lessons to review. Full course access includes ${BOCCONI.simulazioni} mock tests with ${BOCCONI.quesiti} questions each.`
      : `Il diagnostico da ${BOCCONI.diagnostico} quesiti indica quali lezioni ripassare. Il corso completo include ${BOCCONI.simulazioni} simulazioni da ${BOCCONI.quesiti} quesiti ciascuna.`}</p>
  </div>
  <div class="bocconi-prove-link">
    <a class="bottone-primario" href={link(lingua, prove + '#diagnostico')}>{diagnostico}</a>
    <a class="bottone-secondario" href={link(lingua, prove + '#simulazioni')}>{simulazione}</a>
  </div>
</section>
<style>
  .bocconi-prove {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: .8rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--pm-filo);
    border-radius: 14px;
    background: var(--pm-velo);
  }
  h2 { margin: 0 0 .35rem; font: 700 1.15rem/1.25 var(--titoli); }
  p { margin: 0; color: var(--inchiostro-2); font-size: .93rem; line-height: 1.4; }
  .bocconi-prove-link { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; }
  .bocconi-prove-link a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    max-width: 100%;
    min-height: 2.75rem;
    text-align: center;
    overflow-wrap: anywhere;
  }
  @media (max-width: 34rem) {
    .bocconi-prove { padding: .9rem; }
    .bocconi-prove-link a { flex: 1 1 100%; }
  }
</style>
