---
import { T, type Lingua } from '../i18n';

interface Props {
  materia: string;
  titolo: string;
  prezzo: number;
  lingua: Lingua;
  anteprima: string;
  sblocca: string;
  testo?: string;
}

const { materia, titolo, prezzo, lingua, anteprima, sblocca, testo } = Astro.props;
const t = T(lingua);
---
<div class="riquadro-stato" data-materia={materia}>
  <div class="stato-sbloccata">
    <span class="pillola" title={t.accessoAttivoTesto(titolo)}><svg class="icona" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9.5" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg><strong>{t.accessoAttivo}</strong></span>
    <slot name="accesso-attivo" />
  </div>
  <div class="stato-bloccata">
    <svg class="icona" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20S10 9 20 9s16 11 16 11-6 11-16 11S4 20 4 20Z"/><circle cx="20" cy="20" r="5"/></svg>
    <div class="testo"><strong>{t.anteprima}</strong><span>{testo ?? t.anteprimaTesto}</span></div>
    <div class="azioni-anteprima">
      <a class="bottone-sblocca" href={anteprima}>{t.iniziaAnteprima} →</a>
      <a class="link-sblocca" href={sblocca}>{t.sbloccaTutto} · {prezzo} €</a>
      <slot />
    </div>
  </div>
</div>
