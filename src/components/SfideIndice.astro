---
// Accessi alle sfide tra studenti nell'indice laterale, sotto «Lezioni con Carmine»: lega della settimana e duelli.
// Scelta di Carmine del 03/11/2026 (versione B; prima erano nel pannello del livello). Solo in italiano.
const icone = {
  lega: '<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3.5h8v4a4 4 0 0 1-8 0v-4Z"/><path d="M6 5H3.5v1a2.5 2.5 0 0 0 2.6 2.5M14 5h2.5v1a2.5 2.5 0 0 1-2.6 2.5M10 11.5v3M7 16.5h6"/></svg>',
  duelli: '<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="7" r="2.4"/><circle cx="14" cy="7" r="2.4"/><path d="M2 16c.5-2.4 2-3.7 4-3.7s3.5 1.3 4 3.7M10 16c.5-2.4 2-3.7 4-3.7s3.5 1.3 4 3.7"/></svg>',
};
const voci = [
  { href: '/lega', icona: icone.lega, titolo: 'Lega della settimana', sotto: 'Classifica da lunedì a domenica' },
  { href: '/duelli', icona: icone.duelli, titolo: 'Duelli', sotto: 'Sfida un altro studente' },
];
const qui = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '');
---
<div class="lezioni-indice">
  <p class="indice-materia"><span>Sfide tra studenti</span></p>
  <ol class="indice-materie">
    {voci.map((v) => (
      <li style="--colore-materia: var(--accento)">
        <a class="voce-materia" href={v.href} aria-current={qui === v.href ? 'page' : undefined}>
          <span class="lezioni-icona" set:html={v.icona} />
          <span class="materia-testo"><span class="materia-nome">{v.titolo}</span><small class="lezioni-sotto">{v.sotto}</small></span>
        </a>
      </li>
    ))}
  </ol>
</div>
