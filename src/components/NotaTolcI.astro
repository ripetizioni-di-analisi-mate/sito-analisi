---
import { PROVE_INGRESSO } from '../data/tolc.mjs';
const { domande, schede, materia = 'tolc-i', capitoli = 9 } = Astro.props;
const conf = PROVE_INGRESSO[materia];
const ingleseFacoltativo = !conf.ingleseObbligatorio && conf.sezioni.find(s => s.slug === 'inglese');
const titolo = conf.esercitazione ? 'Prova di allenamento OFA' : `Simulazione ${conf.nome}`;
---
<aside class="nota-tolc" aria-label={titolo}>
  <div class="tolc-intro"><h2>{conf.esercitazione ? 'Allenamento a tempo' : 'Struttura della simulazione'}</h2></div>
  <p class="tolc-raccolta"><strong>{capitoli} capitoli · {domande} quiz · {schede} schede svolte</strong></p>
  <dl>{conf.sezioni.map((s) => <div><dt>{s.titolo}</dt><dd><strong>{s.numero}</strong> quesiti <span>· {s.minuti} min</span></dd></div>)}</dl>
  <p class="tolc-punti"><strong>{conf.quesiti} quesiti in {conf.minuti} minuti</strong> · {conf.esercitazione ? '+1 corretta, 0 errata o omessa.' : '+1 corretta, −0,25 errata, 0 omessa.'}
    {ingleseFacoltativo && <> Nella simulazione puoi includere l’inglese, con risultato separato e senza penalità.</>}
    {conf.massimo && <> Punteggio pesato su {conf.massimo}.</>}
  </p>
  <div class="tolc-azioni"><a class="bottone-secondario" href={`/${materia}/simulazione`}>{titolo} →</a><a href={conf.fonte} target="_blank" rel="noopener noreferrer">{conf.testoFonte ?? 'Struttura e programma CISIA'} ↗</a></div>
  <p class="tolc-fonte">{conf.nota ?? 'Preparazione indipendente con quesiti di allenamento. Consulta il bando del tuo ateneo per conoscere il test richiesto e le soglie di ammissione.'}</p>
</aside>
<style>
  .nota-tolc{margin:1.6rem 0 2rem;padding:1.4rem;border:1px solid color-mix(in srgb,var(--accento) 24%,var(--riga));border-radius:var(--raggio);background:color-mix(in srgb,var(--accento) 4%,var(--carta));font-family:var(--ui)}
  .tolc-intro h2{font-size:1.45rem;margin:.25rem 0 .5rem}.tolc-intro p{margin:0;color:var(--inchiostro-2);font-size:.9rem}
  dl{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:1.3rem 0}dl div{border-left:2px solid color-mix(in srgb,var(--accento) 35%,var(--riga));padding-left:.7rem}dt{font-size:.8rem;color:var(--inchiostro-2)}dd{margin:.3rem 0 0;font-size:.83rem}dd strong{font-size:1.15rem}dd span{white-space:nowrap}
  .tolc-punti{font-size:.84rem;border-top:1px solid var(--riga);padding-top:1rem}.tolc-azioni{display:flex;align-items:center;flex-wrap:wrap;gap:.8rem 1.2rem;font-size:.84rem}.tolc-fonte{font-size:.75rem;color:var(--inchiostro-2);margin:1rem 0 0;line-height:1.6}
  @media(max-width:40rem){.nota-tolc{padding:1rem}dl{grid-template-columns:1fr 1fr}.tolc-intro h2{font-size:1.25rem}}
</style>
