---
import { link, type Lingua } from '../i18n';
import '../styles/indice-corso-anteprima.css';

interface Argomento {
  slug: string;
  titolo: string;
  riassunto?: string;
  svolti: number;
  dafare: number;
  verificabili: number;
  domande: number;
}

interface Props {
  lingua: Lingua;
  materia: string;
  titolo: string;
  prezzo?: number;
  argomenti: Argomento[];
  teoremi: number;
  definizioni: number;
  domande: number;
}

const { lingua, materia, titolo, prezzo, argomenti, teoremi, definizioni, domande } = Astro.props;
const en = lingua === 'en';
const primo = argomenti[0];
const base = link(lingua, `/${materia}`);
const t = en ? {
  preview: 'Design preview', original: 'Current page', course: 'University course',
  heading: 'Mathematical', accent: 'Analysis 1', start: 'Start studying', resume: 'Continue studying',
  progress: 'Course progress', chapters: 'Course contents', guided: 'Guided study',
  guidedDescription: 'The test adapts its difficulty to your answers and identifies gaps, their causes and what to study next.',
  test: 'Start the test', testLanguage: 'Test in Italian', free: 'Free preview',
  coverage: 'Is your exam covered?', coverageLanguage: 'Exam comparison in Italian', unlock: 'Unlock the course',
  unlocked: 'Full access active', theory: 'Theory', worked: 'Worked examples', practice: 'Practice exercises',
  timed: 'Timed questions', exam: 'Exam practice', review: 'Review questions', simulation: 'Exam simulation',
  today: 'Today’s review', reference: 'Definitions and theorems', glossary: `${teoremi} theorems · ${definizioni} definitions`,
} : {
  preview: 'Anteprima del design', original: 'Pagina attuale', course: 'Corso universitario',
  heading: 'Analisi', accent: 'matematica 1', start: 'Inizia a studiare', resume: 'Riprendi lo studio',
  progress: 'Avanzamento del corso', chapters: 'Indice dei capitoli', guided: 'Studio guidato',
  guidedDescription: 'Il test adatta la difficoltà alle tue risposte e individua le lacune, le loro cause e il percorso da seguire.',
  test: 'Inizia il test', testLanguage: '', free: 'Anteprima gratuita',
  coverage: 'Il tuo esame è coperto?', coverageLanguage: '', unlock: 'Sblocca tutto',
  unlocked: 'Accesso completo attivo', theory: 'Teoria', worked: 'Esercizi svolti', practice: 'Esercizi da fare',
  timed: 'Domande a tempo', exam: 'Prove d’esame', review: 'Domande di ripasso', simulation: 'Simulazione d’esame',
  today: 'Il tuo ripasso di oggi', reference: 'Teoremi e definizioni', glossary: `${teoremi} teoremi · ${definizioni} definizioni`,
};
const sezioni = [
  { slug: 'teoria', titolo: t.theory, icona: 'book', campo: undefined },
  { slug: 'esercizi-svolti', titolo: t.worked, icona: 'worked', campo: 'svolti' as const },
  { slug: 'esercizi', titolo: t.practice, icona: 'pencil', campo: 'dafare' as const },
  { slug: 'domande', titolo: t.timed, icona: 'timer', campo: 'domande' as const },
];
const icone = {
  book: '<path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15"/>',
  worked: '<path d="M6 3h13v18H6a3 3 0 0 1 0-6h13M3 6h3M3 10h3M3 14h3M10 8l2 2 4-4"/>',
  pencil: '<path d="m15 4 5 5M4 20l5-1L21 7a2 2 0 0 0-5-5L4 14l-1 7Z"/>',
  timer: '<circle cx="12" cy="14" r="8"/><path d="M12 6V3m-3 0h6m4 4 2-2m-9 5v5l3 2"/>',
};
---

<section class="indice-anteprima" data-indice-corso={materia} data-lingua={lingua} aria-label={titolo}>
  <div class="ic-preview"><span>{t.preview}</span><a href={`${base}?lingua=${lingua}`}>{t.original} <span aria-hidden="true">↗</span></a></div>

  <header class="ic-hero">
    <div class="ic-hero-copy">
      <p class="ic-eyebrow">{t.course}</p>
      <h1>{t.heading}<br/><em>{t.accent}</em></h1>
      <div class="ic-resume-row">
        <a class="ic-resume" data-ic-resume data-testo-riprendi={t.resume} href={link(lingua, `/${materia}/${primo.slug}/teoria`)}><span>{t.start}</span><span aria-hidden="true">→</span></a>
        <span class="ic-resume-topic" data-ic-resume-topic>{primo.titolo}</span>
      </div>
    </div>
    <div class="ic-hero-aside">
      <div class="ic-graph" aria-hidden="true">
        <svg viewBox="0 0 300 172" fill="none">
          <defs>
            <pattern id={`ic-grid-${lingua}`} width="30" height="30" patternUnits="userSpaceOnUse"><path d="M30 0H0V30" stroke="#90b49c" stroke-opacity=".19"/></pattern>
            <linearGradient id={`ic-wash-${lingua}`} x1="0" y1="0" x2="0" y2="1"><stop stop-color="#d9ef9d" stop-opacity=".2"/><stop offset="1" stop-color="#d9ef9d" stop-opacity=".02"/></linearGradient>
            <clipPath id={`ic-clip-${lingua}`}><rect width="300" height="172"/></clipPath>
          </defs>
          <g clip-path={`url(#ic-clip-${lingua})`}>
            <rect width="300" height="172" fill={`url(#ic-grid-${lingua})`}/>
            <path d="M30 0Q150 270 270 0V135H30Z" fill={`url(#ic-wash-${lingua})`}/>
            <path d="M0 135H298M150 0V172" stroke="#719985"/>
            <path d="m290 132 8 3-8 3m-143-130 3-7 3 7" stroke="#719985"/>
            <path d="M30 0Q150 270 270 0" stroke="#e2f1b4" stroke-width="2.4"/>
            <path d="M162 155.25 283 19.125M210 101.25V135M150 101.25H210" stroke="#c4dc9f" stroke-dasharray="4 5"/>
            <circle cx="210" cy="101.25" r="4" fill="#e2f1b4"/>
          </g>
          <g fill="#c5ddcb" font-size="11" font-family="var(--ui)"><text x="284" y="128">x</text><text x="159" y="12">y</text></g>
          <text x="15" y="25" fill="#dcebd8" font-size="14" font-family="var(--titoli)">y = x²</text>
        </svg>
      </div>
      <div class="ic-course-progress" data-ic-course-progress hidden>
        <span>{t.progress}</span><strong data-ic-percent></strong>
        <div class="ic-course-track" role="progressbar" aria-label={t.progress} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
      </div>
    </div>
  </header>

  <div class="ic-columns">
    <aside class="ic-guided" data-orientamento-gm hidden>
      <div class="ic-guided-heading"><span class="ic-target" aria-hidden="true">◎</span><h2>{t.guided}</h2></div>
      <p>{t.guidedDescription}</p>
      <a class="ic-guided-action" href={`/studio-guidato/${materia}`}>{t.test}<span aria-hidden="true">→</span></a>
      {t.testLanguage && <small>{t.testLanguage}</small>}
    </aside>

    <nav class="ic-options" data-materia={materia} aria-label={en ? 'Course access' : 'Accesso al corso'}>
      <a href={link(lingua, `/${materia}/${primo.slug}/teoria`)}>{t.free}<span aria-hidden="true">↗</span></a>
      <a href={`/compatibilita?materia=${materia}`} hreflang="it">
        <span>{t.coverage}{t.coverageLanguage && <small>{t.coverageLanguage}</small>}</span><span aria-hidden="true">↗</span>
      </a>
      {prezzo && <a class="ic-purchase stato-bloccata" href={link(lingua, `/${materia}/sblocca`)}>{t.unlock}<strong>{prezzo} €</strong></a>}
      <span class="ic-unlocked stato-sbloccata">✓ {t.unlocked}</span>
    </nav>

    <section class="ic-index" aria-labelledby="ic-chapters">
      <h2 id="ic-chapters">{t.chapters}</h2>
      <div class="ic-chapters">
        {argomenti.map((a, i) => <details class="ic-chapter" name="ic-capitoli" data-ic-argomento={a.slug} data-schede={a.svolti} data-verificabili={a.verificabili} data-domande={a.domande}>
          <summary>
            <span class="ic-chapter-number">{String(i + 1).padStart(2, '0')}</span>
            <span class="ic-chapter-title">{a.titolo}</span>
            <span class="ic-chapter-progress" hidden><span data-ic-chapter-percent></span><span class="ic-chapter-track" aria-hidden="true"><span></span></span></span>
            <svg class="ic-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
          </summary>
          <div class="ic-chapter-body">
            {a.riassunto && <p>{a.riassunto}</p>}
            <nav class="ic-resources" aria-label={a.titolo}>
              {sezioni.filter((s) => !s.campo || a[s.campo] > 0).map((s) => <a href={link(lingua, `/${materia}/${a.slug}/${s.slug}`)}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icone[s.icona as keyof typeof icone]}/>
                {s.campo && <span class="ic-resource-count">{a[s.campo]}</span>}
                <span class="ic-resource-label">{s.titolo}</span>
              </a>)}
            </nav>
          </div>
        </details>)}
      </div>
      <div class="ic-reference">
        <h2>{t.exam}</h2>
        <nav aria-label={t.exam}>
          {domande > 0 && <a href={link(lingua, `/${materia}/prove-d-esame/domande`)}>{t.review}<span>{domande}</span></a>}
          <a href={link(lingua, `/${materia}/simulazione`)}>{t.simulation}<span aria-hidden="true">↗</span></a>
          <a class="solo-collegati" href={link(lingua, `/${materia}/ripasso-di-oggi/domande`)} hidden>{t.today}<span aria-hidden="true">↗</span></a>
          <a href={link(lingua, `/${materia}/teoremi`)}>{t.reference}<small>{t.glossary}</small></a>
        </nav>
      </div>
    </section>
  </div>
</section>

<script>
  import { caricaPercorsoStudio, leggiCatalogoStudio, prossimaAttivita } from '../lib/percorso-studio.mjs';

  const box = document.querySelector<HTMLElement>('[data-indice-corso]');
  if (box) {
    const materia = box.dataset.indiceCorso!;
    const lingua = box.dataset.lingua || 'it';
    const capitoli = [...box.querySelectorAll<HTMLDetailsElement>('[data-ic-argomento]')];

    // L'indice parte chiuso; resta aperto un solo capitolo anche nei browser meno recenti.
    capitoli.forEach((capitolo) => capitolo.addEventListener('toggle', () => {
      if (capitolo.open) capitoli.filter((altro) => altro !== capitolo).forEach((altro) => { altro.open = false; });
    }));

    if (document.documentElement.classList.contains('collegato')) {
      fetch(`/api/progressi?materia=${encodeURIComponent(materia)}`, { credentials: 'same-origin', cache: 'no-store' })
        .then((r) => r.ok ? r.json() : null)
        .then((d) => {
          if (!d?.argomenti) return;
          let totale = 0;
          for (const capitolo of capitoli) {
            const p = d.argomenti[capitolo.dataset.icArgomento!] || {};
            const quote = [p.teoria ? 1 : 0];
            for (const [campo, denominatore] of [['schede', 'schede'], ['esercizi', 'verificabili'], ['domande', 'domande']]) {
              const n = Number(capitolo.dataset[denominatore]);
              if (n > 0) quote.push(Math.max(0, Math.min(1, (Number(p[campo]) || 0) / n)));
            }
            const frazione = quote.reduce((a, b) => a + b, 0) / quote.length;
            const percentuale = Math.round(frazione * 100);
            totale += frazione;
            capitolo.querySelector<HTMLElement>('[data-ic-chapter-percent]')!.textContent = `${percentuale}%`;
            capitolo.querySelector<HTMLElement>('.ic-chapter-track > span')!.style.width = `${percentuale}%`;
            capitolo.querySelector<HTMLElement>('.ic-chapter-progress')!.hidden = false;
          }
          const percentuale = Math.round(totale / capitoli.length * 100);
          box.querySelector<HTMLElement>('[data-ic-percent]')!.textContent = `${percentuale}%`;
          const barra = box.querySelector<HTMLElement>('.ic-course-track')!;
          barra.setAttribute('aria-valuenow', String(percentuale));
          barra.querySelector<HTMLElement>('span')!.style.width = `${percentuale}%`;
          box.querySelector<HTMLElement>('[data-ic-course-progress]')!.hidden = false;
        })
        .catch(() => {});

      caricaPercorsoStudio(lingua).then((d: any) => {
        if (!d) return;
        const sessioni = (d.sessioni || []).filter((s: any) => s.materia === materia);
        const obiettivi = (d.obiettivi || []).filter((o: any) => o.link?.startsWith(`/${materia}/`) || o.link?.startsWith(`/en/${materia}/`));
        if (!sessioni.length && !obiettivi.length) return;
        const attivita = prossimaAttivita({ ...d, sessioni, obiettivi }, leggiCatalogoStudio(), lingua);
        const riprendi = box.querySelector<HTMLAnchorElement>('[data-ic-resume]')!;
        if (!attivita.href.includes(`/${materia}/`)) return;
        riprendi.href = attivita.href;
        riprendi.querySelector('span')!.textContent = riprendi.dataset.testoRiprendi!;
        const slug = attivita.href.split(`/${materia}/`)[1]?.split('/')[0];
        const corrente = capitoli.find((c) => c.dataset.icArgomento === slug);
        box.querySelector<HTMLElement>('[data-ic-resume-topic]')!.textContent = corrente?.querySelector('.ic-chapter-title')?.textContent || attivita.testo;
      });
    }
  }
</script>
