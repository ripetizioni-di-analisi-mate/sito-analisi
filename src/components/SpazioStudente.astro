---
// Spazio personale in home, versione F «Copertina» scelta da Carmine l'08/11:
// fascia calda con il saluto, il titolo della fascia (senza rango e grado), la frase con il filo bronzo come la citazione
// della presentazione, la barra degli EXP e lo stemma grande; sotto, appoggiata alla fascia, la scheda «Continua da qui».
// Visibile solo a chi ha fatto l'accesso (html.collegato).
// Il Worker scrive nella pagina nome, stemma, titolo, frase, EXP e barra (worker/spazio.mjs, nessuno sfarfallio);
// la scheda «Continua da qui» e l'esame li completa /api/percorso. La testata non viene toccata.
import { link, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const en = lingua === 'en';
---
<section class="spazio-studente" aria-labelledby="ss-saluto">
  <div class="ss-copertina">
    <div class="ss-dati">
      <h2 class="ss-saluto" id="ss-saluto">{en ? 'Hi, ' : 'Ciao, '}<span class="ss-nome"></span>.</h2>
      <p class="ss-titolo"><span class="ss-fascia"></span></p>
      <p class="ss-motto"><span class="ss-frase"></span></p>
      <div class="ss-cammino">
        <span class="ss-barra"><span></span></span>
        <p class="ss-exp"><span class="ss-exp-tot"></span> · <span class="ss-mancano"></span></p>
      </div>
    </div>
    <div class="ss-stemma" aria-hidden="true"></div>
    {/* Esame più vicino: solo se lo studente ha inserito una data. */}
    <a class="ss-esame" href="#" hidden><b class="ss-es-giorni"></b> <span class="ss-es-materia"></span></a>
  </div>
  <a class="ss-continua" href={link(lingua, '/domande-a-tempo')}>
    <span class="ss-c-testo">
      <small class="ss-c-su">{en ? 'To get started' : 'Per cominciare'}</small>
      <strong class="ss-c-titolo">{en ? 'Choose a topic and start' : 'Scegli un argomento e inizia'}</strong>
      <span class="ss-c-dove" hidden></span>
    </span>
    <span class="ss-c-tasto" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11M11 5.5 15.5 10 11 14.5"/></svg></span>
  </a>
</section>
<script>
  import { caricaPercorsoStudio, leggiCatalogoStudio, prossimaAttivita, ultimaSessioneStudio } from '../lib/percorso-studio.mjs';
  (async () => {
    const en = document.documentElement.lang === 'en';
    const pref = en ? '/en' : '';
    const box = document.querySelector<HTMLElement>('.spazio-studente');
    if (!box || !document.documentElement.classList.contains('collegato')) return;
    const q = (s: string) => box.querySelector<HTMLElement>(s)!;
    const d = await caricaPercorsoStudio(en ? 'en' : 'it');
    if (!d) return;
    const catalogo = leggiCatalogoStudio();
    const ultima = ultimaSessioneStudio(d.sessioni, catalogo, en ? 'en' : 'it');
    const c = q('.ss-continua') as HTMLAnchorElement;
    if (ultima) {
      // Ultimo argomento studiato: «Continua da qui», titolo dell'argomento, materia e sezione.
      c.href = ultima.href;
      q('.ss-c-su').textContent = en ? 'Continue from here' : 'Continua da qui';
      q('.ss-c-titolo').textContent = ultima.titolo;
      const sezione = ultima.href === ultima.domande ? (en ? 'Timed questions' : 'Domande a tempo') : (en ? 'Theory' : 'Teoria');
      const dove = q('.ss-c-dove');
      dove.textContent = ultima.materia && ultima.materia !== ultima.titolo ? `${ultima.materia} · ${sezione}` : sezione;
      dove.hidden = false;
    } else {
      // Studente nuovo: la prossima attività (obiettivo della settimana o scelta di un argomento).
      const attivita = prossimaAttivita(d, catalogo, en ? 'en' : 'it');
      c.href = attivita.href;
      q('.ss-c-titolo').textContent = attivita.testo;
    }
    // Esame più vicino con la data inserita (/api/percorso → esami).
    const esame = (d.esami || [])[0];
    const es = q('.ss-esame') as HTMLAnchorElement;
    if (esame && es) {
      const giorno = new Date(esame.data + 'T12:00:00');
      const n = Math.round((giorno.getTime() - new Date().setHours(12, 0, 0, 0)) / 86400000);
      if (n >= 0) {
        es.querySelector('.ss-es-giorni')!.textContent = n > 1 ? (en ? `${n} days` : `${n} giorni`) : n === 1 ? (en ? 'Tomorrow' : 'Domani') : (en ? 'Today' : 'Oggi');
        es.querySelector('.ss-es-materia')!.textContent = n > 1 ? (en ? `to your ${esame.titolo} exam` : `all’esame di ${esame.titolo}`) : (en ? `${esame.titolo} exam` : `l’esame di ${esame.titolo}`);
        es.title = `${esame.titolo} · ${giorno.toLocaleDateString(en ? 'en' : 'it', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}`;
        es.href = `${pref}/${esame.materia}`;
        es.hidden = false;
        box.classList.add('con-esame');
      }
    }
  })();
</script>
