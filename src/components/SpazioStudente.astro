---
// Spazio personale in home (versione B scelta da Carmine il 01/11), visibile solo a chi ha fatto l'accesso (html.collegato).
// Il Worker scrive nella pagina nome, stemma, rango, titolo, frase, EXP, barra e prossimo grado (nessuno sfarfallio);
// il tasto «Continua» e «Riprendi» li completa /api/percorso. La testata non viene toccata.
import { link, type Lingua } from '../i18n';
interface Props { lingua: Lingua }
const { lingua } = Astro.props;
const en = lingua === 'en';
const pref = en ? '/en' : '';
---
<section class="spazio-studente" aria-labelledby="ss-nome">
  <div class="ss-eroe">
    <div class="ss-stemma" aria-hidden="true"></div>
    <div class="ss-dati">
      <p class="ss-rango"></p>
      <h2 class="ss-nome" id="ss-nome"></h2>
      <p class="ss-titolo"><strong class="ss-fascia"></strong><span class="ss-frase"></span></p>
    </div>
    <div class="ss-cammino">
      <span class="ss-barra"><span></span></span>
      <p class="ss-exp"><span class="ss-exp-tot"></span><span class="ss-mancano"></span></p>
    </div>
  </div>
  <div class="ss-piede">
    <div class="ss-azioni">
      <a class="ss-riprendi" href="#" hidden><span class="ss-libro" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M10 5.2C8.4 4 6.2 3.6 3 3.8v11.4c3.2-.2 5.4.2 7 1.4 1.6-1.2 3.8-1.6 7-1.4V3.8c-3.2-.2-5.4.2-7 1.4Z"/><path d="M10 5.2v11.4"/></svg></span><span class="ss-rip-testo"><small>{en ? 'Back to' : 'Riprendi'}</small><span class="ss-argomento"></span></span></a>
      <a class="ss-continua" href={link(lingua, '/livelli-e-punti')}><span>{en ? 'Continue with the timed questions' : 'Continua con le domande a tempo'}</span><svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h11M11 5.5 15.5 10 11 14.5"/></svg></a>
    </div>
  </div>
</section>
<script is:inline define:vars={{ en, pref }}>
  (async () => {
    const box = document.querySelector('.spazio-studente');
    if (!box || !document.documentElement.classList.contains('collegato')) return;
    const q = (s) => box.querySelector(s);
    const r = await fetch(`/api/percorso?l=${en ? 'en' : 'it'}`).catch(() => null);
    if (!r || !r.ok) return;
    const d = await r.json();
    // Tasto principale: obiettivo della settimana con un collegamento, altrimenti le domande dell'ultimo argomento studiato.
    const conLink = (d.obiettivi || []).find((o) => o.link && !o.completato);
    const ultima = (d.sessioni || []).find((s) => s.materia && s.argomento);
    const dove = conLink ? conLink.link : ultima ? `/${ultima.materia}/${ultima.argomento}/domande` : null;
    const c = q('.ss-continua');
    if (dove) c.href = pref + dove;
    else { c.href = '#materie-home'; c.querySelector('span').textContent = en ? 'Choose a topic and start' : 'Scegli un argomento e inizia'; }
    // Conto alla rovescia accanto al titolo (src/components/EsameHome.astro): l'esame più vicino, se la data è inserita.
    const eh = document.querySelector('.esame-home');
    const esame = (d.esami || [])[0];
    if (eh && esame) {
      const giorno = new Date(esame.data + 'T12:00:00');
      const n = Math.round((giorno - Date.parse(new Date().toISOString().slice(0, 10) + 'T12:00:00')) / 86400000);
      if (n >= 0) {
        const lingua = en ? 'en' : 'it';
        const metti = (s, t) => { const x = eh.querySelector(s); if (x) x.textContent = t; };
        const data = giorno.toLocaleDateString(lingua, { weekday: 'long', day: 'numeric', month: 'long' });
        const v = eh.dataset.versione;
        eh.href = `${pref}/${esame.materia}`;
        eh.classList.toggle('eh-vicino', n <= 7);
        if (v === 'a') {
          const corta = giorno.toLocaleDateString(lingua, { day: 'numeric', month: 'long' });
          metti('.eh-giorni', n > 1 ? (en ? `${n} days to go` : `Mancano ${n} giorni`) : n === 1 ? (en ? 'Exam tomorrow' : 'L\'esame è domani') : (en ? 'Exam today' : 'L\'esame è oggi'));
          metti('.eh-materia', n > 1 ? (en ? `to the ${esame.titolo} exam, ${corta}` : `all'esame di ${esame.titolo}, ${corta}`) : esame.titolo);
        } else if (v === 'b') {
          metti('.eh-mese', giorno.toLocaleDateString(lingua, { month: 'short' }).replace('.', ''));
          metti('.eh-num', String(giorno.getDate()));
          metti('.eh-materia', esame.titolo);
          metti('.eh-giorni', n > 1 ? (en ? `in ${n} days` : `tra ${n} giorni`) : n === 1 ? (en ? 'tomorrow' : 'domani') : (en ? 'today' : 'oggi'));
        } else {
          metti('.eh-n', n > 0 ? String(n) : '');
          eh.querySelector('.eh-n').hidden = n === 0;
          metti('.eh-giorni', n > 1 ? (en ? 'days to the exam' : 'giorni all\'esame') : n === 1 ? (en ? 'day to the exam' : 'giorno all\'esame') : (en ? 'Exam today' : 'L\'esame è oggi'));
          metti('.eh-materia', en ? `of ${esame.titolo}` : `di ${esame.titolo}`);
          metti('.eh-data', data);
        }
        eh.hidden = false;
      }
    }
    if (ultima && ultima.titolo && ultima.argomento !== 'prove-d-esame') {
      const a = q('.ss-riprendi');
      a.href = `${pref}/${ultima.materia}/${ultima.argomento}/teoria`;
      a.querySelector('.ss-argomento').textContent = ultima.titolo;
      a.hidden = false;
    }
  })();
</script>
