---
import { materieL, materiaL, sezioniL, gruppiL, link, T, type Lingua, blocchiGruppo } from '../i18n';
import Stato from './Stato.astro';
import LezioniCarmine from './LezioniCarmine.astro';
import { VIDEOCORSI, chiaveVideo } from '../data/videocorsi';
import { catalogoDomande } from '../lib/domande';
import { RIPASSO, RIPASSO_OGGI } from '../data/livelli';
interface Props { materia?: string; argomento?: string; sezione?: string; lingua?: Lingua }
const { materia, argomento, sezione, lingua = 'it' } = Astro.props;
const t = T(lingua);
const m = materia ? materiaL(lingua, materia) : undefined;
const MATERIE = materieL(lingua);
const SEZIONI = sezioniL(lingua);
// Domande a tempo: voce in più sotto gli argomenti che ne hanno.
const conDomande = new Set(m ? (await catalogoDomande(lingua))[m.slug] ?? [] : []);
// Spunta accanto ai videocorsi acquistati: il Worker scrive su <html> data-materie anche le chiavi video-<slug>.
const regoleVideo = VIDEOCORSI.map((v) => `html[data-materie~="${chiaveVideo(v.slug)}"] [data-video="${v.slug}"] .stato-sbloccata{display:inline-flex}`).join('');
---
<nav class="indice" aria-label="Indice">
  <div class="indice-testa">
    <span>{t.indice}</span>
  </div>
  <form class="indice-cerca" role="search" action={link(lingua, '/cerca')} method="get">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
    <input type="search" name="q" aria-label={t.cerca} placeholder={lingua === 'en' ? 'Search a topic…' : 'Cerca un argomento…'} autocomplete="off" />
  </form>
  {lingua === 'it' && <LezioniCarmine dove="indice" />}
  {m ? (
    <>
      <p class="indice-materia">
        <a href={link(lingua, `/${m.slug}`)}>{m.titolo}</a>
        <a class="cambia-materia" href={link(lingua, '/')}>{t.altreMaterie}</a>
      </p>
      <ol>
        {m.argomenti.map((a) => {
          const corrente = a.slug === argomento;
          return (
            <li class:list={{ corrente }}>
              <button type="button" class="argomento" aria-expanded={corrente ? 'true' : 'false'} data-apri-argomento>{a.titolo}</button>
              <ol class:list={{ aperta: corrente }}>
                {SEZIONI.map((s) => (
                  <li><a href={link(lingua, `/${m.slug}/${a.slug}/${s.slug}`)} class:list={{ attiva: corrente && s.slug === sezione }}>{s.titolo}</a></li>
                ))}
                {conDomande.has(a.slug) && (
                  <li><a href={link(lingua, `/${m.slug}/${a.slug}/domande`)} class:list={{ attiva: corrente && sezione === 'domande' }}>{lingua === 'en' ? 'Timed questions' : 'Domande a tempo'}</a></li>
                )}
              </ol>
            </li>
          );
        })}
        {conDomande.size > 0 && (
          <li class:list={{ corrente: argomento === RIPASSO || argomento === RIPASSO_OGGI || sezione === 'simulazione' }}>
            <button type="button" class="argomento" aria-expanded={argomento === RIPASSO || argomento === RIPASSO_OGGI || sezione === 'simulazione' ? 'true' : 'false'} data-apri-argomento>{lingua === 'en' ? 'Exam practice' : 'Prove d\'esame'}</button>
            <ol class:list={{ aperta: argomento === RIPASSO || argomento === RIPASSO_OGGI || sezione === 'simulazione' }}>
              <li><a href={link(lingua, `/${m.slug}/${RIPASSO}/domande`)} class:list={{ attiva: argomento === RIPASSO }}>{lingua === 'en' ? 'Review questions' : 'Domande di ripasso'}</a></li>
              <li><a href={link(lingua, `/${m.slug}/simulazione`)} class:list={{ attiva: sezione === 'simulazione' }}>{lingua === 'en' ? 'Exam simulation' : m.gruppo === 'Concorsi' ? 'Simulazione della prova' : 'Simulazione d\'esame'}</a></li>
              <li class="solo-collegati"><a href={link(lingua, `/${m.slug}/${RIPASSO_OGGI}/domande`)} class:list={{ attiva: argomento === RIPASSO_OGGI }}>{lingua === 'en' ? 'Today’s review' : 'Ripasso di oggi'}</a></li>
            </ol>
          </li>
        )}
      </ol>
    </>
  ) : (
    <>
      {gruppiL(lingua).map((g, i) => (
        <details class="indice-gruppo" open={i === 0}>
          <summary class="indice-materia"><span>{g}</span></summary>
          {lingua === 'it' && g === 'Concorsi' && (
            <ol class="indice-materie">
              <li style="--colore-materia: #6d5a8a">
                <a class="voce-materia" href="/concorsi">
                  <span class="materia-punto" aria-hidden="true" />
                  <span class="materia-testo"><span class="materia-nome">Che cosa studiare</span></span>
                  <small class="materia-prossima">guida gratuita</small>
                </a>
              </li>
            </ol>
          )}
          {(() => {
            const lista = (voci: { m: (typeof MATERIE)[number]; nome: string }[]) => (
              <ol class="indice-materie">
                {voci.map(({ m: x, nome }) => {
                  const dentro = (
                    <>
                      <span class="materia-punto" aria-hidden="true" />
                      <span class="materia-testo">
                        <span class="materia-nome">{nome}</span>
                      </span>
                      {x.attiva ? <Stato prezzo={x.prezzo} compatto lingua={lingua} /> : <small class="materia-prossima">{t.inPreparazione}</small>}
                    </>
                  );
                  return (
                    <li data-materia={x.slug} style={`--colore-materia: ${x.colore}`}>
                      {x.attiva ? <a class="voce-materia" href={link(lingua, `/${x.slug}`)}>{dentro}</a> : <span class="voce-materia in-preparazione">{dentro}</span>}
                    </li>
                  );
                })}
              </ol>
            );
            return blocchiGruppo(MATERIE, g).map((b) => b.sotto ? (
              <details class="indice-sottogruppo">
                <summary>{b.sotto}</summary>
                {lista(b.materie)}
              </details>
            ) : lista(b.materie));
          })()}
        </details>
      ))}
      {lingua === 'it' && (
        <details class="indice-gruppo">
          <summary class="indice-materia"><span>Videocorsi</span></summary>
          <style is:inline set:html={regoleVideo}></style>
          <ol class="indice-materie indice-video">
            {VIDEOCORSI.map((v) => (
              <li data-video={v.slug} style="--colore-materia: var(--video)">
                <a class="voce-materia" href={`/videocorsi/${v.slug}`}>
                  <span class="video-punto" aria-hidden="true">▶</span>
                  <span class="materia-testo"><span class="materia-nome">{v.titolo.replace(/^Videocorso di /, '')}</span></span>
                  <span class="stato compatto"><span class="stato-sbloccata"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </>
  )}
  <p class="indice-contatti"><a href={link(lingua, '/contatti')}>{t.contatti}</a></p>
</nav>
<script>
  // Un tocco sul nome dell'argomento apre le sue tre sezioni, un secondo tocco le richiude.
  document.querySelectorAll<HTMLButtonElement>('[data-apri-argomento]').forEach((b) => {
    b.addEventListener('click', () => {
      const ol = b.nextElementSibling as HTMLElement;
      const aperto = ol.classList.toggle('aperta');
      b.setAttribute('aria-expanded', String(aperto));
    });
  });
</script>
