---
import { materieL, materiaL, sezioniL, gruppiL, link, T, type Lingua } from '../i18n';
import Stato from './Stato.astro';
interface Props { materia?: string; argomento?: string; sezione?: string; lingua?: Lingua }
const { materia, argomento, sezione, lingua = 'it' } = Astro.props;
const t = T(lingua);
const m = materia ? materiaL(lingua, materia) : undefined;
const MATERIE = materieL(lingua);
const SEZIONI = sezioniL(lingua);
---
<nav class="indice" aria-label="Indice">
  {m ? (
    <>
      <p class="indice-materia">
        <a href={link(lingua, `/${m.slug}`)}>{m.titolo}</a>
        <a class="cambia-materia" href={link(lingua, '/')}>{t.altreMaterie}</a>
      </p>
      <ol>
        {m.argomenti.map((a) => {
          const corrente = a.slug === argomento;
          return (
            <li class:list={{ corrente }}>
              <button type="button" class="argomento" aria-expanded={corrente ? 'true' : 'false'} data-apri-argomento>{a.titolo}</button>
              <ol class:list={{ aperta: corrente }}>
                {SEZIONI.map((s) => (
                  <li><a href={link(lingua, `/${m.slug}/${a.slug}/${s.slug}`)} class:list={{ attiva: corrente && s.slug === sezione }}>{s.titolo}</a></li>
                ))}
              </ol>
            </li>
          );
        })}
      </ol>
    </>
  ) : (
    <>
      {gruppiL(lingua).map((g) => (
        <>
          <p class="indice-materia"><span>{g}</span></p>
          <ol>
            {MATERIE.filter((x) => x.gruppo === g).map((x) => (
              <li data-materia={x.slug}>{x.attiva ? <a class="argomento" href={link(lingua, `/${x.slug}`)}>{x.titolo}<Stato prezzo={x.prezzo} compatto lingua={lingua} /></a> : <span class="argomento in-preparazione">{x.titolo} <small>{t.inPreparazione}</small></span>}</li>
            ))}
          </ol>
        </>
      ))}
    </>
  )}
  <p class="indice-contatti"><a href={link(lingua, '/contatti')}>{t.contatti}</a></p>
</nav>
<script>
  // Un tocco sul nome dell'argomento apre le sue tre sezioni, un secondo tocco le richiude.
  document.querySelectorAll<HTMLButtonElement>('[data-apri-argomento]').forEach((b) => {
    b.addEventListener('click', () => {
      const ol = b.nextElementSibling as HTMLElement;
      const aperto = ol.classList.toggle('aperta');
      b.setAttribute('aria-expanded', String(aperto));
    });
  });
</script>
