---
import { materieL, materiaL, sezioniL, gruppiL, link, T, type Lingua, blocchiGruppo } from '../i18n';
import { GRUPPI_DE } from '../data/materie-de';
import { GRUPPI_ES } from '../data/materie-es';
import { GRUPPI_FR } from '../data/materie-fr';
import { linguaCatalogo, paginaLocalizzata } from '../lib/lingue-sito';
import Stato from './Stato.astro';
import { url } from '../lib/url';
import { blocchiUsa, gruppiUsa, materieUsa, materiaUsa, linkArgomentoUsa } from '../data/stem-usa/catalog-view';
import { courseUrl } from '../data/stem-usa/catalog.mjs';
import { highSchoolName, highSchoolPath, highSchoolCourse, highSchoolHasStudyPages } from '../data/stem-usa/high-school/index.mjs';
import LezioniCarmine from './LezioniCarmine.astro';
import PercorsoIndice from './PercorsoIndice.astro';
import { VIDEOCORSI, chiaveVideo } from '../data/videocorsi';
import { catalogoDomande } from '../lib/domande';
import { calculusSlug } from '../lib/stem-usa-practice';
import { usTimedTopics } from '../lib/stem-usa-banks';
import { RIPASSO, RIPASSO_OGGI } from '../data/livelli';
import { nomiAllenamento } from '../lib/allenamento.mjs';
interface Props { materia?: string; argomento?: string; sezione?: string; lingua?: Lingua; usa?: boolean; ricercaPrincipale?: boolean }
const { materia, argomento, sezione, lingua = 'it', usa = false } = Astro.props;
const t = T(lingua);
const qui = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const m = materia ? (usa ? materiaUsa(materia) : materiaL(lingua, materia)) : undefined;
const de = lingua === 'de';
const es = lingua === 'es';
const fr = lingua === 'fr';
const localizzato = linguaCatalogo(lingua);
const MATERIE = usa ? materieUsa : materieL(lingua).filter((x) => !localizzato || !x.attiva || paginaLocalizzata(lingua, `/${x.slug}`));
const home = usa ? url('/us') : link(lingua, '/');
const hrefMateria = (slug: string) => usa ? url(courseUrl(slug)) : link(lingua, '/' + slug);
const hrefArgomento = (slug: string, arg: string, sez: string) => usa ? linkArgomentoUsa(slug, arg, sez) : link(lingua, '/' + slug + '/' + arg + '/' + sez);
const SEZIONI = sezioniL(lingua).filter((s) => m?.eserciziDaFare !== false || s.slug !== 'esercizi');
const nomiProve = nomiAllenamento(m, lingua);
const simulazioneUsa = usa && highSchoolHasStudyPages(highSchoolCourse(m?.slug));
const ripassoCorrente = argomento === RIPASSO || argomento === RIPASSO_OGGI || sezione === 'simulazione';
// Domande a tempo: voce in più sotto gli argomenti che ne hanno.
const conDomande = new Set(m ? (usa ? usTimedTopics[m.slug] ?? [] : (await catalogoDomande(lingua))[m.slug] ?? []) : []);
// Spunta accanto ai videocorsi acquistati: il Worker scrive su <html> data-materie anche le chiavi video-<slug>.
const regoleVideo = VIDEOCORSI.map((v) => `html[data-materie~="${chiaveVideo(v.slug)}"] [data-video="${v.slug}"] .stato-sbloccata{display:inline-flex}`).join('');
---
<nav class="indice" aria-label={t.indice}>
  <div class="indice-testa">
    <span>{t.indice}</span>
  </div>
  <form class="indice-cerca" role="search" action={usa ? url('/us') : link(lingua, '/cerca')} data-us-search={usa || undefined} method="get">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
    <input type="search" name="q" aria-label={t.cerca} placeholder={fr ? 'Rechercher un chapitre…' : es ? 'Buscar un tema…' : de ? 'Thema suchen …' : lingua === 'en' ? 'Search a topic…' : 'Cerca un argomento…'} autocomplete="off" />
  </form>
  {lingua === 'it' && <LezioniCarmine dove="indice" />}
  {/* «Compatibilità con il tuo esame» (versione B scelta da Carmine il 04/11) */}
  {lingua === 'it' && (
    <div class="lezioni-indice">
      <p class="indice-materia"><span>Il tuo esame</span></p>
      <ol class="indice-materie">
        <li style="--colore-materia: var(--accento)">
          <a class="voce-materia" href="/compatibilita">
            <span class="lezioni-icona" set:html={'<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5h5.5l3.5 3.5v11.5H6A1.5 1.5 0 0 1 4.5 16V4A1.5 1.5 0 0 1 6 2.5Z"/><path d="M11.5 2.5V6H15"/><path d="m7.6 11.6 1.8 1.8 3.4-3.4"/></svg>'} />
            <span class="materia-testo"><span class="materia-nome">Il sito copre il tuo esame?</span><small class="lezioni-sotto">Carica il compito o il programma</small></span>
          </a>
        </li>
      </ol>
    </div>
  )}
  {lingua === 'it' && (
    <a class="indice-pacchetti" href="/pacchetti" data-sconto-bronzo aria-current={qui === '/pacchetti' ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h8l10 10-7 7L3 10V4Z"/><circle cx="7.5" cy="8" r="1"/></svg>
      <span data-luccichio-bronzo>Pacchetti e sconti</span>
    </a>
  )}
  {localizzato && <div class="lezioni-indice">
    <p class="indice-materia"><span>{fr ? 'Cours et préparation aux examens' : es ? 'Clases y preparación de exámenes' : 'Unterricht und Prüfungsvorbereitung'}</span></p>
    <ol class="indice-materie">
      <li><a class="voce-materia" href="/prenota?lingua=it" hreflang="it">{fr ? 'Cours particuliers (en italien)' : es ? 'Clases individuales (en italiano)' : 'Einzelunterricht (Italienisch)'}</a></li>
      <li><a class="voce-materia" href="/corsi-di-gruppo?lingua=it" hreflang="it">{fr ? 'Cours en groupe (en italien)' : es ? 'Clases en grupo (en italiano)' : 'Gruppenkurse (Italienisch)'}</a></li>
      <li><a class="voce-materia" href="/compatibilita?lingua=it" hreflang="it">{fr ? 'Vérifier les chapitres couverts pour ton examen (en italien)' : es ? 'Comprobar el temario de tu examen (en italiano)' : 'Prüfungsstoff abgleichen (Italienisch)'}</a></li>
      <li><a class="voce-materia" href="/videocorsi?lingua=it" hreflang="it">{fr ? 'Cours en vidéo (en italien)' : es ? 'Videocursos (en italiano)' : 'Videokurse (Italienisch)'}</a></li>
      <li><a class="voce-materia" href="/pacchetti?lingua=it" hreflang="it">{fr ? 'Offres groupées et réductions (en italien)' : es ? 'Paquetes y descuentos (en italiano)' : 'Pakete und Rabatte (Italienisch)'}</a></li>
    </ol>
  </div>}
  {m && localizzato ? (
    <>
      <p class="indice-materia indice-materia-corrente"><a href={link(lingua, `/${m.slug}`)}>{m.titolo}</a><a class="cambia-materia" href={link(lingua, '/')}>{fr ? 'Toutes les matières' : es ? 'Todas las asignaturas' : 'Alle Fächer'}</a></p>
      <ol class="indice-materie">
        {m.argomenti.map((a) => <li><a class="voce-materia" href={link(lingua, `/${m.slug}#${a.slug}`)}>{a.titolo}</a></li>)}
      </ol>
    </>
  ) : m ? (
    <>
      <p class="indice-materia indice-materia-corrente">
        <a href={hrefMateria(m.slug)}>{m.titolo}</a>
        <a class="cambia-materia" href={home}>{lingua === 'en' ? 'All subjects' : 'Tutte le materie'}</a>
      </p>
      <ol data-usa-course-nav={usa || undefined}>
        {m.argomenti.map((a) => {
          const corrente = a.slug === argomento;
          return (
            <li class:list={{ corrente }}>
              <button type="button" class="argomento" aria-expanded={corrente ? 'true' : 'false'} data-apri-argomento>{a.titolo}</button>
              <ol class:list={{ aperta: corrente }}>
                {SEZIONI.map((s) => (
                  <li><a href={hrefArgomento(m.slug, a.slug, s.slug)} class:list={{ attiva: corrente && s.slug === sezione }} aria-current={corrente && s.slug === sezione ? 'page' : undefined}>{s.titolo}</a></li>
                ))}
                {conDomande.has(a.slug) && (
                  <li><a href={hrefArgomento(m.slug, a.slug, 'domande')} class:list={{ attiva: corrente && sezione === 'domande' }}>{lingua === 'en' ? 'Timed questions' : 'Domande a tempo'}</a></li>
                )}
              </ol>
            </li>
          );
        })}
        {usa && !simulazioneUsa && (
          <li>
            <button type="button" class="argomento" aria-expanded="false" data-apri-argomento>Exam practice</button>
            <ol>
              {!m.slug.startsWith('hs-') && <li><a href={url(courseUrl(m.slug) + '#course-practice')}>Review questions</a></li>}
              {conDomande.size > 0 && <>
                <li><a href={hrefArgomento(m.slug, RIPASSO, 'domande')}>Timed review</a></li>
                <li class="solo-collegati"><a href={hrefArgomento(m.slug, RIPASSO_OGGI, 'domande')}>Today’s review</a></li>
              </>}
              {m.slug === calculusSlug && <>
                <li><a href={url('/us/calculus-1/practice-exam')}>General practice exam</a></li>
                <li><a href={url('/us/calculus-1/purdue')}>Purdue exam practice</a></li>
              </>}
            </ol>
          </li>
        )}
        {(!usa || simulazioneUsa) && conDomande.size > 0 && (
          <li class:list={{ corrente: ripassoCorrente }}>
            <button type="button" class="argomento" aria-expanded={ripassoCorrente ? 'true' : 'false'} data-apri-argomento>{nomiProve.ripasso}</button>
            <ol class:list={{ aperta: ripassoCorrente }}>
              <li><a href={hrefArgomento(m.slug, RIPASSO, 'domande')} class:list={{ attiva: argomento === RIPASSO }}>{lingua === 'en' ? 'Review questions' : 'Domande di ripasso'}</a></li>
              {m.eserciziDaFare !== false && <li><a href={usa ? url(courseUrl(m.slug) + '/simulazione') : link(lingua, `/${m.slug}/simulazione`)} class:list={{ attiva: sezione === 'simulazione' }}>{nomiProve.simulazione}</a></li>}
              <li class="solo-collegati" data-usa-content={simulazioneUsa || undefined}><a href={hrefArgomento(m.slug, RIPASSO_OGGI, 'domande')} class:list={{ attiva: argomento === RIPASSO_OGGI }}>{lingua === 'en' ? 'Today’s review' : 'Ripasso di oggi'}</a></li>
            </ol>
          </li>
        )}
      </ol>
    </>
  ) : (
    <>
      <p class="indice-percorsi-titolo">{fr ? 'Choisis ton parcours' : es ? 'Elige tu itinerario' : de ? 'Wähle deinen Lernbereich' : lingua === 'en' ? 'Choose your study path' : 'Scegli il tuo percorso'}</p>
      {(usa ? gruppiUsa : gruppiL(lingua)).map((g) => (
        <details class:list={['indice-gruppo', { 'indice-percorsi-studio': ['Università', 'University', 'Superiori', 'High school', GRUPPI_DE['Università'], GRUPPI_DE.Superiori, GRUPPI_ES.Università, GRUPPI_ES.Superiori, GRUPPI_FR.Università, GRUPPI_FR.Superiori].includes(g) }]}>
          <summary class="indice-materia indice-percorso"><PercorsoIndice lingua={lingua} gruppo={g} /></summary>
          {usa && g === highSchoolName && <p><a href={url(highSchoolPath)}>High school catalog</a></p>}
          {lingua === 'it' && g === 'Concorsi' && (
            <ol class="indice-materie">
              <li style="--colore-materia: #6d5a8a">
                <a class="voce-materia" href="/concorsi" aria-current={qui === '/concorsi' ? 'page' : undefined}>
                  <span class="materia-testo"><span class="materia-nome">Che cosa studiare</span></span>
                  <small class="materia-prossima">guida gratuita</small>
                </a>
              </li>
            </ol>
          )}
          {(() => {
            const lista = (voci: { m: (typeof MATERIE)[number]; nome: string }[]) => (
              <ol class="indice-materie">
                {voci.map(({ m: x, nome }) => {
                  const dentro = (
                    <>
                      <span class="materia-testo">
                        <span class="materia-nome">{nome}</span>
                      </span>
                      {x.attiva ? <Stato prezzo={x.prezzo} compatto lingua={lingua} /> : <small class="materia-prossima">{t.inPreparazione}</small>}
                    </>
                  );
                  return (
                    <li data-materia={x.slug} style={`--colore-materia: ${x.colore}`}>
                      {x.attiva ? <a class="voce-materia" href={hrefMateria(x.slug)} aria-current={qui === hrefMateria(x.slug) ? 'page' : undefined}>{dentro}</a> : <span class="voce-materia in-preparazione">{dentro}</span>}
                    </li>
                  );
                })}
              </ol>
            );
            return (usa ? blocchiUsa.filter(block => block.gruppo === g) : blocchiGruppo(MATERIE, g)).map((b) => b.sotto ? (
              <details class="indice-sottogruppo">
                <summary>{b.sotto}</summary>
                {lista(b.materie)}
              </details>
            ) : lista(b.materie));
          })()}
        </details>
      ))}
      {lingua === 'it' && (
        <details class="indice-gruppo">
          <summary class="indice-materia indice-percorso"><PercorsoIndice lingua={lingua} gruppo="Videocorsi" /></summary>
          <style is:inline set:html={regoleVideo}></style>
          <ol class="indice-materie indice-video">
            {VIDEOCORSI.map((v) => (
              <li data-video={v.slug} style="--colore-materia: var(--video)">
                <a class="voce-materia" href={`/videocorsi/${v.slug}`} aria-current={qui === `/videocorsi/${v.slug}` ? 'page' : undefined}>
                  <span class="materia-testo"><span class="materia-nome">{v.titolo.replace(/^Videocorso di /, '')}</span></span>
                  <span class="stato compatto"><span class="stato-sbloccata"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </>
  )}
  <p class="indice-contatti"><a href={link(lingua, '/contatti')}>{t.contatti}</a></p>
</nav>
<script>
  // Un tocco sul nome dell'argomento apre le sue tre sezioni, un secondo tocco le richiude.
  document.querySelectorAll<HTMLButtonElement>('[data-apri-argomento]').forEach((b) => {
    b.addEventListener('click', () => {
      const ol = b.nextElementSibling as HTMLElement;
      const aperto = ol.classList.toggle('aperta');
      b.setAttribute('aria-expanded', String(aperto));
    });
  });
</script>

<style>
  .indice-materia-corrente { flex-direction: column; align-items: flex-start; gap: 0.2rem; text-wrap: balance; }
  .indice-pacchetti { display: flex; align-items: center; gap: 0.55rem; min-height: 2.75rem; margin: 0.75rem 0 1rem; padding: 0.55rem 0.65rem; border: 1px solid var(--bronzo-bordo); border-radius: var(--raggio); color: var(--bronzo); background: var(--bronzo-fondo); font: 600 0.9rem/1.35 var(--ui); text-decoration: none; }
  .indice-pacchetti svg { flex: none; width: 1.1rem; height: 1.1rem; }
  .indice-pacchetti:hover { color: #654626; border-color: #c9ac89; background: #ede1d1; }
  .indice-pacchetti[aria-current="page"] { box-shadow: inset 3px 0 var(--bronzo); }
  .indice-percorsi-titolo { margin: 1.1rem 0.5rem 0.65rem; color: var(--verde); font: 600 0.78rem/1.35 var(--ui); }
  details.indice-gruppo > summary.indice-percorso { align-items: center; gap: 0.5rem; min-width: 0; min-height: 3.1rem; margin: 0 0 0.35rem; padding: 0.5rem 0.6rem; border: 1px solid transparent; border-radius: 7px; background: transparent; color: var(--inchiostro); letter-spacing: 0; text-transform: none; transition: background 150ms ease, border-color 150ms ease; }
  details.indice-gruppo > summary.indice-percorso::before { display: none; }
  .indice-percorsi-studio > .indice-sottogruppo > .indice-materie {
    margin: 0.1rem 0 0.25rem 0.55rem;
    padding-left: 0.2rem;
    border-left: 1px solid var(--riga);
  }
  @media (pointer: fine) {
    .indice-percorsi-studio > .indice-sottogruppo > summary,
    .indice-percorsi-studio > .indice-sottogruppo .voce-materia { min-height: 2.25rem; }
  }
  details.indice-gruppo > summary.indice-percorso:hover, details.indice-gruppo > summary.indice-percorso:focus-visible, details.indice-gruppo[open] > summary.indice-percorso { border-color: transparent; background: var(--fondo-percorso); box-shadow: inset 3px 0 var(--azione); }
  @media (prefers-reduced-motion: reduce) {
    details.indice-gruppo > summary.indice-percorso { transition: none; }
  }
  a:focus-visible,summary:focus-visible{outline:2px solid var(--accento);outline-offset:3px}
</style>
