---
import { materieL, materiaL, sezioniL, gruppiL, link, T, type Lingua, blocchiGruppo } from '../i18n';
import Stato from './Stato.astro';
import LezioniCarmine from './LezioniCarmine.astro';
import PercorsoIndice from './PercorsoIndice.astro';
import { VIDEOCORSI, chiaveVideo } from '../data/videocorsi';
import { catalogoDomande } from '../lib/domande';
import { RIPASSO, RIPASSO_OGGI } from '../data/livelli';
import { nomiAllenamento } from '../lib/allenamento.mjs';
interface Props { materia?: string; argomento?: string; sezione?: string; lingua?: Lingua; ricercaPrincipale?: boolean }
const { materia, argomento, sezione, lingua = 'it' } = Astro.props;
const t = T(lingua);
const qui = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const m = materia ? materiaL(lingua, materia) : undefined;
const MATERIE = materieL(lingua);
const SEZIONI = sezioniL(lingua);
const nomiProve = nomiAllenamento(m, lingua);
// Domande a tempo: voce in più sotto gli argomenti che ne hanno.
const conDomande = new Set(m ? (await catalogoDomande(lingua))[m.slug] ?? [] : []);
// Spunta accanto ai videocorsi acquistati: il Worker scrive su <html> data-materie anche le chiavi video-<slug>.
const regoleVideo = VIDEOCORSI.map((v) => `html[data-materie~="${chiaveVideo(v.slug)}"] [data-video="${v.slug}"] .stato-sbloccata{display:inline-flex}`).join('');
---
<nav class="indice" aria-label="Indice">
  <div class="indice-testa">
    <span>{t.indice}</span>
  </div>
  <form class="indice-cerca" role="search" action={link(lingua, '/cerca')} method="get">
    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l4 4"/></svg>
    <input type="search" name="q" aria-label={t.cerca} placeholder={lingua === 'en' ? 'Search a topic…' : 'Cerca un argomento…'} autocomplete="off" />
  </form>
  {lingua === 'it' && <LezioniCarmine dove="indice" />}
  {/* «Compatibilità con il tuo esame» (versione B scelta da Carmine il 04/11) */}
  {lingua === 'it' && (
    <div class="lezioni-indice">
      <p class="indice-materia"><span>Il tuo esame</span></p>
      <ol class="indice-materie">
        <li style="--colore-materia: var(--accento)">
          <a class="voce-materia" href="/compatibilita">
            <span class="lezioni-icona" set:html={'<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2.5h5.5l3.5 3.5v11.5H6A1.5 1.5 0 0 1 4.5 16V4A1.5 1.5 0 0 1 6 2.5Z"/><path d="M11.5 2.5V6H15"/><path d="m7.6 11.6 1.8 1.8 3.4-3.4"/></svg>'} />
            <span class="materia-testo"><span class="materia-nome">Il sito copre il tuo esame?</span><small class="lezioni-sotto">Carica il compito e scoprilo</small></span>
          </a>
        </li>
      </ol>
    </div>
  )}
  {lingua === 'it' && (
    <a class="indice-pacchetti" href="/pacchetti" aria-current={qui === '/pacchetti' ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h8l10 10-7 7L3 10V4Z"/><circle cx="7.5" cy="8" r="1"/></svg>
      <span>Pacchetti e sconti</span>
    </a>
  )}
  {m ? (
    <>
      <p class="indice-materia">
        <a href={link(lingua, `/${m.slug}`)}>{m.titolo}</a>
        <a class="cambia-materia" href={link(lingua, '/')}>{lingua === 'en' ? 'All subjects' : 'Tutte le materie'}</a>
      </p>
      <ol>
        {m.argomenti.map((a) => {
          const corrente = a.slug === argomento;
          return (
            <li class:list={{ corrente }}>
              <button type="button" class="argomento" aria-expanded={corrente ? 'true' : 'false'} data-apri-argomento>{a.titolo}</button>
              <ol class:list={{ aperta: corrente }}>
                {SEZIONI.map((s) => (
                  <li><a href={link(lingua, `/${m.slug}/${a.slug}/${s.slug}`)} class:list={{ attiva: corrente && s.slug === sezione }} aria-current={corrente && s.slug === sezione ? 'page' : undefined}>{s.titolo}</a></li>
                ))}
                {conDomande.has(a.slug) && (
                  <li><a href={link(lingua, `/${m.slug}/${a.slug}/domande`)} class:list={{ attiva: corrente && sezione === 'domande' }}>{lingua === 'en' ? 'Timed questions' : 'Domande a tempo'}</a></li>
                )}
              </ol>
            </li>
          );
        })}
        {conDomande.size > 0 && (
          <li class:list={{ corrente: argomento === RIPASSO || argomento === RIPASSO_OGGI || sezione === 'simulazione' }}>
            <button type="button" class="argomento" aria-expanded={argomento === RIPASSO || argomento === RIPASSO_OGGI || sezione === 'simulazione' ? 'true' : 'false'} data-apri-argomento>{nomiProve.ripasso}</button>
            <ol class:list={{ aperta: argomento === RIPASSO || argomento === RIPASSO_OGGI || sezione === 'simulazione' }}>
              <li><a href={link(lingua, `/${m.slug}/${RIPASSO}/domande`)} class:list={{ attiva: argomento === RIPASSO }}>{lingua === 'en' ? 'Review questions' : 'Domande di ripasso'}</a></li>
              <li><a href={link(lingua, `/${m.slug}/simulazione`)} class:list={{ attiva: sezione === 'simulazione' }}>{nomiProve.simulazione}</a></li>
              <li class="solo-collegati"><a href={link(lingua, `/${m.slug}/${RIPASSO_OGGI}/domande`)} class:list={{ attiva: argomento === RIPASSO_OGGI }}>{lingua === 'en' ? 'Today’s review' : 'Ripasso di oggi'}</a></li>
            </ol>
          </li>
        )}
      </ol>
    </>
  ) : (
    <>
      <p class="indice-percorsi-titolo">{lingua === 'en' ? 'Choose your study path' : 'Scegli il tuo percorso'}</p>
      {gruppiL(lingua).map((g) => (
        <details class="indice-gruppo">
          <summary class="indice-materia indice-percorso"><PercorsoIndice lingua={lingua} gruppo={g} /></summary>
          {lingua === 'it' && g === 'Concorsi' && (
            <ol class="indice-materie">
              <li style="--colore-materia: #6d5a8a">
                <a class="voce-materia" href="/concorsi" aria-current={qui === '/concorsi' ? 'page' : undefined}>
                  <span class="materia-testo"><span class="materia-nome">Che cosa studiare</span></span>
                  <small class="materia-prossima">guida gratuita</small>
                </a>
              </li>
            </ol>
          )}
          {(() => {
            const lista = (voci: { m: (typeof MATERIE)[number]; nome: string }[]) => (
              <ol class="indice-materie">
                {voci.map(({ m: x, nome }) => {
                  const dentro = (
                    <>
                      <span class="materia-testo">
                        <span class="materia-nome">{nome}</span>
                      </span>
                      {x.attiva ? <Stato prezzo={x.prezzo} compatto lingua={lingua} /> : <small class="materia-prossima">{t.inPreparazione}</small>}
                    </>
                  );
                  return (
                    <li data-materia={x.slug} style={`--colore-materia: ${x.colore}`}>
                      {x.attiva ? <a class="voce-materia" href={link(lingua, `/${x.slug}`)} aria-current={qui === link(lingua, `/${x.slug}`) ? 'page' : undefined}>{dentro}</a> : <span class="voce-materia in-preparazione">{dentro}</span>}
                    </li>
                  );
                })}
              </ol>
            );
            return blocchiGruppo(MATERIE, g).map((b) => b.sotto ? (
              <details class="indice-sottogruppo">
                <summary>{b.sotto}</summary>
                {lista(b.materie)}
              </details>
            ) : lista(b.materie));
          })()}
        </details>
      ))}
      {lingua === 'it' && (
        <details class="indice-gruppo">
          <summary class="indice-materia indice-percorso"><PercorsoIndice lingua={lingua} gruppo="Videocorsi" /></summary>
          <style is:inline set:html={regoleVideo}></style>
          <ol class="indice-materie indice-video">
            {VIDEOCORSI.map((v) => (
              <li data-video={v.slug} style="--colore-materia: var(--video)">
                <a class="voce-materia" href={`/videocorsi/${v.slug}`} aria-current={qui === `/videocorsi/${v.slug}` ? 'page' : undefined}>
                  <span class="materia-testo"><span class="materia-nome">{v.titolo.replace(/^Videocorso di /, '')}</span></span>
                  <span class="stato compatto"><span class="stato-sbloccata"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      )}
    </>
  )}
  <p class="indice-contatti"><a href={link(lingua, '/contatti')}>{t.contatti}</a></p>
</nav>
<script>
  // Un tocco sul nome dell'argomento apre le sue tre sezioni, un secondo tocco le richiude.
  document.querySelectorAll<HTMLButtonElement>('[data-apri-argomento]').forEach((b) => {
    b.addEventListener('click', () => {
      const ol = b.nextElementSibling as HTMLElement;
      const aperto = ol.classList.toggle('aperta');
      b.setAttribute('aria-expanded', String(aperto));
    });
  });
</script>

<style>
  .indice-pacchetti { display: flex; align-items: center; gap: 0.55rem; min-height: 2.75rem; margin: 0.75rem 0 1rem; padding: 0.55rem 0.65rem; border: 1px solid var(--riga); border-radius: var(--raggio); color: var(--verde); background: color-mix(in srgb, var(--verde) 5%, var(--carta)); font: 600 0.9rem/1.35 var(--ui); text-decoration: none; }
  .indice-pacchetti svg { flex: none; width: 1.1rem; height: 1.1rem; }
  .indice-pacchetti:hover, .indice-pacchetti[aria-current="page"] { border-color: var(--verde); background: color-mix(in srgb, var(--verde) 9%, var(--carta)); }
  .indice-percorsi-titolo { margin: 1.1rem 0.5rem 0.65rem; color: var(--verde); font: 600 0.78rem/1.35 var(--ui); }
  details.indice-gruppo > summary.indice-percorso { align-items: center; gap: 0.5rem; min-width: 0; min-height: 3.1rem; margin: 0 0 0.35rem; padding: 0.4rem 0.6rem; border: 1px solid var(--riga); border-radius: 7px; background: color-mix(in srgb, var(--carta) 55%, white); color: var(--inchiostro); letter-spacing: 0; text-transform: none; transition: background 150ms ease, border-color 150ms ease; }
  details.indice-gruppo > summary.indice-percorso::before { display: none; }
  details.indice-gruppo > summary.indice-percorso:hover, details.indice-gruppo > summary.indice-percorso:focus-visible, details.indice-gruppo[open] > summary.indice-percorso { border-color: var(--verde); background: color-mix(in srgb, var(--verde) 8%, var(--carta)); }
  @media (prefers-reduced-motion: reduce) { details.indice-gruppo > summary.indice-percorso { transition: none; } }
  a:focus-visible,summary:focus-visible{outline:2px solid var(--accento);outline-offset:3px}
</style>
