---
import '../styles/orientamento.css';
---
<section class="orientamento ori-account" id="orientamento" data-orientamento-salvati data-orientamento-gm hidden aria-labelledby="orientamento-account-titolo">
  <div class="ori-testata-sezione"><h2 id="orientamento-account-titolo">Il tuo orientamento</h2><a href="/orientamento">Scegli un test <span aria-hidden="true">→</span></a></div>
  <p class="ori-nota" data-ori-salvati-stato role="status">Caricamento dei risultati…</p>
  <ul class="ori-lista-salvati" data-ori-salvati-lista></ul>
  <button type="button" class="ori-testo-bottone" data-ori-salvati-riprova hidden>Riprova</button>
</section>
