---
interface Props {
  capitoli: { titolo: string; teoria: string; svolti?: string }[];
  en: boolean;
  materia: string;
  descrizione: string;
}
const { capitoli, en, materia, descrizione } = Astro.props;
---
<dialog class="pm-dlg anteprima-capitoli" id="anteprima-capitoli" aria-labelledby="anteprima-titolo">
  <div class="pm-dlg-testa">
    <h2 id="anteprima-titolo">{en ? 'Free preview' : 'Anteprima gratuita'}</h2>
    <form method="dialog"><button class="pm-dlg-x" aria-label={en ? 'Close' : 'Chiudi'}>×</button></form>
  </div>
  <p>{descrizione}</p>
  <label for="anteprima-scelta">{en ? 'Choose a chapter' : 'Scegli un capitolo'}</label>
  <select id="anteprima-scelta">
    {capitoli.map((c, i) => <option value={c.teoria} data-svolti={c.svolti}>{String(i + 1).padStart(2, '0')} · {c.titolo}</option>)}
  </select>
  <div class="anteprima-azioni">
    <a class="anteprima-teoria" href={capitoli[0].teoria} data-ap={materia}>{en ? 'Read the theory' : 'Leggi la teoria'}</a>
    <a class="anteprima-svolti" hidden={!capitoli[0].svolti} href={capitoli[0].svolti} data-ap={materia}>{en ? 'Open worked examples' : 'Apri gli esercizi svolti'}</a>
  </div>
</dialog>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('#anteprima-capitoli');
  const scelta = dialogo?.querySelector('select');
  if (dialogo && scelta && typeof dialogo.showModal === 'function') {
    const teoria = dialogo.querySelector<HTMLAnchorElement>('.anteprima-teoria')!;
    const svolti = dialogo.querySelector<HTMLAnchorElement>('.anteprima-svolti')!;
    const aggiorna = () => {
      const capitolo = scelta.selectedOptions[0];
      teoria.href = capitolo.value;
      svolti.hidden = !capitolo.dataset.svolti;
      if (capitolo.dataset.svolti) svolti.href = capitolo.dataset.svolti;
      else svolti.removeAttribute('href');
    };
    scelta.addEventListener('change', aggiorna);
    document.querySelector('[data-apri-capitoli]')?.addEventListener('click', (e) => {
      if (e instanceof MouseEvent && (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey)) return;
      e.preventDefault();
      aggiorna();
      dialogo.showModal();
    });
    dialogo.addEventListener('click', (e) => { if (e.target === dialogo) dialogo.close(); });
  }
</script>
<style>
  p { font: 400 1rem/1.45 var(--ui); color: var(--inchiostro-2); }
  label { display: block; font-weight: 600; margin: .85rem 0 .35rem; }
  select { width: 100%; padding: .55rem; font: inherit; border: 1px solid var(--riga); color: inherit; background: var(--carta); border-radius: .4rem; }
  .anteprima-azioni { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .9rem; margin-top: 1.15rem; }
  .anteprima-azioni a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; text-underline-offset: .2em; }
  .anteprima-teoria { padding: 0 1rem; background: var(--azione); color: white; border-radius: 2rem; text-decoration: none; }
  .anteprima-svolti[hidden] { display: none; }
</style>
