---
import VerificaRisposta from './VerificaRisposta.astro';
import { calculusAnswer, calculusHtml, calculusSlug } from '../lib/stem-usa-practice';
import { calculusPractice } from '../data/stem-usa/calculus-1-practice.mjs';

interface Props {
  topic: keyof typeof calculusPractice;
  number: number;
  originalExample: string;
}
const { topic, number, originalExample } = Astro.props;
const { worked, exercises } = calculusPractice[topic];
---
<details class="sommario-pagina studio-unita-usa studio-pratica-usa" id={'worked-' + number} hidden>
  <summary>Worked examples ({worked.length + 1})</summary>
  <div>
    <p>{originalExample}</p>
    <ol class="calculus-exercises">
      {worked.map(example => (
        <li>
          <h3>{example.title}</h3>
          <p set:html={calculusHtml(example.prompt)} />
          <ol>
            {example.steps.map(step => <li set:html={calculusHtml(step)} />)}
          </ol>
        </li>
      ))}
    </ol>
  </div>
</details>
<details class="sommario-pagina studio-unita-usa studio-pratica-usa" id={'exercises-' + number} hidden>
  <summary>Practice exercises ({exercises.length})</summary>
  <div>
    <ol class="calculus-exercises">
      {exercises.map(exercise => (
        <li>
          <h3>{exercise.title}</h3>
          <p set:html={calculusHtml(exercise.prompt)} />
          <VerificaRisposta
            lingua="en"
            id={calculusSlug + '/' + topic + '/' + exercise.number}
            tipo={calculusAnswer(exercise.answer, exercise.primitive).tipo}
            primitiva={exercise.primitive}
            mostraIndizio={false}
          />
          <details class="stem-feedback">
            <summary>Show solution</summary>
            <p set:html={calculusHtml(exercise.explanation)} />
          </details>
        </li>
      ))}
    </ol>
  </div>
</details>

<style>
  .studio-pratica-usa { grid-column: 1 / -1; min-inline-size: 0; }
  .calculus-exercises { margin: .5rem 0; padding-inline-start: 1.4rem; }
  .calculus-exercises > li { margin-block: .8rem; padding-block-start: .7rem; border-top: 1px solid var(--riga); }
  .calculus-exercises ol { padding-inline-start: 1.2rem; }
  .calculus-exercises h3 { margin: 0; font-size: 1rem; }
  .calculus-exercises :global(.verifica) { margin-block: .5rem; }
  .calculus-exercises :global(.katex) { font-size: 1.02em; }
</style>
