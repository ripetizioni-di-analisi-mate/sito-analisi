---
import { materiaL, link, T, type Lingua } from '../i18n';
import { linkArgomentoUsa, materiaUsa } from '../data/stem-usa/catalog-view';
import { hasUsStudyPages } from '../data/stem-usa/catalog.mjs';
import { usTimedTopics } from '../lib/stem-usa-banks';
import { catalogoDomande } from '../lib/domande';
import { paginaLocalizzata } from '../lib/lingue-sito';
import { disponibilitaStudio } from '../lib/nav';
import { sezioniStudio } from '../lib/percorso-studio.mjs';
import { indiceCapitolo } from '../lib/indice-capitolo';
import CercaCapitolo from './CercaCapitolo.astro';
import Concentrazione from './Concentrazione.astro';
// indietro: pagina del livello sopra (materia, oppure elenco della sezione per un solo esercizio o una sola voce).
interface Props { materia?: string; argomento?: string; sezione?: string; lingua?: Lingua; usa?: boolean; indietro?: string }
const { materia, argomento, sezione, lingua = 'it', usa = false, indietro } = Astro.props;
const en = lingua === 'en', es = lingua === 'es';
const m = materia ? (usa ? materiaUsa(materia) : materiaL(lingua, materia)) : undefined;
const i = m?.argomenti.findIndex((a) => a.slug === argomento) ?? -1;
const visibile = Boolean(m && i >= 0 && (!usa || hasUsStudyPages(materia)) && ['teoria', 'esercizi-svolti', 'esercizi', 'domande'].includes(sezione ?? ''));
// I corsi americani senza domande a tempo non mostrano la quarta tappa.
const conDomandeUsa = Boolean(usTimedTopics[materia ?? '']?.length || (await catalogoDomande('us'))[materia ?? '']?.length);
const sezioni = !visibile ? [] : usa ? ['teoria', 'esercizi-svolti', 'esercizi', ...(conDomandeUsa ? ['domande'] : [])]
  : sezioniStudio(await disponibilitaStudio(materia!, argomento!, lingua));
const href = (topic: string, section: string) => usa ? linkArgomentoUsa(materia!, topic, section) : link(lingua, es && !paginaLocalizzata('es', '/' + materia + '/' + topic + '/' + section)
    ? '/' + materia + '#' + topic : '/' + materia + '/' + topic + '/' + section);
const nomi = { ...T(lingua).sezioni, domande: es ? 'Preguntas cronometradas' : en ? 'Timed questions' : 'Domande a tempo' };
const dopo = visibile ? m?.argomenti[i + 1] : undefined;
const indice = visibile && !usa ? await indiceCapitolo(lingua, materia!, argomento!) : undefined;
const testoIndietro = es ? 'Volver' : en ? 'Back' : 'Torna indietro';
const freccia = '<svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 10h-11M9 4.5L3.5 10 9 15.5"/></svg>';
---
{visibile && <>
  <div class="studio-percorso-desktop">
    <nav class="studio-sezioni" aria-label={es ? 'Secciones del tema' : en ? 'Sections of this topic' : 'Sezioni di questo argomento'}>
      {indietro && <a class="studio-indietro" href={indietro} title={testoIndietro} aria-label={testoIndietro} set:html={freccia} />}
      <ol>
        {sezioni.map((s) => (
          <li><a href={href(argomento!, s)} aria-current={s === sezione ? 'step' : undefined}>{nomi[s]}</a></li>
        ))}
      </ol>
    </nav>
    <CercaCapitolo lingua={lingua} sezione={sezione} indice={indice} modo="desktop" />
    <Concentrazione lingua={lingua} />
  </div>
  <div class="studio-mobile">
    {indietro && <a class="studio-indietro" href={indietro} title={testoIndietro} aria-label={testoIndietro} set:html={freccia} />}
    <details class="studio-percorso-mobile">
      <summary>{es ? 'Itinerario de estudio' : en ? 'Study path' : 'Percorso'}<span> · {nomi[sezione!]}</span></summary>
      <nav class="studio-sezioni" aria-label={es ? 'Secciones del tema' : en ? 'Sections of this topic' : 'Sezioni di questo argomento'}>
        <ol>
          {sezioni.map((s, n) => (
            <li>
              <a href={href(argomento!, s)} aria-current={s === sezione ? 'step' : undefined}>
                <span class="studio-numero" aria-hidden="true">{n + 1}</span>{nomi[s]}
              </a>
            </li>
          ))}
        </ol>
        {dopo && <a class="studio-salta" href={href(dopo.slug, 'teoria')}>{es ? 'Tema siguiente' : en ? 'Next topic' : 'Argomento successivo'}<span aria-hidden="true"> →</span><span class="studio-salta-titolo"> · {dopo.breve}</span></a>}
      </nav>
    </details>
  </div>
  <CercaCapitolo lingua={lingua} sezione={sezione} modo="mobile" />
</>}
<style>
  /* Riga delle sezioni a linguette (versione 1 scelta da Carmine il 19/11/2026): freccia indietro, sezioni,
     ricerca nel capitolo e Concentrazione solo con l'icona. Al telefono: freccia, «Percorso» e la ricerca sotto. */
  .studio-percorso-desktop { display: flex; align-items: center; gap: .75rem; margin: 0 0 1.75rem; border-bottom: 1px solid var(--riga); font-family: var(--ui); font-size: .86rem; }
  .studio-percorso-desktop .studio-sezioni { display: flex; align-items: center; gap: .6rem; flex: 1; min-width: 0; }
  .studio-percorso-desktop ol { display: flex; flex-wrap: wrap; gap: 0 1.1rem; list-style: none; margin: 0; padding: 0; }
  .studio-percorso-desktop li { margin: 0; }
  .studio-percorso-desktop li a { display: block; padding: .6rem .1rem; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--inchiostro-2); text-decoration: none; white-space: nowrap; }
  .studio-percorso-desktop li a:hover { color: var(--inchiostro); border-bottom-color: var(--riga); }
  .studio-percorso-desktop li a[aria-current] { color: var(--accento); font-weight: 600; border-bottom-color: var(--accento); }
  .studio-percorso-desktop :global(.cerca-capitolo) { width: 12rem; flex: none; margin-bottom: .3rem; }
  .studio-percorso-desktop :global(.studio-comandi) { margin: 0 0 .3rem; flex: none; }
  .studio-percorso-desktop :global(.studio-concentrazione) { width: 2.1rem; height: 2.1rem; min-height: 0; padding: 0; justify-content: center; border-radius: 50%; }
  .studio-percorso-desktop :global(.studio-concentrazione span) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .studio-indietro { display: grid; place-items: center; width: 2rem; height: 2rem; flex: none; border: 1px solid var(--riga); border-radius: 50%; color: var(--inchiostro); background: transparent; }
  .studio-indietro:hover { background: var(--carta-2); }
  .studio-indietro :global(svg) { width: 15px; height: 15px; }
  .studio-percorso-desktop .studio-indietro { margin: 0 .25rem .3rem 0; }
  .studio-mobile { display: none; }
  @media (max-width: 40rem) {
    .studio-percorso-desktop { display: none; }
    .studio-mobile { display: flex; align-items: flex-start; gap: .55rem; margin: 0 0 .9rem; font-family: var(--ui); }
    .studio-mobile .studio-indietro { margin-top: .4rem; }
    .studio-percorso-mobile { flex: 1; min-width: 0; border-bottom: 1px solid var(--riga); }
    .studio-percorso-mobile > summary { display: flex; align-items: center; flex-wrap: wrap; min-height: 2.75rem; padding: .55rem .35rem; font-size: .86rem; font-weight: 600; color: var(--inchiostro); cursor: pointer; list-style: none; }
    .studio-percorso-mobile > summary::-webkit-details-marker { display: none; }
    .studio-percorso-mobile > summary::before { content: ''; width: var(--apertura-lato); height: var(--apertura-lato); margin-right: .55rem; border-right: var(--apertura-tratto) solid currentColor; border-bottom: var(--apertura-tratto) solid currentColor; opacity: var(--apertura-opacita); transform: rotate(-45deg); flex: none; }
    .studio-percorso-mobile[open] > summary::before { transform: rotate(45deg); }
    .studio-percorso-mobile > summary span { margin-left: .25rem; color: var(--inchiostro-2); font-weight: 400; }
    .studio-percorso-mobile .studio-sezioni { padding: .15rem 0 .7rem; font-size: .85rem; }
    .studio-percorso-mobile ol { display: grid; grid-template-columns: 1fr 1fr; gap: .2rem; list-style: none; margin: 0; padding: 0; }
    .studio-percorso-mobile li { margin: 0; }
    .studio-percorso-mobile li a { display: flex; align-items: center; gap: .35rem; width: 100%; min-height: 2.25rem; padding: .25rem .4rem; border-radius: var(--raggio); color: var(--inchiostro-2); text-decoration: none; }
    .studio-percorso-mobile a[aria-current] { background: color-mix(in srgb, var(--accento) 9%, var(--carta)); color: var(--accento); font-weight: 700; }
    .studio-numero { display: grid; place-items: center; width: 1.2rem; height: 1.2rem; flex: none; font-size: .72rem; border: 1px solid var(--riga); border-radius: 50%; }
    a[aria-current] .studio-numero { border-color: currentColor; }
    .studio-salta { display: inline-block; margin: .4rem .4rem 0; color: var(--inchiostro-2); font-size: .78rem; text-decoration: none; }
  }
  @media print { .studio-percorso-desktop, .studio-mobile { display: none; } }
</style>
