---
import { materieL, link, type Lingua } from '../i18n';
import { VIDEOCORSI, chiaveVideo } from '../data/videocorsi';
const { lingua } = Astro.props as { lingua: Lingua };
const en = lingua === 'en';
const materie = materieL(lingua).filter((m) => m.attiva && m.prezzo);
const video = en ? [] : VIDEOCORSI;
const regole = [
  ...materie.map((m) => `html[data-materie~="${m.slug}"] .materiali-studente{display:block}html[data-materie~="${m.slug}"] .ms-materia-${m.slug}{display:flex}`),
  ...video.map((v) => `html[data-materie~="${chiaveVideo(v.slug)}"] .materiali-studente{display:block}html[data-materie~="${chiaveVideo(v.slug)}"] .ms-video-${v.slug}{display:flex}`),
].join('');
---
<style is:inline set:html={regole}></style>
<section class="materiali-studente" aria-labelledby="ms-titolo">
  <h2 id="ms-titolo">{en ? 'Your study materials' : 'I tuoi materiali'}</h2>
  <ul>
    {materie.map((m) => <li class={`ms-materia-${m.slug}`} style={`--materia: ${m.colore}`}>
      <span class="ms-punto" aria-hidden="true"></span>
      <div><h3>{m.titolo}</h3><p>{en ? 'Theory and exercises · Full access' : 'Teoria ed esercizi · Accesso completo'}</p></div>
      <a href={link(lingua, `/${m.slug}`)} aria-label={`${en ? 'Study' : 'Studia'} ${m.titolo}`}>{en ? 'Study' : 'Studia'} <span aria-hidden="true">→</span></a>
    </li>)}
    {video.map((v) => <li class={`ms-video-${v.slug}`} style="--materia: var(--video)">
      <span class="ms-punto" aria-hidden="true"></span><div><h3>{v.titolo}</h3><p>{v.lezioni} lezioni registrate con PDF</p></div>
      <a href="/account#videocorsi" aria-label={`Apri ${v.titolo}`}>Apri i video <span aria-hidden="true">→</span></a>
    </li>)}
  </ul>
</section>
<style>
  .materiali-studente{display:none;margin:2.3rem 0 2.5rem;font-family:var(--ui)}
  h2{margin:0 0 .8rem;font:600 1.3rem var(--testo,var(--ui));color:var(--inchiostro)}
  ul{list-style:none;margin:0;padding:0;border:1px solid var(--riga);border-radius:var(--raggio);overflow:hidden;background:var(--carta)}
  li{display:none;align-items:center;gap:.8rem;padding:1rem 1.1rem}
  li+li{border-top:1px solid var(--riga)}
  .ms-punto{width:.45rem;height:1.9rem;border-radius:1rem;background:var(--materia);flex:none}
  li>div{flex:1;min-width:0}h3{font:600 1rem var(--ui);margin:0 0 .15rem}p{font-size:.85rem;color:var(--inchiostro-2);margin:0}
  li>a{font:600 .9rem var(--ui);padding:.5rem .7rem;white-space:nowrap;text-decoration:none;border:1px solid var(--riga);border-radius:var(--raggio)}
  a:hover{text-decoration:underline}a:focus-visible{outline:2px solid var(--accento);outline-offset:3px}
  @media(max-width:560px){li{flex-wrap:wrap;gap:.7rem;padding:.9rem}li>a{margin-left:1.2rem}li>div{flex-basis:75%}}
</style>
