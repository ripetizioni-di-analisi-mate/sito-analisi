---
// Ingresso dello Studio guidato nella pagina della materia (anteprima riservata ai GM, 13/11/2026).
// Versione A (tasto) per chi non ha ancora fatto il test; versione C (riquadro con il progresso)
// dopo il primo test. Il riquadro si riempie con /api/studio-guidato.
interface Props { materia: string }
const { materia } = Astro.props;
const href = `/studio-guidato/${materia}`;
const icona = `<svg class="sg-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.3" fill="currentColor"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3"/></svg>`;
---
<div class="sg-ingresso" data-orientamento-gm hidden data-sg-ingresso={materia}>
  <a class="sg-a" href={href} data-sg-tasto><Fragment set:html={icona} /><span><strong>Studio guidato</strong><small>Parti dalle tue lacune</small></span><span class="freccia" aria-hidden="true">→</span></a>
  <section class="sg-c" data-sg-riquadro hidden aria-label="Studio guidato">
    <div class="testa"><Fragment set:html={icona} /><strong>Studio guidato</strong><span data-sg-quando></span></div>
    <div class="corpo">
      <svg class="sg-anello" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="none" stroke="#f1eee7" stroke-width="5"/><circle data-sg-arco cx="20" cy="20" r="16" fill="none" stroke="#214f50" stroke-width="5" stroke-dasharray="0 100.5" transform="rotate(-90 20 20)" stroke-linecap="round"/><text data-sg-frazione x="20" y="23.5" text-anchor="middle" font-size="9" font-weight="700" fill="#23302e"></text></svg>
      <div><p class="num" data-sg-conteggio></p><p class="prossimo"><small>Prossimo passo</small><span data-sg-prossimo></span></p></div>
      <div class="azioni"><a class="sg-btn" data-sg-continua href={href}>Continua</a><a class="sg-btn sec" href={href}>Rifai il test</a></div>
    </div>
  </section>
</div>
<style>
  .sg-ingresso{margin:.6rem 0 1.4rem;font-family:var(--ui)}
  .sg-ingresso :global(.sg-ico){width:1.5rem;height:1.5rem;flex:none}
  .sg-a{display:inline-flex;align-items:center;gap:.8rem;padding:.75rem 1.1rem .75rem .9rem;border-radius:999px;background:var(--azione);color:#fff;text-decoration:none;box-shadow:0 .25rem .9rem #214f5033}
  .sg-a :global(.sg-ico){width:2.1rem;height:2.1rem;padding:.35rem;border-radius:50%;background:#ffffff22}
  .sg-a strong{display:block;font-size:1.05rem}
  .sg-a small{display:block;font-size:.88rem;opacity:.85}
  .sg-a .freccia{margin-left:.4rem;font-size:1.2rem}
  .sg-c{border:1px solid var(--riga);border-radius:10px;background:#fff;overflow:hidden}
  .sg-c .testa{display:flex;align-items:center;gap:.7rem;padding:.8rem 1.2rem;background:var(--azione);color:#fff}
  .sg-c .testa strong{font-size:1.05rem}.sg-c .testa span{opacity:.85;font-size:.9rem;margin-left:auto}
  .sg-c .corpo{display:grid;grid-template-columns:auto 1fr auto;gap:1.2rem;align-items:center;padding:1rem 1.2rem}
  .sg-anello{width:4.6rem;height:4.6rem;font-family:var(--ui)}
  .sg-c .num{margin:0;font-size:.95rem;color:#3d4a48}
  .sg-c .prossimo{margin:.35rem 0 0;font-size:1.05rem;color:var(--inchiostro)}
  .sg-c .prossimo small{display:block;font-size:.78rem;color:#6a716f;text-transform:uppercase;letter-spacing:.06em}
  .sg-c .azioni{display:flex;flex-direction:column;gap:.5rem}
  .sg-btn{display:inline-flex;justify-content:center;padding:.6rem 1.1rem;border-radius:var(--raggio);background:var(--azione);color:#fff;text-decoration:none;font-weight:700}
  .sg-btn.sec{background:#fff;color:var(--azione);border:1px solid var(--azione)}
  @media(max-width:650px){.sg-c .corpo{grid-template-columns:auto 1fr}.sg-c .azioni{grid-column:1/-1;flex-direction:row}.sg-c .azioni a{flex:1}}
</style>
<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-sg-ingresso]')) {
    const materia = box.dataset.sgIngresso!;
    fetch(`/api/studio-guidato?materia=${encodeURIComponent(materia)}`, { credentials: 'same-origin', cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        const p = d?.progresso;
        if (!d?.ultimo || !p) return;
        const q = <T extends Element>(s: string) => box.querySelector<T>(s)!;
        q<HTMLElement>('[data-sg-tasto]').hidden = true;
        q<HTMLElement>('[data-sg-riquadro]').hidden = false;
        q('[data-sg-quando]').textContent = `Ultimo test: ${new Date(p.ultimo).toLocaleDateString('it-IT', { day: 'numeric', month: 'long' })}`;
        // Dopo il primo test si contano le lacune trovate; dal secondo anche quelle risolte.
        const primo = p.test === 1;
        const parte = !p.trovate ? 1 : primo ? 0 : p.risolte / p.trovate;
        q('[data-sg-arco]').setAttribute('stroke-dasharray', `${(100.5 * parte).toFixed(1)} 100.5`);
        q('[data-sg-arco]').toggleAttribute('hidden', parte === 0);
        q('[data-sg-frazione]').textContent = !p.trovate ? '✓' : primo ? String(p.trovate) : `${p.risolte}/${p.trovate}`;
        const lac = (n: number, s: string, pl: string) => `${n} ${n === 1 ? s : pl}`;
        q('[data-sg-conteggio]').innerHTML = !p.trovate ? '<b>Nessuna lacuna</b> negli argomenti verificati'
          : primo ? `<b>${lac(p.trovate, 'lacuna trovata', 'lacune trovate')}</b> nel primo test`
          : `<b>${lac(p.risolte, 'lacuna risolta', 'lacune risolte')}</b> su ${lac(p.trovate, 'trovata', 'trovate')}`;
        const continua = q<HTMLAnchorElement>('[data-sg-continua]');
        if (p.prossimo) {
          q('[data-sg-prossimo]').textContent = p.prossimo.titolo;
          continua.href = p.prossimo.link.teoria;
        } else {
          q('[data-sg-prossimo]').textContent = 'Simulazione d’esame';
          continua.href = `/${materia}/simulazione`;
        }
      })
      .catch(() => {});
  }
</script>
