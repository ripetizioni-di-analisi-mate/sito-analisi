---
// «Compatibilità con il tuo esame»: caricamento del testo dell'esame (foto, PDF o testo), confronto con il
// materiale della materia e risultato richiesta per richiesta. Pagina /compatibilita; dalla pagina Sblocca delle
// materie universitarie si arriva con ?materia=<slug>. Worker: worker/compatibilita.mjs.
import { materia as datiMateria } from '../data/materie';
import { MATERIE_COMPATIBILITA, MAX_PAGINE, SOGLIA_CONSIGLIATO } from '../data/compatibilita';
const elenco = MATERIE_COMPATIBILITA.map((s) => datiMateria(s));
---
<div class="compat" id="compat" data-max-pagine={MAX_PAGINE} data-soglia={SOGLIA_CONSIGLIATO} data-prezzi={JSON.stringify(Object.fromEntries(elenco.map((m) => [m.slug, m.prezzo])))}>
  <form class="compat-modulo" id="compat-modulo" novalidate>
    <div class="compat-pillole" role="radiogroup" aria-label="Materia dell’esame">
      {elenco.map((m) => (<label><input type="radio" name="materia" value={m.slug} /><span>{m.titolo}</span></label>))}
    </div>
    <label class="compat-carica">
      <input type="file" name="file" accept="image/*,application/pdf" multiple />
      <span><b>Carica le foto o il PDF</b> del compito, fino a {MAX_PAGINE} pagine</span>
    </label>
    <ul class="compat-file" id="compat-file"></ul>
    <details class="compat-incolla">
      <summary>oppure incolla il testo</summary>
      <textarea name="testo" rows="6" maxlength="8000"></textarea>
    </details>
    <div class="compat-tasti">
      <button type="submit" class="bottone-primario" id="compat-invia">Controlla la compatibilità</button>
      <span class="esito-modulo compat-stato" id="compat-stato" role="status"></span>
    </div>
    <p class="compat-nota">Gratuito, anche senza account. Il compito si conserva senza dati personali per migliorare il materiale: copri nome e matricola prima della foto (<a href="/privacy">informativa</a>).</p>
  </form>
  <section class="compat-esito" id="compat-esito" hidden aria-live="polite"></section>
</div>

<style is:global>
  .compat { font-family: var(--ui); }
  .compat-modulo { display: grid; gap: 0.75rem; }
  .compat-pillole { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .compat-pillole label { position: relative; cursor: pointer; }
  .compat-pillole input { position: absolute; opacity: 0; pointer-events: none; }
  .compat-pillole span { display: inline-block; padding: 0.35rem 0.8rem; border: 1px solid var(--riga); border-radius: 999px; background: white; font-size: 0.9rem; }
  .compat-pillole input:checked + span { background: var(--accento); border-color: var(--accento); color: white; font-weight: 600; }
  .compat-pillole input:focus-visible + span { outline: 2px solid var(--accento); outline-offset: 2px; }
  .compat-carica { display: block; position: relative; border: 1.5px dashed var(--riga); border-radius: var(--raggio); background: white; padding: 0.9rem 1rem; text-align: center; cursor: pointer; color: var(--inchiostro-2); font-size: 0.95rem; }
  .compat-carica:hover, .compat-carica.sopra { border-color: var(--accento); }
  .compat-carica input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .compat-carica b { color: var(--accento); }
  .compat-file { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .compat-file:empty { display: none; }
  .compat-file li { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.85rem; background: var(--carta-2); border-radius: 999px; padding: 0.15rem 0.35rem 0.15rem 0.7rem; }
  .compat-file button { font: inherit; border: 0; background: none; color: var(--inchiostro-2); cursor: pointer; width: 1.3rem; height: 1.3rem; border-radius: 50%; line-height: 1; }
  .compat-incolla summary { cursor: pointer; font-size: 0.9rem; color: var(--accento); width: max-content; }
  .compat textarea { width: 100%; box-sizing: border-box; margin-top: 0.4rem; font: inherit; font-size: 0.92rem; padding: 0.6rem 0.75rem; border: 1px solid var(--riga); border-radius: var(--raggio); background: white; color: var(--inchiostro); resize: vertical; }
  .compat textarea:focus { outline: 2px solid var(--accento); outline-offset: -1px; }
  .compat-tasti { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  .compat-tasti button:disabled { opacity: 0.6; cursor: wait; }
  .compat-stato { margin: 0; min-height: 0; }
  .compat-nota { margin: 0; font-size: 0.82rem; color: var(--inchiostro-2); }

  .compat-esito { margin-top: 1.4rem; border: 1px solid var(--riga); border-radius: var(--raggio); background: white; }
  .compat-sintesi { padding: 0.9rem 1rem 0.8rem; border-bottom: 1px solid var(--riga); }
  .compat-titolo-esito { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.6rem; }
  .compat-titolo-esito strong { font-family: var(--titoli); font-size: 2rem; line-height: 1; color: var(--accento); font-variant-numeric: tabular-nums; }
  .compat-titolo-esito span { color: var(--inchiostro-2); font-size: 0.95rem; }
  .compat-barra { height: 5px; border-radius: 999px; background: var(--carta-2); margin: 0.65rem 0 0.5rem; overflow: hidden; display: flex; }
  .compat-barra i { display: block; height: 100%; }
  .compat-barra .b-stesso { background: var(--accento); }
  .compat-barra .b-argomento { background: #d8b27a; }
  .compat-righe-sintesi { margin: 0; font-size: 0.88rem; color: var(--inchiostro-2); }
  .compat-righe-sintesi + .compat-righe-sintesi { margin-top: 0.25rem; }
  .compat-righe-sintesi b { color: var(--inchiostro); }
  .compat-acquisto { margin: 0.6rem 0 0; font-size: 0.92rem; }
  .compat-consigliato { position: relative; overflow: hidden; margin: 0.9rem 0 0.1rem; padding: 1rem 1rem 1.05rem; border-radius: var(--raggio); text-align: center;
    background: linear-gradient(180deg, #eaf4ef 0%, #f6faf7 100%); border: 1px solid #cfe2db; animation: cc-entra 0.5s ease-out; }
  .cc-etichetta { position: relative; display: inline-flex; align-items: center; gap: 0.35rem; margin: 0 0 0.35rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--azione); }
  .cc-etichetta svg { width: 1rem; height: 1rem; }
  .cc-titolo { position: relative; margin: 0 0 0.8rem; font-family: var(--titoli); font-size: 1.2rem; line-height: 1.3; color: var(--inchiostro); }
  .compat-consigliato .bottone-primario { position: relative; background: var(--azione); }
  @keyframes cc-entra { from { transform: scale(0.97); opacity: 0; } to { transform: none; opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .compat-consigliato { animation: none; } }
  .compat-acquisto a { color: var(--azione); font-weight: 600; }

  .compat-richieste { list-style: none; margin: 0; padding: 0; }
  .compat-richieste li { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr); gap: 0 0.5rem; padding: 0.6rem 1rem; border-bottom: 1px solid var(--carta-2); }
  .compat-n { font-weight: 700; color: var(--inchiostro-2); font-variant-numeric: tabular-nums; }
  .compat-r { min-width: 0; }
  .compat-r .testo-richiesta { font-family: var(--testo); line-height: 1.4; overflow-x: auto; }
  .compat-link { margin: 0.2rem 0 0; font-size: 0.85rem; color: var(--inchiostro-2); }
  .compat-link a { color: var(--accento); }
  .compat-et { font-size: 0.75rem; font-weight: 700; border-radius: 999px; padding: 0.05rem 0.5rem; margin-right: 0.35rem; }
  .compat-et.stesso { background: #e3efe9; color: #2f6f68; }
  .compat-et.argomento { background: #f6ecd9; color: #8a5f1f; }
  .compat-et.nessuno { background: #eee8dc; color: #5a6664; }
  .compat-dettagli { padding: 0.55rem 1rem; font-size: 0.88rem; }
  .compat-dettagli + .compat-dettagli { border-top: 1px solid var(--carta-2); }
  .compat-dettagli summary { cursor: pointer; color: var(--inchiostro-2); }
  .compat-dettagli p { color: var(--inchiostro-2); margin: 0.4rem 0; }
  .compat-dettagli .bottone-secondario { font: inherit; font-weight: 600; background: white; color: var(--inchiostro); border: 1px solid var(--riga); border-radius: 999px; padding: 0.45rem 1rem; cursor: pointer; margin-top: 0.4rem; }
</style>

<script>
  import { avviaCompatibilita } from '../scripts/compatibilita';
  avviaCompatibilita();
</script>
