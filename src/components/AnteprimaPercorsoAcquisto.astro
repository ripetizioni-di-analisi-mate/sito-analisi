---
import type { Lingua } from '../i18n';
import { url } from '../lib/url';

export const schedePercorso: Record<string, string> = {
  'analisi-1': 'limiti',
  'fisica-1': 'cinematica-1d',
  'matematica-superiori-5': 'derivate',
  'tolc-i': 'aritmetica-e-algebra',
};
interface Props { lingua: Lingua; materia: string }
const { lingua, materia } = Astro.props;
const en = lingua === 'en';
---
<div id="anteprima-percorso-acquisto" hidden data-materia={materia} data-argomento={schedePercorso[materia]} data-lingua={lingua}
  data-catalogo={url(`/anteprime/percorso-acquisto/${lingua}.json`)} data-logo={url('/logo.svg')}>
  <span>{en ? 'Your personal study plan' : 'Il tuo piano di studio personale'}</span>
  <button type="button" data-avvia-anteprima>{en ? 'Build my plan' : 'Costruisci il mio piano'}</button>
</div>
<script>
  const modo = new URLSearchParams(location.search).get('anteprima-percorso');
  const avvio = document.querySelector<HTMLElement>('#anteprima-percorso-acquisto');
  if (avvio && (modo === '1' || modo === 'esercizio')) {
    import('../scripts/anteprima-consulenza/percorso.mjs').then(mod => mod.attivaAnteprima(avvio, modo)).catch(() => {
      avvio.hidden = false;
      const pulsante = avvio.querySelector('button')!;
      const en = avvio.dataset.lingua === 'en';
      avvio.querySelector('span')!.textContent = en ? 'The plan could not load.' : 'Caricamento del piano interrotto.';
      pulsante.textContent = en ? 'Try again' : 'Riprova';
      pulsante.onclick = () => location.reload();
    });
  }
</script>
