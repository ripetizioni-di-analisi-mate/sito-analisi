---
// La verifica del Worker è disponibile solo per i risultati che il sito riconosce.
import { type Lingua } from '../i18n';
interface Props { id: string; tipo?: 'numero' | 'funzione'; primitiva?: boolean; lingua: Lingua; mostraIndizio?: boolean }
const { id, tipo, primitiva = false, lingua, mostraIndizio = true } = Astro.props;
const en = lingua === 'en';
const es = lingua === 'es';
const campo = `verifica-${id.replace(/[^a-z0-9]+/gi, '-')}`;
const esempio = tipo === 'numero'
  ? (en ? 'e.g. 3/2, e^6, sqrt(2), pi/4, -inf' : es ? 'p. ej., 3/2, e^6, sqrt(2), pi/4, -inf' : 'per esempio 3/2, e^6, sqrt(2), pi/4, -inf')
  : (en ? 'e.g. x^2/2 + ln|x|, 3x^2, e^x sin x' : es ? 'p. ej., x^2/2 + ln|x|, 3x^2, e^x sin x' : 'per esempio x^2/2 + ln|x|, 3x^2, e^x sin x');
const tasti = [
  { simbolo: '□', modello: '/(|)', nome: en ? 'Fraction' : es ? 'Fracción' : 'Frazione', accoda: true },
  { simbolo: '□', modello: '^(|)', nome: en ? 'Power' : es ? 'Potencia' : 'Potenza', accoda: true },
  { simbolo: '√□', modello: '√(|)', nome: en ? 'Square root' : es ? 'Raíz cuadrada' : 'Radice quadrata' },
  { simbolo: '(□)', modello: '(|)', nome: en ? 'Parentheses' : es ? 'Paréntesis' : 'Parentesi' },
  { simbolo: 'π', modello: 'π', nome: en ? 'Pi' : es ? 'Pi' : 'Pi greco' },
  { simbolo: '∞', modello: '∞', nome: en ? 'Infinity' : es ? 'Infinito' : 'Infinito' },
  { simbolo: 'e', modello: 'e', nome: en ? 'Euler’s number' : es ? 'Número de Euler' : 'Numero di Nepero' },
  { simbolo: 'ln(□)', modello: 'ln(|)', nome: en ? 'Natural logarithm' : es ? 'Logaritmo natural' : 'Logaritmo naturale' },
];
---
<form class="verifica zona-libera" data-id={id} data-tipo={tipo} data-senza-indizio={mostraIndizio ? undefined : ''} novalidate>
  <label for={campo}>{en ? 'Write your answer' : es ? 'Escribe tu respuesta' : 'Scrivi la tua risposta'}{primitiva && <small>{en ? ' (the constant c can be left out)' : es ? ' (puedes omitir la constante c)' : ' (la costante c si può tralasciare)'}</small>}</label>
  <div class="verifica-riga">
    {tipo ? (
      <input id={campo} type="text" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="200" placeholder={esempio} />
    ) : (
      <textarea id={campo} rows="3" autocomplete="off" aria-describedby={`${campo}-confronto`}></textarea>
    )}
    <button type="submit">{en ? 'Submit' : es ? 'Enviar' : 'Invia'}</button>
  </div>
  <details class="verifica-tastiera">
    <summary>{en ? 'Math keyboard' : es ? 'Teclado matemático' : 'Tastiera matematica'}</summary>
    <div class="verifica-tasti">
      {tasti.map(({ simbolo, modello, nome, accoda }) => (
        <button type="button" data-modello={modello} data-accoda={accoda ? '' : undefined} aria-label={nome} title={nome}>
          <span aria-hidden="true">
            {modello === '/(|)' ? <span class="verifica-frazione"><span>□</span><span>□</span></span>
              : modello === '^(|)' ? <>□<sup>□</sup></> : simbolo}
          </span>
        </button>
      ))}
    </div>
  </details>
  {tipo ? (
    <p class="verifica-lettura" aria-live="polite"></p>
  ) : (
    <p id={`${campo}-confronto`} class="verifica-confronto">{en ? 'Submit your answer to compare it with the solution.' : es ? 'Envía tu respuesta para compararla con la solución.' : 'Premi «Invia» per confrontare la tua risposta con la soluzione.'}</p>
  )}
  <p class="verifica-esito" role="status" aria-live="polite"></p>
</form>

<style>
  .verifica-riga input { font-size: 1rem; }
  .verifica-riga button { align-self: flex-start; min-height: 44px; flex-shrink: 0; }
  .verifica-riga textarea { flex: 1; min-width: 0; font: 1rem/1.3 var(--ui); padding: 0.5rem 0.65rem; border: 1px solid var(--riga); border-radius: 8px; background: var(--carta); color: var(--inchiostro); resize: vertical; }
  .verifica-riga textarea:focus { outline: 2px solid color-mix(in srgb, var(--accento) 40%, transparent); border-color: var(--accento); background: #fff; }
  .verifica-tastiera { margin-top: 0.35rem; color: var(--accento); }
  .verifica-tastiera > summary { width: fit-content; padding: 0.45rem 0.65rem; border: 1px solid var(--riga); border-radius: 7px; background: var(--carta); font-size: 0.88rem; font-weight: 600; cursor: pointer; }
  .verifica-tasti { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.35rem; }
  .verifica-tasti button { display: grid; place-items: center; min-width: 44px; min-height: 44px; padding: 0.25rem; border: 1px solid var(--riga); border-radius: 7px; background: color-mix(in srgb, var(--accento) 6%, #fff); color: var(--accento); font: 600 1rem/1 var(--testo); cursor: pointer; }
  .verifica-tasti button:hover { background: color-mix(in srgb, var(--accento) 12%, #fff); }
  .verifica-frazione { display: inline-grid; font-size: 0.77rem; }
  .verifica-frazione > :first-child { border-bottom: 1px solid currentColor; padding-bottom: 1px; }
  .verifica-confronto { margin: 0.35rem 0 0; font-size: 0.85rem; color: var(--inchiostro-2); }
  @media (max-width: 30rem) {
    .verifica-riga { flex-wrap: wrap; }
    .verifica-riga input, .verifica-riga textarea { flex-basis: 100%; }
  }
</style>

<script>
  import katex from 'katex';
  import { leggi, latex } from '../../worker/valuta.mjs';
  const inglese = document.documentElement.lang === 'en';
  const T = document.documentElement.lang === 'es' ? {
    leggo: 'Interpretado como', illeggibile: 'No se ha podido interpretar la respuesta. Prueba con 3/2, sqrt(2), e^6, pi/4, inf o x^2 + ln|x|.',
    giusta: 'Respuesta correcta.', sbagliata: 'El resultado es distinto. Puedes intentarlo de nuevo o pedir una pista a Pi debajo del ejercicio.',
    vicina: 'El valor se aproxima al resultado. Escribe el valor exacto con fracciones, raíces, π o e.',
    riprova: 'El resultado es distinto. Revisa los pasos e inténtalo de nuevo.', rete: 'Error de red. Inténtalo de nuevo.', exp: 'EXP',
    vuota: 'Escribe tu respuesta antes de enviarla.',
    confronto: 'Compara tu respuesta con la solución. Este ejercicio requiere una comprobación manual.',
    riservata: 'Desbloquea la materia para comparar tu respuesta con la solución.',
    senzaSoluzione: 'La solución no está disponible en esta página.',
  } : inglese ? {
    leggo: 'Read as', illeggibile: 'The answer cannot be read. Examples: 3/2, sqrt(2), e^6, pi/4, inf, x^2 + ln|x|.',
    giusta: 'Correct answer.', sbagliata: 'The result is different. You can try again or ask Pi for a hint below the exercise.', vicina: 'The value approximates the result; the check accepts the exact value, written with fractions, roots, π or e.',
    riprova: 'The result is different. Check your work and try again.', rete: 'Network error: please try again.', exp: 'XP',
    vuota: 'Write your answer before submitting it.',
    confronto: 'Compare your answer with the solution. This exercise requires a manual check.',
    riservata: 'Unlock the subject to compare your answer with the solution.',
    senzaSoluzione: 'The solution is not available on this page.',
  } : {
    leggo: 'Letta come', illeggibile: 'La risposta non si legge. Esempi di scrittura: 3/2, sqrt(2), e^6, pi/4, inf, x^2 + ln|x|.',
    giusta: 'Risposta corretta.', sbagliata: 'Il risultato è diverso. Puoi riprovare o chiedere un indizio a Pi sotto l’esercizio.', vicina: 'Il valore approssima il risultato; la verifica accetta il valore esatto, scritto con frazioni, radici, π o e.',
    riprova: 'Il risultato è diverso. Controlla i passaggi e riprova.', rete: 'Errore di rete: riprova.', exp: 'EXP',
    vuota: 'Scrivi la tua risposta prima di inviare.',
    confronto: 'Confronta la tua risposta con la soluzione. Per questo esercizio la verifica è manuale.',
    riservata: 'Sblocca la materia per confrontare la tua risposta con la soluzione.',
    senzaSoluzione: 'La soluzione non è disponibile in questa pagina.',
  };
  for (const f of document.querySelectorAll<HTMLFormElement>('form.verifica')) {
    if (f.dataset.pronto) continue;
    f.dataset.pronto = '1';
    const campo = f.querySelector<HTMLInputElement | HTMLTextAreaElement>('input, textarea')!;
    // Il riferimento resta quello dell'esercizio anche dopo lo spostamento del modulo.
    const esercizio = f.closest('.traccia') ?? f.parentElement;
    const corpo = f.previousElementSibling;
    corpo?.querySelector(':scope > .blocco-soluzione, :scope > .soluzione-riservata, :scope > .velo-blocco')?.before(f);
    // Tab passa al denominatore o all'esponente quando entrambi gli spazi sono stati inseriti insieme.
    campo.addEventListener('keydown', (e) => {
      const posizione = campo.selectionEnd ?? 0;
      if (e.key !== 'Tab' || e.shiftKey || e.ctrlKey || e.altKey || e.metaKey || campo.selectionStart !== posizione) return;
      if (!/^\)[/^]\(\)/.test(campo.value.slice(posizione))) return;
      e.preventDefault();
      campo.setSelectionRange(posizione + 3, posizione + 3);
    });
    f.querySelector('.verifica-tasti')!.addEventListener('click', (e) => {
      const tasto = (e.target as Element).closest<HTMLButtonElement>('button[data-modello]');
      if (!tasto) return;
      const fine = campo.selectionEnd ?? campo.value.length;
      const inizio = campo.selectionStart ?? fine;
      const selezione = campo.value.slice(inizio, fine);
      const accoda = tasto.hasAttribute('data-accoda');
      let modello = tasto.dataset.modello!;
      if (accoda && !selezione && !/[\p{L}\p{N})\]∞]$/u.test(campo.value.slice(0, inizio).trimEnd())) {
        modello = `(|)${modello.replace('|', '')}`;
      }
      const [apri, chiudi = ''] = modello.split('|');
      const prima = (accoda && selezione ? `(${selezione})` : '') + apri;
      const dentro = !accoda && chiudi ? selezione : '';
      const testo = prima + dentro + chiudi;
      if (campo.maxLength >= 0 && campo.value.length - (fine - inizio) + testo.length > campo.maxLength) return;
      const cursore = inizio + (dentro ? testo.length : prima.length);
      campo.setRangeText(testo, inizio, fine);
      campo.focus({ preventScroll: true });
      campo.setSelectionRange(cursore, cursore);
      campo.dispatchEvent(new Event('input', { bubbles: true }));
    });
    const lettura = f.querySelector<HTMLElement>('.verifica-lettura');
    const esito = f.querySelector<HTMLElement>('.verifica-esito')!;
    const bottone = f.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const mostraLettura = () => {
      const v = campo.value.trim();
      esito.textContent = ''; f.dataset.esito = '';
      if (!lettura) return;
      if (!v) { lettura.textContent = ''; return; }
      const n = leggi(v);
      if (!n) { lettura.textContent = ''; return; }
      try { lettura.innerHTML = `<span>${T.leggo}</span>${katex.renderToString(latex(n), { throwOnError: false, strict: false, output: 'html' })}`; } catch { lettura.textContent = ''; }
    };
    campo.addEventListener('input', mostraLettura);
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const risposta = campo.value.trim();
      if (!risposta) { esito.textContent = T.vuota; campo.focus(); return; }
      if (!f.dataset.tipo) {
        const soluzione = esercizio?.querySelector<HTMLDetailsElement>('details.blocco-soluzione, details.stem-feedback');
        const riservata = esercizio?.querySelector<HTMLElement>('.soluzione-riservata, .velo-blocco');
        if (soluzione) {
          soluzione.open = true;
          esito.textContent = T.confronto;
          f.dataset.esito = 'confronto';
        } else {
          esito.textContent = riservata ? T.riservata : T.senzaSoluzione;
        }
        (soluzione ?? riservata)?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }
      if (!leggi(risposta)) { esito.textContent = T.illeggibile; f.dataset.esito = 'illeggibile'; return; }
      bottone.disabled = true;
      const r = await fetch('/api/verifica', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: f.dataset.id, risposta, lingua: inglese ? 'en' : 'it' }),
      }).catch(() => null);
      bottone.disabled = false;
      const d = r ? await r.json().catch(() => null) : null;
      if (!r || !d) { esito.textContent = T.rete; return; }
      if (d.errore) { esito.textContent = d.errore; return; }
      f.dataset.esito = d.esito;
      const sbagliata = f.hasAttribute('data-senza-indizio') ? T.riprova : T.sbagliata;
      esito.textContent = d.esito === 'sbagliata' ? sbagliata : (T as Record<string, string>)[d.esito] || sbagliata;
      if (d.esito === 'giusta' && d.punti) {
        const b = document.createElement('strong');
        b.textContent = ` +${d.punti} ${T.exp}`;
        esito.append(b);
      }
      if (d.stato) dispatchEvent(new CustomEvent('livello', { detail: d.stato }));
      if (d.nuovi?.length) dispatchEvent(new CustomEvent('premi', { detail: d.nuovi }));
    });
  }
</script>
