---
import UsPractice from './UsPractice.astro';
import { calculusHtml } from '../lib/stem-usa-practice';
import { optionsFor } from '../data/stem-usa/catalog.mjs';

interface PreviewLesson {
  title: string;
  sections: [string, string][];
  worked: [string, string][];
  exercises: [string, string, string, string?][];
  prompt: string;
  correct: string;
  distractors: string[];
  explanation: string;
}
interface Props { lessons: PreviewLesson[] }
const { lessons } = Astro.props;
const questions = lessons.map((lesson, index) => {
  const choices = optionsFor(lesson, index);
  return {
    title: lesson.title,
    prompt: lesson.prompt,
    choices,
    correct: index % choices.length,
    explanation: lesson.explanation,
    href: '#preview-unit-' + (index + 1),
  };
});
---
<section aria-labelledby="preview-title" class="anteprima-liceo-usa">
  <h2 id="preview-title">Free preview</h2>
  {lessons.map((lesson, index) => {
    const [heading, text] = lesson.sections[0];
    const [workedPrompt, workedSolution] = lesson.worked[0];
    const [label, exercisePrompt, exerciseSolution] = lesson.exercises[0];
    return (
      <details class="sommario-pagina studio-unita-usa" id={'preview-unit-' + (index + 1)} open={index === 0}>
        <summary>{lesson.title}</summary>
        <div>
          <section aria-label="Theory">
            <h3>{heading}</h3>
            <p set:html={calculusHtml(text)} />
          </section>
          <section aria-label="Worked example">
            <h3>Worked example</h3>
            <p set:html={calculusHtml(workedPrompt)} />
            <p set:html={calculusHtml(workedSolution)} />
          </section>
          <section aria-label="Practice exercise">
            <h3>{label}</h3>
            <p set:html={calculusHtml(exercisePrompt)} />
            <details class="stem-feedback">
              <summary>Show solution</summary>
              <p set:html={calculusHtml(exerciseSolution)} />
            </details>
          </section>
        </div>
      </details>
    );
  })}
  <UsPractice questions={questions} minutes={questions.length * 2} renderMath />
</section>
<style>
  .anteprima-liceo-usa { margin-block: 1.5rem; }
  .studio-unita-usa section + section { margin-top: 1rem; }
  .studio-unita-usa h3 { margin: 0 0 .25rem; font-size: 1.05rem; }
</style>
