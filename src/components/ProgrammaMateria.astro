    .pm-esame .esame-materia { font-size: .82rem; min-height: 2.5rem; flex-wrap: nowrap; gap: .3rem; }
    .pm-esame .esame-materia:not(.con-data) .esame-titolo, .pm-esame .esame-testo { display: none !important; }
    .pm-esame .esame-apri { font-size: 0; margin: 0; text-decoration: none; color: var(--inchiostro); }
    .pm-esame .esame-apri::after { content: 'Data d’esame'; font-size: .82rem; }
    .pm-esame .esame-modifica { display: inline; font-size: inherit; margin-left: 0; }
    .pm-link:has(.con-data) { gap: 0 .3rem; font-size: .76rem; flex-wrap: wrap; }
    .pm-link:has(.con-data) .esame-icona { display: none; }
