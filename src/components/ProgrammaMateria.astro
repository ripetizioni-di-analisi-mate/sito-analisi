    .pm-link:has(.esame-modulo:not([hidden])) { flex-wrap: wrap; justify-content: flex-start; gap: 0 .9rem; }
    .pm-link:has(.esame-modulo:not([hidden])) .esame-materia { flex: 1 0 100%; flex-wrap: wrap; white-space: normal; gap: .3rem .45rem; padding-bottom: .5rem; }
    .pm-esame .con-data .esame-titolo { cursor: auto; }
