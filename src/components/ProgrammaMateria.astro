---
// Pagina della materia, versione «A2» (14/11/2026, scelta di Carmine sulla tavola dei disegni): Studio guidato,
// riga con anteprima, compatibilità, data d'esame e «Sblocca tutto» (apre il riquadro dell'accesso completo),
// programma a righe con le barrette di schede svolte, esercizi da fare e domande a tempo.
// Parte alta «B con lucchetto» (14/11 notte, scelta fra quattro varianti leggere): Studio guidato in una striscia
// sottile velata (mirino senza cerchio, tasto a contorno), tre passi sotto con le icone al posto dei numeri,
// icone a tratto fine, «Sblocca tutto · prezzo» come link con il lucchetto al posto della pillola oro.
// Vale per ogni materia in italiano ed è visibile a tutti dal 15/11/2026 (prima solo ai GM): la vista classica
// (classe vista-classica in Materia.astro) resta nel codice della pagina ma è sempre nascosta.
// Lo Studio guidato funziona solo dove ci sono le domande classificate (STUDIO_GUIDATO); altrove «In preparazione».
// Versione E (16/11/2026, scelta di Carmine fra sei varianti): riquadro dell'anteprima gratuita in cima (azione principale,
// con «Sblocca tutto» e «Copre il tuo esame?»), Studio guidato sotto; nei capitoli la Teoria è la prima delle quattro voci.
// Vale anche per le pagine inglesi (prop lingua); lo Studio guidato e la compatibilità restano in italiano.
import NotaBocconi from './NotaBocconi.astro';
import { BOCCONI } from '../data/bocconi.mjs';
import { ANTEPRIMA_ATTIVITA_ANALISI_1 } from '../data/anteprima-attivita.mjs';

interface Argomento { slug: string; titolo: string; riassunto?: string; pronto: boolean; svolti: number; dafare: number; verificabili: number; domande: number }
interface Props {
  materia: string;
  titolo: string;
  argomenti: Argomento[];
  prezzo?: number;
  anteprima: string;
  sblocca: string;
  compatibilita?: string;
  studioGuidato: boolean;
  incluso: string[];
  ripasso?: { titolo: string; domande: number; href: string; simulazione?: { href: string; titolo: string }; oggi: string };
  teoremi?: { href: string; teoremi: number; definizioni: number };
  inArrivo?: string[];
  lingua?: 'it' | 'en';
  /** Lingua delle pagine delle domande a tempo (alcune materie inglesi le hanno solo in italiano). */
  linguaDomande?: 'it' | 'en';
}
const { materia, titolo, argomenti, prezzo, anteprima, sblocca, compatibilita, studioGuidato, incluso, ripasso, teoremi, inArrivo = [], lingua = 'it', linguaDomande = lingua } = Astro.props;
const en = lingua === 'en';
// Testi della pagina nelle due lingue (16/11/2026: la versione E vale anche in inglese).
const L = en ? {
  sg: 'Guided study', sgInfo: 'How Guided study works', sgInfoBreve: 'How it works', sgFrase: 'The level of the questions adapts to your answers. The test is in Italian.',
  sgInizia: 'Start the test', sgPrep: 'Coming soon', passi: [['Answer the questions', 'Questions'], ['Find your gaps and their cause', 'Gaps'], ['Follow the path', 'Path']],
  apTitolo: 'Free preview', apTesto: 'For each topic, read the beginning of the theory and the first 3 sheets of worked examples for free, no account needed.',
  apInizia: 'Start with the preview', sblocca: 'Unlock everything', copre: 'Does it cover your exam?', attivo: 'Full access active',
  programma: 'Syllabus', teoria: 'Theory', svolti: ['Worked examples', 'Worked'], dafare: ['Exercises', 'Exercises'], domande: ['Timed questions', 'Questions'],
  prep: 'Coming soon', ripassoN: (n: number) => `${n} review questions on the whole syllabus.`, ripassoV: 'Review questions', oggi: 'Today’s review',
  indice: 'Index of theorems and definitions', indiceN: (t: number, d: number) => `${t} theorems and ${d} definitions`,
  accesso: 'Full access', chiudi: 'Close', totale: 'Total', paga: 'Go to checkout', compatDlg: 'Want to check the compatibility before buying?', provaDlg: 'Try the free preview first',
  dataEsame: 'Exam date',
} : {
  sg: 'Studio guidato', sgInfo: 'Come funziona lo Studio guidato', sgInfoBreve: 'Come funziona', sgFrase: 'Il livello delle domande si adatta alle tue risposte.',
  sgInizia: 'Inizia il test', sgPrep: 'In preparazione', passi: [['Rispondi alle domande', 'Domande'], ['Trovi le tue lacune e la loro causa', 'Lacune'], ['Segui il percorso', 'Percorso']],
  apTitolo: 'Anteprima gratuita', apTesto: 'Di ogni capitolo leggi gratis l’inizio della teoria e le prime 3 schede di esercizi svolti, senza creare l’account.',
  apInizia: 'Inizia con l’anteprima', sblocca: 'Sblocca tutto', copre: 'Copre il tuo esame?', attivo: 'Accesso completo attivo',
  programma: 'Programma', teoria: 'Teoria', svolti: ['Esercizi svolti', 'Svolti'], dafare: ['Esercizi da fare', 'Da fare'], domande: ['Domande a tempo', 'Domande'],
  prep: 'In preparazione', ripassoN: (n: number) => `${n} domande di ripasso su tutto il programma.`, ripassoV: 'Domande di ripasso', oggi: 'Il tuo ripasso di oggi',
  indice: 'Indice di teoremi e definizioni', indiceN: (t: number, d: number) => `${t} teoremi e ${d} definizioni`,
  accesso: 'Accesso completo', chiudi: 'Chiudi', totale: 'Totale', paga: 'Vai al pagamento', compatDlg: 'Vuoi controllare la compatibilità prima dell’acquisto?', provaDlg: 'Prova prima l’anteprima gratuita',
  dataEsame: 'Data d’esame',
};
const ic = (corpo: string, tratto = 1.7) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${tratto}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${corpo}</svg>`;
const I = {
  bersaglio: ic('<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>'),
  info: ic('<circle cx="12" cy="12" r="9.5"/><path d="M12 11v5.5"/><path d="M12 7.6v.1"/>'),
  mirino: ic('<circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="1.6"/>'),
  matita: ic('<path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="m13.5 6.5 4 4"/>'),
  lente: ic('<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>'),
  percorso: ic('<circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M8 18h6a3 3 0 0 0 0-6h-4a3 3 0 0 1 0-6h6"/>'),
  freccia: ic('<path d="M5 12h14M14 7l5 5-5 5"/>'),
  occhio: ic('<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.5"/>'),
  foglio: ic('<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="m9.5 14 2 2 3.5-4"/>'),
  lucchetto: ic('<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 7.5-2"/>', 1.8),
  svolti: ic('<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12 2.5 2.5 4.5-5"/>'),
  dafare: ic('<path d="M4 20l1-4L16 5l3 3L8 19z"/>'),
  domande: ic('<circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/>'),
  avanti: ic('<path d="m9 6 6 6-6 6"/>'),
  libro: ic('<path d="M5 5.5A2.5 2.5 0 0 1 7.5 3H19v14H7.5A2.5 2.5 0 0 0 5 19.5z"/><path d="M5 19.5A2.5 2.5 0 0 0 7.5 22H19v-5"/>'),
  spunta: ic('<path d="m5 12.5 4.5 4.5L19 7.5"/>', 2.2),
  chiudi: ic('<path d="M6 6l12 12M18 6 6 18"/>'),
};
const pre = en ? '/en' : '';
const href = (slug: string, sezione: string) => `${sezione === 'domande' && linguaDomande === 'it' ? '' : pre}/${materia}/${slug}/${sezione}`;
---
<div class:list={['pm', { 'pm-en': en }]} data-programma-materia={materia} data-lingua={lingua}>
  {/* Versione E (16/11/2026, scelta di Carmine): l'anteprima gratuita è l'azione principale e raccoglie anche
      «Sblocca tutto» e «Copre il tuo esame?». Chi ha la materia vede al suo posto «Accesso completo attivo». */}
  {prezzo && (
    <div class="pm-acc" data-materia={materia}>
      <section class="pm-ap stato-bloccata">
        <span class="pm-ap-ic" set:html={I.occhio} />
        <h2>{L.apTitolo}</h2>
        <p>{L.apTesto}</p>
        <div class="pm-ap-az">
          <a class="pm-ap-btn" href={anteprima} data-ap={materia}>{L.apInizia}<span set:html={I.freccia} /></a>
          <span class="pm-ap-sec">
            <a class="pm-sblocca" href={sblocca} data-pm-apri><span set:html={I.lucchetto} /><span class="pm-sblocca-t">{L.sblocca} · {prezzo} €</span></a>
            {compatibilita && <a class="pm-ap-compat" href={compatibilita}><span set:html={I.foglio} /><span class="pm-lungo">{L.copre}</span><span class="pm-corto">{en ? 'Covers your exam?' : 'Copre l’esame?'}</span></a>}
          </span>
        </div>
      </section>
      <span class="stato-sbloccata"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9.5" fill="currentColor"/><path d="M6 10.4l2.7 2.6L14 7.6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>{L.attivo}</span>
    </div>
  )}

  {materia === BOCCONI.slug ? <NotaBocconi lingua={lingua} /> : <section class="pm-sg">
    <span class="pm-sg-ic" set:html={I.mirino} />
    <h2>{L.sg}</h2>
    <button type="button" class="pm-info" aria-expanded="false" aria-controls="pm-sg-info" aria-label={L.sgInfo} title={L.sgInfoBreve} data-pm-info set:html={I.info}></button>
    <p>{L.sgFrase}</p>
    {studioGuidato
      ? <a class="pm-btn" href={`/studio-guidato/${materia}`}>{L.sgInizia}<span set:html={I.freccia} /></a>
      : <span class="pm-btn pm-btn-off">{L.sgPrep}</span>}
    <ol class="pm-sg2" id="pm-sg-info" hidden>
      <li><span set:html={I.matita} /><span class="pm-lungo">{L.passi[0][0]}</span><span class="pm-corto">{L.passi[0][1]}</span></li>
      <li class="pm-fr" aria-hidden="true" set:html={I.freccia} />
      <li><span set:html={I.lente} /><span class="pm-lungo">{L.passi[1][0]}</span><span class="pm-corto">{L.passi[1][1]}</span></li>
      <li class="pm-fr" aria-hidden="true" set:html={I.freccia} />
      <li><span set:html={I.percorso} /><span class="pm-lungo">{L.passi[2][0]}</span><span class="pm-corto">{L.passi[2][1]}</span></li>
    </ol>
  </section>}

  <div class="pm-ph-riga">
    <h2 class="pm-ph" id="programma">{L.programma}</h2>
    <span class="pm-esame" data-pm-esame></span>
  </div>
  <ol class="pm-perc">
    {argomenti.map((a, i) => (
      <li data-arg={a.pronto ? a.slug : undefined} data-schede={a.svolti} data-verificabili={a.verificabili} data-domande={a.domande} class:list={{ 'pm-prep': !a.pronto }}>
        <span class="pm-num">{String(i + 1).padStart(2, '0')}</span>
        <div class="pm-cp">
          <h3>{a.pronto ? <a href={href(a.slug, 'teoria')}>{a.titolo}<span set:html={I.avanti} /></a> : a.titolo}</h3>
          {a.riassunto && <p>{a.riassunto}</p>}
          {lingua === 'it' && materia === 'analisi-1' && a.slug === 'insiemi' && (
            <a class="pm-anteprima-attivita" href={ANTEPRIMA_ATTIVITA_ANALISI_1} data-orientamento-gm hidden>Anteprima attività</a>
          )}
        </div>
        {a.pronto ? (
          <div class="pm-voci">
            <em class="pm-stato" hidden></em>
            <a class="pm-v" href={href(a.slug, 'teoria')} data-voce="teoria"><span class="pm-vr"><span set:html={I.libro} /><span class="pm-vn">{L.teoria}</span><span class="pm-vc"></span><span set:html={I.avanti} /></span><span class="pm-barra"><i></i></span></a>
            {a.svolti > 0 && <a class="pm-v" href={href(a.slug, 'esercizi-svolti')} data-voce="schede"><span class="pm-vr"><span set:html={I.svolti} /><span class="pm-vn"><span class="pm-lungo">{L.svolti[0]}</span><span class="pm-corto">{L.svolti[1]}</span></span><span class="pm-vc">{a.svolti}</span><span set:html={I.avanti} /></span><span class="pm-barra"><i></i></span></a>}
            {a.dafare > 0 && <a class="pm-v" href={href(a.slug, 'esercizi')} data-voce="esercizi"><span class="pm-vr"><span set:html={I.dafare} /><span class="pm-vn"><span class="pm-lungo">{L.dafare[0]}</span><span class="pm-corto">{L.dafare[1]}</span></span><span class="pm-vc">{a.dafare}</span><span set:html={I.avanti} /></span><span class="pm-barra"><i></i></span></a>}
            {a.domande > 0 && <a class="pm-v" href={href(a.slug, 'domande')} data-voce="domande"><span class="pm-vr"><span set:html={I.domande} /><span class="pm-vn"><span class="pm-lungo">{L.domande[0]}</span><span class="pm-corto">{L.domande[1]}</span></span><span class="pm-vc">{a.domande}</span><span set:html={I.avanti} /></span><span class="pm-barra"><i></i></span></a>}
          </div>
        ) : <em class="pm-stato pm-stato-prep">{L.prep}</em>}
      </li>
    ))}
    {inArrivo.map((titoloArrivo, i) => (
      <li class="pm-prep">
        <span class="pm-num">{String(argomenti.length + i + 1).padStart(2, '0')}</span>
        <div class="pm-cp"><h3>{titoloArrivo}</h3></div>
        <em class="pm-stato pm-stato-prep">{L.prep}</em>
      </li>
    ))}
    {ripasso && (
      <li class="pm-fine">
        <span class="pm-num pm-num-ic" set:html={I.bersaglio} />
        <div class="pm-cp">
          <h3><a href={ripasso.href}>{ripasso.titolo}<span set:html={I.avanti} /></a></h3>
          <p>{L.ripassoN(ripasso.domande)}</p>
        </div>
        <div class="pm-voci">
          <a class="pm-v" href={ripasso.href}><span class="pm-vr"><span set:html={I.domande} /><span class="pm-vn">{L.ripassoV}</span><span class="pm-vc">{ripasso.domande}</span><span set:html={I.avanti} /></span></a>
          {ripasso.simulazione && <a class="pm-v" href={ripasso.simulazione.href}><span class="pm-vr"><span set:html={I.foglio} /><span class="pm-vn">{ripasso.simulazione.titolo}</span><span set:html={I.avanti} /></span></a>}
          <a class="pm-v solo-collegati" href={ripasso.oggi} hidden><span class="pm-vr"><span set:html={I.svolti} /><span class="pm-vn">{L.oggi}</span><span set:html={I.avanti} /></span></a>
        </div>
      </li>
    )}
  </ol>
  {teoremi && <p class="pm-dopo"><a href={teoremi.href}>{L.indice}</a><span>{L.indiceN(teoremi.teoremi, teoremi.definizioni)}</span></p>}

  {prezzo && (
    <dialog class="pm-dlg" aria-labelledby={`pm-dlg-${materia}`}>
      <div class="pm-dlg-testa">
        <div><span>{L.accesso}</span><h2 id={`pm-dlg-${materia}`}>{titolo}</h2></div>
        <button type="button" class="pm-dlg-x" aria-label={L.chiudi} data-pm-chiudi set:html={I.chiudi} />
      </div>
      <ul>{incluso.map((v) => <li><span set:html={I.spunta} />{v}</li>)}</ul>
      <p class="pm-dlg-tot"><span>{L.totale}</span><b>{prezzo} €</b></p>
      <a class="pm-oro pm-oro-largo" href={sblocca}><span set:html={I.lucchetto} />{L.paga}</a>
      <div class="pm-dlg-link">
        {compatibilita && <a href={compatibilita}><span set:html={I.foglio} /><span>{L.compatDlg}</span><span set:html={I.avanti} /></a>}
        <a href={anteprima} data-ap={materia}><span set:html={I.occhio} /><span>{L.provaDlg}</span><span set:html={I.avanti} /></a>
      </div>
    </dialog>
  )}
</div>

<style is:global>
  .vista-classica { display: none !important; }
  /* Sopra il titolo restano solo la freccia e «Materie»: l'etichetta della materia e l'ultima voce del percorso ripetevano il titolo. */
  .pagina:has([data-programma-materia]) > .contesto-materia,
  .pagina:has([data-programma-materia]) > .percorso li[aria-current] { display: none; }
  .pm { font-family: var(--ui); margin-top: 1.2rem; --pm-oro: #d6c28e; --pm-oro-testo: #2b2210; --pm-sabbia: #f4efe1; --pm-sabbia-bordo: #e7dec8; }
  .pm svg { width: 1em; height: 1em; flex: none; }
  .pm-corto { display: none; }
  .pm a > span:has(> svg), .pm li > span:has(> svg), .pm button > span:has(> svg) { display: inline-flex; }

  /* Parte alta leggera: velo semitrasparente, icone a tratto fine e poco marcate. */
  .pm { --pm-velo: color-mix(in srgb, var(--azione) 5%, transparent); --pm-filo: color-mix(in srgb, var(--azione) 14%, transparent); --pm-icona: #6b8a86; }
  .pm-sg svg, .pm-sg2 svg, .pm-link a svg, .pm-sblocca svg { stroke-width: 1.4; }
  .pm-sg { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .65rem; padding: .6rem .6rem .6rem 1rem; background: var(--pm-velo); border: 1px solid var(--pm-filo); border-radius: 12px; }
  .pm-sg-ic { display: inline-flex; color: #41706b; font-size: 1.25rem; flex: none; }
  .pm-sg h2 { font: 700 1.1rem/1.2 var(--titoli); margin: 0; white-space: nowrap; }
  .pm-sg p { flex: 1 1 0; min-width: 9rem; margin: 0; padding-left: .65rem; border-left: 1px solid color-mix(in srgb, var(--azione) 20%, transparent); font-size: .9rem; line-height: 1.35; color: var(--inchiostro-2); }
  .pm-btn { display: inline-flex; align-items: center; gap: .4rem; flex: none; height: 2.75rem; padding: 0 1rem; border: 1px solid color-mix(in srgb, var(--azione) 40%, transparent); border-radius: 999px; background: none; color: var(--azione); font-size: .92rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  a.pm-btn:hover { background: color-mix(in srgb, var(--azione) 7%, transparent); color: var(--azione); }
  .pm-btn svg { font-size: .9rem; stroke-width: 1.7; }
  .pm-btn-off { color: var(--inchiostro-2); border-color: var(--riga); font-weight: 500; }
  .pm-info { display: inline-flex; align-items: center; justify-content: center; flex: none; width: 2rem; height: 2rem; margin: 0 -.3rem; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--pm-icona); font-size: 1.1rem; cursor: pointer; }
  .pm-info:hover, .pm-info[aria-expanded='true'] { color: var(--azione); background: color-mix(in srgb, var(--azione) 8%, transparent); }
  .pm-sg2[hidden] { display: none; }
  .pm-sg2 { list-style: none; flex: 1 0 100%; margin: .15rem 0 0; padding: .5rem 0 .15rem; border-top: 1px solid var(--pm-filo); display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .6rem; font-size: .84rem; line-height: 1.3; color: var(--inchiostro-2); }
  .pm-sg2 li { display: inline-flex; align-items: center; gap: .4rem; }
  .pm-sg2 li svg { color: var(--pm-icona); font-size: .95rem; }
  .pm-sg2 .pm-fr svg { color: #a9b7b4; font-size: .8rem; }

  /* Versione E (16/11/2026): riquadro dell'anteprima gratuita in cima, con «Sblocca tutto» e «Copre il tuo esame?» come link secondari. */
  .pm-acc { margin: 0 0 .6rem; }
  .pm-ap { grid-template-columns: auto minmax(0, 1fr); gap: .2rem .85rem; padding: 1.1rem 1.25rem 1.15rem; background: var(--pm-velo); border: 1px solid var(--pm-filo); border-radius: 14px; }
  .pm-acc .pm-ap.stato-bloccata { display: grid; }
  .pm-ap-ic { display: inline-flex; grid-row: 1 / span 2; padding-top: .1rem; color: #41706b; font-size: 1.6rem; }
  .pm-ap-ic svg { stroke-width: 1.4; }
  .pm-ap h2 { font: 700 1.3rem/1.25 var(--titoli); margin: 0; }
  .pm-ap p { margin: .15rem 0 0; font-size: .95rem; line-height: 1.4; color: var(--inchiostro-2); }
  .pm-ap-az { grid-column: 2; display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.2rem; margin-top: .75rem; }
  .pm-ap-btn { display: inline-flex; align-items: center; gap: .45rem; height: 2.9rem; padding: 0 1.3rem; border-radius: 999px; background: var(--azione); color: #fff; font-size: .98rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .pm-ap-btn:hover { color: #fff; filter: brightness(1.1); }
  .pm-ap-btn svg { font-size: .9rem; stroke-width: 1.8; }
  .pm-ap-sec { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.1rem; font-size: .9rem; }
  .pm-ap-sec .pm-sblocca { display: inline-flex; }
  .pm-ap-compat { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.75rem; color: var(--inchiostro); text-decoration: none; white-space: nowrap; }
  .pm-ap-compat svg { color: var(--pm-icona); font-size: 1.05rem; stroke-width: 1.4; }
  .pm-ap-compat:hover { color: var(--azione); text-decoration: underline; text-underline-offset: 3px; }
  .pm-acc .stato-sbloccata { display: none; align-items: center; gap: .4rem; padding: .25rem .75rem .25rem .3rem; border-radius: 999px; background: color-mix(in srgb, var(--verde) 12%, transparent); color: var(--verde); font-size: .88rem; font-weight: 600; }
  .pm-acc .stato-sbloccata svg { width: 1.1rem; height: 1.1rem; }

  .pm-az { display: flex; align-items: center; justify-content: space-between; gap: .3rem .9rem; margin: .5rem 0 0; font-size: .9rem; }
