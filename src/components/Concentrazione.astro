---
import type { Lingua } from '../i18n';
interface Props { lingua?: Lingua }
const { lingua = 'it' } = Astro.props;
const en = lingua === 'en';
const testi = en ? {
  etichetta: 'Focus mode', attiva: 'Focus mode active',
  descrizione: 'Hide the side index and promotional bar while studying. Navigation and Pi remain available.',
  acceso: 'Focus mode active. The index is available from the menu button.', spento: 'Standard view restored.',
} : {
  etichetta: 'Concentrazione', attiva: 'Concentrazione attiva',
  descrizione: 'Nasconde l’indice laterale e la barra promozionale durante lo studio. Navigazione e Pi restano disponibili.',
  acceso: 'Concentrazione attiva. L’indice si apre dal pulsante del menu.', spento: 'Vista completa ripristinata.',
};
---
<div class="studio-comandi" data-concentrazione hidden>
  <button type="button" class="studio-concentrazione" aria-pressed="false" title={testi.descrizione} data-testi={JSON.stringify(testi)}>
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M7 3H3v4M13 3h4v4M17 13v4h-4M7 17H3v-4"/><circle cx="10" cy="10" r="2.3"/></svg>
    <span>{testi.etichetta}</span>
  </button>
  <span class="studio-stato" aria-live="polite" role="status"></span>
</div>
<script>
  const comandi = document.querySelector<HTMLElement>('[data-concentrazione]');
  const bottone = comandi?.querySelector<HTMLButtonElement>('button');
  if (comandi && bottone) {
    const testi = JSON.parse(bottone.dataset.testi ?? '{}');
    const applica = (attiva: boolean, annuncia = false) => {
      document.documentElement.classList.toggle('studio-concentrato', attiva);
      bottone.setAttribute('aria-pressed', String(attiva));
      const nome = bottone.querySelector('span');
      if (nome) nome.textContent = attiva ? testi.attiva : testi.etichetta;
      if (annuncia) {
        try { localStorage.setItem('studio-concentrazione', attiva ? '1' : '0'); } catch {}
        const stato = comandi.querySelector('.studio-stato');
        if (stato) stato.textContent = attiva ? testi.acceso : testi.spento;
        // Le formule si adattano alla nuova larghezza attraverso il gestore già presente in Base.
        window.dispatchEvent(new Event('resize'));
      }
    };
    let attiva = false;
    try { attiva = localStorage.getItem('studio-concentrazione') === '1'; } catch {}
    applica(attiva);
    comandi.hidden = false;
    bottone.addEventListener('click', () => applica(bottone.getAttribute('aria-pressed') !== 'true', true));
  }
</script>
<style>
  .studio-comandi { display: flex; justify-content: flex-end; margin: -.35rem 0 .65rem; font-family: var(--ui); }
  .studio-concentrazione { display: inline-flex; gap: .4rem; align-items: center; min-height: 2.5rem; padding: .35rem .6rem; font: inherit; font-size: .82rem; color: var(--inchiostro-2); border: 1px solid var(--riga); border-radius: var(--raggio); background: transparent; cursor: pointer; }
  .studio-concentrazione:hover { background: var(--carta-2); }
  .studio-concentrazione[aria-pressed="true"] { color: var(--accento); border-color: var(--accento); background: color-mix(in srgb, var(--accento) 6%, var(--carta)); }
  .studio-stato { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :global(html.studio-concentrato .barra-sconto) { display: none !important; }
  @media (min-width: 60rem) {
    :global(html.studio-concentrato .corpo) { grid-template-columns: 1fr; }
    :global(html.studio-concentrato .corpo > .indice) { display: none; }
    :global(html.studio-concentrato .bottone-indice) { display: inline-flex; }
  }
  @media print { .studio-comandi { display: none; } }
</style>
