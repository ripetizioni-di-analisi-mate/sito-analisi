{
  // Pubblicazione su Cloudflare: Worker (accessi, oscuramento, dashboard) + file statici
  "name": "sito-analisi",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "main": "worker/index.mjs",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ARCHIVIO", "class_name": "Archivio" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Archivio"] }],
  "vars": {
    // "0" = sito tutto aperto; qualsiasi altro valore = oscuramento attivo
    "VENDITA": "1",
    // Paddle: identificativi pubblici dei due prezzi (non sono segreti)
    "PADDLE_AMBIENTE": "production",
    "PADDLE_PREZZO_ANALISI_1": "pri_01m5z6aynthpe6w821c27ycaxk",
    "PADDLE_PREZZO_ANALISI_2": "pri_01m5z6cfsrj5ss4kd532hkgpd7"
    // Segreti da impostare nel pannello Cloudflare (Worker -> Settings -> Variables and Secrets),
    // mai in questo file: "ADMIN_PASSWORD" (password della dashboard) e
    // "CHIAVE_ACCESSO" (firma dei link personali; cambiarla invalida i link gia' consegnati).
    // Quando Paddle è pronto, aggiungere lì anche:
    // "PADDLE_CLIENT_TOKEN", "PADDLE_AMBIENTE" ("sandbox" o "production"),
    // "PADDLE_PREZZO_ANALISI_1", "PADDLE_PREZZO_ANALISI_2", e come segreto "PADDLE_WEBHOOK_SECRET".
    // Per le email: "RESEND_API_KEY" (segreto) e "MITTENTE".
  }
}
