{
  // Pubblicazione su Cloudflare: Worker (accessi, oscuramento, dashboard) + file statici
  "name": "sito-analisi",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "main": "worker/index.mjs",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  "durable_objects": { "bindings": [{ "name": "ARCHIVIO", "class_name": "Archivio" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Archivio"] }],
  // Intelligenza artificiale di Cloudflare per l'assistente di studio (worker/assistente.mjs)
  "ai": { "binding": "AI" },
  "vars": {
    // "0" = sito tutto aperto; qualsiasi altro valore = oscuramento attivo
    "VENDITA": "1",
    // Paddle: token del checkout e identificativi dei prezzi, tutti pubblici (non sono segreti)
    "PADDLE_AMBIENTE": "production",
    "PADDLE_CLIENT_TOKEN": "live_3dfdc4fac37285fb2b6966f7b58",
    "PADDLE_PREZZO_PRECORSO": "pri_01m60xgef8rr7t089736k3fa3z",
    "PADDLE_PREZZO_ANALISI_1": "pri_01m5z6aynthpe6w821c27ycaxk",
    "PADDLE_PREZZO_ANALISI_2": "pri_01m5z6cfsrj5ss4kd532hkgpd7",
    "PADDLE_PREZZO_ALGEBRA_LINEARE": "pri_01m61jm6w03harfshmj8a1vfke",
    "PADDLE_PREZZO_FISICA_1": "pri_01m61jnkz4dx9drvpk02cc801d",
    "PADDLE_PREZZO_FISICA_2": "pri_01m61jpx5sxsb03hw6yqyh1mc2",
    "PADDLE_PREZZO_MATEMATICA_GENERALE": "pri_01m644j57901k5gxbwwbpe485v",
    "PADDLE_PREZZO_MATEMATICA_SUPERIORI_5": "pri_01m644kjg8zmzfewdmmwvad9hg",
    "PADDLE_PREZZO_MATEMATICA_CONCORSI": "pri_01m66bzzp37j6gp6sn0cx54vdr"
    // Segreti, solo nel pannello Cloudflare (Worker -> Settings -> Variables and Secrets), mai in questo file:
    // "ADMIN_PASSWORD" (dashboard), "CHIAVE_ACCESSO" (firma di sessioni e link: cambiarla scollega tutti),
    // "PADDLE_WEBHOOK_SECRET". Per le email automatiche: "RESEND_API_KEY" (segreto) e "MITTENTE".
  }
}
